# Generated and vendored files, marked so the repository's language statistics,
# pull-request diffs and code search describe what is written here. The product
# is Go and hand-authored CSS; sqlc's output, templ's output and htmx must not
# classify it otherwise.
*_templ.go linguist-generated
internal/db/db.go linguist-generated
internal/db/models.go linguist-generated
internal/db/query.sql.go linguist-generated
assets/js/vendor/** linguist-vendored

# The fonts are Google's woff2, fetched once and vendored; the stylesheet that
# names them is generated from those files by the step in assets/fonts/README.
# Neither is written here, and a 109-rule sheet would otherwise read as the
# largest piece of CSS in the repository.
assets/fonts/** linguist-vendored
assets/css/app/fonts.css linguist-generated
