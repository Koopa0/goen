bin/
.env
*.out
.DS_Store

# Scratch space for probes and screenshots; never part of the delivery.
/tmp/

# The throwaway Chrome profile `make check-layout` drives.
/.layout-chrome/

# Provider credentials. .env already covers the normal path; these catch the
# copy-paste-from-the-dashboard file that arrives beside it, which is how a
# test key — and one day a live one — reaches a public repository.
*api-key*.txt
*secret*.txt
stripe-*.txt

# The compiled binary, if somebody runs `go build` without -o. It is 25 MB and
# has been left in the tree by a review before now.
/goen
