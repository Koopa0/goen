bin/
.env
*.out
.DS_Store

# Scratch space for probes and screenshots; never part of the delivery.
/tmp/

# The throwaway Chrome profile `make check-layout` drives.
/.layout-chrome/
/chrome.log

# Provider credentials. .env covers the normal path; these catch the
# copy-paste-from-the-dashboard file that arrives beside it.
*api-key*.txt
*secret*.txt
stripe-*.txt

# The compiled binary, if somebody runs `go build` without -o.
/goen

# Notes, briefs, review transcripts and decision records. The code is the
# specification; a spec beside it becomes a second answer that drifts.
/docs/*
# The figures ARCHITECTURE.md draws, with the script that renders them.
!/docs/architecture/
# The renderer writes each SVG on its way to the PNG; only the PNG is published.
/docs/architecture/*.svg
/branding/

# Product photography. The images the site serves live in PostgreSQL.
/goen-product-images/
goen-product-images.zip
