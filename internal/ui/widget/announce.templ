package widget

import "github.com/koopa0/goen/internal/i18n"

templ Announce(r Result) {
	@announce(r, "")
}

// The layout gate finds the order page's notice by the vendored spelling, so the element keeps it (#380 R8).
templ AnnounceOrder(r Result) {
	@announce(r, "ui-alert")
}

// A refusal or a failure opens with a word, so the outcome does not rest on colour alone.
templ announce(r Result, class string) {
	if r.Text != "" {
		@Notice(NoticeProps{Intent: r.Outcome.Intent(), Class: class}) {
			switch r.Outcome {
				case OutcomeRefused:
					<strong class="goen-notice__lead">{ i18n.T(ctx, i18n.KeyAdminNoticeLeadRefused) }</strong>
				case OutcomeFailed:
					<strong class="goen-notice__lead">{ i18n.T(ctx, i18n.KeyAdminNoticeLeadFailed) }</strong>
			}
			{ r.Text }
		}
	}
}
