package widget

// Disclosure is a native <details>, rendered closed: Summary is its one line and
// the children are its panel. Class lets a caller's stylesheet place it.
templ Disclosure(p DisclosureProps) {
	<details class={ p.class() }>
		<summary class="goen-disclosure__summary">{ p.Summary }</summary>
		<div class="goen-disclosure__panel">
			{ children... }
		</div>
	</details>
}
