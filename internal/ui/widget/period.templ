package widget

// The cells are ahead, past or today, and a return window's mark its last
// statutory day. The period is one image with one sentence.
templ Period(p PeriodSpec) {
	<div
		class="ui-period"
		role="img"
		aria-label={ p.Description }
		if p.TodayAtStart {
			data-today="start"
		}
	>
		for i, c := range p.Cells {
			<i
				if c.State != CellAhead {
					data-cell={ string(c.State) }
				}
				if c.Mark {
					data-mark
				}
				if c.Extra {
					data-span="extra"
				}
			>
				if c.State == CellToday || p.TodayAtStart && i == 0 {
					<b>{ p.TodayLabel }</b>
				}
				if c.Label != "" {
					<small>{ c.Label }</small>
				}
			</i>
		}
	</div>
}

// DayTrack is the period as a row of days and nothing else: no labels, no
// today word, and hidden from a screen reader, because it is drawn only beside
// words that say the same (the end and the days left). The days to come are the
// campaign's colour and the days gone a quiet line.
templ DayTrack(p PeriodSpec) {
	<div class="goen-days" aria-hidden="true">
		for _, c := range p.Cells {
			<i
				if c.State == CellPast {
					data-cell="past"
				}
			></i>
		}
	</div>
}
