templ Star() {
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
	</svg>
}

// Category renders nothing for a key it does not know.
templ Category(key string) {
	switch key {
		case categoryPhone:
			@Smartphone()
		case categoryLaptop:
			@Laptop()
		case categoryTablet:
			@Tablet()
		case categoryHeadphones:
			@Headphones()
		case categoryWatch:
			@Watch()
		case categoryPlug:
			@Plug()
		case categoryShield:
			@Shield()
		case categoryBook:
			@Book()
		case categoryStationery:
			@Pencil()
		case categoryHome:
			@House()
		case categoryKitchen:
			@Pot()
		case categoryFood:
			@Bowl()
		case categoryDrink:
			@Cup()
		case categoryBeauty:
			@Lipstick()
		case categoryApparel:
			@Shirt()
		case categoryKids:
			@Bear()
		case categoryGift:
			@Gift()
	}
}

templ Smartphone() {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"></path>
		<path d="M12 18h.01"></path>
	</svg>
}

templ Laptop() {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"></path>
	</svg>
}

templ Tablet() {
