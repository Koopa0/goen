package components

// The label comes before the figure in the document, so a screen reader hears what is counted first.
templ StatLine(stats []Stat, variant StatLineVariant) {
	if items := shown(stats); len(items) > 0 {
		<dl class={ variant.class() }>
			for _, s := range items {
				<div>
					<dt>{ s.Label }</dt>
					@statValue(s)
				</div>
			}
		</dl>
	}
}

// GlanceStatLine is a stat line whose labels link; the figure stays outside the link.
templ GlanceStatLine(stats []LinkedStat) {
	if items := shownLinked(stats); len(items) > 0 {
		<dl class="ui-statline ui-statline--glance">
			for _, s := range items {
				<div>
					<dt><a href={ templ.SafeURL(s.Href) }>{ s.Label }</a></dt>
					@statValue(s.Stat)
				</div>
			}
		</dl>
	}
}

templ statValue(s Stat) {
	<dd>
		if s.Value.pre != "" {
			<small class="ui-statline__pre">{ s.Value.pre }</small>{ s.Value.figure }
		} else if s.Value.unit != "" {
			{ s.Value.figure + "\u00a0" }<small>{ s.Value.unit }</small>
		} else {
			{ s.Value.figure }
		}
		if s.Note != "" {
			<span class="ui-statline__note">{ s.Note }</span>
		}
	</dd>
}
