package components

// The cells are ahead, past or today; the first and last carry their dates and
// the current one the word for today. The grid is one image with one sentence.
templ Period(p PeriodSpec) {
	<div
		class="ui-period"
		role="img"
		aria-label={ p.Description }
		if p.unitAttr() != "" {
			data-unit={ p.unitAttr() }
		}
	>
		for _, c := range p.Cells {
			<i
				if c.State != CellAhead {
					data-cell={ string(c.State) }
				}
				if c.Mark {
					data-mark
				}
				if c.Extra {
					data-span="extra"
				}
			>
				if c.State == CellToday {
					<b>{ p.TodayLabel }</b>
				}
				if c.Label != "" {
					<small>{ c.Label }</small>
				}
			</i>
		}
	</div>
}
