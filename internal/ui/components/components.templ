package components

// Type is explicit at every call: a button inside a form submits unless told not to.
templ Button(p ButtonProps, buttonType string) {
	<button class={ p.class() } type={ buttonType } { p.Attrs... }>
		{ children... }
	</button>
}

// Stays an anchor: choosing a variant is navigation, which has to work with scripting
// off and with the middle mouse button.
templ ButtonLink(p ButtonProps, href templ.SafeURL) {
	<a class={ p.class() } href={ href } { p.Attrs... }>
		{ children... }
	</a>
}

templ Badge(p BadgeProps) {
	<span class={ p.class() }>
		{ children... }
	</span>
}

templ Card(p CardProps) {
	<div class={ p.class() } { p.Attrs... }>
		{ children... }
	</div>
}

templ Notice(p NoticeProps) {
	if p.ID != "" {
		<p class={ p.class() } id={ p.ID } role={ p.Intent.role() }>
			{ children... }
		</p>
	} else {
		<p class={ p.class() } role={ p.Intent.role() }>
			{ children... }
		</p>
	}
}

templ Label(p LabelProps) {
	<label class={ p.class() } for={ p.For }>
		{ children... }
	</label>
}

templ Input(p FieldProps) {
	<input
		class={ p.class() }
		id={ p.ID }
		name={ p.Name }
		type={ p.inputType() }
		value={ p.Value }
		if p.Invalid {
			aria-invalid="true"
			if p.Describes != "" {
				aria-describedby={ p.Describes }
			}
		}
		{ p.Attrs... }
	/>
}

templ Textarea(p FieldProps) {
	<textarea
		class={ p.areaClass() }
		id={ p.ID }
		name={ p.Name }
		if p.Invalid {
			aria-invalid="true"
			if p.Describes != "" {
				aria-describedby={ p.Describes }
			}
		}
		{ p.Attrs... }
	>
		{ children... }
	</textarea>
}

// An empty Href marks the page itself, rendered as text with aria-current, not a link to where you are.
type Crumb struct {
	Label string
	Href  string
}

// The class is the design system's spelling, not a goen- one: a test locates the
// product page's trail by it (internal/product/integration_test.go), and a selector a
// test reads keeps its spelling while app.css changes its declarations.
templ Breadcrumb(p BreadcrumbProps) {
	<nav class="ui-crumbs" aria-label={ p.Label }>
		for i, c := range p.Crumbs {
			if i > 0 {
				<span class="ui-crumbs__sep" aria-hidden="true">/</span>
			}
			if c.Href == "" {
				<span class="ui-crumbs__current" aria-current="page">{ c.Label }</span>
			} else {
				<a class="ui-crumbs__link" href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
			}
		}
	</nav>
}
