package components

// The field is the control; the buttons are an enhancement. They carry type="button"
// so they never submit and are hidden until a stylesheet is told scripting is on.
//
// data-stepper and data-stepper-step are what assets/js/goen.js listens for. It
// delegates from the document, so a region swapped in later needs no initialisation.
templ Stepper(p StepperProps) {
	<div class={ p.class() } data-stepper { p.Attrs... }>
		<button
			class="goen-stepper__step"
			type="button"
			data-stepper-step="-1"
			aria-label={ p.DecreaseLabel }
			disabled?={ p.Disabled }
		>
			<span aria-hidden="true">&#8722;</span>
		</button>
		<input
			class="goen-stepper__value"
			id={ p.ID }
			name={ p.Name }
			type="number"
			inputmode="numeric"
			value={ p.Value }
			min={ p.Min }
			max={ p.Max }
			step="1"
			disabled?={ p.Disabled }
		/>
		<button
			class="goen-stepper__step"
			type="button"
			data-stepper-step="1"
			aria-label={ p.IncreaseLabel }
			disabled?={ p.Disabled }
		>
			<span aria-hidden="true">+</span>
		</button>
	</div>
}
