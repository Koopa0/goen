package frame

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/widget"
)

// One row of text: the brand, the departments, the search field and the words
// for the language, the account, the wishlist and the cart, in the order they
// are drawn at 1440. English and a narrow screen take the departments to a row
// of their own (app.css); the order of the markup stays the one a reader of the
// one-row header meets.
//
// ui-navitem is not a leftover: two assertions in backoffice_test.go locate the
// drawer's back-office entrance by the whole tag, and app.css replaces every
// declaration the name carries upstream.
templ Header(p Page) {
	<header class="goen-header">
		<div class="goen-header__bar">
			<a class="goen-header__brand" href="/">
				@icons.Mark("goen-header__mark")
				<span class="goen-header__wordmark">goen</span>
			</a>
			if departmentRow(ctx) {
				<nav class="goen-header__nav" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
					for _, n := range TopNavFrom(ctx) {
						@department(p, n)
					}
					if HasDeals(ctx) {
						<a
							class="ui-navitem goen-header__navitem--deal"
							if currentPage(ctx, "/deals") {
								aria-current="page"
							}
							href="/deals"
						>{ i18n.T(ctx, i18n.KeyDeals) }</a>
					}
				</nav>
			}
			<form class="goen-header__search" role="search" aria-label={ i18n.T(ctx, i18n.KeySearch) } action="/search" method="get">
				<span class="goen-header__searchicon">
					@icons.Search()
				</span>
				<label class="goen-sr-only" for="site-search">{ i18n.T(ctx, i18n.KeySearch) }</label>
				@widget.Input(widget.FieldProps{
					ID:    "site-search",
					Name:  "q",
					Type:  "search",
					Value: p.SearchQuery,
					Class: "goen-header__field",
					Attrs: templ.Attributes{"placeholder": i18n.T(ctx, i18n.KeySearchHint)},
				})
			</form>
			<div class="goen-header__actions">
				// Shown from 1024, as the language, the account and the wishlist are; below
				// that the menu carries all four and the bar keeps the cart and the menu.
				if IsStaff(ctx) {
					<a class="goen-header__tool goen-header__backoffice" href="/admin">{ i18n.T(ctx, i18n.KeyBackOffice) }</a>
				}
				@languageLink()
				<a class="goen-header__tool goen-header__wide" href="/account">{ i18n.T(ctx, i18n.KeyAccount) }</a>
				<a class="goen-header__tool goen-header__wide" href="/account/wishlist">{ i18n.T(ctx, i18n.KeyWishlist) }</a>
				@cartLink()
				<details class="goen-header__menu" data-menu>
					<summary class="goen-header__tool">{ i18n.T(ctx, i18n.KeyMenu) }</summary>
					<nav class="goen-header__drawer" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
						// A visible way out at the drawer's own edge. goen.js closes the menu and
						// returns focus to the menu's button, as Escape does.
						<button class="goen-header__close goen-btn goen-btn--ghost goen-btn--icon" type="button" data-menu-close aria-label={ i18n.T(ctx, i18n.KeyCloseMenu) }>
							@icons.Close()
						</button>
						if len(TopNavFrom(ctx)) > 1 {
							<span class="goen-header__drawerheading">{ i18n.T(ctx, i18n.KeyCategoryNav) }</span>
						}
						for _, n := range TopNavFrom(ctx) {
							<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>
								<span class="goen-header__navname">{ n.Name }</span>
								if n.ProductCount > 0 {
									<small>{ strconv.Itoa(n.ProductCount) }</small>
								}
							</a>
						}
						if HasDeals(ctx) {
							<a
								class="ui-navitem goen-header__navitem--deal"
								if currentPage(ctx, "/deals") {
									aria-current="page"
								}
								href="/deals"
							>{ i18n.T(ctx, i18n.KeyDeals) }</a>
						}
						if IsStaff(ctx) {
							<a class="ui-navitem" href="/admin">{ i18n.T(ctx, i18n.KeyBackOffice) }</a>
						}
						<div class="goen-header__drawertools">
							<a class="ui-navitem" href="/account/wishlist">{ i18n.T(ctx, i18n.KeyWishlist) }</a>
							<a class="ui-navitem" href="/account">{ i18n.T(ctx, i18n.KeyAccount) }</a>
							@languageMenu("goen-header__drawerlang", true)
						</div>
					</nav>
				</details>
			</div>
		</div>
	</header>
}

// The panel is plain markup shown by CSS: on hover, and under :focus-within until
// goen.js runs, when ArrowDown on the department's link opens it instead. Three of
// the newest products sit between the sub-categories and the photograph, so a
// department with two sub-categories still fills its panel. Every image is lazy: a
// closed panel is display:none and fetches nothing.
templ department(p Page, n NavItem) {
	if len(n.Children) == 0 {
		<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>{ n.Name }</a>
	} else {
		@departmentPanel(p, n)
	}
}

templ departmentPanel(p Page, n NavItem) {
	<div class="goen-dept">
		<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>{ n.Name }</a>
		<div class="goen-dept__panel">
			<div class="goen-dept__inner">
				<ul class="goen-dept__links" role="list">
					for _, c := range n.Children {
						<li>
							<a class="goen-dept__link" href={ templ.URL(c.Href) }>{ c.Name }</a>
						</li>
					}
				</ul>
				if len(n.Picks) > 0 {
					<ul class="goen-dept__picks" role="list">
						for _, pick := range n.Picks {
							<li>
								<a class="goen-dept__pick" href={ templ.URL("/p/" + pick.Slug) }>
									<span class="goen-dept__well">
										if pick.ImageURL != "" {
											<img src={ pick.ImageURL } srcset={ pick.ImageSrcset } sizes="144px" alt="" loading="lazy" decoding="async"/>
										}
									</span>
									<span class="goen-dept__name">{ pick.Name }</span>
									<span class="goen-dept__price">{ pick.Price }</span>
								</a>
							</li>
						}
					</ul>
				}
				<a class="goen-dept__browse" href={ templ.URL(n.Href) }>
					if n.PhotoURL != "" {
						<img class="goen-dept__photo" src={ n.PhotoURL } srcset={ n.PhotoSrcset } sizes="240px" alt="" loading="lazy" decoding="async"/>
					}
					<span class="goen-dept__caption">
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyBrowseDepartment), n.Name) }
						<span aria-hidden="true">&nbsp;→</span>
					</span>
				</a>
			</div>
		</div>
	</div>
}

// cartLink carries an id because adding to the cart from a product page replaces
// this element out of band, from the same response the buy column comes from. The
// whole link is the unit: the accessible name says how many are in there, so swapping
// the number alone would leave the sentence behind. What it shows is the word and
// the number, 「購物車 2」, and the name is the sentence 「購物車，2 件商品」.
templ cartLink() {
	{{ count := CartCount(ctx) }}
	<a class="goen-header__tool goen-header__cart" id="cart-link" href="/cart" aria-label={ cartLabel(ctx, count) }>
		{ i18n.T(ctx, i18n.KeyCart) }
		if count > 0 {
			<span class="goen-header__count">{ strconv.Itoa(count) }</span>
		}
	</a>
}

// The bar's language control is the other language's short name, one press
// from it: with two languages a menu would only stand between the shopper and
// the one choice there is. It posts to /locale as the footer's pair does, so it
// is a button and not a link: the language lives in a cookie, not in the URL,
// and there is no other-language address for an hreflang to name. The label is
// in its own language, so 繁中 is read in Chinese on an English page.
templ languageLink() {
	{{ other := languageShown(i18n.FromContext(ctx), true) }}
	<form class="goen-header__lang" method="post" action="/locale">
		<input type="hidden" name="return" value={ returnPath(ctx) }/>
		<button class="goen-header__tool" type="submit" name="locale" value={ other.Tag() }>
			<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyLanguage) }</span>
			<span lang={ other.Tag() }>{ other.Short() }</span>
		</button>
	</form>
}

// A native <details>, so it opens without script; goen.js adds Escape and the
// outside click. Its choices post to the same /locale form the footer's switch
// uses. The drawer and the back office's bar carry it.
templ languageMenu(class string, showOther bool) {
	{{ current := i18n.FromContext(ctx) }}
	{{ shown := languageShown(current, showOther) }}
	<details class={ "goen-langmenu", templ.KV(class, class != "") } data-popover>
		<summary class="goen-langmenu__button">
			@icons.Globe()
			<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyLanguage) }</span>
			<span class="goen-langmenu__current" lang={ shown.Tag() }>{ shown.Short() }</span>
		</summary>
		<form class="goen-langmenu__panel" method="post" action="/locale">
			<input type="hidden" name="return" value={ returnPath(ctx) }/>
			<div role="group" aria-label={ i18n.T(ctx, i18n.KeyLanguage) }>
				for _, l := range i18n.Locales() {
					<button
						class="goen-langmenu__item"
						type="submit"
						name="locale"
						value={ l.Tag() }
						lang={ l.Tag() }
						aria-pressed={ pressed(l == current) }
					>
						<span>{ l.Label() }</span>
						if l == current {
							@icons.Check()
						}
					</button>
				}
			</div>
		</form>
	</details>
}

// Which language is on is read from aria-pressed, not from a second class the
// server renders: one fact, one source.
//
// class is empty where the footer's flex row already puts the form at the end.
templ languageSwitch(class, zh, en string) {
	{{ current := i18n.FromContext(ctx) }}
	<form class={ templ.KV(class, class != "") } method="post" action="/locale">
		<input type="hidden" name="return" value={ returnPath(ctx) }/>
		// The group is inside the form because a form may not take the group role. Each
		// label carries its own language, so a screen reader reads 繁中 in Chinese on an
		// English page and EN in English on a Chinese one.
		<div class="goen-lang" role="group" aria-label={ i18n.T(ctx, i18n.KeyLanguage) }>
			for _, l := range i18n.Locales() {
				<button
					class="goen-lang__item"
					type="submit"
					name="locale"
					value={ l.Tag() }
					lang={ l.Tag() }
					aria-pressed={ pressed(l == current) }
				>
					if l == i18n.En {
						{ en }
					} else {
						{ zh }
					}
				</button>
			}
		</div>
	</form>
}

func pressed(on bool) string {
	if on {
		return "true"
	}
	return "false"
}
