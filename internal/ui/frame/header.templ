package frame

import (
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/money"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/widget"
)

// The bar is the one row that stays on screen: the brand, the search field and
// the words for comparing, the language, the account and the cart. It sticks to
// the top of the window; the row under it, the departments and what delivery
// costs this cart, scrolls away with the page, so two bars never stack over
// the products. Below 1024 the menu opens a modal drawer that carries what the
// bar has no room for; below 640 the search field opens under the bar from a
// button of its own, so the bar that follows the scroll stays one row.
//
// ui-navitem is not a leftover: two assertions in backoffice_test.go locate the
// drawer's back-office entrance by the whole tag, and app.css replaces every
// declaration the name carries upstream.
templ Header(p Page) {
	<header class="goen-header">
		<div class="goen-header__bar">
			<button class="goen-header__tool goen-header__menu" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu">{ i18n.T(ctx, i18n.KeyMenu) }</button>
			<a class="goen-header__brand" href="/">
				@icons.Mark("goen-header__mark")
				<span class="goen-header__wordmark">goen</span>
			</a>
			<button class="goen-header__tool goen-header__searchbutton" type="button" data-search-open aria-controls="site-search-form" aria-expanded="false">
				@icons.Search()
				<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeySearch) }</span>
			</button>
			<form id="site-search-form" class="goen-header__search" role="search" aria-label={ i18n.T(ctx, i18n.KeySearch) } action="/search" method="get">
				<span class="goen-header__searchicon">
					@icons.Search()
				</span>
				<label class="goen-sr-only" for="site-search">{ i18n.T(ctx, i18n.KeySearch) }</label>
				// A combobox over the list under it: htmx fills the list as the shopper
				// types, and goen.js moves through it with the arrow keys. Submitting
				// still goes to the search page.
				@widget.Input(widget.FieldProps{
					ID:    "site-search",
					Name:  "q",
					Type:  "search",
					Value: p.SearchQuery,
					Class: "goen-header__field",
					Attrs: templ.Attributes{
						"placeholder":       i18n.T(ctx, i18n.KeySearchHint),
						"autocomplete":      "off",
						"role":              "combobox",
						"aria-autocomplete": "list",
						"aria-expanded":     "false",
						"aria-controls":     "site-search-list",
						"hx-get":            "/search/suggest",
						"hx-trigger":        "input changed delay:200ms",
						"hx-target":         "#site-search-suggest",
						"hx-swap":           "innerHTML",
						"hx-sync":           "this:replace",
					},
				})
				// goen.js names the shortcut for the visitor's keyboard: ⌘K or Ctrl K.
				<kbd class="goen-header__kbd" data-shortcut hidden></kbd>
				<div id="site-search-suggest" class="goen-suggest" hidden>
					<ul id="site-search-list" class="goen-suggest__list" role="listbox" aria-label={ i18n.T(ctx, i18n.KeySearchSuggestions) }></ul>
				</div>
			</form>
			<div class="goen-header__actions">
				if IsStaff(ctx) {
					<a class="goen-header__tool goen-header__backoffice" href="/admin">{ i18n.T(ctx, i18n.KeyBackOffice) }</a>
				}
				<a class="goen-header__tool goen-header__compare" href="/compare">
					@icons.Sliders()
					{ i18n.T(ctx, i18n.KeyCompareTitle) }
				</a>
				@languageLink()
				<a class="goen-header__tool goen-header__wide" href="/account">{ i18n.T(ctx, i18n.KeyAccount) }</a>
				@cartLink()
			</div>
		</div>
	</header>
	{{ word, wordHref := deliveryWord(ctx) }}
	if departmentRow(ctx) || word != "" {
		<div class="goen-rail">
			<div class="goen-rail__inner">
				if departmentRow(ctx) {
					<nav class="goen-header__nav" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
						for _, n := range TopNavFrom(ctx) {
							@departmentLink(p, n)
						}
						if HasDeals(ctx) {
							@dealsLink()
						}
					</nav>
				}
				if word != "" {
					<a class="goen-rail__delivery" href={ templ.URL(wordHref) }>{ word }</a>
				}
			</div>
		</div>
	}
	// A modal dialog: the browser keeps focus inside it, closes it on Escape and
	// gives focus back to the menu's button. goen.js opens it and closes it on the
	// close button and a press on the backdrop.
	<dialog class="goen-menu" id="site-menu" aria-label={ i18n.T(ctx, i18n.KeyMenu) }>
		<nav class="goen-header__drawer" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
			<button class="goen-header__close goen-btn goen-btn--ghost goen-btn--icon" type="button" data-menu-close aria-label={ i18n.T(ctx, i18n.KeyCloseMenu) }>
				@icons.Close()
			</button>
			if len(TopNavFrom(ctx)) > 1 {
				<span class="goen-header__drawerheading">{ i18n.T(ctx, i18n.KeyCategoryNav) }</span>
			}
			for _, n := range TopNavFrom(ctx) {
				@departmentLink(p, n)
			}
			if HasDeals(ctx) {
				@dealsLink()
			}
			if IsStaff(ctx) {
				<a class="ui-navitem" href="/admin">{ i18n.T(ctx, i18n.KeyBackOffice) }</a>
			}
			// The language menu comes first: in a modal dialog nothing follows the
			// last control, so a menu there would never see focus leave it for a
			// place on the page.
			<div class="goen-header__drawertools">
				@languageMenu("goen-header__drawerlang", true)
				<a class="ui-navitem" href="/compare">{ i18n.T(ctx, i18n.KeyCompareTitle) }</a>
				<a class="ui-navitem" href="/account/wishlist">{ i18n.T(ctx, i18n.KeyWishlist) }</a>
				<a class="ui-navitem" href="/account">{ i18n.T(ctx, i18n.KeyAccount) }</a>
			</div>
		</nav>
	</dialog>
}

// A department in the rail and in the drawer: its name, then how many products
// it holds, which a department with none does not print.
templ departmentLink(p Page, n NavItem) {
	<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>
		<span class="goen-header__navname">{ n.Name }</span>
		if n.ProductCount > 0 {
			<small>{ strconv.Itoa(n.ProductCount) }</small>
		}
	</a>
}

templ dealsLink() {
	<a
		class="ui-navitem goen-header__navitem--deal"
		if currentPage(ctx, "/deals") {
			aria-current="page"
		}
		href="/deals"
	>{ i18n.T(ctx, i18n.KeyDeals) }</a>
}

// cartLink carries an id because adding to the cart replaces this element out
// of band, from the same response the buy column comes from. The whole link is
// the unit. What it shows is the word, the number and the subtotal,
// 「購物車 2 NT$1,907」; what it is called is the sentence, 「購物車，2 件商品，小計
// NT$1,907」, held in the link rather than in an aria-label, which would have to
// repeat the visible text word for word (WCAG 2.5.3).
templ cartLink() {
	{{ c := CartFrom(ctx) }}
	<a class="goen-header__tool goen-header__cart" id="cart-link" href="/cart">
		<span class="goen-header__cartshown" aria-hidden="true">
			{ i18n.T(ctx, i18n.KeyCart) }
			if c.Units > 0 {
				<span class="goen-header__count">{ strconv.Itoa(c.Units) }</span>
			}
			if c.Units > 0 && c.SubtotalCents > 0 {
				<span class="goen-header__subtotal">{ money.TWD(c.SubtotalCents) }</span>
			}
		</span>
		<span class="goen-sr-only">{ cartLabel(ctx, c) }</span>
	</a>
}

// The bar's language control is the other language's short name, one press
// from it: with two languages a menu would only stand between the shopper and
// the one choice there is. It posts to /locale as the footer's pair does, so it
// is a button and not a link: the language lives in a cookie, not in the URL,
// and there is no other-language address for an hreflang to name. The label is
// in its own language, so 繁中 is read in Chinese on an English page.
templ languageLink() {
	{{ other := languageShown(i18n.FromContext(ctx), true) }}
	<form class="goen-header__lang" method="post" action="/locale">
		<input type="hidden" name="return" value={ returnPath(ctx) }/>
		<button class="goen-header__tool" type="submit" name="locale" value={ other.Tag() }>
			<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyLanguage) }</span>
			<span lang={ other.Tag() }>{ other.Short() }</span>
		</button>
	</form>
}

// A native <details>, so it opens without script; goen.js adds Escape and the
// outside click. Its choices post to the same /locale form the footer's switch
// uses. The drawer and the back office's bar carry it.
templ languageMenu(class string, showOther bool) {
	{{ current := i18n.FromContext(ctx) }}
	{{ shown := languageShown(current, showOther) }}
	<details class={ "goen-langmenu", templ.KV(class, class != "") } data-popover>
		<summary class="goen-langmenu__button">
			@icons.Globe()
			<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyLanguage) }</span>
			<span class="goen-langmenu__current" lang={ shown.Tag() }>{ shown.Short() }</span>
		</summary>
		<form class="goen-langmenu__panel" method="post" action="/locale">
			<input type="hidden" name="return" value={ returnPath(ctx) }/>
			<div role="group" aria-label={ i18n.T(ctx, i18n.KeyLanguage) }>
				for _, l := range i18n.Locales() {
					<button
						class="goen-langmenu__item"
						type="submit"
						name="locale"
						value={ l.Tag() }
						lang={ l.Tag() }
						aria-pressed={ pressed(l == current) }
					>
						<span>{ l.Label() }</span>
						if l == current {
							@icons.Check()
						}
					</button>
				}
			</div>
		</form>
	</details>
}

// Which language is on is read from aria-pressed, not from a second class the
// server renders: one fact, one source.
//
// class is empty where the footer's flex row already puts the form at the end.
templ languageSwitch(class, zh, en string) {
	{{ current := i18n.FromContext(ctx) }}
	<form class={ templ.KV(class, class != "") } method="post" action="/locale">
		<input type="hidden" name="return" value={ returnPath(ctx) }/>
		// The group is inside the form because a form may not take the group role. Each
		// label carries its own language, so a screen reader reads 繁中 in Chinese on an
		// English page and EN in English on a Chinese one.
		<div class="goen-lang" role="group" aria-label={ i18n.T(ctx, i18n.KeyLanguage) }>
			for _, l := range i18n.Locales() {
				<button
					class="goen-lang__item"
					type="submit"
					name="locale"
					value={ l.Tag() }
					lang={ l.Tag() }
					aria-pressed={ pressed(l == current) }
				>
					if l == i18n.En {
						{ en }
					} else {
						{ zh }
					}
				</button>
			}
		</div>
	</form>
}

func pressed(on bool) string {
	if on {
		return "true"
	}
	return "false"
}
