package frame

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/widget"
)

// MissingRecord is the back-office page for a record that is not there. What a desk can offer in its place,
// such as the order desk's search, is its children and is drawn between the heading and the way back.
templ MissingRecord(p Page, v MissingRecordView) {
	@Admin(p, v.Section) {
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ v.Heading }</h1>
				<p class="ui-page-head__sub">{ v.Body }</p>
			</div>
		</div>
		{ children... }
		@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary}, templ.URL("/admin/"+v.Section)) {
			{ i18n.T(ctx, v.BackLabel) }
		}
	}
}
