package frame

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/widget"
	"github.com/koopa0/goen/internal/user"
)

templ Notice(p Page, code, heading, body string, next ...NoticeActions) {
	{{ actions := noticeActions(next) }}
	@Base(p) {
		<div class={ "notice", templ.KV("notice--missing", code == "404" && len(next) == 0) }>
			if code != "" && code != "404" {
				<span class="notice__code" aria-hidden="true">{ code }</span>
			}
			<h1 class="notice__title">{ heading }</h1>
			<p class="notice__body">{ body }</p>
			<div class="notice__actions">
				if len(next) == 0 {
					// Back to the shop is the page's next step: the section's one blue link with
					// its arrow, not a solid button.
					<a class="notice__next" href={ templ.URL(actions.Primary.Href) }>
						{ i18n.T(ctx, actions.Primary.Label) }<span aria-hidden="true">&nbsp;→</span>
					</a>
				} else {
					@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge}, templ.URL(actions.Primary.Href)) {
						{ i18n.T(ctx, actions.Primary.Label) }
					}
					if actions.Secondary.Href != "" {
						@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline, Size: widget.SizeLarge}, templ.URL(actions.Secondary.Href)) {
							{ i18n.T(ctx, actions.Secondary.Label) }
						}
					}
				}
			</div>
			if code == "404" {
				@departmentLinks()
			}
		</div>
	}
}

// Reads the header's category row, so a visitor on a missing page has somewhere
// known to go; renders nothing outside the middleware that carries the row.
templ departmentLinks() {
	if items := TopNavFrom(ctx); len(items) > 0 {
		<section class="notice__departments" aria-labelledby="notice-departments">
			<h2 class="notice__departmentshead" id="notice-departments">{ i18n.T(ctx, i18n.KeySectionCategories) }</h2>
			@DepartmentIndex()
		</section>
	}
}

templ OrderNotFound(p Page) {
	if _, signedIn := user.FromContext(ctx); signedIn {
		@Notice(p, "404", i18n.T(ctx, i18n.KeyOrderNotFound), i18n.T(ctx, i18n.KeyOrderNotInAccount), NoticeActions{
			Primary: NoticeLink{Href: "/orders/find", Label: i18n.KeyFindOrderTitle},
		})
	} else {
		@Notice(p, "404", i18n.T(ctx, i18n.KeyOrderNotFound), i18n.T(ctx, i18n.KeyOrderNotYours), NoticeActions{
			Primary:   NoticeLink{Href: "/orders/find", Label: i18n.KeyFindOrderTitle},
			Secondary: NoticeLink{Href: "/signin", Label: i18n.KeySignIn},
		})
	}
}
