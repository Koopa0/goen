package layouts

import (
	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
)

// Admin shares the head with [Base] and nothing else: the storefront chrome is a
// shopper's tools and a row of noise for a staff member who reads the queue all day.
//
// It owns the FRAME: the two-column rule reaches the rail through the element the
// work is wrapped in, so a screen that opened its own .goen-admin pushed the rail
// onto a row of its own. current names the screen; the shell renders the rail and
// the column, and the page is only what goes inside them.
//
// An empty current is the step-up challenge, reached before the back office will
// answer: it gets the bar alone, because every rail link would send a staff member
// back to the challenge they are standing on.
templ Admin(p Page, current string) {
	<!DOCTYPE html>
	<html lang={ i18n.FromContext(ctx).Tag() } class="theme-blue">
		@documentHead(p, assets.AdminCSS)
		<body class="goen-shell">
			<a class="goen-skip" href="#main">{ i18n.T(ctx, i18n.KeySkipToContent) }</a>
			@adminBar()
			<main id="main">
				if current == "" {
					{ children... }
				} else {
					<div class="goen-admin">
						@adminNav(current)
						<div class="goen-admin__main">
							{ children... }
						</div>
					</div>
				}
			</main>
			<footer class="goen-adminfoot">
				<span class="goen-adminfoot__copyright">© 2026 goen</span>
			</footer>
		</body>
	</html>
}

// No page navigation here: the screens are the rail inside the page, and a second
// route into them would be a second list to keep current.
templ adminBar() {
	<header class="goen-adminbar">
		<div class="goen-adminbar__inner">
			<a class="goen-adminbar__brand" href="/admin">
				@icons.Mark("goen-adminbar__mark")
				<span class="goen-adminbar__wordmark">goen</span>
				<span class="goen-adminbar__tag">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</span>
			</a>
			<div class="goen-adminbar__actions">
				<a class="goen-adminbar__link" href="/">{ i18n.T(ctx, i18n.KeyBackToShop) }</a>
				@languageMenu("goen-adminbar__lang", false)
				<form method="post" action="/signout">
					@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost}, "submit") {
						{ i18n.T(ctx, i18n.KeySignOut) }
					}
				</form>
			</div>
		</div>
	</header>
}

// Groups answer the QUESTION each screen answers, rather than a flat row of labels.
//
// One element and two stylesheets (a column from the wide breakpoint, a band above
// the page below it), not two navs: a second copy of the links is a second copy to
// keep current, and a screen reader would hear both.
//
// Every group is a native <details>: no script, and the server renders `open` on the
// one holding the current screen. Groups are independent. The dashboard is nobody's
// group and holds the queues group open: orders and returns are where a shift starts.
//
// The whole nav is closed behind its summary until the desk width, where the
// stylesheet shows it as the rail; on a phone it would otherwise fill the screen
// above every page's first line of work.
templ adminNav(current string) {
	@components.Disclosure(components.DisclosureProps{
		Class:   "goen-admin__nav",
		Summary: i18n.T(ctx, i18n.KeyAdminQueueNavLabel),
	}) {
		<nav class="goen-admin__navlist" aria-label={ i18n.T(ctx, i18n.KeyAdminQueueNavLabel) }>
			<a
				class="ui-navitem"
				href="/admin"
				if current == "dashboard" {
					aria-current="page"
				}
			>{ i18n.T(ctx, i18n.KeyAdminQueueOverview) }</a>
			<details
				class="goen-admin__navgroup"
				open?={ adminNavHolds(current, "dashboard", "orders", "returns", "questions", "messages", "reviews") }
			>
				<summary class="ui-navitem goen-admin__navlabel">{ i18n.T(ctx, i18n.KeyAdminNavQueues) }</summary>
				<div class="goen-admin__navitems">
					<a
						class="ui-navitem"
						href="/admin/orders"
						if current == "orders" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueOrders) }</a>
					<a
						class="ui-navitem"
						href="/admin/returns"
						if current == "returns" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueReturns) }</a>
					<a
						class="ui-navitem"
						href="/admin/questions"
						if current == "questions" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueQuestions) }</a>
					<a
						class="ui-navitem"
						href="/admin/messages"
						if current == "messages" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageMessages) }</a>
					<a
						class="ui-navitem"
						href="/admin/reviews"
						if current == "reviews" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueReviews) }</a>
				</div>
			</details>
			<details
				class="goen-admin__navgroup"
				open?={ adminNavHolds(current, "products", "stock", "taxonomy", "campaigns", "coupons") }
			>
				<summary class="ui-navitem goen-admin__navlabel">{ i18n.T(ctx, i18n.KeyAdminNavCatalogue) }</summary>
				<div class="goen-admin__navitems">
					<a
						class="ui-navitem"
						href="/admin/products"
						if current == "products" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageProducts) }</a>
					<a
						class="ui-navitem"
						href="/admin/stock"
						if current == "stock" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueStock) }</a>
					<a
						class="ui-navitem"
						href="/admin/taxonomy"
						if current == "taxonomy" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueTaxonomy) }</a>
					<a
						class="ui-navitem"
						href="/admin/campaigns"
						if current == "campaigns" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueCampaigns) }</a>
					<a
						class="ui-navitem"
						href="/admin/coupons"
						if current == "coupons" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageCoupons) }</a>
				</div>
			</details>
			<details
				class="goen-admin__navgroup"
				open?={ adminNavHolds(current, "customers", "credit", "tiers", "warranty", "newsletter") }
			>
				<summary class="ui-navitem goen-admin__navlabel">{ i18n.T(ctx, i18n.KeyAdminNavCustomers) }</summary>
				<div class="goen-admin__navitems">
					<a
						class="ui-navitem"
						href="/admin/customers"
						if current == "customers" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageCustomers) }</a>
					<a
						class="ui-navitem"
						href="/admin/credit"
						if current == "credit" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueCredit) }</a>
					<a
						class="ui-navitem"
						href="/admin/tiers"
						if current == "tiers" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageTiers) }</a>
					<a
						class="ui-navitem"
						href="/admin/warranty"
						if current == "warranty" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueWarranty) }</a>
					<a
						class="ui-navitem"
						href="/admin/newsletter"
						if current == "newsletter" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageNewsletter) }</a>
				</div>
			</details>
			<details
				class="goen-admin__navgroup"
				open?={ adminNavHolds(current, "shipping", "home", "faq", "staff") }
			>
				<summary class="ui-navitem goen-admin__navlabel">{ i18n.T(ctx, i18n.KeyAdminNavShop) }</summary>
				<div class="goen-admin__navitems">
					<a
						class="ui-navitem"
						href="/admin/shipping"
						if current == "shipping" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueShipping) }</a>
					<a
						class="ui-navitem"
						href="/admin/home"
						if current == "home" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminQueueHomePage) }</a>
					<a
						class="ui-navitem"
						href="/admin/faq"
						if current == "faq" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageFAQ) }</a>
					if isAdmin(ctx) {
						<a
							class="ui-navitem"
							href="/admin/staff"
							if current == "staff" {
								aria-current="page"
							}
						>{ i18n.T(ctx, i18n.KeyAdminQueueStaff) }</a>
					}
				</div>
			</details>
			<details
				class="goen-admin__navgroup"
				open?={ adminNavHolds(current, "reports", "audit", "health") }
			>
				<summary class="ui-navitem goen-admin__navlabel">{ i18n.T(ctx, i18n.KeyAdminNavRecords) }</summary>
				<div class="goen-admin__navitems">
					<a
						class="ui-navitem"
						href="/admin/reports"
						if current == "reports" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageReports) }</a>
					<a
						class="ui-navitem"
						href="/admin/audit"
						if current == "audit" {
							aria-current="page"
						}
					>{ i18n.T(ctx, i18n.KeyAdminPageAudit) }</a>
					<a
						class="ui-navitem"
						href="/admin/health"
						if current == "health" {
							aria-current="page"
						}
					>
						{ i18n.T(ctx, i18n.KeyAdminPageHealth) }
						<span class="goen-admin__meta">{ healthTaskText(ctx) }</span>
					</a>
				</div>
			</details>
			<a class="ui-navitem goen-admin__navback" href="/">{ i18n.T(ctx, i18n.KeyBackToShop) }</a>
		</nav>
	}
}
