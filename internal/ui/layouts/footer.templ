package layouts

import (
	"fmt"

	"github.com/koopa0/goen/internal/fieldrule"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
)

templ Footer(state NewsletterState) {
	<footer class="goen-footer">
		<div class="goen-footer__grid">
			<div class="goen-footer__brand">
				<div class="goen-footer__brandline">
					@icons.Mark("goen-footer__mark")
					<span class="goen-footer__wordmark">goen</span>
				</div>
				<p class="goen-footer__contact">
					{ i18n.T(ctx, i18n.KeySupportHours) }
					<br/>
					<a class="goen-footer__link" href={ templ.URL("mailto:" + ContactEmail) }>{ ContactEmail }</a>
				</p>
			</div>
			if items := TopNavFrom(ctx); len(items) > 0 {
				<nav class="goen-footer__links" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
					<span class="goen-footer__heading">{ i18n.T(ctx, i18n.KeyCategoryNav) }</span>
					<ul class="goen-footer__list" role="list">
						for _, n := range items {
							<li>
								<a class="goen-footer__link" href={ templ.URL(n.Href) }>{ n.Name }</a>
							</li>
						}
					</ul>
				</nav>
			}
			@footerColumn(i18n.T(ctx, i18n.KeyFooterHelp), footerHelp[:])
			@footerColumn(i18n.T(ctx, i18n.KeyFooterAboutTerms), footerAbout[:])
			<div class="goen-footer__news">
				<span class="goen-footer__heading">{ i18n.T(ctx, i18n.KeyNewsletter) }</span>
				<p class="goen-footer__newsnote">{ i18n.T(ctx, i18n.KeyNewsletterNote) }</p>
				@NewsletterForm(state)
			</div>
		</div>
		<div class="goen-footer__bottom">
			<div class="goen-footer__bottominner">
				<span class="goen-footer__copyright">© 2026 goen</span>
				if i18n.FromContext(ctx) != i18n.Default {
					<p class="goen-footer__contentnote">{ i18n.T(ctx, i18n.KeyContentNotice) }</p>
				}
				// i18n-exempt: a language's own name, shown in both locales on purpose.
				@languageSwitch("", "繁體中文", "English")
			</div>
		</div>
	</footer>
}

// The title is a span, not a heading: the footer sits after the page's own outline
// and a heading would take a level the page has already spent.
templ footerColumn(title string, links []footerLink) {
	<nav class="goen-footer__links" aria-label={ title }>
		<span class="goen-footer__heading">{ title }</span>
		<ul class="goen-footer__list" role="list">
			for _, l := range links {
				<li>
					<a class="goen-footer__link" href={ templ.URL(l.Href) }>{ l.Label(ctx) }</a>
				</li>
			}
		</ul>
	</nav>
}

type NewsletterState struct {
	Email        string
	FieldRefusal string
	Notice       string
	Done         bool
}

templ NewsletterForm(s NewsletterState) {
	<form
		class="goen-footer__signup"
		id="newsletter-form"
		method="post"
		action="/newsletter"
		hx-post="/newsletter"
		hx-target="this"
		hx-swap="outerHTML"
	>
		if s.Done {
			<p class="goen-footer__signup-done" role="status">
				if s.Email != "" {
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyNewsletterSentTo), s.Email) }
				} else {
					{ i18n.T(ctx, i18n.KeyNewsletterInlineDone) }
				}
			</p>
			<a
				class="goen-footer__link"
				href="/#newsletter-form"
				hx-get="/"
				hx-select="#newsletter-form"
				hx-target="#newsletter-form"
				hx-swap="outerHTML"
				data-focus-after-swap="newsletter-email"
			>{ i18n.T(ctx, i18n.KeyEmailReenter) }</a>
		} else {
			<label class="goen-label goen-footer__signuplabel" for="newsletter-email">{ i18n.T(ctx, i18n.KeyFieldEmail) }</label>
			<div class="goen-footer__field">
				@components.Input(components.FieldProps{
					ID:        "newsletter-email",
					Name:      "email",
					Type:      "email",
					Value:     s.Email,
					Invalid:   s.FieldRefusal != "",
					Describes: "newsletter-error",
					Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
						"placeholder":  "you@example.com",
						"required":     true,
						"autocomplete": "email",
						"maxlength":    "254",
					}, fieldrule.Message(i18n.KeyEmailMalformed), fieldrule.ErrorID("newsletter-error")),
				})
				@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost, Attrs: templ.Attributes{"id": "newsletter-submit"}}, "submit") {
					{ i18n.T(ctx, i18n.KeyNewsletterSubmit) }
					<span aria-hidden="true">→</span>
				}
			</div>
			if s.Notice != "" {
				<p class="ui-error-text goen-footer__signup-error" id="newsletter-notice" role="alert">{ s.Notice }</p>
			}
			if s.FieldRefusal != "" {
				<p class="ui-error-text goen-footer__signup-error" id="newsletter-error" role="alert">{ s.FieldRefusal }</p>
			} else {
				<p class="ui-error-text goen-footer__signup-error" id="newsletter-error" role="alert" hidden></p>
			}
		}
	</form>
}
