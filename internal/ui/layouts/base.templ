package layouts

import (
	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
)

// Base is the storefront's document shell.
templ Base(p Page) {
	<!DOCTYPE html>
	<html lang={ i18n.FromContext(ctx).Tag() } class="theme-blue">
		@documentHead(p)
		<body class="goen-shell">
			<a class="goen-skip" href="#main">{ i18n.T(ctx, i18n.KeySkipToContent) }</a>
			@promoBanner()
			@Header(p)
			<main id="main">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}

// documentHead is the head both shells send. It is one templ and not two
// because every entry in it — the fonts, the four stylesheets, htmx and its
// configuration — is a fact about the document rather than about the storefront,
// and a second copy is a second copy to keep current.
templ documentHead(p Page) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="htmx-config" content={ htmxConfig }/>
		<title>{ p.title(ctx) }</title>
		if p.Description != "" {
			<meta name="description" content={ p.Description }/>
		}
		if p.StructuredData != "" {
			@structuredData(p.StructuredData)
		}
		<link rel="icon" type="image/svg+xml" href={ templ.URL(assets.URL(assets.MarkSVG)) }/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&amp;display=swap"/>
		// The design system's own sheet opens with an @import of these four
		// families, which the browser cannot discover until that sheet has
		// arrived and been parsed — a second font fetch chained behind the
		// first. Asking for the same URL here starts it with the rest of the
		// head, so the @import resolves from cache instead of opening a
		// round trip of its own. The sheet is vendored and cannot say this
		// itself; the URL has to match it exactly.
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500&amp;family=Space+Grotesk:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap"/>
		<link rel="stylesheet" href={ templ.URL(assets.URL(assets.DesignSystemCSS)) }/>
		<link rel="stylesheet" href={ templ.URL(assets.URL(assets.AccentsCSS)) }/>
		<link rel="stylesheet" href={ templ.URL(assets.URL(assets.CommerceCSS)) }/>
		<link rel="stylesheet" href={ templ.URL(assets.URL(assets.AppCSS)) }/>
		<script src={ templ.URL(assets.URL(assets.HTMXJS)) } defer></script>
		<script src={ templ.URL(assets.URL(assets.AppJS)) } defer></script>
	</head>
}

// Inside templ.Raw because templ treats a <script> body as literal text.
templ structuredData(doc string) {
	@templ.Raw(`<script type="application/ld+json">` + doc + `</script>`)
}
