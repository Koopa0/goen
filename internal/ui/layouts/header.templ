package layouts

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/web"
)

// Header renders the site header: one row, static at every width. The
// departments sit in the bar from 1024 up, each one that has sub-categories
// opening a full-width panel on hover or focus; below 1024 they sit behind a
// native disclosure, and the search field wraps onto its own row. The language
// menu sits in the bar from 768 up and in the drawer below that.
//
// The ui-navitem and ui-btn spellings inside it are not leftovers: two
// assertions in backoffice_test.go locate the back-office entrance by the whole
// tag, and app.css replaces every declaration those names carry upstream.
templ Header(p Page) {
	<header class="goen-header">
		<div class="goen-header__bar">
			<details class="goen-header__menu" data-menu>
				<summary class="goen-btn goen-btn--ghost goen-btn--icon" aria-label={ i18n.T(ctx, i18n.KeyMenu) }>
					@icons.Menu()
				</summary>
				<nav class="goen-header__drawer" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
					// A visible way out beside the hamburger, which sits under the
					// drawer's edge on a phone. goen.js closes the menu and returns the
					// focus to the hamburger, as Escape does.
					<button class="goen-header__close goen-btn goen-btn--ghost goen-btn--icon" type="button" data-menu-close aria-label={ i18n.T(ctx, i18n.KeyCloseMenu) }>
						@icons.Close()
					</button>
					for _, n := range TopNavFrom(ctx) {
						<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>{ n.Name }</a>
						if len(n.Children) > 0 {
							<div class="goen-header__subs">
								for _, c := range n.Children {
									<a class="ui-navitem goen-header__subitem" aria-current={ p.ariaCurrent(c) } href={ templ.URL(c.Href) }>{ c.Name }</a>
								}
							</div>
						}
					}
					<a class="ui-navitem goen-header__navitem--deal" href="/deals">{ i18n.T(ctx, i18n.KeyDeals) }</a>
					// The back office is reached from the header HERE and not from the wide
					// bar's action row, which has no room: at 1024 with the English
					// catalogue names the search field is already on its floor, and a text
					// button in that row overflows or wraps the bar. Making room is an
					// app.css decision about what the wide bar drops first, not a markup
					// one. Above 1024 this drawer is display:none and /account carries
					// the entrance instead.
					if IsStaff(ctx) {
						<a class="ui-navitem" href="/admin">{ i18n.T(ctx, i18n.KeyBackOffice) }</a>
					}
					// What the phone's bar has no room for: the wishlist, the account
					// (which sends a visitor who is not signed in to the sign-in page)
					// and the language, the same menu the bar carries from 768 up.
					<div class="goen-header__drawertools">
						<a class="ui-navitem" href="/account/wishlist">{ i18n.T(ctx, i18n.KeyWishlist) }</a>
						<a class="ui-navitem" href="/account">{ i18n.T(ctx, i18n.KeyAccount) }</a>
						@languageMenu("goen-header__drawerlang")
					</div>
				</nav>
			</details>
			<a class="goen-header__brand" href="/">
				@icons.Mark("goen-header__mark")
				<span class="goen-header__wordmark">goen</span>
			</a>
			<nav class="goen-header__nav" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
				for _, n := range TopNavFrom(ctx) {
					if len(n.Children) == 0 {
						<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>{ n.Name }</a>
					} else {
						@department(p, n)
					}
				}
				<a class="ui-navitem goen-header__navitem--deal" href="/deals">{ i18n.T(ctx, i18n.KeyDeals) }</a>
			</nav>
			<form class="goen-header__search" role="search" aria-label={ i18n.T(ctx, i18n.KeySearch) } action="/search" method="get">
				<span class="goen-header__searchicon">
					@icons.Search()
				</span>
				<label class="goen-sr-only" for="site-search">{ i18n.T(ctx, i18n.KeySearch) }</label>
				@components.Input(components.FieldProps{
					ID:    "site-search",
					Name:  "q",
					Type:  "search",
					Value: p.SearchQuery,
					Class: "goen-header__field",
					Attrs: templ.Attributes{"placeholder": i18n.T(ctx, i18n.KeySearchHint)},
				})
			</form>
			<div class="goen-header__actions">
				@languageMenu("goen-header__lang")
				@components.ButtonLink(components.ButtonProps{
					Variant: components.VariantGhost,
					Icon:    true,
					Attrs:   templ.Attributes{"aria-label": i18n.T(ctx, i18n.KeyAccount)},
				}, templ.SafeURL("/account")) {
					@icons.User()
				}
				if IsStaff(ctx) {
					// The wide slot, not a fourth button: at 1024 in English the
					// search field is already on its floor, and anything added
					// there overflows or wraps the bar. A staff member reaches
					// the wishlist from /account; the back office is what they
					// open all day, and below 1024 this slot is hidden and the
					// drawer carries the entrance instead.
					<a class="ui-btn ui-btn--ghost ui-btn--icon goen-header__action--wide" href="/admin" aria-label={ i18n.T(ctx, i18n.KeyBackOffice) }>
						@icons.Lock()
					</a>
				} else {
					<a class="ui-btn ui-btn--ghost ui-btn--icon goen-header__action--wide" href="/account/wishlist" aria-label={ i18n.T(ctx, i18n.KeyWishlist) }>
						@icons.Heart()
					</a>
				}
				@cartLink()
			</div>
		</div>
	</header>
}

// department is a root category that has sub-categories: its link, and the
// panel that opens under the header on hover or keyboard focus. The panel is
// plain markup shown by CSS, so it needs no script to open: on hover, and under
// :focus-within until goen.js is running, when ArrowDown on the department's
// link opens it instead and its links are out of the tab order until then.
// Three of the department's newest products sit between the sub-categories and
// the department's photograph, so a department with two sub-categories still
// fills its panel. A department without a photograph shows the caption alone.
// Every image is lazy: a closed panel is display:none and fetches nothing.
templ department(p Page, n NavItem) {
	<div class="goen-dept">
		<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>{ n.Name }</a>
		<div class="goen-dept__panel">
			<div class="goen-dept__inner">
				<ul class="goen-dept__links" role="list">
					for _, c := range n.Children {
						<li>
							<a class="goen-dept__link" href={ templ.URL(c.Href) }>{ c.Name }</a>
						</li>
					}
				</ul>
				if len(n.Picks) > 0 {
					<ul class="goen-dept__picks" role="list">
						for _, pick := range n.Picks {
							<li>
								// The name is the link's label, so the photograph is decoration.
								<a class="goen-dept__pick" href={ templ.URL("/p/" + pick.Slug) }>
									<span class="goen-dept__well">
										if pick.ImageURL != "" {
											<img src={ pick.ImageURL } srcset={ pick.ImageSrcset } sizes="144px" alt="" loading="lazy" decoding="async"/>
										}
									</span>
									<span class="goen-dept__name">{ pick.Name }</span>
									<span class="goen-dept__price">{ pick.Price }</span>
								</a>
							</li>
						}
					</ul>
				}
				<a class="goen-dept__browse" href={ templ.URL(n.Href) }>
					if src, srcset, ok := assets.CategoryImage(n.Slug); ok {
						<img class="goen-dept__photo" src={ src } srcset={ srcset } sizes="240px" alt="" loading="lazy" decoding="async"/>
					}
					<span class="goen-dept__caption">
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyBrowseDepartment), n.Name) }
						<span aria-hidden="true">&nbsp;→</span>
					</span>
				</a>
			</div>
		</div>
	</div>
}

// cartLink carries an id because adding to the cart from a product page
// replaces this element out of band, out of the same response the buy column
// comes from. The whole link is the unit and not the number inside it: the
// count appears and disappears, and the accessible name says how many are in
// there, so swapping the number alone would leave the sentence behind.
templ cartLink() {
	{{ count := web.CartCount(ctx) }}
	@components.ButtonLink(components.ButtonProps{
		Variant: components.VariantGhost,
		Icon:    true,
		Class:   "goen-header__cart",
		Attrs: templ.Attributes{
			"aria-label": cartLabel(ctx, count),
			"id":         "cart-link",
		},
	}, templ.SafeURL("/cart")) {
		@icons.Cart()
		if count > 0 {
			<span class="ui-badge--count" aria-hidden="true">{ strconv.Itoa(count) }</span>
		}
	}
}

// languageMenu is the compact language control of the header and the back
// office's bar: a globe and the current language's short name, opening a small
// menu with both choices, each in its own language. It is a native <details>,
// so it opens without script; goen.js adds Escape and the outside click.
//
// The button's accessible name is "Language" plus the short name, which is
// what the eye reads, and the choices post to the same /locale form the
// footer's switch uses.
templ languageMenu(class string) {
	{{ current := i18n.FromContext(ctx) }}
	<details class={ "goen-langmenu", templ.KV(class, class != "") } data-popover>
		<summary class="goen-langmenu__button">
			@icons.Globe()
			<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyLanguage) }</span>
			<span class="goen-langmenu__current" lang={ current.Tag() }>{ current.Short() }</span>
		</summary>
		<form class="goen-langmenu__panel" method="post" action="/locale">
			<input type="hidden" name="return" value={ returnPath(ctx) }/>
			<div role="group" aria-label={ i18n.T(ctx, i18n.KeyLanguage) }>
				for _, l := range i18n.Locales() {
					<button
						class="goen-langmenu__item"
						type="submit"
						name="locale"
						value={ l.Tag() }
						lang={ l.Tag() }
						aria-pressed={ pressed(l == current) }
					>
						<span>{ l.Label() }</span>
						if l == current {
							@icons.Check()
						}
					</button>
				}
			</div>
		</form>
	</details>
}

// languageSwitch is the locale form of the footer. Which language is on is read from aria-pressed rather than from a
// second class the server renders: one fact, one source.
//
// class is where the caller needs to place the form, and is empty where it does
// not: the footer's sits in a flex row that already puts it at the end.
templ languageSwitch(class, zh, en string) {
	{{ current := i18n.FromContext(ctx) }}
	<form class={ templ.KV(class, class != "") } method="post" action="/locale">
		<input type="hidden" name="return" value={ returnPath(ctx) }/>
		// The group is inside the form because a form may not take the group
		// role. Each label carries its own language, so a screen reader reads
		// 繁中 in Chinese on an English page and EN in English on a Chinese one.
		<div class="goen-lang" role="group" aria-label={ i18n.T(ctx, i18n.KeyLanguage) }>
			for _, l := range i18n.Locales() {
				<button
					class="goen-lang__item"
					type="submit"
					name="locale"
					value={ l.Tag() }
					lang={ l.Tag() }
					aria-pressed={ pressed(l == current) }
				>
					if l == i18n.En {
						{ en }
					} else {
						{ zh }
					}
				</button>
			}
		</div>
	</form>
}

func pressed(on bool) string {
	if on {
		return "true"
	}
	return "false"
}
