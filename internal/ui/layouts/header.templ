package layouts

import (
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/web"
)

// Header renders the site header: one row, static at every width. The category
// links sit in the bar from 1024 up and behind a native disclosure below it;
// the search field stays in the bar and wraps onto its own row.
//
// The ui-navitem and ui-btn spellings inside it are not leftovers: two
// assertions in backoffice_test.go locate the back-office entrance by the whole
// tag, and app.css replaces every declaration those names carry upstream.
templ Header(p Page) {
	<header class="goen-header">
		<div class="goen-header__bar">
			<details class="goen-header__menu" data-menu>
				<summary class="goen-btn goen-btn--ghost goen-btn--icon" aria-label={ i18n.T(ctx, i18n.KeyMenu) }>
					@icons.Menu()
				</summary>
				<nav class="goen-header__drawer" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
					for _, n := range TopNavFrom(ctx) {
						<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>{ n.Name }</a>
					}
					<a class="ui-navitem goen-header__navitem--deal" href="/deals">{ i18n.T(ctx, i18n.KeyDeals) }</a>
					// The back office is reached from the header HERE and not from the wide
					// bar's action row, which has no room: at 1024 with the English
					// catalogue names the search field is already on its floor, and a text
					// button in that row overflows or wraps the bar. Making room is an
					// app.css decision about what the wide bar drops first, not a markup
					// one. Above 1024 this drawer is display:none and /account carries
					// the entrance instead.
					if IsStaff(ctx) {
						<a class="ui-navitem" href="/admin">{ i18n.T(ctx, i18n.KeyBackOffice) }</a>
					}
					// i18n-exempt: a language's own name, shown in both locales on purpose.
					@languageSwitch("goen-header__lang", "繁中", "EN")
				</nav>
			</details>
			<a class="goen-header__brand" href="/">
				@icons.Mark("goen-header__mark")
				<span class="goen-header__wordmark">goen</span>
			</a>
			<nav class="goen-header__nav" aria-label={ i18n.T(ctx, i18n.KeyCategoryNav) }>
				for _, n := range TopNavFrom(ctx) {
					<a class="ui-navitem" aria-current={ p.ariaCurrent(n) } href={ templ.URL(n.Href) }>{ n.Name }</a>
				}
				<a class="ui-navitem goen-header__navitem--deal" href="/deals">{ i18n.T(ctx, i18n.KeyDeals) }</a>
			</nav>
			<form class="goen-header__search" role="search" action="/search" method="get">
				<span class="goen-header__searchicon">
					@icons.Search()
				</span>
				<label class="goen-sr-only" for="site-search">{ i18n.T(ctx, i18n.KeySearch) }</label>
				@components.Input(components.FieldProps{
					ID:    "site-search",
					Name:  "q",
					Type:  "search",
					Value: p.SearchQuery,
					Class: "goen-header__field",
					Attrs: templ.Attributes{"placeholder": i18n.T(ctx, i18n.KeySearchHint)},
				})
			</form>
			// i18n-exempt: a language's own name, shown in both locales on purpose.
			@languageSwitch("goen-header__lang", "繁中", "EN")
			<div class="goen-header__actions">
				@components.ButtonLink(components.ButtonProps{
					Variant: components.VariantGhost,
					Icon:    true,
					Attrs:   templ.Attributes{"aria-label": i18n.T(ctx, i18n.KeyAccount)},
				}, templ.SafeURL("/account")) {
					@icons.User()
				}
				if IsStaff(ctx) {
					// The wide slot, not a fourth button: at 1024 in English the
					// search field is already on its floor, and anything added
					// there overflows or wraps the bar. A staff member reaches
					// the wishlist from /account; the back office is what they
					// open all day, and below 1024 this slot is hidden and the
					// drawer carries the entrance instead.
					<a class="ui-btn ui-btn--ghost ui-btn--icon goen-header__action--wide" href="/admin" aria-label={ i18n.T(ctx, i18n.KeyBackOffice) }>
						@icons.Lock()
					</a>
				} else {
					<a class="ui-btn ui-btn--ghost ui-btn--icon goen-header__action--wide" href="/account/wishlist" aria-label={ i18n.T(ctx, i18n.KeyWishlist) }>
						@icons.Heart()
					</a>
				}
				@cartLink()
			</div>
		</div>
	</header>
}

templ cartLink() {
	{{ count := web.CartCount(ctx) }}
	@components.ButtonLink(components.ButtonProps{
		Variant: components.VariantGhost,
		Icon:    true,
		Class:   "goen-header__cart",
		Attrs:   templ.Attributes{"aria-label": cartLabel(ctx, count)},
	}, templ.SafeURL("/cart")) {
		@icons.Cart()
		if count > 0 {
			<span class="ui-badge--count" aria-hidden="true">{ strconv.Itoa(count) }</span>
		}
	}
}

// languageSwitch is the locale form, shared by the header bar, the drawer and
// the footer. Which language is on is read from aria-pressed rather than from a
// second class the server renders: one fact, one source.
//
// class is where the caller needs to place the form, and is empty where it does
// not: the header shows and hides its copies at three widths, the footer's sits
// in a flex row that already puts it at the end.
templ languageSwitch(class, zh, en string) {
	{{ current := i18n.FromContext(ctx) }}
	<form class={ "goen-lang", templ.KV(class, class != "") } method="post" action="/locale" role="group" aria-label={ i18n.T(ctx, i18n.KeyLanguage) }>
		<input type="hidden" name="return" value={ returnPath(ctx) }/>
		for _, l := range i18n.Locales() {
			<button
				class="goen-lang__item"
				type="submit"
				name="locale"
				value={ l.Tag() }
				aria-pressed={ pressed(l == current) }
			>
				if l == i18n.En {
					{ en }
				} else {
					{ zh }
				}
			</button>
		}
	</form>
}

func pressed(on bool) string {
	if on {
		return "true"
	}
	return "false"
}
