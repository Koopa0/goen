package layouts

import "github.com/koopa0/goen/internal/i18n"

// promoBanner renders the site-wide promotional strip, above the header and in
// normal flow so it scrolls away.
templ promoBanner() {
	{{ b := bannerFrom(ctx) }}
	if b.Shown() {
		<form class="goen-promo" method="post" action={ templ.SafeURL(b.DismissAction()) }>
			<input type="hidden" name="banner" value={ b.ID }/>
			// Validated server-side as a same-site path.
			<input type="hidden" name="return" value={ returnPath(ctx) }/>
			if b.HasCTA() {
				// At 375 the entire strip is the link: a 44px row cannot hold
				// two touch targets that both meet the minimum size.
				<a class="goen-promo__link" href={ templ.SafeURL(b.CTAHref) }>
					<span class="goen-promo__message">
						<span class="goen-promo__wide">{ b.Message }</span>
						<span class="goen-promo__narrow">{ b.Narrow() }</span>
					</span>
					if b.HasCode() {
						@promoCode(b.Code)
					}
					<span class="goen-promo__cta">{ b.CTALabel }</span>
					@chevronRight()
				</a>
			} else {
				<span class="goen-promo__link">
					<span class="goen-promo__message">
						<span class="goen-promo__wide">{ b.Message }</span>
						<span class="goen-promo__narrow">{ b.Narrow() }</span>
					</span>
					if b.HasCode() {
						@promoCode(b.Code)
					}
				</span>
			}
			<button class="goen-promo__close" type="submit" aria-label={ i18n.T(ctx, i18n.KeyCloseBanner) }>
				@closeIcon()
			</button>
		</form>
	}
}

// promoCode renders a discount code as a selectable chip; user-select:all makes
// one tap select the whole code, which a copy button could not do without
// scripting.
templ promoCode(code string) {
	<code class="goen-promo__code">{ code }</code>
}

// chevronRight hints that the strip is tappable.
templ chevronRight() {
	<svg
		class="goen-promo__chevron"
		width="14"
		height="14"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m9 18 6-6-6-6"></path>
	</svg>
}

// closeIcon is the dismiss control's glyph.
templ closeIcon() {
	<svg
		width="15"
		height="15"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<path d="M18 6 6 18M6 6l12 12"></path>
	</svg>
}
