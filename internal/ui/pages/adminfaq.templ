package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminFAQ renders the FAQ management page.
templ AdminFAQ(p layouts.Page, v *AdminFAQView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("faq")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageFAQ) }</h1>
					<p class="ui-page-head__sub">
						{ i18n.T(ctx, i18n.KeyAdminFaqpLead) }
					</p>
				</div>
			</div>
			if v.HasNotice() {
				<p class="ui-alert" role="status">{ v.Notice }</p>
			}
			if v.Untranslated() > 0 {
				<p class="ui-alert ui-alert--warn" role="status">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminFaqpNoEnglish), untranslatedText(v)) }
				</p>
			}
			<div class="goen-admin__split">
				<form class="goen-admin__form" method="post" action="/admin/faq">
					<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminFaqpAdd) }</h2>
					<div class="ui-field">
						<label class="ui-label" for="faq-category">{ i18n.T(ctx, i18n.KeyAdminColCategory) }</label>
						<input
							class="ui-input"
							id="faq-category"
							name="category"
							required
							maxlength="40"
							value={ v.Draft.Category }
							placeholder={ i18n.T(ctx, i18n.KeyAdminFaqpCategoryPlaceholder) }
							if v.HasErr("category") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("category") {
							<p class="ui-error-text">{ v.Err("category") }</p>
						}
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminFaqpCategoryHint) }</p>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-question">{ i18n.T(ctx, i18n.KeyAdminFaqpQuestion) }</label>
						<input
							class="ui-input"
							id="faq-question"
							name="question"
							required
							maxlength="200"
							value={ v.Draft.Question }
							if v.HasErr("question") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("question") {
							<p class="ui-error-text">{ v.Err("question") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-answer">{ i18n.T(ctx, i18n.KeyAdminFaqpAnswer) }</label>
						<textarea
							class="ui-input goen-admin__textarea"
							id="faq-answer"
							name="answer"
							rows="5"
							maxlength="2000"
							required
							if v.HasErr("answer") {
								aria-invalid="true"
							}
						>{ v.Draft.Answer }</textarea>
						if v.HasErr("answer") {
							<p class="ui-error-text">{ v.Err("answer") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-category-en">{ i18n.T(ctx, i18n.KeyAdminFaqpCategoryEn) }</label>
						<input class="ui-input" id="faq-category-en" name="category_en" maxlength="40" value={ v.Draft.CategoryEn } placeholder="Orders"/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-question-en">{ i18n.T(ctx, i18n.KeyAdminFaqpQuestionEn) }</label>
						<input class="ui-input" id="faq-question-en" name="question_en" maxlength="200" value={ v.Draft.QuestionEn }/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-answer-en">{ i18n.T(ctx, i18n.KeyAdminFaqpAnswerEn) }</label>
						<textarea class="ui-input goen-admin__textarea" id="faq-answer-en" name="answer_en" rows="5" maxlength="2000">{ v.Draft.AnswerEn }</textarea>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminFaqpEnHint) }</p>
					</div>
					<button class="ui-btn ui-btn--primary" type="submit">{ i18n.T(ctx, i18n.KeyAdminAddButton) }</button>
				</form>
				<aside class="goen-admin__side">
					<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminFaqpCurrent) }</h2>
					if v.Empty() {
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminFaqpEmpty) }</p>
					} else {
						<ul class="goen-admin__coupons" role="list">
							for _, e := range v.Rows {
								<li class="goen-admin__coupon">
									<div class="goen-admin__couponhead">
										<span class="goen-admin__sku">{ e.Category }</span>
										if !e.Translated() {
											<span class="ui-badge ui-badge--warn">{ i18n.T(ctx, i18n.KeyAdminUntranslated) }</span>
										}
									</div>
									<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/faq/" + e.ID) }>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "q-" + e.ID }>{ i18n.T(ctx, i18n.KeyAdminFaqpQuestion) }</label>
											<input class="ui-input" id={ "q-" + e.ID } name="question" value={ e.Question } required maxlength="200"/>
										</div>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "a-" + e.ID }>{ i18n.T(ctx, i18n.KeyAdminFaqpAnswer) }</label>
											<textarea class="ui-input goen-admin__textarea" id={ "a-" + e.ID } name="answer" rows="3" maxlength="2000" required>{ e.Answer }</textarea>
										</div>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "qe-" + e.ID }>{ i18n.T(ctx, i18n.KeyAdminFaqpQuestionEn) }</label>
											<input class="ui-input" id={ "qe-" + e.ID } name="question_en" value={ e.QuestionEn } maxlength="200" placeholder="English question"/>
										</div>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "ae-" + e.ID }>{ i18n.T(ctx, i18n.KeyAdminFaqpAnswerEn) }</label>
											<textarea class="ui-input goen-admin__textarea" id={ "ae-" + e.ID } name="answer_en" rows="3" maxlength="2000" placeholder="English answer">{ e.AnswerEn }</textarea>
										</div>
										<input type="hidden" name="category" value={ e.Category }/>
										<input type="hidden" name="category_en" value={ e.CategoryEn }/>
										<div class="goen-admin__decidebtns">
											<button class="ui-btn ui-btn--secondary" type="submit" name="action" value="save">{ i18n.T(ctx, i18n.KeyAdminFaqpSave) }</button>
											<button class="ui-btn ui-btn--ghost" type="submit" name="action" value="delete">{ i18n.T(ctx, i18n.KeyAdminDelete) }</button>
										</div>
									</form>
									<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminFaqpUpdated), e.UpdatedAt) }</span>
								</li>
							}
						</ul>
					}
				</aside>
			</div>
		</div>
	}
}
