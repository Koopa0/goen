package pages

import "github.com/koopa0/goen/internal/ui/layouts"

// AdminFAQ renders the FAQ management page.
//
// It exists because CLAUDE.md claimed /faq let support "answer a recurring question
// without a deploy" and nothing could write the table. The claim was the design
// intent; this is the door.
templ AdminFAQ(p layouts.Page, v *AdminFAQView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("faq")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">後台</p>
					<h1 class="ui-page-head__title">常見問題</h1>
					<p class="ui-page-head__sub">
						/faq 讀的就是這一份。改完不用重新部署 —— 這一頁就是那句話的門。
					</p>
				</div>
			</div>
			if v.HasNotice() {
				<p class="ui-alert" role="status">{ v.Notice }</p>
			}
			if v.Untranslated() > 0 {
				<p class="ui-alert ui-alert--warn" role="status">
					有 { untranslatedText(v) } 則沒有英文答案,英文訪客讀到的是中文。
				</p>
			}
			<div class="goen-admin__split">
				<form class="goen-admin__form" method="post" action="/admin/faq">
					<h2 class="goen-admin__subhead">新增問答</h2>
					<div class="ui-field">
						<label class="ui-label" for="faq-category">分類</label>
						<input
							class="ui-input"
							id="faq-category"
							name="category"
							required
							maxlength="40"
							value={ v.Draft.Category }
							placeholder="訂單"
							if v.HasErr("category") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("category") {
							<p class="ui-error-text">{ v.Err("category") }</p>
						}
						<p class="goen-admin__hint">同一個分類會排在一起,順序是加入的順序。</p>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-question">問題</label>
						<input
							class="ui-input"
							id="faq-question"
							name="question"
							required
							maxlength="200"
							value={ v.Draft.Question }
							if v.HasErr("question") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("question") {
							<p class="ui-error-text">{ v.Err("question") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-answer">答案</label>
						<textarea
							class="ui-input goen-admin__textarea"
							id="faq-answer"
							name="answer"
							rows="5"
							maxlength="2000"
							required
							if v.HasErr("answer") {
								aria-invalid="true"
							}
						>{ v.Draft.Answer }</textarea>
						if v.HasErr("answer") {
							<p class="ui-error-text">{ v.Err("answer") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-category-en">分類(英文)</label>
						<input class="ui-input" id="faq-category-en" name="category_en" maxlength="40" value={ v.Draft.CategoryEn } placeholder="Orders"/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-question-en">問題(英文)</label>
						<input class="ui-input" id="faq-question-en" name="question_en" maxlength="200" value={ v.Draft.QuestionEn }/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="faq-answer-en">答案(英文)</label>
						<textarea class="ui-input goen-admin__textarea" id="faq-answer-en" name="answer_en" rows="5" maxlength="2000">{ v.Draft.AnswerEn }</textarea>
						<p class="goen-admin__hint">留空的話,英文訪客會讀到中文 —— 讀得懂,但看得出還沒翻。</p>
					</div>
					<button class="ui-btn ui-btn--primary" type="submit">新增</button>
				</form>
				<aside class="goen-admin__side">
					<h2 class="goen-admin__subhead">目前的問答</h2>
					if v.Empty() {
						<p class="goen-admin__hint">還沒有問答。/faq 會是一張空白的頁面。</p>
					} else {
						<ul class="goen-admin__coupons" role="list">
							for _, e := range v.Rows {
								<li class="goen-admin__coupon">
									<div class="goen-admin__couponhead">
										<span class="goen-admin__sku">{ e.Category }</span>
										if !e.Translated() {
											<span class="ui-badge ui-badge--warn">未翻譯</span>
										}
									</div>
									// One form per row: editing a FAQ answer is typing
									// into it, not opening a second page.
									<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/faq/" + e.ID) }>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "q-" + e.ID }>問題</label>
											<input class="ui-input" id={ "q-" + e.ID } name="question" value={ e.Question } required maxlength="200"/>
										</div>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "a-" + e.ID }>答案</label>
											<textarea class="ui-input goen-admin__textarea" id={ "a-" + e.ID } name="answer" rows="3" maxlength="2000" required>{ e.Answer }</textarea>
										</div>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "qe-" + e.ID }>問題(英文)</label>
											<input class="ui-input" id={ "qe-" + e.ID } name="question_en" value={ e.QuestionEn } maxlength="200" placeholder="English question"/>
										</div>
										<div class="ui-field">
											<label class="goen-sr-only" for={ "ae-" + e.ID }>答案(英文)</label>
											<textarea class="ui-input goen-admin__textarea" id={ "ae-" + e.ID } name="answer_en" rows="3" maxlength="2000" placeholder="English answer">{ e.AnswerEn }</textarea>
										</div>
										<input type="hidden" name="category" value={ e.Category }/>
										<input type="hidden" name="category_en" value={ e.CategoryEn }/>
										<div class="goen-admin__decidebtns">
											<button class="ui-btn ui-btn--secondary" type="submit" name="action" value="save">儲存</button>
											<button class="ui-btn ui-btn--ghost" type="submit" name="action" value="delete">刪除</button>
										</div>
									</form>
									<span class="ui-cart-line__meta">最後修改 { e.UpdatedAt }</span>
								</li>
							}
						</ul>
					}
				</aside>
			</div>
		</div>
	}
}
