package pages

import "github.com/koopa0/goen/internal/ui/layouts"

// AdminHome renders the hero queue and the form that adds to it.
templ AdminHome(p layouts.Page, v *AdminHeroView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("home")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">後台</p>
					<h1 class="ui-page-head__title">首頁主視覺</h1>
					<p class="ui-page-head__sub">
						顧客看到的是排在最前面、而且在檔期內的那一則。沒有任何一則符合時,首頁會顯示內建的預設文案。
					</p>
				</div>
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			if v.UsingFallback() {
				<p class="ui-alert" role="status">目前首頁顯示的是內建預設文案。</p>
			}
			<div class="goen-admin__productlayout">
				<form
					class="goen-admin__form"
					method="post"
					action="/admin/home"
					enctype="multipart/form-data"
				>
					<div class="ui-field">
						<label class="ui-label" for="h-headline">標題</label>
						<input
							class="ui-input"
							id="h-headline"
							name="headline"
							required
							maxlength="40"
							placeholder="挑一台好的,值得。"
							value={ v.Draft.Headline }
							if v.HasErr("headline") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("headline") {
							<p class="ui-error-text">{ v.Err("headline") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-eyebrow">小標(選填)</label>
						<input class="ui-input" id="h-eyebrow" name="eyebrow" maxlength="40" value={ v.Draft.Eyebrow } placeholder="台灣出貨 · 原廠保固"/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-body">說明(選填)</label>
						<textarea class="ui-input" id="h-body" name="body" rows="2" maxlength="200">{ v.Draft.Body }</textarea>
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="h-plabel">主要按鈕文字</label>
							<input
								class="ui-input"
								id="h-plabel"
								name="primary_label"
								required
								maxlength="20"
								value={ v.Draft.PrimaryLabel }
								if v.HasErr("primary") {
									aria-invalid="true"
								}
							/>
							if v.HasErr("primary") {
								<p class="ui-error-text">{ v.Err("primary") }</p>
							}
						</div>
						<div class="ui-field">
							<label class="ui-label" for="h-phref">主要按鈕連結</label>
							<input
								class="ui-input"
								id="h-phref"
								name="primary_href"
								required
								placeholder="/deals"
								value={ v.Draft.PrimaryHref }
								if v.HasErr("primaryhref") {
									aria-invalid="true"
								}
							/>
							if v.HasErr("primaryhref") {
								<p class="ui-error-text">{ v.Err("primaryhref") }</p>
							}
						</div>
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="h-slabel">次要按鈕文字(選填)</label>
							<input class="ui-input" id="h-slabel" name="second_label" maxlength="20" value={ v.Draft.SecondLabel }/>
						</div>
						<div class="ui-field">
							<label class="ui-label" for="h-shref">次要按鈕連結</label>
							<input
								class="ui-input"
								id="h-shref"
								name="second_href"
								placeholder="/about"
								value={ v.Draft.SecondHref }
								if v.HasErr("second") {
									aria-invalid="true"
								}
							/>
							if v.HasErr("second") {
								<p class="ui-error-text">{ v.Err("second") }</p>
							}
						</div>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-image">主視覺圖片(選填)</label>
						<input class="ui-input" id="h-image" name="image" type="file" accept="image/*"/>
						<p class="goen-admin__hint">留空就沿用內建主視覺。</p>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-alt">圖片說明文字</label>
						<input
							class="ui-input"
							id="h-alt"
							name="alt"
							maxlength="200"
							value={ v.Draft.ImageAlt }
							if v.HasErr("alt") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("alt") {
							<p class="ui-error-text">{ v.Err("alt") }</p>
						}
					</div>
					// The English hero. Optional, and every field falls back to the
					// Chinese one — but the headline is the largest thing on the site, so
					// a slide with no English copy makes the whole page look untranslated
					// to an English visitor even when everything around it is not.
					<div class="ui-field">
						<label class="ui-label" for="h-eyebrow-en">小標(英文)</label>
						<input class="ui-input" id="h-eyebrow-en" name="eyebrow_en" maxlength="40" value={ v.Draft.EyebrowEn }/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-headline-en">標題(英文)</label>
						<input class="ui-input" id="h-headline-en" name="headline_en" maxlength="40" value={ v.Draft.HeadlineEn } placeholder="Choose one good thing."/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-body-en">說明(英文)</label>
						<textarea class="ui-input goen-admin__textarea" id="h-body-en" name="body_en" rows="3" maxlength="200">{ v.Draft.BodyEn }</textarea>
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="h-plabel-en">主要按鈕(英文)</label>
							<input class="ui-input" id="h-plabel-en" name="primary_label_en" maxlength="20" value={ v.Draft.PrimaryLabelEn }/>
						</div>
						<div class="ui-field">
							<label class="ui-label" for="h-slabel-en">次要按鈕(英文)</label>
							<input class="ui-input" id="h-slabel-en" name="second_label_en" maxlength="20" value={ v.Draft.SecondLabelEn }/>
						</div>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-alt-en">圖片替代文字(英文)</label>
						<input class="ui-input" id="h-alt-en" name="alt_en" maxlength="200" value={ v.Draft.ImageAltEn }/>
						<p class="goen-admin__hint">
							螢幕閱讀器會用頁面語言把這段文字唸出來,所以英文頁面需要英文的版本。
						</p>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="h-days">檔期天數</label>
						<input class="ui-input" id="h-days" name="days" type="number" min="0" max="365" step="1" inputmode="numeric" value={ v.Draft.Days } placeholder="0"/>
						<p class="goen-admin__hint">0 表示不設結束日。</p>
						if v.HasErr("days") {
							<p class="ui-error-text">{ v.Err("days") }</p>
						}
					</div>
					<button class="ui-btn ui-btn--primary" type="submit">加入佇列</button>
				</form>
				<aside class="goen-admin__side">
					<h2 class="goen-admin__subhead">佇列</h2>
					if v.Empty() {
						<p class="goen-admin__hint">還沒有任何主視覺。</p>
					} else {
						<ul class="goen-admin__coupons" role="list">
							for _, slide := range v.Rows {
								<li class="goen-admin__coupon">
									<div class="goen-admin__couponhead">
										<span class="goen-admin__sku">{ slide.Headline }</span>
										if v.IsShowing(slide) {
											<span class="ui-badge ui-badge--brand">顯示中</span>
										} else {
											<span class="ui-badge">{ slide.State() }</span>
										}
									</div>
									if slide.ImageURL() != "" {
										<img class="goen-admin__heroshot" src={ slide.ImageURL() } alt="" loading="lazy" width="160" height="90"/>
									}
									<span class="ui-cart-line__meta">{ slide.CTALabel } → { slide.CTAHref }</span>
									if slide.EndsAt != "" {
										<span class="ui-cart-line__meta">至 { slide.EndsAt }</span>
									}
									<div class="goen-admin__heroactions">
										if !v.IsShowing(slide) && slide.Active {
											<form method="post" action={ templ.SafeURL(slide.PromoteAction()) }>
												<button class="ui-btn ui-btn--secondary" type="submit">設為顯示</button>
											</form>
										}
										<form method="post" action={ templ.SafeURL(slide.ToggleAction()) }>
											<input type="hidden" name="active" value={ slide.NextActive() }/>
											<button class="ui-btn ui-btn--secondary" type="submit">{ slide.ToggleLabel() }</button>
										</form>
									</div>
								</li>
							}
						</ul>
					}
				</aside>
			</div>
			// The promotional strip. On this page because it is the same question the
			// hero answers — what the storefront says before a visitor has chosen
			// anything — and because until now it had no page at all: the only way to
			// run a promotion was SQL.
			<h2 class="goen-admin__subhead">促銷條</h2>
			<p class="goen-admin__hint">
				顯示在頁首上方,只在商店頁面。訪客關掉的是「這一條」,
				下一條會再出現 —— 新的促銷是他們還沒讀過的資訊。
			</p>
			<div class="goen-admin__split">
				<form class="goen-admin__form" method="post" action="/admin/home/banner">
					<div class="ui-field">
						<label class="ui-label" for="b-message">訊息</label>
						<input
							class="ui-input"
							id="b-message"
							name="message"
							required
							maxlength="60"
							value={ v.BannerDraft.Message }
							placeholder="全站滿 NT$3,000 免運"
							if v.HasErr("message") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("message") {
							<p class="ui-error-text">{ v.Err("message") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-short">窄螢幕版本</label>
						<input class="ui-input" id="b-short" name="short" maxlength="60" value={ v.BannerDraft.Short } placeholder="滿 3,000 免運"/>
						<p class="goen-admin__hint">手機上顯示的另一種寫法,不是截斷。留空就用上面那句。</p>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-message-en">訊息(英文)</label>
						<input class="ui-input" id="b-message-en" name="message_en" maxlength="60" value={ v.BannerDraft.MessageEn } placeholder="Free delivery over NT$3,000"/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-short-en">窄螢幕版本(英文)</label>
						<input class="ui-input" id="b-short-en" name="short_en" maxlength="60" value={ v.BannerDraft.ShortEn }/>
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="b-code">優惠碼</label>
							<input class="ui-input" id="b-code" name="code" maxlength="40" value={ v.BannerDraft.Code } placeholder="FREESHIP"/>
						</div>
						<div class="ui-field">
							<label class="ui-label" for="b-days">檔期天數</label>
							<input class="ui-input" id="b-days" name="days" type="number" min="0" max="365" step="1" inputmode="numeric" value={ v.BannerDraft.Days } placeholder="0"/>
							if v.HasErr("days") {
								<p class="ui-error-text">{ v.Err("days") }</p>
							}
						</div>
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="b-cta-label">按鈕文字</label>
							<input class="ui-input" id="b-cta-label" name="cta_label" maxlength="20" value={ v.BannerDraft.CTALabel } placeholder="看看"/>
						</div>
						<div class="ui-field">
							<label class="ui-label" for="b-cta-href">按鈕連結</label>
							<input class="ui-input" id="b-cta-href" name="cta_href" maxlength="200" value={ v.BannerDraft.CTAHref } placeholder="/deals"/>
						</div>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-cta-label-en">按鈕文字(英文)</label>
						<input class="ui-input" id="b-cta-label-en" name="cta_label_en" maxlength="20" value={ v.BannerDraft.CTALabelEn } placeholder="Shop"/>
					</div>
					if v.HasErr("cta") {
						<p class="ui-error-text">{ v.Err("cta") }</p>
					}
					<button class="ui-btn ui-btn--primary" type="submit">新增促銷條</button>
				</form>
				<aside class="goen-admin__side">
					<h3 class="goen-admin__subhead">目前的促銷條</h3>
					if !v.HasBanners() {
						<p class="goen-admin__hint">還沒有促銷條。沒有也是一個完整的網站。</p>
					} else {
						<ul class="goen-admin__coupons" role="list">
							for _, b := range v.Banners {
								<li class="goen-admin__coupon">
									<div class="goen-admin__couponhead">
										<span class="goen-admin__sku">{ b.Message }</span>
										if b.Active {
											<span class="ui-badge ui-badge--brand">顯示中</span>
										} else {
											<span class="ui-badge">已關閉</span>
										}
										if !b.Translated() {
											<span class="ui-badge ui-badge--warn">未翻譯</span>
										}
									</div>
									<span class="ui-cart-line__meta">
										if b.MessageEn != "" {
											{ b.MessageEn }
										}
										if b.HasCTA() {
											· { b.CTALabel } → { b.CTAHref }
										}
										if b.Scheduled() {
											· 到 { b.EndsAt }
										}
									</span>
									<form method="post" action={ templ.SafeURL("/admin/home/banner/" + b.ID + "/active") }>
										if b.Active {
											<input type="hidden" name="active" value="0"/>
											<button class="ui-btn ui-btn--secondary" type="submit">關閉</button>
										} else {
											<input type="hidden" name="active" value="1"/>
											<button class="ui-btn ui-btn--secondary" type="submit">開啟</button>
										}
									</form>
								</li>
							}
						</ul>
					}
				</aside>
			</div>
		</div>
	}
}
