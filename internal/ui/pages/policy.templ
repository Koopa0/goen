package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Policy renders a static policy document.
templ Policy(p layouts.Page, doc PolicyDoc) {
	@layouts.Base(p) {
		<div class="goen-doc">
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyPolicyEyebrow) }</p>
					<h1 class="ui-page-head__title">{ doc.Title }</h1>
					<p class="ui-page-head__sub">{ doc.Summary }</p>
				</div>
			</div>
			for _, s := range doc.Sections {
				<section class={ "goen-doc__section", templ.KV("is-pending", s.Pending) }>
					<h2 class="h4">{ s.Heading }</h2>
					for _, para := range s.Body {
						<p>{ para }</p>
					}
				</section>
			}
			<p class="goen-doc__contact">
				{ i18n.T(ctx, i18n.KeyPolicyMore) }<a href="/contact">{ i18n.T(ctx, i18n.KeyPolicyContactLink) }</a>{ i18n.T(ctx, i18n.KeyPolicyMoreFAQ) }<a href="/faq">{ i18n.T(ctx, i18n.KeyPolicyFAQLink) }</a>
			</p>
		</div>
	}
}

// FAQ renders the questions, grouped.
templ FAQ(p layouts.Page, v FAQView) {
	@layouts.Base(p) {
		<div class="goen-doc">
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyPolicyHelp) }</p>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyFAQTitle) }</h1>
				</div>
			</div>
			if v.Empty() {
				<p class="goen-doc__contact">
					{ i18n.T(ctx, i18n.KeyFAQEmpty) }<a href="/contact">{ i18n.T(ctx, i18n.KeyPolicyContactLink) }</a>{ i18n.T(ctx, i18n.KeyFAQEmptyTail) }
				</p>
			} else {
				for _, g := range v.Groups {
					<section class="goen-doc__section">
						<h2 class="h4">{ g.Category }</h2>
						for _, item := range g.Items {
							<details class="goen-doc__qa">
								<summary>{ item.Question }</summary>
								<p>{ item.Answer }</p>
							</details>
						}
					</section>
				}
			}
		</div>
	}
}

// Shipping renders the delivery policy, priced from the rows checkout uses.
templ Shipping(p layouts.Page, v ShippingView) {
	@layouts.Base(p) {
		<div class="goen-doc">
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyPolicyEyebrow) }</p>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyShippingTitle) }</h1>
					<p class="ui-page-head__sub">{ i18n.T(ctx, i18n.KeyShippingSub) }</p>
				</div>
			</div>
			<section class="goen-doc__section">
				<h2 class="h4">{ i18n.T(ctx, i18n.KeyShippingMethods) }</h2>
				if v.Empty() {
					<p>{ i18n.T(ctx, i18n.KeyShippingNoMethods) }</p>
				} else {
					<ul class="goen-doc__methods" role="list">
						for _, m := range v.Methods {
							<li class="goen-doc__method">
								<span class="goen-doc__methodname">
									{ m.Name }
									if m.Carrier != "" {
										<span class="ui-cart-line__meta">{ m.Carrier }</span>
									}
								</span>
								<span class="goen-doc__methodfee">
									{ m.Fee() }
									if m.FreeOver() != "" {
										<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyShippingFreeOver), m.FreeOver()) }</span>
									}
									if m.HasSurcharges() {
										<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyShippingZoneNote), m.SurchargeText(ctx)) }</span>
									}
								</span>
							</li>
						}
					</ul>
				}
			</section>
			<section class="goen-doc__section">
				<h2 class="h4">{ i18n.T(ctx, i18n.KeyShippingTracking) }</h2>
				<p>{ i18n.T(ctx, i18n.KeyShippingTrackingBody) }</p>
			</section>
			<section class="goen-doc__section">
				<h2 class="h4">{ i18n.T(ctx, i18n.KeyShippingHold) }</h2>
				<p>
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyShippingHoldBody), HoldMinutesText()) }
				</p>
			</section>
			<p class="goen-doc__contact">
				{ i18n.T(ctx, i18n.KeyPolicyMore) }<a href="/contact">{ i18n.T(ctx, i18n.KeyPolicyContactLink) }</a>{ i18n.T(ctx, i18n.KeyPolicyMoreFAQ) }<a href="/faq">{ i18n.T(ctx, i18n.KeyPolicyFAQLink) }</a>
			</p>
		</div>
	}
}
