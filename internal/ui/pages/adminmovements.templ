package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminMovements renders one variant's stock ledger.
//
// The receiving form comes before the ledger because that is why the page is
// open: a delivery has arrived and the count has to be raised. The ledger
// below is read afterwards to check it landed.
templ AdminMovements(p layouts.Page, v *AdminMovementsView) {
	@layouts.Admin(p, "stock") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">
					<a href="/admin/stock">{ i18n.T(ctx, i18n.KeyAdminStockLink) }</a>
				</p>
				<h1 class="ui-page-head__title">{ v.SKU }</h1>
				<p class="ui-page-head__sub">
					<a href={ templ.SafeURL("/admin/products/" + v.Slug) }>{ v.ProductName }</a>
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminStockNowSafe), v.StockText(), v.SafetyText()) }
				</p>
			</div>
		</div>
		if v.HasNotice() {
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
				{ v.Notice }
			}
		}
		@adminReceiveForm(v)
		if v.Empty() && !v.Paged {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminLedgerEmpty) }</p>
			</div>
		} else if !v.Empty() {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColWhen) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColChange) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColReason) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColActor) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColBalance) }</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range v.Rows {
							<tr>
								<td class="goen-admin__cellkey">{ m.At }</td>
								<td class={ "goen-admin__cellnum", templ.KV("goen-admin__in", m.In()) }>{ m.DeltaText() }</td>
								<td>{ m.ReasonText(ctx) }</td>
								<td>
									if m.HasOrder() {
										<a href={ templ.SafeURL("/admin/orders/" + m.OrderNumber) }>{ m.OrderNumber }</a>
									} else {
										—
									}
								</td>
								<td>{ m.By(ctx) }</td>
								<td class="goen-admin__cellnum">{ m.RunningText() }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminLedgerFoot) }
			</p>
		}
		@listBound(v.ListBound, ByRecency, false)
	}
}

// adminReceiveForm raises the count. The idempotency key is rendered with the
// form so a reload cannot post the same delivery twice.
templ adminReceiveForm(v *AdminMovementsView) {
	@components.Card(components.CardProps{Class: "goen-admin__section"}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminReceiveButton) }</h2>
		<form class="goen-admin__form" method="post" action="/admin/stock/receive">
			<input type="hidden" name="sku" value={ v.SKU }/>
			<input type="hidden" name="idempotency" value={ v.ReceiveKey() }/>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "receive-qty"}) {
					{ i18n.T(ctx, i18n.KeyAdminReceiveQty) }
				}
				<input
					class="goen-input goen-admin__num"
					id="receive-qty"
					type="number"
					name="quantity"
					min="1"
					step="1"
					placeholder="10"
					required
				/>
			</div>
			@components.Button(components.ButtonProps{
				Variant: components.VariantPrimary,
				Class:   "goen-admin__submit",
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminReceiveButton) }
			}
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminReceiveHint) }
			</p>
		</form>
	}
}
