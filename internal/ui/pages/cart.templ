package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Cart renders the cart page.
templ Cart(p layouts.Page, v CartView) {
	@layouts.Base(p) {
		<div class="goen-cart">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCart) }</h1>
				if !v.Empty() {
					<p class="goen-pagehead__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCartItemCount), v.ItemCountText()) }</p>
				}
			</div>
			if v.HasNotice() {
				if v.ContinueURL != "" {
					<div class="ui-alert ui-alert--info" id="cart-adjustment" role="status">
						<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" fill-rule="evenodd"></path>
						</svg>
						<div class="goen-cart__adjustment-content">
							<p class="goen-cart__adjustment-message">{ v.Notice }</p>
							<p class="goen-cart__adjustment-action">
								<a href={ templ.URL(v.ContinueURL) }>
									{ i18n.T(ctx, i18n.KeyCartAdjustmentContinue) }
									<span aria-hidden="true">→</span>
								</a>
							</p>
						</div>
					</div>
				} else {
					@components.Notice(components.NoticeProps{Tone: components.ToneAccent, ID: "cart-adjustment"}) {
						{ v.Notice }
					}
				}
			}
			if v.FromReorder() {
				@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
					{ v.ReorderText(ctx) }
				}
			}
			if v.Empty() {
				<div class="goen-empty">
					<span class="goen-medallion" aria-hidden="true">
						@icons.Cart()
					</span>
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyEmptyCart) }</p>
					<p class="goen-empty__text">{ i18n.T(ctx, i18n.KeyCartEmptyDesc) }</p>
					@components.ButtonLink(components.ButtonProps{
						Variant: components.VariantPrimary,
						Size:    components.SizeLarge,
					}, "/") {
						{ i18n.T(ctx, i18n.KeyCartEmptyLink) }
					}
				</div>
			} else {
				<div class="goen-cart__layout">
					<ul class="goen-cart__lines" role="list">
						for _, l := range v.Lines {
							@cartLine(l)
						}
					</ul>
					@components.Card(components.CardProps{
						Class: "goen-cart__summary",
						Attrs: templ.Attributes{"aria-labelledby": "summary-heading"},
					}) {
						<h2 id="summary-heading" class="goen-summary__title">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
						<div class="goen-summary">
							<div class="goen-summary__row">
								<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
								<span class="goen-summary__value">{ v.Subtotal() }</span>
							</div>
							<div class="goen-summary__row">
								<span>{ i18n.T(ctx, i18n.KeyShippingFee) }</span>
								<span class="goen-summary__value">{ i18n.T(ctx, i18n.KeyShippingLater) }</span>
							</div>
						</div>
						if v.Blocked() {
							@components.Notice(components.NoticeProps{Tone: components.ToneWarn}) {
								{ i18n.T(ctx, i18n.KeyCartStockShort) }
							}
						}
						<div class="goen-summary__actions">
							if v.CanCheckout() {
								@components.ButtonLink(components.ButtonProps{
									Variant: components.VariantPrimary,
									Size:    components.SizeLarge,
									Block:   true,
								}, "/checkout") {
									{ i18n.T(ctx, i18n.KeyCheckout) }
								}
							} else {
								// Present and plainly unavailable, rather than
								// absent: a shopper who cannot check out still
								// needs to see the control and the sentence above
								// it saying why.
								<span class="goen-btn goen-btn--primary goen-btn--lg goen-btn--block" aria-disabled="true">
									{ i18n.T(ctx, i18n.KeyCheckout) }
								</span>
							}
							@components.ButtonLink(components.ButtonProps{
								Variant: components.VariantGhost,
								Block:   true,
							}, "/") {
								{ i18n.T(ctx, i18n.KeyContinue) }
							}
						</div>
					}
				</div>
			}
		</div>
	}
}

templ cartLine(l CartLine) {
	<li class={ "goen-line", templ.KV("goen-line--out", l.Unavailable) }>
		<a class="goen-line__thumb" href={ templ.URL("/p/" + l.Slug) }>
			if l.HasImage() {
				// Width and height on the element, not only in the sheet: the
				// row's height is reserved before the image arrives, so nothing
				// below it jumps as the list loads.
				<img
					class="goen-line__img"
					src={ l.ImageURL }
					alt={ l.ImageAlt }
					width="96"
					height="96"
					loading="lazy"
					decoding="async"
				/>
			} else {
				<span class="goen-line__ph" aria-hidden="true"></span>
			}
		</a>
		<div class="goen-line__body">
			if l.Brand != "" {
				<span class="goen-line__brand">{ l.Brand }</span>
			}
			<a class="goen-line__name" href={ templ.URL("/p/" + l.Slug) }>{ l.Name }</a>
			if l.Label != "" {
				<span class="goen-line__meta">{ l.Label }</span>
			}
			<span class="goen-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyUnitPrice), l.UnitPrice()) }</span>
			if l.Unavailable {
				@components.Badge(components.BadgeProps{Tone: components.ToneDanger}) {
					{ i18n.T(ctx, i18n.KeyNoStock) }
				}
			} else if l.Short {
				@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOnlyLeft), l.AvailableText()) }
				}
			}
			<form class="goen-line__controls" method="post" action="/cart/items/update">
				<input type="hidden" name="variant" value={ l.VariantID }/>
				<label class="goen-sr-only" for={ "qty-" + l.VariantID }>{ i18n.T(ctx, i18n.KeyQuantity) }</label>
				@components.Stepper(components.StepperProps{
					ID: "qty-" + l.VariantID, Name: "quantity",
					Value: l.QuantityText(),
					// Zero is how a line is removed with no script, so the
					// field's floor is zero here and one on the product page.
					Min: "0", Max: l.MaxQuantity(),
					DecreaseLabel: i18n.T(ctx, i18n.KeyQuantityDecrease),
					IncreaseLabel: i18n.T(ctx, i18n.KeyQuantityIncrease),
				})
				@components.Button(components.ButtonProps{
					Variant: components.VariantOutline,
					Size:    components.SizeSmall,
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyUpdate) }
				}
				@components.Button(components.ButtonProps{
					Variant: components.VariantGhost,
					Size:    components.SizeSmall,
					Attrs:   templ.Attributes{"name": "remove", "value": "1"},
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyRemove) }
				}
			</form>
		</div>
		<div class="goen-line__money">
			<span class="goen-line__total">{ l.LineTotal() }</span>
			if l.Short {
				<span class="goen-line__meta">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPricedFor), l.PricedQuantityText()) }
				</span>
			}
		</div>
	</li>
}

// Checkout renders the checkout form.
templ Checkout(p layouts.Page, v *CheckoutView) {
	@layouts.Base(p) {
		<div class="goen-checkout">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCheckoutTitle) }</h1>
				<p class="goen-pagehead__sub">{ i18n.T(ctx, i18n.KeyCheckoutSub) }</p>
			</div>
			<div id="checkout-region">
				<form class="goen-checkout__layout" id="checkout-form" method="post" action="/checkout">
					// The form's DEFAULT button, and the reason it is first: HTML
					// makes the first submit button in tree order the one Enter
					// activates, and the chooser's 更新 buttons sit above the real
					// one — so pressing Enter in any field re-rendered the form
					// instead of placing the order. Inert to the keyboard and to a
					// screen reader; the visible button below is the real control,
					// and this carries the same words so the two cannot drift.
					<button
						class="goen-sr-only"
						type="submit"
						tabindex="-1"
						aria-hidden="true"
					>{ i18n.T(ctx, i18n.KeyPlaceOrder) }</button>
					<input type="hidden" name="idempotency" value={ v.IdempotencyKey }/>
					// One fixed-size identity covers the cart lines and prices, delivery,
					// coupon and exact credit spend. The server rebuilds it while holding
					// the corresponding database locks; it is a witness, not pricing input.
					<input type="hidden" name="checkout_quote" value={ v.QuoteID }/>
					// No hidden `address` here. It carried the same NAME as the radios
					// below and came FIRST, so PostFormValue returned it every time and
					// the customer's pick was discarded — the whole chooser was inert.
					// It is a leftover from when picking an address was a link.
					<div class="goen-checkout__main">
						if v.AnyErrors() {
							@components.Notice(components.NoticeProps{
								Tone:  components.ToneDanger,
								Class: "ui-alert--error",
							}) {
								{ i18n.T(ctx, i18n.KeyCheckoutHasErrors) }
							}
						}
						@components.Card(components.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "shipping"},
						}) {
							<h2 class="goen-checkout__heading" id="shipping-heading">{ i18n.T(ctx, i18n.KeySectionShipping) }</h2>
							// A radio inside the form, not a link beside it. The choice
							// decides which fields the form asks for, so changing it has
							// to re-render — and a link carrying only the choice threw
							// away everything already typed.
							//
							// The refusal is announced on the GROUP and not on an option:
							// a form refuses the choice, not one of the things on offer.
							<div
								class="goen-checkout__choices"
								{ checkoutChoiceSwap("shipping")... }
								role="radiogroup"
								aria-labelledby="shipping-heading"
								aria-invalid={ v.Invalid("shipping") }
								if v.HasErr("shipping") {
									aria-describedby="shipping-error"
								}
							>
								for _, c := range v.Shipping {
									<label class="goen-checkout__ship">
										<input
											class="goen-sr-only"
											id={ "shipping-" + c.VersionID }
											type="radio"
											name="shipping"
											value={ c.VersionID }
											checked?={ c.VersionID == v.Chosen }
										/>
										<span class="goen-checkout__shipname">
											{ c.Name }
											if c.Carrier != "" {
												<span class="goen-checkout__shipnote">{ c.Carrier }</span>
											}
										</span>
										<span class="goen-checkout__shipfee">
											if c.Free {
												{ i18n.T(ctx, i18n.KeyFreeShipping) }
											} else {
												{ c.Fee() }
											}
										</span>
									</label>
								}
							</div>
							@applyChoice("shipping")
							if v.HasErr("shipping") {
								<p class="ui-error-text" id="shipping-error">{ v.Err("shipping") }</p>
							}
							if v.Repriced != "" {
								@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
									{ v.Repriced }
								}
							}
							if v.CreditChanged != "" {
								@components.Notice(components.NoticeProps{
									Tone:  components.ToneAccent,
									Class: "ui-alert--info",
								}) {
									{ v.CreditChanged }
								}
							}
						}
						@components.Card(components.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "address"},
						}) {
							<h2 class="goen-checkout__heading" id="recipient-heading">{ i18n.T(ctx, i18n.KeySectionRecipient) }</h2>
							if v.OffersTheAddressBook() {
								<div
									class="goen-checkout__choices"
									{ checkoutChoiceSwap("address")... }
									role="radiogroup"
									aria-labelledby="recipient-heading"
									aria-invalid={ v.Invalid("address") }
									if v.HasErr("address") {
										aria-describedby="address-error"
									}
								>
									for _, a := range v.SavedAddresses {
										<label class="goen-checkout__ship">
											<input
												class="goen-sr-only"
												id={ "address-" + a.ID }
												type="radio"
												name="address"
												value={ a.ID }
												checked?={ a.ID == v.ChosenAddress }
											/>
											<span class="goen-checkout__shipname">
												{ a.DisplayLabel(ctx) }
												<span class="goen-checkout__shipnote">{ a.Line() }</span>
											</span>
										</label>
									}
								</div>
								@applyChoice("address")
								if v.HasErr("address") {
									<p class="ui-error-text" id="address-error">{ v.Err("address") }</p>
								}
							}
							<div class="goen-checkout__fields">
								@field("email", i18n.T(ctx, i18n.KeyFieldEmail), "email", v.Address.Email, v)
								@field("name", i18n.T(ctx, i18n.KeyFieldName), "text", v.Address.Name, v)
								@field("phone", i18n.T(ctx, i18n.KeyFieldPhone), "tel", v.Address.Phone, v)
								if v.ToPickupPoint() {
									// The chain is what the shopper chooses here. Which
									// store the parcel waits at comes from the carrier's
									// own picker; nobody types a store number, and asking
									// for one only produced refusals.
									//
									// The chooser re-renders the form, because the chain
									// decides which map the button below opens and that
									// form is built on the server.
									<div class="goen-field goen-checkout__wide" id="pickup_brand">
										<p class="goen-label" id="pickup_brand-label">{ i18n.T(ctx, i18n.KeyFieldPickupBrand) }</p>
										<div
											class="goen-checkout__choices"
											{ checkoutChoiceSwap("pickup_brand")... }
											role="radiogroup"
											aria-labelledby="pickup_brand-label"
											aria-invalid={ v.Invalid("pickup_brand") }
											if v.HasErr("pickup_brand") {
												aria-describedby="pickup_brand-error"
											}
										>
											for _, b := range v.PickupBrands {
												<label class="goen-checkout__ship">
													<input
														class="goen-sr-only"
														id={ "pickup_brand-" + string(b.Value) }
														type="radio"
														name="pickup_brand"
														value={ string(b.Value) }
														checked?={ b.Value == v.Address.PickupBrand }
													/>
													<span class="goen-checkout__shipname">{ b.Label }</span>
												</label>
											}
										</div>
										@applyChoice("pickup_brand")
										if v.HasErr("pickup_brand") {
											<p class="ui-error-text" id="pickup_brand-error">{ v.Err("pickup_brand") }</p>
										}
										@pickupStore(v)
									</div>
								} else {
									@field("postal_code", i18n.T(ctx, i18n.KeyFieldPostalCode), "text", v.Address.PostalCode, v)
									@field("city", i18n.T(ctx, i18n.KeyFieldCity), "text", v.Address.City, v)
									@field("district", i18n.T(ctx, i18n.KeyFieldDistrict), "text", v.Address.District, v)
									<div class="goen-field goen-checkout__wide">
										@components.Label(components.LabelProps{For: "street"}) {
											{ i18n.T(ctx, i18n.KeyFieldStreet) }
										}
										<input
											class="goen-input"
											id="street"
											type="text"
											name="street"
											value={ v.Address.Street }
											required
											maxlength="200"
											autocomplete="street-address"
											aria-invalid={ v.Invalid("street") }
											if v.HasErr("street") {
												aria-describedby="street-error"
											}
										/>
										if v.HasErr("street") {
											<p class="ui-error-text" id="street-error">{ v.Err("street") }</p>
										}
									</div>
								}
								<div class="goen-field goen-checkout__wide">
									@components.Label(components.LabelProps{For: "note"}) {
										{ i18n.T(ctx, i18n.KeyFieldNote) }
									}
									<textarea
										class="goen-input goen-input--area"
										id="note"
										name="note"
										autocomplete="off"
										maxlength="500"
										rows="2"
										aria-invalid={ v.Invalid("note") }
										if v.HasErr("note") {
											aria-describedby="note-error"
										}
									>{ v.Address.Note }</textarea>
									if v.HasErr("note") {
										<p class="ui-error-text" id="note-error">{ v.Err("note") }</p>
									}
								</div>
							</div>
						}
						@components.Card(components.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "invoice"},
						}) {
							<h2 class="goen-checkout__heading" id="invoice-heading">{ i18n.T(ctx, i18n.KeySectionInvoice) }</h2>
							// This one sat BELOW the address fields, so choosing it through
							// a link discarded a whole recipient the customer had just
							// typed. It is the sharpest case of the three.
							<div
								class="goen-checkout__choices"
								{ checkoutChoiceSwap("invoice")... }
								role="radiogroup"
								aria-labelledby="invoice-heading"
								aria-invalid={ v.Invalid("invoice_type") }
								if v.HasErr("invoice_type") {
									aria-describedby="invoice_type-error"
								}
							>
								for _, c := range v.InvoiceChoices {
									<label class="goen-checkout__ship">
										<input
											class="goen-sr-only"
											id={ "invoice_type-" + string(c.Value) }
											type="radio"
											name="invoice_type"
											value={ string(c.Value) }
											checked?={ v.Invoice.Is(c.Value) }
										/>
										<span class="goen-checkout__shipname">{ c.Label }</span>
									</label>
								}
							</div>
							@applyChoice("invoice")
							<div class="goen-checkout__fields">
								if v.Invoice.NeedsCarrier() {
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "invoice_carrier"}) {
											{ i18n.T(ctx, i18n.KeyFieldCarrier) }
										}
										<input
											class="goen-input"
											id="invoice_carrier"
											name="invoice_carrier"
											maxlength="8"
											autocomplete="off"
											placeholder="/ABC+123"
											value={ v.Invoice.Carrier }
											aria-invalid={ v.Invalid("invoice_carrier") }
											if v.HasErr("invoice_carrier") {
												aria-describedby="invoice_carrier-error"
											}
										/>
										if v.HasErr("invoice_carrier") {
											<p class="ui-error-text" id="invoice_carrier-error">{ v.Err("invoice_carrier") }</p>
										}
									</div>
								}
								if v.Invoice.NeedsTaxID() {
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "invoice_company_name"}) {
											{ i18n.T(ctx, i18n.KeyFieldCompanyName) }
										}
										<input
											class="goen-input"
											id="invoice_company_name"
											name="invoice_company_name"
											maxlength="60"
											autocomplete="organization"
											value={ v.Invoice.CompanyName }
											aria-invalid={ v.Invalid("invoice_company_name") }
											if v.HasErr("invoice_company_name") {
												aria-describedby="invoice_company_name-error"
											}
										/>
										if v.HasErr("invoice_company_name") {
											<p class="ui-error-text" id="invoice_company_name-error">{ v.Err("invoice_company_name") }</p>
										}
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "invoice_tax_id"}) {
											{ i18n.T(ctx, i18n.KeyFieldTaxID) }
										}
										<input
											class="goen-input"
											id="invoice_tax_id"
											name="invoice_tax_id"
											maxlength="8"
											inputmode="numeric"
											autocomplete="off"
											value={ v.Invoice.TaxID }
											aria-invalid={ v.Invalid("invoice_tax_id") }
											if v.HasErr("invoice_tax_id") {
												aria-describedby="invoice_tax_id-error"
											}
										/>
										if v.HasErr("invoice_tax_id") {
											<p class="ui-error-text" id="invoice_tax_id-error">{ v.Err("invoice_tax_id") }</p>
										}
									</div>
								}
							</div>
							if v.HasErr("invoice_type") {
								<p class="ui-error-text" id="invoice_type-error">{ v.Err("invoice_type") }</p>
							}
						}
					</div>
					@components.Card(components.CardProps{
						Class: "goen-checkout__summary",
						Attrs: templ.Attributes{"id": "summary", "aria-labelledby": "summary-heading"},
					}) {
						<h2 id="summary-heading" class="goen-summary__title">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
						<ul class="goen-checkout__lines" role="list">
							for _, l := range v.Cart.Lines {
								<li>
									<span>
										{ l.Name } × { l.QuantityText() }
										if l.Label != "" {
											<span class="goen-line__meta">{ l.Label }</span>
										}
									</span>
									<span class="goen-summary__value">{ l.LineTotal() }</span>
								</li>
							}
						</ul>
						<div class="goen-summary">
							<div class="goen-summary__row">
								<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
								<span class="goen-summary__value">{ v.Cart.Subtotal() }</span>
							</div>
							<div class="goen-summary__row">
								<span>{ i18n.T(ctx, i18n.KeyShippingFee) }</span>
								<span class="goen-summary__value">
									if v.ShipsFree() {
										{ i18n.T(ctx, i18n.KeyFreeShipping) }
									} else {
										{ v.ShippingText() }
									}
								</span>
							</div>
							if v.HasSurcharge() {
								<div class="goen-summary__row">
									<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyZoneSurcharge), v.ZoneName) }</span>
									<span class="goen-summary__value">{ v.Surcharge() }</span>
								</div>
							}
							if v.HasCoupon() && v.CouponDiscountCents > 0 {
								<div class="goen-summary__row">
									<span>{ i18n.T(ctx, i18n.KeyDiscount) }({ v.CouponApplied })</span>
									<span class="goen-summary__value">{ v.CouponDiscount() }</span>
								</div>
							}
							if v.UsesCredit() {
								<div class="goen-summary__row">
									<span>{ i18n.T(ctx, i18n.KeyStoreCredit) }</span>
									<span class="goen-summary__value">{ v.Credit() }</span>
								</div>
							}
							<div class="goen-summary__row goen-summary__row--total">
								<span>{ i18n.T(ctx, i18n.KeyTotal) }</span>
								<span class="goen-summary__value">{ v.Total() }</span>
							</div>
						</div>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "coupon"}) {
								{ i18n.T(ctx, i18n.KeyCouponCode) }
							}
							<div class="goen-checkout__couponrow">
								<input
									class="goen-input"
									id="coupon"
									name="coupon"
									maxlength="32"
									autocomplete="off"
									placeholder={ i18n.T(ctx, i18n.KeyCouponPlaceholder) }
									value={ v.CouponCode }
									aria-invalid={ v.Invalid("coupon") }
									if v.HasErr("coupon") {
										aria-describedby="coupon-error"
									}
								/>
								@components.Button(components.ButtonProps{
									Variant: components.VariantOutline,
									Attrs:   templ.Attributes{"name": "update", "value": "coupon", "formnovalidate": true},
								}, "submit") {
									{ i18n.T(ctx, i18n.KeyApplyCoupon) }
								}
							</div>
							if v.HasErr("coupon") {
								<p class="ui-error-text" id="coupon-error">{ v.Err("coupon") }</p>
							}
							if v.HasCoupon() {
								<p class="goen-checkout__note">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCouponApplied), v.CouponApplied) }</p>
							}
						</div>
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size:    components.SizeLarge,
							Block:   true,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyPlaceOrder) }
						}
						<p class="goen-checkout__note">
							{ i18n.T(ctx, i18n.KeyCheckoutSubmitNote) }
						</p>
					}
				</form>
				@storeMapForm(v)
			</div>
		</div>
	}
}

// pickupStore is the store the parcel waits at, and the control that opens the
// carrier's map to choose one.
//
// The summary is a SECURITY CONTROL, not decoration. The map's callback carries
// no signature of any kind and the map itself is run by the convenience-store
// chain rather than by the carrier, so a store reported back cannot be checked
// by any means goen has. The shopper reading the name AND the address before
// paying is the only check there is. Do not reduce it to the name.
templ pickupStore(v *CheckoutView) {
	if v.OffersTheStoreMap() || v.HasPickupStore() || v.PickupRefused {
		<div class="goen-pickup">
			if v.PickupRefused {
				// The message says a store could not be confirmed and repeats
				// NONE of what arrived: that text came from a cross-site post.
				@components.Notice(components.NoticeProps{
					Tone:  components.ToneDanger,
					Class: "ui-alert--error",
				}) {
					{ i18n.T(ctx, i18n.KeyPickupStoreUnconfirmed) }
				}
			}
			if v.HasPickupStore() {
				// Carried back so the order can be placed from this page. The
				// ADDRESS is not among them: it is read from the URL for the
				// summary above, and is never posted and never stored.
				<input type="hidden" name="pickup_store_code" value={ v.Address.PickupStoreCode }/>
				<input type="hidden" name="pickup_store_name" value={ v.Address.PickupStoreName }/>
				<input type="hidden" name="pickup_store_brand" value={ string(v.Address.PickupBrand) }/>
				<input type="hidden" name="pickup_n" value={ v.PickupNonce }/>
				<p class="goen-pickup__name">{ v.Address.PickupStoreName } ({ v.Address.PickupStoreCode })</p>
				if v.PickupStoreAddr != "" {
					<p class="goen-pickup__addr">{ v.PickupStoreAddr }</p>
				}
			}
			if v.HasErr("pickup_store") {
				<p class="ui-error-text" id="pickup_store-error">{ v.Err("pickup_store") }</p>
			}
			if v.OffersTheStoreMap() {
				// form= and no name or value: a form-associated submit button
				// contributes its OWN name and value to the form it submits, and
				// that would be one more field on its way to a third party.
				//
				// It is also the control a refusal belongs to: nobody types a
				// store, they choose one through the picker this opens.
				{{ storeAttrs := checkoutStoreButtonAttrs(v.Invalid("pickup_store"), v.HasErr("pickup_store")) }}
				@components.Button(components.ButtonProps{
					Variant: components.VariantOutline,
					Attrs:   storeAttrs,
				}, "submit") {
					if v.HasPickupStore() {
						{ i18n.T(ctx, i18n.KeyPickupChangeStore) }
					} else {
						{ i18n.T(ctx, i18n.KeyPickupChooseStore) }
					}
				}
			}
		</div>
	}
}

// storeMapForm is the one form that posts to the carrier, and it is a SIBLING
// of the checkout form rather than anything inside it. Two reasons, both
// absolute: a formaction on #checkout-form would hand a third party the
// shopper's name, phone, e-mail and street address, and a <form> nested in a
// <form> is dropped by the HTML parser outright.
//
// Every input here is a parameter the carrier's map documents. Nothing the
// shopper typed appears, and nothing may be added.
templ storeMapForm(v *CheckoutView) {
	if v.OffersTheStoreMap() {
		<form id={ mapFormID } class="goen-pickup__map" method="post" action={ templ.URL(v.Map.Action) }>
			<input type="hidden" name="MerchantID" value={ v.Map.MerchantID }/>
			<input type="hidden" name="MerchantTradeNo" value={ v.Map.MerchantTradeNo }/>
			<input type="hidden" name="LogisticsType" value={ v.Map.LogisticsType }/>
			<input type="hidden" name="LogisticsSubType" value={ v.Map.LogisticsSubType }/>
			<input type="hidden" name="IsCollection" value={ v.Map.IsCollection }/>
			<input type="hidden" name="ServerReplyURL" value={ v.Map.ServerReplyURL }/>
			<input type="hidden" name="ExtraData" value={ v.Map.ExtraData }/>
			if v.Map.Device != "" {
				<input type="hidden" name="Device" value={ v.Map.Device }/>
			}
		</form>
	}
}

// applyChoice re-renders the form with the choice above it applied. A submit
// button rather than a link, because the form carries everything the customer
// has typed and a link carries only the choice.
//
// It is the path a browser without scripting takes; the stylesheet hides it
// where the change itself applies the choice. The fragment names the section
// this button belongs to, so the answer opens at that heading instead of the
// top of a form the customer had already scrolled past.
templ applyChoice(which string) {
	<div class="goen-checkout__apply">
		@components.Button(components.ButtonProps{
			Variant: components.VariantOutline,
			Size:    components.SizeSmall,
			Attrs: templ.Attributes{
				"formaction":     "/checkout#" + which,
				"name":           "update",
				"value":          which,
				"formnovalidate": true,
			},
		}, "submit") {
			{ i18n.T(ctx, i18n.KeyApplyChoice) }
		}
	</div>
}

templ field(name, label, kind, value string, v *CheckoutView) {
	{{ hints := checkoutHintsFor(name) }}
	<div class="goen-field">
		@components.Label(components.LabelProps{For: name}) {
			{ label }
		}
		<input
			class="goen-input"
			id={ name }
			type={ kind }
			name={ name }
			value={ value }
			required
			autocomplete={ hints.Autocomplete }
			if hints.InputMode != "" {
				inputmode={ hints.InputMode }
			}
			if hints.AutoCapitalize != "" {
				autocapitalize={ hints.AutoCapitalize }
			}
			if hints.SpellCheck != "" {
				spellcheck={ hints.SpellCheck }
			}
			aria-invalid={ v.Invalid(name) }
			if v.HasErr(name) {
				aria-describedby={ name + "-error" }
			}
		/>
		if v.HasErr(name) {
			<p class="ui-error-text" id={ name + "-error" }>{ v.Err(name) }</p>
		}
	</div>
}

// Order renders the confirmation page.
templ Order(p layouts.Page, v *OrderView) {
	@layouts.Base(p) {
		<div class="goen-order">
			<div class="goen-order__placed">
				<span class="goen-medallion goen-medallion--success" aria-hidden="true">
					@icons.CheckCircle()
				</span>
				<div class="goen-pagehead">
					<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, i18n.KeyOrderPlaced) }</p>
					<h1 class="goen-pagehead__title">{ v.Number }</h1>
					<p class="goen-pagehead__sub">
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderPlacedAt), v.PlacedAt) }
						if v.Email != "" {
							· { fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderEmailNotice), v.Email) }
						}
					</p>
				</div>
			</div>
			if v.Cancelled {
				@components.Notice(components.NoticeProps{
					Tone: components.ToneNeutral,
					ID:   "order-cancelled",
				}) {
					{ i18n.T(ctx, i18n.KeyOrderCancelled) }
				}
			}
			if v.AwaitingPayment() {
				@components.Notice(components.NoticeProps{
					Tone: components.ToneAccent,
					ID:   "order-unpaid",
				}) {
					{ i18n.T(ctx, i18n.KeyOrderUnpaid) }
					<a href={ templ.SafeURL("/orders/" + v.Number + "/pay") }>{ i18n.T(ctx, i18n.KeyPay) }</a>
				}
			}
			<div class="goen-order__layout">
				<div class="goen-order__panels">
					if len(v.Shipments) > 0 {
						<section class="goen-order__tracking" aria-labelledby="tracking-heading">
							<h2 id="tracking-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderTracking) }</h2>
							<ul class="goen-order__shipments" role="list">
								for _, sh := range v.Shipments {
									<li class="goen-order__shipment">
										<span class="goen-order__carrier">{ sh.Carrier }</span>
										<span class="goen-order__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderTrackingNo), sh.Tracking) }</span>
										if sh.Delivered() {
											@components.Badge(components.BadgeProps{Tone: components.ToneNeutral}) {
												{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderDeliveredAt), sh.DeliveredAt) }
											}
										} else {
											<span class="goen-order__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderShippedAt), sh.ShippedAt) }</span>
										}
									</li>
								}
							</ul>
						</section>
					}
					if len(v.Timeline) > 0 {
						// The history as a rail of dots, on the page rather than
						// behind a tab: "where is my order" is the question this
						// page is opened with, and a tab hides the answer from
						// anyone who does not know to press it.
						<section class="goen-order__history" aria-labelledby="history-heading">
							<h2 id="history-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderHistory) }</h2>
							<ol class="goen-order__steps">
								for i, e := range v.Timeline {
									<li class="goen-order__step">
										<span class="goen-order__rail" aria-hidden="true">
											<span class="goen-order__dot"></span>
											if i < len(v.Timeline)-1 {
												<span class="goen-order__connector"></span>
											}
										</span>
										<div class="goen-order__stepbody">
											<p class="goen-order__steplabel">{ i18n.T(ctx, e.LabelKey()) }</p>
											<p class="goen-order__meta">{ e.At }</p>
											if e.Note != "" {
												<p class="goen-order__meta">{ e.Note }</p>
											}
										</div>
									</li>
								}
							</ol>
						</section>
					}
					if v.DeliveryTo != "" {
						<section class="goen-order__delivery" aria-labelledby="delivery-heading">
							<h2 id="delivery-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderDeliveryTo) }</h2>
							<div class="goen-order__shipment">
								<span class="goen-order__carrier">{ v.ShippingName }</span>
								<span class="goen-order__meta">{ v.DeliveryTo }</span>
							</div>
						</section>
					}
					<ul class="goen-order__lines" role="list">
						for _, l := range v.Lines {
							<li class="goen-line">
								<div class="goen-line__body">
									<p class="goen-line__name">{ l.Name }</p>
									if l.Label != "" {
										<span class="goen-line__meta">{ l.Label }</span>
									}
									<span class="goen-line__meta">{ l.SKU } · { l.UnitPrice() } × { l.QuantityText() }</span>
								</div>
								<div class="goen-line__money">
									<span class="goen-line__total">{ l.LineTotal() }</span>
								</div>
							</li>
						}
					</ul>
				</div>
				@components.Card(components.CardProps{Class: "goen-order__summary"}) {
					<div class="goen-summary">
						<div class="goen-summary__row">
							<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
							<span class="goen-summary__value">{ v.Subtotal() }</span>
						</div>
						<div class="goen-summary__row">
							<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderShippingFee), v.ShippingName) }</span>
							<span class="goen-summary__value">{ v.Shipping(ctx) }</span>
						</div>
						if v.Discounted() {
							<div class="goen-summary__row">
								<span>
									{ i18n.T(ctx, i18n.KeyDiscount) }
									if v.DiscountReason != "" {
										({ v.DiscountReason })
									}
								</span>
								<span class="goen-summary__value">{ v.Discount() }</span>
							</div>
						}
						<div class="goen-summary__row goen-summary__row--total">
							<span>{ i18n.T(ctx, i18n.KeyOrderGrandTotal) }</span>
							<span class="goen-summary__value">{ v.Total() }</span>
						</div>
						// Below the total, because it is not a reduction of the
						// price: the goods cost what they cost and this is part
						// of how they were paid for.
						if v.UsedCredit() {
							<div class="goen-summary__row">
								<span>{ i18n.T(ctx, i18n.KeyOrderCreditApplied) }</span>
								<span class="goen-summary__value">{ v.Credit() }</span>
							</div>
						}
					</div>
					<div class="goen-summary__actions">
						<form class="goen-order__cancel" method="post" action={ templ.SafeURL("/orders/" + v.Number + "/reorder") }>
							@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
								{ i18n.T(ctx, i18n.KeyOrderReorder) }
							}
							<span class="goen-order__meta">{ i18n.T(ctx, i18n.KeyOrderReorderNote) }</span>
						</form>
						if v.CanCancel() {
							<form class="goen-order__cancel" method="post" action={ templ.SafeURL("/orders/" + v.Number + "/cancel") }>
								@components.Button(components.ButtonProps{Variant: components.VariantGhost}, "submit") {
									{ i18n.T(ctx, i18n.KeyOrderCancel) }
								}
								<span class="goen-order__meta">{ i18n.T(ctx, i18n.KeyOrderCancelNote) }</span>
							</form>
						}
						if v.ShowWarrantyLink && v.CanRegisterWarranty() {
							@components.ButtonLink(components.ButtonProps{
								Variant: components.VariantOutline,
								Block:   true,
							}, templ.SafeURL(v.WarrantyLink())) {
								{ i18n.T(ctx, i18n.KeyWarrantyTitle) }
							}
						}
						if v.CanRequestReturn() {
							@components.ButtonLink(components.ButtonProps{
								Variant: components.VariantOutline,
								Block:   true,
							}, templ.SafeURL("/orders/"+v.Number+"/return")) {
								{ i18n.T(ctx, i18n.KeyOrderReturn) }
							}
						}
						@components.ButtonLink(components.ButtonProps{
							Variant: components.VariantGhost,
							Block:   true,
						}, "/") {
							{ i18n.T(ctx, i18n.KeyContinue) }
						}
					</div>
				}
			</div>
		</div>
	}
}
