package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Cart renders the cart page.
//
// Every control is a plain form. Changing a quantity is a POST that answers 303,
// so a reload cannot resubmit it, and the page works with scripting off because
// there is nothing here that needs scripting.
templ Cart(p layouts.Page, v CartView) {
	@layouts.Base(p) {
		<div class="goen-cart">
			<div class="ui-page-head">
				<div>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyCart) }</h1>
					if !v.Empty() {
						<p class="ui-page-head__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCartItemCount), v.ItemCountText()) }</p>
					}
				</div>
			</div>
			if v.FromReorder() {
				<p class="ui-alert ui-alert--info" role="status">{ v.ReorderText(ctx) }</p>
			}
			if v.Empty() {
				<div class="ui-empty">
					<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeyEmptyCart) }</p>
					<p class="ui-empty__desc">
						{ i18n.T(ctx, i18n.KeyCartEmptyDesc) }
						<a href="/">{ i18n.T(ctx, i18n.KeyCartEmptyLink) }</a>
					</p>
				</div>
			} else {
				<div class="goen-cart__layout">
					<ul class="goen-cart__lines" role="list">
						for _, l := range v.Lines {
							@cartLine(l)
						}
					</ul>
					<aside class="goen-cart__summary" aria-labelledby="summary-heading">
						<h2 id="summary-heading" class="goen-cart__summarytitle">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
						<div class="ui-summary">
							<div class="ui-summary__row">
								<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
								<span class="ui-summary__val">{ v.Subtotal() }</span>
							</div>
							<div class="ui-summary__row">
								<span>{ i18n.T(ctx, i18n.KeyShippingFee) }</span>
								<span class="ui-summary__val">{ i18n.T(ctx, i18n.KeyShippingLater) }</span>
							</div>
						</div>
						if v.Blocked() {
							<p class="ui-alert ui-alert--warn goen-cart__blocked" role="status">
								{ i18n.T(ctx, i18n.KeyCartStockShort) }
							</p>
						}
						if v.CanCheckout() {
							<a class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block goen-cart__checkout" href="/checkout">
								{ i18n.T(ctx, i18n.KeyCheckout) }
							</a>
						} else {
							<span class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block goen-cart__checkout" aria-disabled="true">
								{ i18n.T(ctx, i18n.KeyCheckout) }
							</span>
						}
						<a class="goen-cart__keep" href="/">{ i18n.T(ctx, i18n.KeyContinue) }</a>
					</aside>
				</div>
			}
		</div>
	}
}

// cartLine is one line, with its own form so a quantity change posts only that
// line rather than the whole cart.
templ cartLine(l CartLine) {
	<li class={ "goen-cart__line", templ.KV("goen-cart__line--out", l.Unavailable) }>
		<a class="goen-cart__thumb" href={ templ.URL("/p/" + l.Slug) }>
			if l.HasImage() {
				<img src={ l.ImageURL } alt={ l.ImageAlt } loading="lazy" decoding="async"/>
			} else {
				<span class="goen-cart__thumbph" aria-hidden="true"></span>
			}
		</a>
		<div class="goen-cart__body">
			<span class="ui-cart-line__meta">{ l.Brand }</span>
			<a class="goen-cart__name" href={ templ.URL("/p/" + l.Slug) }>{ l.Name }</a>
			if l.Label != "" {
				<span class="ui-cart-line__meta">{ l.Label }</span>
			}
			if l.Unavailable {
				<span class="ui-badge">{ i18n.T(ctx, i18n.KeyNoStock) }</span>
			} else if l.Short {
				<span class="ui-badge ui-badge--warn">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOnlyLeft), l.AvailableText()) }</span>
			}
			<form class="goen-cart__controls" method="post" action="/cart/items/update">
				<input type="hidden" name="variant" value={ l.VariantID }/>
				<label class="goen-sr-only" for={ "qty-" + l.VariantID }>{ i18n.T(ctx, i18n.KeyQuantity) }</label>
				<input
					class="ui-input ui-input--sm goen-cart__qty"
					id={ "qty-" + l.VariantID }
					type="number"
					name="quantity"
					value={ l.QuantityText() }
					min="0"
					max={ l.MaxQuantity() }
					step="1"
					inputmode="numeric"
				/>
				<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyUpdate) }</button>
				<button class="ui-btn ui-btn--ghost ui-btn--sm" type="submit" name="remove" value="1">{ i18n.T(ctx, i18n.KeyRemove) }</button>
			</form>
		</div>
		<div class="goen-cart__money">
			<span class="ui-cart-line__price">{ l.LineTotal() }</span>
			<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyUnitPrice), l.UnitPrice()) }</span>
		</div>
	</li>
}

// Checkout renders the checkout form: delivery details, a shipping choice, and
// what it all comes to.
//
// The form is a plain POST. A rejected submission comes back at 422 with every
// value the visitor typed and aria-invalid on each control the server refused —
// nobody retypes an address because a postal code was wrong.
templ Checkout(p layouts.Page, v *CheckoutView) {
	@layouts.Base(p) {
		<div class="goen-checkout">
			<div class="ui-page-head">
				<div>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyCheckoutTitle) }</h1>
					<p class="ui-page-head__sub">{ i18n.T(ctx, i18n.KeyCheckoutSub) }</p>
				</div>
			</div>
			if v.AnyErrors() {
				<p class="ui-alert ui-alert--error goen-checkout__alert" role="alert">
					{ i18n.T(ctx, i18n.KeyCheckoutHasErrors) }
				</p>
			}
			<form class="goen-checkout__layout" method="post" action="/checkout">
				<input type="hidden" name="idempotency" value={ v.Idempoten }/>
				// What delivery was last QUOTED at. The server compares it with
				// what the typed address actually costs, and refuses the first
				// submission that finds a different figure — so a 離島 order
				// is never charged a surcharge the customer has not seen.
				<input type="hidden" name="quoted_shipping" value={ v.QuotedShipping() }/>
				// Which saved address filled the form, echoed so a rejected
				// submission comes back with the same one marked. It selects
				// nothing on its own — the fields are what is written.
				<input type="hidden" name="address" value={ v.ChosenAddress }/>
				<div class="goen-checkout__panel">
					// The method comes first, because it decides what the rest of
					// the form asks for. Each one is a LINK carrying the choice in
					// the URL — no cookie, no stored state, correct under the back
					// button, and working with scripting off because there is
					// nothing to script.
					<h2 class="goen-checkout__section">{ i18n.T(ctx, i18n.KeySectionShipping) }</h2>
					<input type="hidden" name="shipping" value={ v.Chosen }/>
					<div class="goen-checkout__shipping">
						for _, c := range v.Shipping {
							<a
								class={ "goen-checkout__ship",
									templ.KV("goen-checkout__ship--on", c.VersionID == v.Chosen) }
								href={ templ.URL(v.CheckoutLink("ship", c.VersionID)) }
								if c.VersionID == v.Chosen {
									aria-current="true"
								}
							>
								<span class="goen-checkout__shipname">
									{ c.Name }
									if c.Carrier != "" {
										<span class="ui-cart-line__meta">{ c.Carrier }</span>
									}
								</span>
								<span class="goen-checkout__shipfee">
									if c.Free {
										{ i18n.T(ctx, i18n.KeyFreeShipping) }
									} else {
										{ c.Fee() }
									}
								</span>
							</a>
						}
					</div>
					if v.HasErr("shipping") {
						<p class="ui-error-text">{ v.Err("shipping") }</p>
					}
					<h2 class="goen-checkout__section">{ i18n.T(ctx, i18n.KeySectionRecipient) }</h2>
					if v.OffersTheAddressBook() {
						// The customer's own address book. Links, like the method
						// above — choosing one re-renders the form filled in, and
						// the fields stay editable afterwards.
						<div class="goen-checkout__shipping">
							for _, a := range v.SavedAddresses {
								<a
									class={ "goen-checkout__ship",
										templ.KV("goen-checkout__ship--on", a.ID == v.ChosenAddress) }
									href={ templ.URL(v.CheckoutLink("address", a.ID)) }
									if a.ID == v.ChosenAddress {
										aria-current="true"
									}
								>
									<span class="goen-checkout__shipname">
										{ a.DisplayLabel(ctx) }
										<span class="ui-cart-line__meta">{ a.Line() }</span>
									</span>
								</a>
							}
						</div>
					}
					<div class="goen-checkout__fields">
						@field("email", i18n.T(ctx, i18n.KeyFieldEmail), "email", v.Address.Email, v, true)
						@field("name", i18n.T(ctx, i18n.KeyFieldName), "text", v.Address.Name, v, true)
						@field("phone", i18n.T(ctx, i18n.KeyFieldPhone), "tel", v.Address.Phone, v, true)
						if v.ToPickupPoint() {
							// 超商取貨. A street address here would be data nobody
							// ever reads: the parcel goes to the store, and the
							// store is identified by its number.
							<div class="ui-field">
								<label class="ui-label" for="pickup_brand">{ i18n.T(ctx, i18n.KeyFieldPickupBrand) }</label>
								<select
									class="ui-select"
									id="pickup_brand"
									name="pickup_brand"
									required
									aria-invalid={ v.Invalid("pickup_brand") }
								>
									<option value="">{ i18n.T(ctx, i18n.KeySelectPlaceholder) }</option>
									for _, b := range v.PickupBrands {
										<option value={ b.Value } selected?={ b.Value == v.Address.PickupBrand }>
											{ b.Label }
										</option>
									}
								</select>
								if v.HasErr("pickup_brand") {
									<p class="ui-error-text">{ v.Err("pickup_brand") }</p>
								}
							</div>
							@field("pickup_store_code", i18n.T(ctx, i18n.KeyFieldStoreCode), "text", v.Address.PickupStoreCode, v, true)
							<div class="ui-field goen-checkout__wide">
								<label class="ui-label" for="pickup_store_name">{ i18n.T(ctx, i18n.KeyFieldStoreName) }</label>
								<input
									class="ui-input"
									id="pickup_store_name"
									type="text"
									name="pickup_store_name"
									value={ v.Address.PickupStoreName }
									required
									maxlength="40"
									aria-invalid={ v.Invalid("pickup_store_name") }
									if v.HasErr("pickup_store_name") {
										aria-describedby="pickup_store_name-error"
									}
								/>
								if v.HasErr("pickup_store_name") {
									<p class="ui-error-text" id="pickup_store_name-error">{ v.Err("pickup_store_name") }</p>
								}
								<p class="goen-checkout__hint">
									{ i18n.T(ctx, i18n.KeyPickupHint) }
								</p>
							</div>
						} else {
							@field("postal_code", i18n.T(ctx, i18n.KeyFieldPostalCode), "text", v.Address.PostalCode, v, true)
							@field("city", i18n.T(ctx, i18n.KeyFieldCity), "text", v.Address.City, v, true)
							@field("district", i18n.T(ctx, i18n.KeyFieldDistrict), "text", v.Address.District, v, true)
							<div class="ui-field goen-checkout__wide">
								<label class="ui-label" for="street">{ i18n.T(ctx, i18n.KeyFieldStreet) }</label>
								<input
									class="ui-input"
									id="street"
									type="text"
									name="street"
									value={ v.Address.Street }
									required
									maxlength="200"
									autocomplete="street-address"
									aria-invalid={ v.Invalid("street") }
									if v.HasErr("street") {
										aria-describedby="street-error"
									}
								/>
								if v.HasErr("street") {
									<p class="ui-error-text" id="street-error">{ v.Err("street") }</p>
								}
							</div>
						}
						<div class="ui-field goen-checkout__wide">
							<label class="ui-label" for="note">{ i18n.T(ctx, i18n.KeyFieldNote) }</label>
							<textarea
								class="ui-textarea"
								id="note"
								name="note"
								maxlength="500"
								rows="2"
								aria-invalid={ v.Invalid("note") }
							>{ v.Address.Note }</textarea>
							if v.HasErr("note") {
								<p class="ui-error-text">{ v.Err("note") }</p>
							}
						</div>
					</div>
					<h2 class="goen-checkout__legend">{ i18n.T(ctx, i18n.KeySectionInvoice) }</h2>
					<div class="goen-checkout__invoice">
						for _, c := range v.InvoiceChoices {
							<label class="goen-checkout__ship">
								<input
									class="ui-radio"
									type="radio"
									name="invoice_type"
									value={ c.Value }
									checked?={ v.Invoice.Is(c.Value) }
								/>
								<span class="goen-checkout__shipname">{ c.Label }</span>
							</label>
						}
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="invoice_carrier">{ i18n.T(ctx, i18n.KeyFieldCarrier) }</label>
							<input
								class="ui-input"
								id="invoice_carrier"
								name="invoice_carrier"
								maxlength="8"
								autocomplete="off"
								placeholder="/ABC+123"
								value={ v.Invoice.Carrier }
								if v.HasErr("invoice_carrier") {
									aria-invalid="true"
								}
							/>
							if v.HasErr("invoice_carrier") {
								<p class="ui-error-text">{ v.Err("invoice_carrier") }</p>
							}
						</div>
						<div class="ui-field">
							<label class="ui-label" for="invoice_tax_id">{ i18n.T(ctx, i18n.KeyFieldTaxID) }</label>
							<input
								class="ui-input"
								id="invoice_tax_id"
								name="invoice_tax_id"
								maxlength="8"
								inputmode="numeric"
								autocomplete="off"
								value={ v.Invoice.TaxID }
								if v.HasErr("invoice_tax_id") {
									aria-invalid="true"
								}
							/>
							if v.HasErr("invoice_tax_id") {
								<p class="ui-error-text">{ v.Err("invoice_tax_id") }</p>
							}
						</div>
					</div>
					if v.HasErr("invoice_type") {
						<p class="ui-error-text">{ v.Err("invoice_type") }</p>
					}
				</div>
				<aside class="goen-checkout__summary">
					<h2 class="goen-cart__summarytitle">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
					<ul class="goen-checkout__lines" role="list">
						for _, l := range v.Cart.Lines {
							<li>
								<span>{ l.Name } × { l.QuantityText() }</span>
								<span class="ui-summary__val">{ l.LineTotal() }</span>
							</li>
						}
					</ul>
					<div class="ui-summary">
						<div class="ui-summary__row">
							<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
							<span class="ui-summary__val">{ v.Cart.Subtotal() }</span>
						</div>
						<div class="ui-summary__row">
							<span>{ i18n.T(ctx, i18n.KeyShippingFee) }</span>
							<span class="ui-summary__val">
								if v.ShipsFree() {
									{ i18n.T(ctx, i18n.KeyFreeShipping) }
								} else {
									{ v.ShippingText() }
								}
							</span>
						</div>
						if v.HasSurcharge() {
							// Named on its own line rather than folded into the
							// fee: 「運費 NT$280」 for an order the customer
							// expected to pay NT$80 for reads as a mistake.
							<div class="ui-summary__row">
								<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyZoneSurcharge), v.ZoneName) }</span>
								<span class="ui-summary__val">{ v.Surcharge() }</span>
							</div>
						}
						if v.HasCoupon() && v.CouponDiscountCents > 0 {
							<div class="ui-summary__row">
								<span>{ i18n.T(ctx, i18n.KeyDiscount) }({ v.CouponApplied })</span>
								<span class="ui-summary__val">{ v.CouponDiscount() }</span>
							</div>
						}
						<div class="ui-summary__row ui-summary__row--total">
							<span>{ i18n.T(ctx, i18n.KeyTotal) }</span>
							<span class="ui-summary__val">{ v.Total() }</span>
						</div>
					</div>
					<div class="ui-field goen-checkout__coupon">
						<label class="ui-label" for="coupon">{ i18n.T(ctx, i18n.KeyCouponCode) }</label>
						<input
							class="ui-input"
							id="coupon"
							name="coupon"
							maxlength="32"
							autocomplete="off"
							placeholder={ i18n.T(ctx, i18n.KeyCouponPlaceholder) }
							value={ v.CouponCode }
							if v.HasErr("coupon") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("coupon") {
							<p class="ui-error-text">{ v.Err("coupon") }</p>
						}
						if v.HasCoupon() {
							<p class="goen-checkout__note">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCouponApplied), v.CouponApplied) }</p>
						}
					</div>
					<button class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block goen-checkout__submit" type="submit">
						{ i18n.T(ctx, i18n.KeyPlaceOrder) }
					</button>
					<p class="goen-checkout__note">
						{ i18n.T(ctx, i18n.KeyCheckoutSubmitNote) }
					</p>
				</aside>
			</form>
		</div>
	}
}

// field is one labelled input, with its error wired to aria-describedby so a
// screen reader hears the reason rather than only that something is wrong.
templ field(name, label, kind, value string, v *CheckoutView, required bool) {
	<div class="ui-field">
		<label class="ui-label" for={ name }>{ label }</label>
		<input
			class="ui-input"
			id={ name }
			type={ kind }
			name={ name }
			value={ value }
			required?={ required }
			aria-invalid={ v.Invalid(name) }
			if v.HasErr(name) {
				aria-describedby={ name + "-error" }
			}
		/>
		if v.HasErr(name) {
			<p class="ui-error-text" id={ name + "-error" }>{ v.Err(name) }</p>
		}
	</div>
}

// Order renders the confirmation page.
templ Order(p layouts.Page, v *OrderView) {
	@layouts.Base(p) {
		<div class="goen-order">
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyOrderPlaced) }</p>
					<h1 class="ui-page-head__title">{ v.Number }</h1>
					<p class="ui-page-head__sub">
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderPlacedAt), v.PlacedAt) }
						if v.Email != "" {
							· { fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderEmailNotice), v.Email) }
						}
					</p>
				</div>
			</div>
			if v.Cancelled {
				<p class="ui-alert ui-alert--success goen-order__status" role="status">
					{ i18n.T(ctx, i18n.KeyOrderCancelled) }
				</p>
			}
			if v.AwaitingPayment() {
				<p class="ui-alert ui-alert--info goen-order__status" role="status">
					{ i18n.T(ctx, i18n.KeyOrderUnpaid) }
					<a href={ templ.SafeURL("/orders/" + v.Number + "/pay") }>{ i18n.T(ctx, i18n.KeyPay) }</a>
				</p>
			}
			<form class="goen-order__cancel" method="post" action={ templ.SafeURL("/orders/" + v.Number + "/reorder") }>
				<button class="ui-btn ui-btn--secondary" type="submit">{ i18n.T(ctx, i18n.KeyOrderReorder) }</button>
				<span class="ui-cart-line__meta">{ i18n.T(ctx, i18n.KeyOrderReorderNote) }</span>
			</form>
			if v.CanCancel() {
				// A plain POST. The button is absent rather than present and
				// refused once the order is paid or being picked — a control
				// that can only say no is worse than no control.
				<form class="goen-order__cancel" method="post" action={ templ.SafeURL("/orders/" + v.Number + "/cancel") }>
					<button class="ui-btn ui-btn--ghost" type="submit">{ i18n.T(ctx, i18n.KeyOrderCancel) }</button>
					<span class="ui-cart-line__meta">{ i18n.T(ctx, i18n.KeyOrderCancelNote) }</span>
				</form>
			}
			if len(v.Shipments) > 0 {
				<section class="goen-order__tracking" aria-labelledby="tracking-heading">
					<h2 id="tracking-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderTracking) }</h2>
					<ul class="goen-order__shipments" role="list">
						for _, sh := range v.Shipments {
							<li class="goen-order__shipment">
								<span class="goen-order__carrier">{ sh.Carrier }</span>
								<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderTrackingNo), sh.Tracking) }</span>
								if sh.Delivered() {
									<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderDeliveredAt), sh.DeliveredAt) }</span>
								} else {
									<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderShippedAt), sh.ShippedAt) }</span>
								}
							</li>
						}
					</ul>
				</section>
			}
			if len(v.Timeline) > 0 {
				<section class="goen-order__history" aria-labelledby="history-heading">
					<h2 id="history-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderHistory) }</h2>
					<ol class="goen-order__events">
						for _, e := range v.Timeline {
							<li class="goen-order__event">
								<span class="goen-order__eventkind">{ i18n.T(ctx, e.LabelKey()) }</span>
								<span class="ui-cart-line__meta">{ e.At }</span>
								if e.Note != "" {
									<span class="ui-cart-line__meta">{ e.Note }</span>
								}
							</li>
						}
					</ol>
				</section>
			}
			if v.DeliveryTo != "" {
				<section class="goen-order__history" aria-labelledby="delivery-heading">
					<h2 id="delivery-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderDeliveryTo) }</h2>
					<p class="goen-order__event">
						<span class="goen-order__eventkind">{ v.ShippingName }</span>
						<span class="ui-cart-line__meta">{ v.DeliveryTo }</span>
					</p>
				</section>
			}
			<div class="goen-order__layout">
				<ul class="goen-order__lines" role="list">
					for _, l := range v.Lines {
						<li class="goen-order__line">
							<div>
								<p class="goen-order__name">{ l.Name }</p>
								if l.Label != "" {
									<span class="ui-cart-line__meta">{ l.Label }</span>
								}
								<span class="ui-cart-line__meta">{ l.SKU } · { l.UnitPrice() } × { l.QuantityText() }</span>
							</div>
							<span class="ui-cart-line__price">{ l.LineTotal() }</span>
						</li>
					}
				</ul>
				<aside class="goen-order__summary">
					<div class="ui-summary">
						<div class="ui-summary__row">
							<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
							<span class="ui-summary__val">{ v.Subtotal() }</span>
						</div>
						<div class="ui-summary__row">
							<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderShippingFee), v.ShippingName) }</span>
							<span class="ui-summary__val">{ v.Shipping(ctx) }</span>
						</div>
						if v.Discounted() {
							<div class="ui-summary__row">
								<span>
									{ i18n.T(ctx, i18n.KeyDiscount) }
									if v.DiscountReason != "" {
										({ v.DiscountReason })
									}
								</span>
								<span class="ui-summary__val">{ v.Discount() }</span>
							</div>
						}
						<div class="ui-summary__row ui-summary__row--total">
							<span>{ i18n.T(ctx, i18n.KeyOrderGrandTotal) }</span>
							<span class="ui-summary__val">{ v.Total() }</span>
						</div>
					</div>
					if v.CanRequestReturn() {
						<a class="ui-btn ui-btn--secondary ui-btn--block" href={ templ.SafeURL("/orders/" + v.Number + "/return") }>
							{ i18n.T(ctx, i18n.KeyOrderReturn) }
						</a>
					}
					<a class="ui-btn ui-btn--secondary ui-btn--block" href="/">{ i18n.T(ctx, i18n.KeyContinue) }</a>
				</aside>
			</div>
		</div>
	}
}
