package pages

import (
	"fmt"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/fieldrule"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Cart(p layouts.Page, v CartView) {
	@layouts.Base(p) {
		<div class="goen-cart">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCart) }</h1>
				if !v.Empty() {
					<div id="cart-count" class="goen-cart__facts" role="status">
						if notice := v.StockNotice(ctx); notice != "" {
							<p id="cart-alert" class="goen-cart__alert">{ notice }</p>
						}
						@components.StatLine(v.Facts(ctx), components.StatLinePlain)
					</div>
				}
			</div>
			// Always present, so an update that changes only the notice has somewhere to put it.
			<div id="cart-notices" class="goen-cart__notices">
				if v.HasNotice() {
					if v.ContinueURL != "" {
						<div class="ui-alert ui-alert--info" id="cart-adjustment" role="status">
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" fill-rule="evenodd"></path>
							</svg>
							<div class="goen-cart__adjustment-content">
								<p class="goen-cart__adjustment-message">{ v.Notice }</p>
								<p class="goen-cart__adjustment-action">
									<a href={ templ.URL(v.ContinueURL) }>
										{ i18n.T(ctx, i18n.KeyCartAdjustmentContinue) }
										<span aria-hidden="true">→</span>
									</a>
								</p>
							</div>
						</div>
					} else {
						@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "cart-adjustment"}) {
							{ v.Notice }
						}
					}
				}
				if v.FromReorder() {
					@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
						{ v.ReorderText(ctx) }
					}
				}
			</div>
			if v.Empty() {
				<div class="goen-empty">
					@emptyArt(assets.EmptyCartImage)
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyEmptyCart) }</p>
					<p class="goen-empty__text">{ i18n.T(ctx, i18n.KeyCartEmptyDesc) }</p>
					@components.ButtonLink(components.ButtonProps{
						ButtonStyle: components.ButtonStylePrimary,
						Size:        components.SizeLarge,
					}, "/") {
						{ i18n.T(ctx, i18n.KeyCartEmptyLink) }
					}
				</div>
			} else {
				<div class="goen-cart__layout">
					<ul class="goen-cart__lines" role="list">
						for _, l := range v.Lines {
							@cartLine(l)
						}
					</ul>
					@components.Card(components.CardProps{
						Class: "goen-cart__summary",
						Attrs: templ.Attributes{"id": "cart-summary", "aria-labelledby": "summary-heading"},
					}) {
						<h2 id="summary-heading" class="goen-summary__title">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
						<dl class="goen-summary">
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeyShippingFee) }</dt>
								<dd class="goen-summary__value">
									if v.FreeDelivery.Kind == FreeDeliveryReached {
										{ v.FreeDelivery.Word(ctx) }
									} else {
										{ i18n.T(ctx, i18n.KeyShippingLater) }
									}
								</dd>
							</div>
							<div class="goen-summary__row goen-summary__row--total">
								<dt>{ i18n.T(ctx, i18n.KeySubtotal) }</dt>
								<dd class="goen-summary__value">{ v.Subtotal() }</dd>
							</div>
						</dl>
						if v.MixedTaxTypes {
							@components.Notice(components.NoticeProps{Intent: components.IntentWarn}) {
								{ i18n.T(ctx, i18n.KeyCartMixedTaxTypes) }
							}
						}
						if v.NoDelivery {
							@components.Notice(components.NoticeProps{Intent: components.IntentWarn, ID: "cart-delivery-unavailable"}) {
								{ i18n.T(ctx, i18n.KeyShippingUnavailable) }
							}
						}
						<div class="goen-summary__actions">
							if v.CanCheckout() && !v.NoDelivery {
								@components.ButtonLink(components.ButtonProps{
									ButtonStyle: components.ButtonStylePrimary,
									Size:        components.SizeLarge,
									Block:       true,
								}, "/checkout") {
									{ i18n.T(ctx, i18n.KeyCheckout) }
								}
							} else {
								// Present and plainly unavailable, not absent: a shopper who cannot check out
								// still needs the control, and it points at the sentence under the title that says why.
								<span
									class="goen-btn goen-btn--primary goen-btn--lg goen-btn--block"
									role="link"
									aria-disabled="true"
									if v.NoDelivery && v.StockNotice(ctx) != "" {
										aria-describedby="cart-alert cart-delivery-unavailable"
									}
									else
									if v.NoDelivery {
										aria-describedby="cart-delivery-unavailable"
									}
									else
									if v.StockNotice(ctx) != "" {
										aria-describedby="cart-alert"
									}
								>
									{ i18n.T(ctx, i18n.KeyCheckout) }
								</span>
							}
							@components.ButtonLink(components.ButtonProps{
								ButtonStyle: components.ButtonStyleGhost,
								Block:       true,
							}, "/") {
								{ i18n.T(ctx, i18n.KeyContinue) }
							}
						</div>
						<p class="goen-cart__hold">{ i18n.Count(ctx, i18n.KeyCartHold, holdMinutes, HoldMinutesText()) }</p>
					}
				</div>
			}
		</div>
	}
}

templ cartLine(l CartLine) {
	<li id={ "line-" + l.VariantID } class={ "goen-line", "goen-line--cart", templ.KV("goen-line--out", l.Unavailable) }>
		<a class="goen-line__thumb" href={ templ.URL("/p/" + l.Slug) }>
			if l.HasImage() {
				// Width and height on the element, not only in the sheet: the row's height is
				// reserved before the image arrives, so nothing below jumps.
				<img
					class="goen-line__img"
					src={ l.ImageURL }
					srcset={ l.ImageSrcset }
					sizes="96px"
					alt={ l.ImageAlt }
					width="96"
					height="96"
					loading="lazy"
					decoding="async"
				/>
			} else {
				<span class="goen-line__ph" aria-hidden="true"></span>
			}
		</a>
		<div class="goen-line__body" id={ "line-body-" + l.VariantID }>
			if l.Brand != "" {
				<span class="goen-line__brand">{ l.Brand }</span>
			}
			<a class="goen-line__name" href={ templ.URL("/p/" + l.Slug) }>{ l.Name }</a>
			if l.Label != "" {
				<span class="goen-line__meta">{ l.Label }</span>
			}
			<span class="goen-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyUnitPrice), l.UnitPrice()) }</span>
			if l.TaxExempt {
				@components.Badge(components.BadgeProps{}) {
					{ i18n.T(ctx, i18n.KeyInvoiceExempt) }
				}
			}
			if l.Unavailable {
				@components.Badge(components.BadgeProps{Intent: components.IntentDanger}) {
					{ i18n.T(ctx, i18n.KeySoldOut) }
				}
			} else if l.Short {
				@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOnlyLeft), l.AvailableText()) }
				}
			}
		</div>
		<div class="goen-line__money" id={ "line-money-" + l.VariantID }>
			if !l.Unavailable {
				<span class="goen-line__total">{ l.LineTotal() }</span>
			}
			if l.Short {
				<span class="goen-line__meta">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPricedFor), l.PricedQuantityText()) }
				</span>
			}
		</div>
		<form
			class="goen-line__controls"
			method="post"
			action="/cart/items/update"
			data-autosubmit
			hx-post="/cart/items/update"
			hx-swap="none"
			hx-select-oob={ cartLineSwap(l.VariantID) }
			hx-sync="closest .goen-cart__lines:queue all"
		>
			<input type="hidden" name="variant" value={ l.VariantID }/>
			// A sold-out line has nothing to adjust, so removing it is all it offers.
			if !l.Unavailable {
				<label class="goen-sr-only" for={ "qty-" + l.VariantID }>{ i18n.T(ctx, i18n.KeyQuantity) }</label>
				@components.Stepper(components.StepperProps{
					ID: "qty-" + l.VariantID, Name: "quantity",
					Value: l.QuantityText(),
					// Zero removes a line with no script, so the floor is zero here and one on the product page.
					Min: "0", Max: l.MaxQuantity(),
					DecreaseLabel: i18n.T(ctx, i18n.KeyQuantityDecrease),
					IncreaseLabel: i18n.T(ctx, i18n.KeyQuantityIncrease),
				})
				// Shown only where scripting is off: with it on, changing the quantity submits the form.
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Size:        components.SizeSmall,
					Class:       "goen-line__update",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyUpdate) }
				}
			}
			@components.Button(components.ButtonProps{
				ButtonStyle: components.ButtonStyleGhost,
				Size:        components.SizeSmall,
				Class:       "goen-line__remove",
				// Not dimmed while a quantity request is pending: the request is about the number.
				Attrs: templ.Attributes{"name": "remove", "value": "1", "data-feedback-skip": true, "formnovalidate": true},
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyRemove) }
			}
		</form>
	</li>
}

templ Checkout(p layouts.Page, v *CheckoutView) {
	@layouts.Base(p) {
		<div class="goen-checkout">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCheckoutTitle) }</h1>
				<p class="goen-pagehead__sub">{ i18n.T(ctx, i18n.KeyCheckoutSub) }</p>
			</div>
			<div id="checkout-region">
				<form
					class="goen-checkout__layout"
					id="checkout-form"
					method="post"
					action="/checkout"
					novalidate
					data-focus-refused?={ v.AnyErrors() }
				>
					// The form's DEFAULT button: HTML makes the first submit button in tree order the
					// one Enter activates, and the chooser's 更新 buttons sit above the real one. Inert
					// to keyboard and screen reader; it carries the same words as the visible button
					// so the two cannot drift.
					<button
						class="goen-sr-only"
						type="submit"
						tabindex="-1"
						aria-hidden="true"
						disabled?={ !v.HasShipping() }
					>{ i18n.T(ctx, v.PlaceOrderKey()) }</button>
					<input type="hidden" name="idempotency" value={ v.IdempotencyKey }/>
					// One fixed-size identity for the lines, prices, delivery, coupon and credit spend.
					// The server rebuilds it while holding the database locks; it is a witness, not pricing input.
					<input type="hidden" id="checkout-quote" name="checkout_quote" value={ v.QuoteID }/>
					<div class="goen-checkout__main">
						if v.AnyErrors() {
							@components.Notice(components.NoticeProps{
								Intent: components.IntentDanger,
								Class:  "ui-alert--error",
							}) {
								if v.OnlyCouponRefused() {
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCheckoutCouponRefused), v.Err("coupon")) }
								} else {
									{ i18n.T(ctx, i18n.KeyCheckoutHasErrors) }
								}
							}
						}
						@components.Card(components.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "shipping"},
						}) {
							<h2 class="goen-checkout__heading" id="shipping-heading">{ i18n.T(ctx, i18n.KeySectionShipping) }</h2>
							// Unavailable delivery refuses the cart, so it has no invalid control.
							if !v.HasShipping() {
								<p id="shipping-unavailable" role="alert">{ i18n.T(ctx, i18n.KeyShippingUnavailable) }</p>
								<p><a href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a> · <a href="/contact">{ i18n.T(ctx, i18n.KeyContact) }</a></p>
							} else {
								// A radio inside the form, not a link: the choice decides which fields the form
								// asks for, so changing it re-renders, and a link would drop what was typed.
								//
								// The refusal is announced on the GROUP, not an option: a form refuses the choice,
								// not one of the things on offer.
								<div
									class="goen-checkout__choices"
									{ checkoutChoiceSwap("shipping")... }
									role="radiogroup"
									aria-labelledby="shipping-heading"
									aria-invalid={ v.Invalid("shipping") }
									if v.HasErr("shipping") {
										aria-describedby="shipping-error"
									}
								>
									for _, c := range v.Shipping {
										<label class="goen-checkout__ship">
											<input
												class="goen-sr-only"
												id={ "shipping-" + c.VersionID }
												type="radio"
												name="shipping"
												value={ c.VersionID }
												checked?={ c.VersionID == v.Chosen }
											/>
											<span class="goen-checkout__shipname">
												{ c.Name }
												if c.Carrier != "" {
													<span class="goen-checkout__shipnote">{ c.Carrier }</span>
												}
											</span>
											<span class="goen-checkout__shipfee">
												if c.Free {
													{ i18n.T(ctx, i18n.KeyFreeShipping) }
												} else {
													{ c.Fee() }
												}
											</span>
										</label>
									}
								</div>
								@applyChoice("shipping")
								if v.HasErr("shipping") {
									<p class="ui-error-text" id="shipping-error">{ v.Err("shipping") }</p>
								}
							}
							if v.Repriced != "" {
								@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
									{ v.Repriced }
								}
							}
							if v.CreditChanged != "" {
								@components.Notice(components.NoticeProps{
									Intent: components.IntentAccent,
									Class:  "ui-alert--info",
								}) {
									{ v.CreditChanged }
								}
							}
						}
						@components.Card(components.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "address"},
						}) {
							<h2 class="goen-checkout__heading" id="recipient-heading">{ i18n.T(ctx, i18n.KeySectionRecipient) }</h2>
							if v.OffersTheProfile() {
								// Fills the name and phone from the account, all it knows of a recipient. With
								// scripting the page's script does it from the data below; without, the button
								// applies it on the server. Neither overwrites what has been typed.
								<label class="goen-check" id="recipient">
									<input
										class="goen-check__box"
										type="checkbox"
										name="recipient_me"
										value="1"
										checked?={ v.RecipientMe }
										data-recipient-me
										data-name={ v.Profile.Name }
										data-phone={ v.Profile.Phone }
										data-email={ v.Profile.Email }
									/>
									<span>{ i18n.T(ctx, i18n.KeyRecipientIsMe) }</span>
								</label>
								<input type="hidden" name="recipient_prev_name" value={ v.RecipientPrevName }/>
								<input type="hidden" name="recipient_prev_phone" value={ v.RecipientPrevPhone }/>
								@applyChoice("recipient")
							}
							if v.OffersTheAddressBook() {
								// Choosing applies the address on the server, which also re-quotes delivery for
								// its postal code.
								<div class="goen-field">
									@components.Label(components.LabelProps{For: "address-book"}) {
										{ i18n.T(ctx, i18n.KeyChooseSavedAddress) }
									}
									<select
										class="goen-checkout__select"
										id="address-book"
										name="address"
										{ checkoutChoiceSwap("address")... }
										aria-invalid={ v.Invalid("address") }
										if v.HasErr("address") {
											aria-describedby="address-error"
										}
									>
										for _, a := range v.SavedAddresses {
											<option value={ a.ID } selected?={ a.ID == v.ChosenAddress }>
												{ a.DisplayLabel(ctx) } — { a.Line() }
											</option>
										}
										<option value={ OtherAddress } selected?={ v.ChosenAddress == OtherAddress }>
											{ i18n.T(ctx, i18n.KeyOtherAddress) }
										</option>
									</select>
								</div>
								@applyChoice("address")
								if v.HasErr("address") {
									<p class="ui-error-text" id="address-error">{ v.Err("address") }</p>
								}
							}
							<div class="goen-checkout__fields">
								@field("email", i18n.T(ctx, i18n.KeyFieldEmail), "email", v.Address.Email, v)
								@field("name", i18n.T(ctx, i18n.KeyFieldName), "text", v.Address.Name, v)
								@field("phone", i18n.T(ctx, i18n.KeyFieldPhone), "tel", v.Address.Phone, v)
								if v.ToPickupPoint() {
									// The chain is what the shopper chooses; the store comes from the carrier's own
									// picker, because nobody types a store number correctly.
									//
									// The chooser re-renders the form: the chain decides which map the button below
									// opens, and that form is built on the server.
									<div class="goen-field goen-checkout__wide" id="pickup_chain">
										<p class="goen-label" id="pickup_chain-label">{ i18n.T(ctx, i18n.KeyFieldPickupChain) }</p>
										if v.PickupRefused {
											// The message says a store could not be confirmed and repeats NONE of what
											// arrived: that text came from a cross-site post. It sits here because the
											// next step is the choice below: with no chain chosen there is no map button.
											@components.Notice(components.NoticeProps{
												Intent: components.IntentDanger,
												Class:  "ui-alert--error",
											}) {
												{ i18n.T(ctx, i18n.KeyPickupStoreUnconfirmed) }
											}
										}
										<div
											class="goen-checkout__choices"
											{ checkoutChoiceSwap("pickup_chain")... }
											role="radiogroup"
											aria-labelledby="pickup_chain-label"
											aria-invalid={ v.Invalid("pickup_chain") }
											if v.HasErr("pickup_chain") {
												aria-describedby="pickup_chain-error"
											}
										>
											for _, b := range v.PickupChains {
												<label class="goen-checkout__ship">
													<input
														class="goen-sr-only"
														id={ "pickup_chain-" + string(b.Value) }
														type="radio"
														name="pickup_chain"
														value={ string(b.Value) }
														checked?={ b.Value == v.Address.PickupChain }
													/>
													<span class="goen-checkout__shipname">{ b.Label }</span>
												</label>
											}
										</div>
										@applyChoice("pickup_chain")
										if v.HasErr("pickup_chain") {
											<p class="ui-error-text" id="pickup_chain-error">{ v.Err("pickup_chain") }</p>
										}
										@pickupStore(v)
									</div>
								} else {
									@field("postal_code", i18n.T(ctx, i18n.KeyFieldPostalCode), "text", v.Address.PostalCode, v)
									@field("city", i18n.T(ctx, i18n.KeyFieldCity), "text", v.Address.City, v)
									@field("district", i18n.T(ctx, i18n.KeyFieldDistrict), "text", v.Address.District, v)
									<div class="goen-field goen-checkout__wide">
										@components.Label(components.LabelProps{For: "street"}) {
											{ i18n.T(ctx, i18n.KeyFieldStreet) }
										}
										<input
											class="goen-input"
											id="street"
											type="text"
											name="street"
											value={ v.Address.Street }
											required
											maxlength="200"
											autocomplete="street-address"
											aria-invalid={ v.Invalid("street") }
											if v.HasErr("street") {
												aria-describedby="street-error"
											}
										/>
										if v.HasErr("street") {
											<p class="ui-error-text" id="street-error">{ v.Err("street") }</p>
										}
									</div>
								}
								<div class="goen-field goen-checkout__wide">
									@components.Label(components.LabelProps{For: "note"}) {
										{ i18n.T(ctx, i18n.KeyFieldNote) }
									}
									<textarea
										class="goen-input goen-input--area"
										id="note"
										name="note"
										autocomplete="off"
										maxlength="500"
										rows="2"
										aria-invalid={ v.Invalid("note") }
										if v.HasErr("note") {
											aria-describedby="note-error"
										}
									>{ v.Address.Note }</textarea>
									if v.HasErr("note") {
										<p class="ui-error-text" id="note-error">{ v.Err("note") }</p>
									}
								</div>
							</div>
						}
						@components.Card(components.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "invoice"},
						}) {
							<h2 class="goen-checkout__heading" id="invoice-heading">{ i18n.T(ctx, i18n.KeySectionInvoice) }</h2>
							<div
								class="goen-checkout__choices"
								{ checkoutChoiceSwap("invoice")... }
								role="radiogroup"
								aria-labelledby="invoice-heading"
								aria-invalid={ v.Invalid("invoice_type") }
								if v.HasErr("invoice_type") {
									aria-describedby="invoice_type-error"
								}
							>
								for _, c := range v.InvoiceChoices {
									<label class="goen-checkout__ship">
										<input
											class="goen-sr-only"
											id={ "invoice_type-" + string(c.Value) }
											type="radio"
											name="invoice_type"
											value={ string(c.Value) }
											checked?={ v.Invoice.Is(c.Value) }
										/>
										<span class="goen-checkout__shipname">{ c.Label }</span>
									</label>
								}
							</div>
							@applyChoice("invoice")
							<div class="goen-checkout__fields">
								if v.Invoice.NeedsMobileBarcode() {
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "invoice_carrier"}) {
											{ i18n.T(ctx, i18n.KeyFieldMobileBarcode) }
										}
										<input
											class="goen-input"
											{ fieldrule.MobileBarcode.Attrs(ctx, nil)... }
											id="invoice_carrier"
											name="invoice_carrier"
											maxlength="8"
											autocomplete="off"
											placeholder="/ABC+123"
											value={ v.Invoice.MobileBarcode }
											aria-invalid={ v.Invalid("invoice_carrier") }
											if v.HasErr("invoice_carrier") {
												aria-describedby="invoice_carrier-error"
											}
										/>
										if v.HasErr("invoice_carrier") {
											<p class="ui-error-text" id="invoice_carrier-error">{ v.Err("invoice_carrier") }</p>
										}
									</div>
								}
								if v.Invoice.NeedsDonationCode() {
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "invoice_donation_code"}) {
											{ i18n.T(ctx, i18n.KeyFieldDonationCode) }
										}
										<input
											class="goen-input"
											{ fieldrule.DonationCode.Attrs(ctx, nil)... }
											id="invoice_donation_code"
											name="invoice_donation_code"
											type="text"
											inputmode="numeric"
											maxlength="7"
											autocomplete="off"
											value={ v.Invoice.DonationCode }
											aria-invalid={ v.Invalid("invoice_donation_code") }
											if v.HasErr("invoice_donation_code") {
												aria-describedby="invoice_donation_code-help invoice_donation_code-error"
											} else {
												aria-describedby="invoice_donation_code-help"
											}
										/>
										<p class="goen-checkout__hint" id="invoice_donation_code-help">{ i18n.T(ctx, i18n.KeyDonationCodeHelp) }</p>
										if v.HasErr("invoice_donation_code") {
											<p class="ui-error-text" id="invoice_donation_code-error">{ v.Err("invoice_donation_code") }</p>
										}
									</div>
								}
								if v.Invoice.NeedsTaxID() {
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "invoice_company_name"}) {
											{ i18n.T(ctx, i18n.KeyFieldCompanyName) }
										}
										<input
											class="goen-input"
											id="invoice_company_name"
											name="invoice_company_name"
											maxlength="60"
											autocomplete="organization"
											value={ v.Invoice.CompanyName }
											aria-invalid={ v.Invalid("invoice_company_name") }
											if v.HasErr("invoice_company_name") {
												aria-describedby="invoice_company_name-error"
											}
										/>
										if v.HasErr("invoice_company_name") {
											<p class="ui-error-text" id="invoice_company_name-error">{ v.Err("invoice_company_name") }</p>
										}
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "invoice_tax_id"}) {
											{ i18n.T(ctx, i18n.KeyFieldTaxID) }
										}
										<input
											class="goen-input"
											{ fieldrule.TaxID.Attrs(ctx, nil)... }
											id="invoice_tax_id"
											name="invoice_tax_id"
											maxlength="8"
											inputmode="numeric"
											autocomplete="off"
											value={ v.Invoice.TaxID }
											aria-invalid={ v.Invalid("invoice_tax_id") }
											if v.HasErr("invoice_tax_id") {
												aria-describedby="invoice_tax_id-error"
											}
										/>
										if v.HasErr("invoice_tax_id") {
											<p class="ui-error-text" id="invoice_tax_id-error">{ v.Err("invoice_tax_id") }</p>
										}
									</div>
									<p class="goen-checkout__note">{ i18n.T(ctx, i18n.KeyInvoiceCompanyStored) }</p>
								}
							</div>
							if v.HasErr("invoice_type") {
								<p class="ui-error-text" id="invoice_type-error">{ v.Err("invoice_type") }</p>
							}
						}
					</div>
					@components.Card(components.CardProps{
						Class: "goen-checkout__summary",
						Attrs: templ.Attributes{"id": "summary", "aria-labelledby": "summary-heading"},
					}) {
						<h2 id="summary-heading" class="goen-summary__title">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
						<ul class="goen-checkout__lines" role="list">
							for _, l := range v.Cart.Lines {
								<li>
									<span>
										{ l.Name } × { l.QuantityText() }
										if l.Label != "" {
											<span class="goen-line__meta">{ l.Label }</span>
										}
									</span>
									<span class="goen-summary__value">{ l.LineTotal() }</span>
								</li>
							}
						</ul>
						<dl class="goen-summary" id="summary-totals">
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeySubtotal) }</dt>
								<dd class="goen-summary__value">{ v.Cart.Subtotal() }</dd>
							</div>
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeyShippingFee) }</dt>
								<dd class="goen-summary__value">
									if !v.HasShipping() {
										{ i18n.T(ctx, i18n.KeyShippingUnavailableShort) }
									} else if v.ShipsFree() {
										{ i18n.T(ctx, i18n.KeyFreeShipping) }
									} else {
										{ v.ShippingText() }
									}
								</dd>
							</div>
							if v.HasSurcharge() {
								<div class="goen-summary__row">
									<dt>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyZoneSurcharge), v.ZoneName) }</dt>
									<dd class="goen-summary__value">{ v.Surcharge() }</dd>
								</div>
							}
							if v.HasCoupon() && v.CouponDiscountCents > 0 {
								<div class="goen-summary__row">
									<dt>{ DiscountLabel(ctx, v.CouponApplied) }</dt>
									<dd class="goen-summary__value">{ v.CouponDiscount() }</dd>
								</div>
							}
							if v.UsesCredit() {
								<div class="goen-summary__row">
									<dt>{ i18n.T(ctx, i18n.KeyStoreCredit) }</dt>
									<dd class="goen-summary__value">{ v.Credit() }</dd>
								</div>
							}
							<div class="goen-summary__row goen-summary__row--total">
								<dt>{ i18n.T(ctx, i18n.KeyTotal) }</dt>
								<dd class="goen-summary__value">{ v.Total() }</dd>
							</div>
						</dl>
						<div class="goen-field" id="coupon-field">
							@components.Label(components.LabelProps{For: "coupon"}) {
								{ i18n.T(ctx, i18n.KeyCouponCode) }
							}
							<div class="goen-checkout__couponrow">
								<input
									class="goen-input"
									id="coupon"
									name="coupon"
									maxlength="32"
									autocomplete="off"
									placeholder={ i18n.T(ctx, i18n.KeyCouponPlaceholder) }
									value={ v.CouponCode }
									aria-invalid={ v.Invalid("coupon") }
									if v.HasErr("coupon") {
										aria-describedby="coupon-error"
									}
								/>
								@components.Button(components.ButtonProps{
									ButtonStyle: components.ButtonStyleOutline,
									Attrs:       couponButtonAttrs(ctx),
								}, "submit") {
									{ i18n.T(ctx, i18n.KeyApplyCoupon) }
								}
							</div>
							<div id="coupon-message" aria-live="polite">
								if v.HasErr("coupon") {
									<p class="ui-error-text" id="coupon-error">{ v.Err("coupon") }</p>
								}
								if v.HasCoupon() {
									<p class="goen-checkout__note">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCouponApplied), v.CouponApplied) }</p>
								}
							</div>
						</div>
						<p class="goen-checkout__note">
							{ v.PlacementNote(ctx) }
						</p>
						@components.Button(components.ButtonProps{
							ButtonStyle: components.ButtonStylePrimary,
							Size:        components.SizeLarge,
							Block:       true,
							Attrs:       templ.Attributes{"disabled": !v.HasShipping()},
						}, "submit") {
							{ i18n.T(ctx, v.PlaceOrderKey()) }
						}
					}
				</form>
			</div>
		</div>
	}
}

// The summary is a SECURITY CONTROL, not decoration. The map's callback carries no
// signature and the map is run by the convenience-store chain, so a reported store
// cannot be checked by any means goen has. The shopper reading the name AND the
// address before paying is the only check. Do not reduce it to the name.
templ pickupStore(v *CheckoutView) {
	if v.OffersTheStoreMap() || v.HasPickupStore() {
		<div class="goen-pickup">
			if v.HasPickupStore() {
				// Carried back so the order can be placed from this page. The ADDRESS is not among
				// them: it is read from the URL for the summary above, never posted, never stored.
				<input type="hidden" name="pickup_store_code" value={ v.Address.PickupStoreCode }/>
				<input type="hidden" name="pickup_store_name" value={ v.Address.PickupStoreName }/>
				<input type="hidden" name="pickup_store_chain" value={ string(v.Address.PickupChain) }/>
				<input type="hidden" name="pickup_n" value={ v.PickupNonce }/>
				<p class="goen-pickup__name">{ v.Address.PickupStoreName } ({ v.Address.PickupStoreCode })</p>
				if v.PickupStoreAddr != "" {
					<p class="goen-pickup__addr">{ v.PickupStoreAddr }</p>
				}
			}
			if v.HasErr("pickup_store") {
				<p class="ui-error-text" id="pickup_store-error">{ v.Err("pickup_store") }</p>
			}
			if v.OffersTheStoreMap() {
				// A submit button of the checkout form aimed at goen's own start route by
				// formaction: the server keeps what was typed, then opens the carrier's map. It has
				// no name or value, and the route is local, so what was typed never goes to a third party.
				//
				// It is also the control a refusal belongs to: nobody types a store.
				{{ storeAttrs := checkoutStoreButtonAttrs(v.Invalid("pickup_store"), v.HasErr("pickup_store")) }}
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Attrs:       storeAttrs,
				}, "submit") {
					if v.HasPickupStore() {
						{ i18n.T(ctx, i18n.KeyPickupChangeStore) }
					} else {
						{ i18n.T(ctx, i18n.KeyPickupChooseStore) }
					}
				}
			}
		</div>
	}
}

// A submit button, not a link: the form carries everything typed and a link only
// the choice. It is the path without scripting; the stylesheet hides it where the
// change itself applies the choice. The fragment opens the answer at this section's
// heading, not the top of a form the customer scrolled past.
templ applyChoice(which string) {
	<div class="goen-checkout__apply">
		@components.Button(components.ButtonProps{
			ButtonStyle: components.ButtonStyleOutline,
			Size:        components.SizeSmall,
			Attrs: templ.Attributes{
				"formaction":     "/checkout#" + which,
				"name":           "update",
				"value":          which,
				"formnovalidate": true,
			},
		}, "submit") {
			{ i18n.T(ctx, i18n.KeyApplyChoice) }
		}
	</div>
}

templ field(name, label, kind, value string, v *CheckoutView) {
	{{ hints := checkoutHintsFor(name) }}
	<div class="goen-field">
		@components.Label(components.LabelProps{For: name}) {
			{ label }
		}
		<input
			class="goen-input"
			id={ name }
			type={ kind }
			name={ name }
			value={ value }
			required
			autocomplete={ hints.Autocomplete }
			if hints.InputMode != "" {
				inputmode={ hints.InputMode }
			}
			if hints.AutoCapitalize != "" {
				autocapitalize={ hints.AutoCapitalize }
			}
			if hints.SpellCheck != "" {
				spellcheck={ hints.SpellCheck }
			}
			if hints.Pattern != "" {
				pattern={ hints.Pattern }
				if !v.HasErr(name) {
					data-checkout-constraint
				}
			}
			if hints.Rule != nil {
				{ hints.Rule.Attrs(ctx, nil)... }
				if !v.HasErr(name) {
					data-checkout-constraint
				}
			}
			if v.HasErr(name) {
				aria-invalid="true"
			}
			if v.HasErr(name) || hints.Constrained() {
				aria-describedby={ name + "-error" }
			}
		/>
		if v.HasErr(name) {
			<p class="ui-error-text" id={ name + "-error" }>{ v.Err(name) }</p>
		} else if hints.Constrained() {
			<p class="ui-error-text goen-field__constraint" id={ name + "-error" }>{ hints.ConstraintText(ctx) }</p>
		}
	</div>
}

templ Order(p layouts.Page, v *OrderView) {
	@layouts.Base(p) {
		<div class="goen-order">
			<div class="goen-order__placed">
				<div class="goen-pagehead">
					<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, v.StateKey()) }</p>
					<h1 class="goen-pagehead__title">{ v.Number }</h1>
					if v.Email != "" {
						<p class="goen-pagehead__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderEmailNotice), v.Email) }</p>
					}
					if note := v.ParcelsNote(ctx); note != "" {
						<p class="goen-pagehead__sub">{ note }</p>
					}
					@components.StatLine(v.Facts(ctx), components.StatLinePlain)
				</div>
			</div>
			if v.Cancelled {
				@components.Notice(components.NoticeProps{
					Intent: components.IntentNeutral,
					ID:     "order-cancelled",
				}) {
					{ i18n.T(ctx, i18n.KeyOrderCancelled) }
				}
			}
			if v.PaymentRefreshURL != "" {
				<div class="goen-notice goen-notice--accent" id="order-payment-processing" role="status">
					<h2 class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyPayProcessingTitle) }</h2>
					<p>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderPaymentChecking), v.PaymentRefreshSeconds, v.PaymentRefreshChecks) }</p>
					<div class="goen-order__actions">
						@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, templ.SafeURL(v.PaymentRefreshURL)) {
							{ i18n.T(ctx, i18n.KeyOrderCheckPayment) }
						}
						@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost}, templ.SafeURL("/orders/"+v.Number+"?paid=1&confirmation=done")) {
							{ i18n.T(ctx, i18n.KeyOrderStopChecking) }
						}
					</div>
				</div>
			} else if v.PaymentConfirmationPending {
				@components.Notice(components.NoticeProps{
					Intent: components.IntentAccent,
					ID:     "order-payment-confirmation-pending",
				}) {
					{ i18n.T(ctx, i18n.KeyOrderPaymentConfirmationPending) }
					<a href="/contact">{ i18n.T(ctx, i18n.KeyContact) }</a>
				}
			} else if v.AwaitingPayment() {
				@components.Notice(components.NoticeProps{
					Intent: components.IntentAccent,
					ID:     "order-unpaid",
				}) {
					{ i18n.T(ctx, i18n.KeyOrderUnpaid) }
					if v.PaymentsEnabled {
						<a href={ templ.SafeURL("/orders/" + v.Number + "/pay") }>{ i18n.T(ctx, i18n.KeyPay) }</a>
					}
				}
			}
			<div class="goen-order__layout">
				<div class="goen-order__panels">
					if v.Returned != nil {
						<section class="goen-order__returned" aria-labelledby="returned-heading">
							<h2 id="returned-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderReturnedTitle) }</h2>
							@components.StatLine(v.ReturnedFacts(ctx), components.StatLinePlain)
							<p class="goen-order__meta">{ i18n.T(ctx, i18n.KeyOrderReturnedAll) }</p>
						</section>
					}
					if v.SimpleLines() {
						@orderLines(v, v.Lines, i18n.T(ctx, i18n.KeyOrderItems), "lines-heading", false, !v.IsCancelled() && v.Returned == nil)
					} else {
						for i, sh := range v.Shipments {
							@orderParcel(v, sh, i)
						}
						if len(v.Unshipped) > 0 {
							@orderLines(v, v.Unshipped, i18n.T(ctx, i18n.KeyOrderNotShipped), "unshipped-heading", false, true)
						}
					}
					if len(v.Timeline) > 0 {
						// On the page, not behind a tab: "where is my order" is the question this page is
						// opened with, and a tab hides the answer from anyone who does not know to press it.
						<section class="goen-order__history" aria-labelledby="history-heading">
							<h2 id="history-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderHistory) }</h2>
							<ol class="goen-order__steps">
								for i, e := range v.Timeline {
									<li class="goen-order__step">
										<span class="goen-order__rail" aria-hidden="true">
											<span class="goen-order__dot"></span>
											if i < len(v.Timeline)-1 {
												<span class="goen-order__connector"></span>
											}
										</span>
										<div class="goen-order__stepbody">
											<p class="goen-order__steplabel">{ i18n.T(ctx, e.LabelKey()) }</p>
											<p class="goen-order__meta"><time datetime={ e.Datetime() }>{ e.Stamp(ctx) }</time></p>
											if e.ShowsNote() {
												<p class="goen-order__meta">{ e.Note }</p>
											}
										</div>
									</li>
								}
							</ol>
						</section>
					}
					if v.DeliveryTo != "" {
						<section class="goen-order__delivery" aria-labelledby="delivery-heading">
							<h2 id="delivery-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeyOrderDeliveryTo) }</h2>
							<div class="goen-order__shipment">
								<span class="goen-order__carrier">{ v.ShippingName }</span>
								<span class="goen-order__meta">{ v.DeliveryTo }</span>
							</div>
						</section>
					}
					if v.Invoice != nil {
						<section class="goen-order__invoice" aria-labelledby="invoice-heading">
							<h2 id="invoice-heading" class="goen-order__subhead">{ i18n.T(ctx, i18n.KeySectionInvoice) }</h2>
							<ul class="goen-order__shipments" role="list">
								for _, d := range v.Invoice.Documents {
									<li class="goen-order__shipment">
										<span class="goen-order__carrier">{ d.Label(ctx) } { d.Number }</span>
										if d.Allowance {
											<span class="goen-order__meta">{ d.Amount() }</span>
										}
										if d.Voided {
											@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
												{ i18n.T(ctx, i18n.KeyAdminQueueVoided) }
											}
										}
										<span class="goen-order__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderInvoiceIssued), d.IssuedOn) }</span>
										if d.RandomCode != "" {
											<span class="goen-order__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueRandomCode), d.RandomCode) }</span>
										}
									</li>
								}
							</ul>
							<p class="goen-order__meta">{ v.Invoice.ChoiceText(ctx) }</p>
						</section>
					}
				</div>
				@components.Card(components.CardProps{Class: "goen-order__summary"}) {
					<dl class="goen-summary">
						<div class="goen-summary__row">
							<dt>{ i18n.T(ctx, i18n.KeySubtotal) }</dt>
							<dd class="goen-summary__value">{ v.Subtotal() }</dd>
						</div>
						<div class="goen-summary__row">
							<dt>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderShippingFee), v.ShippingName) }</dt>
							<dd class="goen-summary__value">{ v.Shipping(ctx) }</dd>
						</div>
						if v.Discounted() {
							<div class="goen-summary__row">
								<dt>{ DiscountLabel(ctx, v.DiscountReason) }</dt>
								<dd class="goen-summary__value">{ v.Discount() }</dd>
							</div>
						}
						if v.UsedCredit() {
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeyOrderCreditApplied) }</dt>
								<dd class="goen-summary__value">{ v.Credit() }</dd>
							</div>
							<div class="goen-summary__row goen-summary__row--total">
								<dt>{ i18n.T(ctx, i18n.KeyOrderAmountDue) }</dt>
								<dd class="goen-summary__value">{ v.Owed() }</dd>
							</div>
						} else {
							<div class="goen-summary__row goen-summary__row--total">
								<dt>{ i18n.T(ctx, i18n.KeyOrderGrandTotal) }</dt>
								<dd class="goen-summary__value">{ v.Total() }</dd>
							</div>
						}
						if v.PaymentState() != PaymentNone {
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeyOrderPayment) }</dt>
								<dd class="goen-summary__value">{ i18n.T(ctx, v.PaymentState().Key()) }</dd>
							</div>
						}
					</dl>
					<div class="goen-summary__actions">
						<form class="goen-order__cancel" method="post" action={ templ.SafeURL("/orders/" + v.Number + "/reorder") }>
							@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
								{ i18n.T(ctx, i18n.KeyOrderReorder) }
							}
							<span class="goen-order__meta">{ i18n.T(ctx, i18n.KeyOrderReorderNote) }</span>
						</form>
						if v.ShowCancel() {
							<form class="goen-order__cancel" method="post" action={ templ.SafeURL("/orders/" + v.Number + "/cancel") }>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost}, "submit") {
									{ i18n.T(ctx, i18n.KeyOrderCancel) }
								}
								if v.CancelVoidsInvoice() {
									<span class="goen-order__meta">{ i18n.T(ctx, i18n.KeyOrderCancelVoidsInvoice) }</span>
								} else {
									<span class="goen-order__meta">{ i18n.T(ctx, i18n.KeyOrderCancelNote) }</span>
								}
							</form>
						}
						if v.CanRequestReturn() {
							@components.ButtonLink(components.ButtonProps{
								ButtonStyle: components.ButtonStyleOutline,
								Block:       true,
							}, templ.SafeURL("/orders/"+v.Number+"/return")) {
								{ i18n.T(ctx, i18n.KeyOrderReturn) }
							}
						}
						@components.ButtonLink(components.ButtonProps{
							ButtonStyle: components.ButtonStyleGhost,
							Block:       true,
						}, "/") {
							{ i18n.T(ctx, i18n.KeyContinue) }
						}
					</div>
				}
			</div>
		</div>
	}
}

// A parcel states the right to cancel from its own delivery, then the lines in it.
templ orderParcel(v *OrderView, sh OrderShipment, i int) {
	<section class="goen-order__parcel" aria-labelledby={ fmt.Sprintf("parcel-%d-heading", i) }>
		<h2 id={ fmt.Sprintf("parcel-%d-heading", i) } class="goen-order__subhead">{ v.ParcelTitle(ctx, i) }</h2>
		<p class="goen-order__meta">
			{ i18n.CarrierName(ctx, sh.Carrier) }
			if sh.Carrier.DeepLinks() {
				· <a href={ templ.SafeURL(sh.TrackURL()) } rel="noopener noreferrer" target="_blank">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderTrackingNo), sh.Tracking) }</a>
			} else {
				· { fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderTrackingNo), sh.Tracking) }
				if sh.TrackURL() != "" {
					· <a href={ templ.SafeURL(sh.TrackURL()) } rel="noopener noreferrer" target="_blank">{ i18n.T(ctx, i18n.KeyOrderTrackLink) }</a>
				}
			}
			if sh.Delivered() {
				· { fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderDeliveredAt), sh.DeliveredStamp(ctx)) }
			} else {
				· { fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderShippedAt), sh.ShippedStamp(ctx)) }
			}
		</p>
		if sh.Delivered() {
			@components.StatLine(v.ReturnFacts(ctx, sh), components.StatLinePlain)
			if grid, ok := v.ReturnGrid(ctx, sh); ok {
				@components.Period(grid)
			}
			<p class="goen-order__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderRescissionEnds), v.RescissionLastDay(ctx, sh)) }</p>
			if note := v.PickupCounted(ctx); note != "" {
				<p class="goen-order__meta">{ note }</p>
			}
		} else {
			<p class="goen-order__meta">{ v.ReturnPending(ctx) }</p>
		}
		if v.SeveralParcels() {
			@orderLines(v, sh.Lines, "", "", sh.Delivered(), true)
		}
	</section>
	if !v.SeveralParcels() {
		@orderLines(v, sh.Lines, i18n.T(ctx, i18n.KeyOrderItems), "lines-heading", sh.Delivered(), true)
	}
}

// A list of lines keeps the markers the layout gate and the tests read. Without a heading it sits inside its parcel.
templ orderLines(v *OrderView, lines []OrderLine, heading, headingID string, delivered, warranty bool) {
	if headingID != "" {
		<section class="goen-order__items" aria-labelledby={ headingID }>
			<h2 id={ headingID } class="goen-order__subhead">{ heading }</h2>
			@orderLineList(v, lines, delivered, warranty)
		</section>
	} else {
		@orderLineList(v, lines, delivered, warranty)
	}
}

templ orderLineList(v *OrderView, lines []OrderLine, delivered, warranty bool) {
	<ul class="goen-order__lines" role="list">
		for _, l := range lines {
			<li class="goen-line goen-line--order">
				<span class="goen-line__thumb">
					if l.HasImage() {
						<img
							class="goen-line__img"
							src={ l.ImageURL }
							srcset={ l.ImageSrcset }
							sizes="96px"
							alt={ l.ImageAlt }
							width="96"
							height="96"
							loading="lazy"
							decoding="async"
						/>
					} else {
						<span class="goen-line__ph" aria-hidden="true"></span>
					}
				</span>
				<div class="goen-line__body">
					<p class="goen-line__name">{ l.Name }</p>
					if l.Label != "" {
						<span class="goen-line__meta">{ l.Label }</span>
					}
					<span class="goen-line__meta">{ l.SKU } · { l.UnitPrice() } × { l.QuantityText() }</span>
					if warranty && l.WarrantyMonths > 0 {
						@components.StatLine(v.WarrantyFacts(ctx, l, delivered), components.StatLineSmall)
						if v.CanRegister(l, delivered) {
							<a class="goen-line__act" href={ templ.SafeURL(v.WarrantyLink()) }>{ i18n.T(ctx, i18n.KeyOrderWarrantyRegister) }</a>
						}
					}
				</div>
				<div class="goen-line__money">
					<span class="goen-line__total">{ l.LineTotal() }</span>
				</div>
			</li>
		}
	</ul>
}
