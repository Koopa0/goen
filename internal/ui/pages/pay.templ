package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Pay hands the customer over to Stripe's hosted card form. Nothing on this page
// loads, so it has no skeleton and no spinner: the handover is a form post.
templ Pay(p layouts.Page, v PayView) {
	@layouts.Base(p) {
		<div class="goen-pay">
			<div class="goen-pagehead">
				<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, v.EyebrowKey()) }</p>
				<h1 class="goen-pagehead__title">{ v.Number }</h1>
				<p class="goen-pagehead__sub">
					if v.Closed() {
						{ i18n.T(ctx, v.ClosedTitle()) }
					} else {
						{ i18n.T(ctx, i18n.KeyPayBody) }
					}
				</p>
			</div>
			if v.Cancelled && !v.Closed() {
				@components.Notice(components.NoticeProps{
					Tone: components.ToneAccent,
					ID:   "pay-cancelled",
				}) {
					{ i18n.T(ctx, i18n.KeyPayCancelled) }
				}
			}
			<ul class="goen-pay__lines" role="list">
				for _, l := range v.Lines {
					<li class="goen-line">
						<div class="goen-line__body">
							<p class="goen-line__name">{ l.Name }</p>
							if l.Label != "" {
								<span class="goen-line__meta">{ l.Label }</span>
							}
							<span class="goen-line__meta">{ l.UnitPrice() } × { l.QuantityText() }</span>
						</div>
						<div class="goen-line__money">
							<span class="goen-line__total">{ l.LineTotal() }</span>
						</div>
					</li>
				}
			</ul>
			@components.Card(components.CardProps{Class: "goen-pay__summary"}) {
				<dl class="goen-summary">
					<div class="goen-summary__row">
						<dt>{ i18n.T(ctx, i18n.KeySubtotal) }</dt>
						<dd class="goen-summary__value">{ v.Subtotal() }</dd>
					</div>
					<div class="goen-summary__row">
						<dt>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderShippingFee), v.ShippingName) }</dt>
						<dd class="goen-summary__value">{ v.Shipping(ctx) }</dd>
					</div>
					if v.Discounted() {
						<div class="goen-summary__row">
							<dt>{ DiscountLabel(ctx, v.DiscountReason) }</dt>
							<dd class="goen-summary__value">{ v.Discount() }</dd>
						</div>
					}
					if v.UsedCredit() {
						<div class="goen-summary__row">
							<dt>{ i18n.T(ctx, i18n.KeyOrderCreditApplied) }</dt>
							<dd class="goen-summary__value">{ v.Credit() }</dd>
						</div>
					}
					<div class="goen-summary__row goen-summary__row--total">
						<dt>{ i18n.T(ctx, i18n.KeyTotal) }</dt>
						<dd class="goen-summary__value">{ v.Total() }</dd>
					</div>
				</dl>
				if v.Closed() {
					@components.Notice(components.NoticeProps{
						Tone: components.ToneAccent,
						ID:   "pay-closed",
					}) {
						{ i18n.T(ctx, v.ClosedBody()) }
					}
					<form method="post" action={ templ.SafeURL("/orders/" + v.Number + "/reorder") }>
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size:    components.SizeLarge,
							Block:   true,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyOrderReorder) }
						}
					</form>
					<p class="goen-pay__assurance">
						{ i18n.T(ctx, i18n.KeyOrderReorderNote) }
					</p>
				} else if v.Enabled {
					if v.Sandbox {
						@components.Notice(components.NoticeProps{
							Tone: components.ToneAccent,
							ID:   "pay-sandbox",
						}) {
							{ i18n.T(ctx, i18n.KeyPaySandbox) }
						}
					}
					if v.StartBy != "" {
						<p class="goen-pay__assurance">
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPayStartBy), v.StartBy) }
						</p>
					}
					<form method="post" action={ templ.SafeURL(v.Action()) }>
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size:    components.SizeLarge,
							Block:   true,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyPay) }
						}
					</form>
					<p class="goen-pay__assurance">
						{ i18n.T(ctx, i18n.KeyPayStripeNote) }
					</p>
				} else {
					@components.Notice(components.NoticeProps{
						Tone: components.ToneAccent,
						ID:   "pay-disabled",
					}) {
						{ i18n.T(ctx, i18n.KeyPayDisabled) }
					}
					@components.ButtonLink(components.ButtonProps{
						Variant: components.VariantGhost,
						Block:   true,
					}, "/contact") {
						{ i18n.T(ctx, i18n.KeyContact) }
					}
				}
				@components.ButtonLink(components.ButtonProps{
					Variant: components.VariantOutline,
					Block:   true,
				}, templ.SafeURL("/orders/"+v.Number)) {
					{ i18n.T(ctx, i18n.KeyPayViewOrder) }
				}
			}
		</div>
	}
}
