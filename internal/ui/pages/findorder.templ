package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// FindOrder is the lookup a guest who has lost their cookie uses. It wears the
// same card as every other credential form: the reader is being asked for two
// things they have to go and find, and a full-width page makes that look like
// more work than it is.
templ FindOrder(p layouts.Page, v FindOrderView) {
	@layouts.Base(p) {
		<div class="goen-findorder">
			@components.Card(components.CardProps{Class: "goen-findorder__card"}) {
				<h1 class="goen-findorder__title">{ i18n.T(ctx, i18n.KeyFindOrderTitle) }</h1>
				<p class="goen-findorder__sub">{ i18n.T(ctx, i18n.KeyFindOrderSub) }</p>
				if v.Error != "" {
					@components.Notice(components.NoticeProps{
						Tone: components.ToneDanger,
						ID:   "find-error",
					}) {
						{ v.Error }
					}
				}
				// goen-auth__form is the class the layout gate reads on every
				// credential form, and its declarations are shared with sign in,
				// register and reset — so this page carries the spelling and adds
				// nothing that would repaint the three it shares it with.
				<form class="goen-auth__form" method="post" action="/orders/find">
					<div class="goen-field">
						@components.Label(components.LabelProps{For: "find-number"}) {
							{ i18n.T(ctx, i18n.KeyFieldOrderNumber) }
						}
						@components.Input(components.FieldProps{
							ID:    "find-number",
							Name:  "number",
							Type:  "text",
							Value: v.Number,
							Attrs: templ.Attributes{
								"placeholder":  "GO-260101-000001",
								"autocomplete": "off",
								"required":     true,
							},
						})
					</div>
					<div class="goen-field">
						@components.Label(components.LabelProps{For: "find-email"}) {
							{ i18n.T(ctx, i18n.KeyFieldEmail) }
						}
						@components.Input(components.FieldProps{
							ID:    "find-email",
							Name:  "email",
							Type:  "email",
							Value: v.Email,
							Attrs: templ.Attributes{
								"autocomplete": "email",
								"required":     true,
							},
						})
					</div>
					@components.Button(components.ButtonProps{
						Variant: components.VariantPrimary,
						Size:    components.SizeLarge,
						Block:   true,
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyFindOrderSubmit) }
					}
				</form>
				<p class="goen-findorder__alt">
					{ i18n.T(ctx, i18n.KeyFindOrderSignIn) }
					<a href="/signin">{ i18n.T(ctx, i18n.KeySignIn) }</a>
				</p>
			}
		</div>
	}
}
