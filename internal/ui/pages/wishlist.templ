package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// SoleVariantID is set only when the product has one variant and it is in stock:
// the one case where the row can add it to the cart without asking which.
type WishlistItem struct {
	ProductTile
	SoleVariantID string
}

type WishlistView struct {
	Products []WishlistItem
	// Added is what the last add-to-cart from this page did, as the cart's
	// redirect names it.
	Added AddOutcome
}

func (v WishlistView) Empty() bool { return len(v.Products) == 0 }

templ Wishlist(p layouts.Page, v WishlistView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<div class="goen-pagehead">
				<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, i18n.KeyAccountTitle) }</p>
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyWishlistTitle) }</h1>
			</div>
			<div id="wishlist">
				if v.Empty() {
					<div class="ui-empty">
						<span class="goen-medallion" aria-hidden="true">
							@icons.Heart()
						</span>
						<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyWishlistEmpty) }</p>
						<p class="goen-empty__text">{ i18n.T(ctx, i18n.KeyWishlistEmptyHint) }</p>
						@components.ButtonLink(components.ButtonProps{
							ButtonStyle: components.ButtonStylePrimary,
						}, templ.SafeURL("/")) {
							{ i18n.T(ctx, i18n.KeyWishlistEmptyLink) }
						}
					</div>
				} else {
					switch v.Added {
						case AddOutcomeAdded:
							@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "added", Class: "goen-wish__added"}) {
								{ i18n.T(ctx, i18n.KeyAddedToCart) }
								<a href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
							}
						case AddOutcomeAdjusted:
							@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "added", Class: "goen-wish__added"}) {
								{ i18n.T(ctx, i18n.KeyAddAdjusted) }
								<a href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
							}
						case AddOutcomeUnavailable, AddOutcomeUnknown:
							@components.Notice(components.NoticeProps{Intent: components.IntentDanger, ID: "added", Class: "goen-wish__added"}) {
								{ i18n.T(ctx, i18n.KeyAddRefused) }
							}
						case AddOutcomeFull:
							@components.Notice(components.NoticeProps{Intent: components.IntentDanger, ID: "added", Class: "goen-wish__added"}) {
								{ i18n.T(ctx, i18n.KeyCartLineLimit) }
							}
					}
					<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.Products {
							<li class="goen-wish goen-tile__cell">
								@tileCard(t.ProductTile)
								if t.SoleVariantID != "" {
									<form method="post" action="/cart/items" class="goen-wish__add">
										<input type="hidden" name="variant" value={ t.SoleVariantID }/>
										<input type="hidden" name="return" value="/account/wishlist"/>
										<input type="hidden" name="quantity" value="1"/>
										@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleSecondary, Size: components.SizeSmall, Block: true}, "submit") {
											{ i18n.T(ctx, i18n.KeyAddToCart) }
										}
									</form>
								} else if t.InStock {
									@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleSecondary, Size: components.SizeSmall, Block: true}, templ.SafeURL("/p/"+t.Slug)) {
										{ i18n.T(ctx, i18n.KeyChooseOptions) }
									}
								}
								<form
									method="post"
									action="/account/wishlist"
									class="goen-wish__remove"
									hx-post="/account/wishlist"
									hx-target="#wishlist"
									hx-select="#wishlist"
									hx-swap="outerHTML"
								>
									<input type="hidden" name="slug" value={ t.Slug }/>
									<input type="hidden" name="action" value="remove"/>
									<input type="hidden" name="return" value="/account/wishlist"/>
									// ui-btn is the name check-layout.mjs measures the remove control by; app.css
									// writes what it declares.
									<button class="goen-btn goen-btn--outline goen-btn--sm goen-btn--block ui-btn" type="submit">
										{ i18n.T(ctx, i18n.KeyRemove) }
									</button>
								</form>
							</li>
						}
					</ul>
				}
			</div>
		</div>
	}
}
