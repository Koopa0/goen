package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/user"
)

templ Notice(p layouts.Page, code, heading, body string, next ...NoticeActions) {
	{{ actions := noticeActions(next) }}
	@layouts.Base(p) {
		<div class="notice">
			if code != "" && code != "404" {
				<span class="notice__code" aria-hidden="true">{ code }</span>
			}
			<h1 class="notice__title">{ heading }</h1>
			<p class="notice__body">{ body }</p>
			<div class="notice__actions">
				@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge}, templ.URL(actions.Primary.Href)) {
					{ i18n.T(ctx, actions.Primary.Label) }
				}
				if actions.Secondary.Href != "" {
					@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Size: components.SizeLarge}, templ.URL(actions.Secondary.Href)) {
						{ i18n.T(ctx, actions.Secondary.Label) }
					}
				}
			</div>
			if code == "404" {
				@departmentLinks()
			}
		</div>
	}
}

// Reads the header's category row, so a visitor on a missing page has somewhere
// known to go; renders nothing outside the middleware that carries the row.
templ departmentLinks() {
	if items := layouts.TopNavFrom(ctx); len(items) > 0 {
		<nav class="notice__departments" aria-labelledby="notice-departments">
			<h2 class="notice__departmentshead" id="notice-departments">{ i18n.T(ctx, i18n.KeySectionCategories) }</h2>
			<ul class="notice__departmentlist" role="list">
				for _, it := range items {
					<li><a class="notice__department" href={ templ.SafeURL(it.Href) }>{ it.Name }</a></li>
				}
			</ul>
		</nav>
	}
}

templ PlacementGrantFailed(p layouts.Page) {
	@layouts.Base(p) {
		<div class="notice">
			<span class="notice__code" aria-hidden="true">500</span>
			<h1 class="notice__title">{ i18n.T(ctx, i18n.KeyPlacementGrantFailedTitle) }</h1>
			<p class="notice__body">{ i18n.T(ctx, i18n.KeyPlacementGrantFailedBody) }</p>
			<div class="notice__actions">
				@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge}, "/orders/find") {
					{ i18n.T(ctx, i18n.KeyFindOrderTitle) }
				}
			</div>
		</div>
	}
}

templ FindOrderGrantFailed(p layouts.Page) {
	@layouts.Base(p) {
		<div class="notice">
			<span class="notice__code" aria-hidden="true">500</span>
			<h1 class="notice__title">{ i18n.T(ctx, i18n.KeyFindOrderGrantFailedTitle) }</h1>
			<p class="notice__body">{ i18n.T(ctx, i18n.KeyFindOrderGrantFailedBody) }</p>
			<div class="notice__actions">
				@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge}, "/orders/find") {
					{ i18n.T(ctx, i18n.KeyFindOrderTitle) }
				}
			</div>
		</div>
	}
}

templ OrderNotFound(p layouts.Page) {
	if _, signedIn := user.FromContext(ctx); signedIn {
		@Notice(p, "404", i18n.T(ctx, i18n.KeyOrderNotFound), i18n.T(ctx, i18n.KeyOrderNotInAccount), NoticeActions{
			Primary: NoticeLink{Href: "/orders/find", Label: i18n.KeyFindOrderTitle},
		})
	} else {
		@Notice(p, "404", i18n.T(ctx, i18n.KeyOrderNotFound), i18n.T(ctx, i18n.KeyOrderNotYours), NoticeActions{
			Primary:   NoticeLink{Href: "/orders/find", Label: i18n.KeyFindOrderTitle},
			Secondary: NoticeLink{Href: "/signin", Label: i18n.KeySignIn},
		})
	}
}
