package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminDashboard renders the back office landing page: the five figures the
// shop is judged by, then the two queues somebody actually works from.
//
// Every figure is a link. A count on its own tells a staff member that there is
// work and not where it is, and the screen holding it is one they would
// otherwise find in the navigation.
templ AdminDashboard(p layouts.Page, v AdminDashboardView) {
	@layouts.Admin(p, "dashboard") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminQueueDashboardTitle) }</h1>
			</div>
		</div>
		<div class="goen-admin__stats">
			@components.StatTile(components.StatTileProps{
				Label: i18n.T(ctx, i18n.KeyAdminQueueStatPending),
				Value: v.PendingText(),
				Href:  "/admin/orders?status=pending",
			})
			@components.StatTile(components.StatTileProps{
				Label: i18n.T(ctx, i18n.KeyAdminStatusPicking),
				Value: v.PickingText(),
				Href:  "/admin/orders?status=picking",
			})
			@components.StatTile(components.StatTileProps{
				Label: i18n.T(ctx, i18n.KeyAdminQueueStatLowStock),
				Value: v.LowStockText(),
				Href:  "/admin/stock?low=1",
			})
			@components.StatTile(components.StatTileProps{
				Label: i18n.T(ctx, i18n.KeyAdminQueueStatActive),
				Value: v.ActiveProductsText(),
				Href:  "/admin/products",
			})
			@components.StatTile(components.StatTileProps{
				Label: i18n.T(ctx, i18n.KeyAdminQueueStatMessages),
				Value: v.OpenMessagesText(),
				Href:  "/admin/messages",
			})
		</div>
		<section class="goen-admin__queue" aria-labelledby="orders-heading">
			<h2 class="goen-admin__heading" id="orders-heading">
				<a href="/admin/orders">{ i18n.T(ctx, i18n.KeyAdminQueueOrders) }</a>
			</h2>
			if len(v.Recent) == 0 {
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueNoneYet) }</p>
			} else {
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyFieldOrderNumber) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColPlacedAt) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range v.Recent {
								<tr>
									<td class="goen-admin__cellkey">
										<a href={ templ.URL("/admin/orders/" + o.Number) }>{ o.Number }</a>
									</td>
									<td>
										<div class="goen-admin__cellbadges">
											@components.Badge(components.BadgeProps{}) {
												{ o.StatusText }
											}
											if o.Committed {
												@components.Badge(components.BadgeProps{Tone: components.ToneAccent}) {
													{ i18n.T(ctx, i18n.KeyAdminQueueCommitted) }
												}
											}
										</div>
									</td>
									<td>{ o.RecipientText(ctx) }</td>
									<td>{ o.PlacedAt }</td>
									<td class="goen-admin__cellnum">{ o.Total() }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		if v.HasLow() {
			<section class="goen-admin__queue" aria-labelledby="low-heading">
				<h2 class="goen-admin__heading" id="low-heading">
					<a href="/admin/stock?low=1">{ i18n.T(ctx, i18n.KeyAdminQueueRestockHead) }</a>
				</h2>
				<p class="goen-admin__hint">
					{ i18n.T(ctx, i18n.KeyAdminQueueSellableHint) }
				</p>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">SKU</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColProduct) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminQueueColStock) }</th>
							</tr>
						</thead>
						<tbody>
							for _, x := range v.Low {
								<tr>
									<td class="goen-admin__cellkey">
										<a href={ templ.SafeURL("/admin/stock/" + x.SKU) }>{ x.SKU }</a>
									</td>
									<td>
										{ x.ProductName }
										<span class="goen-admin__meta">{ x.Brand }</span>
									</td>
									<td class="goen-admin__cellnum">
										{ x.StockText() } / { x.SafetyText() } /
										<strong>{ x.SellableText() }</strong>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@components.ButtonLink(components.ButtonProps{
					Variant: components.VariantOutline,
					Size:    components.SizeSmall,
				}, "/admin/stock?low=1") {
					{ i18n.T(ctx, i18n.KeyAdminQueueAllLowStock) }
				}
			</section>
		}
	}
}

// AdminOrders renders the order queue: the status tabs, then one table whose
// first column is the way into each order.
//
// The tabs are links and the selected one is marked with aria-current alone.
// A second class saying the same thing is a second source of truth for which
// tab is on, and the two disagree the moment one of them is forgotten.
templ AdminOrders(p layouts.Page, v AdminOrdersView) {
	@layouts.Admin(p, "orders") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminQueueOrders) }</h1>
			</div>
		</div>
		if v.HasNotice() {
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
				{ v.Notice }
			}
		}
		<form class="goen-admin__search" method="get" action="/admin/orders">
			<label class="goen-sr-only" for="order-search">{ i18n.T(ctx, i18n.KeyAdminQueueSearchLabel) }</label>
			<input
				class="ui-input"
				id="order-search"
				type="search"
				name="q"
				value={ v.Term }
				placeholder={ i18n.T(ctx, i18n.KeyAdminQueueSearchPlaceholder) }
				autocomplete="off"
			/>
			@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminSearch) }
			}
			if v.Searching() {
				@components.ButtonLink(components.ButtonProps{Variant: components.VariantGhost}, "/admin/orders") {
					{ i18n.T(ctx, i18n.KeyAdminQueueClear) }
				}
			}
		</form>
		if v.Searching() {
			<p class="goen-admin__hint">
				{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueSearchNote), v.Term) }
			</p>
		}
		if v.TermTooShort() {
			@components.Notice(components.NoticeProps{Tone: components.ToneWarn}) {
				{ i18n.T(ctx, i18n.KeyAdminQueueSearchShort) }
			}
		}
		<div class="ui-filterbar goen-admin__tabs">
			for _, t := range v.Tabs {
				<a
					class="ui-filter"
					href={ templ.URL("/admin/orders?status=" + string(t.Value)) }
					if t.Selected {
						aria-current="page"
					}
				>
					{ t.Label }
					<span class="ui-filter__count">{ t.CountText() }</span>
				</a>
			}
		</div>
		if v.Empty() {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ v.EmptyText(ctx) }</p>
			</div>
		} else {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyFieldOrderNumber) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColPlacedAt) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
						</tr>
					</thead>
					<tbody>
						for _, o := range v.Orders {
							<tr>
								<td class="goen-admin__cellkey">
									<a href={ templ.URL("/admin/orders/" + o.Number) }>{ o.Number }</a>
								</td>
								<td>
									<div class="goen-admin__cellbadges">
										@components.Badge(components.BadgeProps{}) {
											{ o.StatusText }
										}
										if o.Committed {
											@components.Badge(components.BadgeProps{Tone: components.ToneAccent}) {
												{ i18n.T(ctx, i18n.KeyAdminQueueCommitted) }
											}
										}
									</div>
								</td>
								<td>{ o.RecipientText(ctx) }</td>
								<td>{ o.PlacedAt }</td>
								<td class="goen-admin__cellnum">{ o.Total() }</td>
							</tr>
						}
					</tbody>
				</table>
				@listBound(v.ListBound, ByRecency, true)
			</div>
		}
	}
}

// AdminOrder renders one order: what was bought and what has happened to it on
// the left, what the shop can do about it on the right.
//
// Each operation is one card with one form and one button. A column of forms
// sharing a panel reads as one long form, and the staff member who means to
// dispatch presses whatever button is nearest.
templ AdminOrder(p layouts.Page, v *AdminOrderView) {
	@layouts.Admin(p, "orders") {
		@components.Breadcrumb(components.BreadcrumbProps{
			Label: i18n.T(ctx, i18n.KeyBreadcrumb),
			Crumbs: []components.Crumb{
				{Label: i18n.T(ctx, i18n.KeyAdminQueueOrders), Href: "/admin/orders"},
				{Label: v.Number},
			},
		})
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ v.Number }</h1>
				<p class="ui-page-head__sub">{ v.PlacedAt } · { v.ShippingName }</p>
			</div>
			<div class="ui-page-head__actions">
				@components.Badge(components.BadgeProps{}) {
					{ v.StatusText }
				}
				if v.Committed {
					@components.Badge(components.BadgeProps{Tone: components.ToneAccent}) {
						{ i18n.T(ctx, i18n.KeyAdminQueueCommitted) }
					}
				}
			</div>
		</div>
		if v.HasNotice() {
			// The layout gate finds this screen's notice by the vendored
			// spelling, so the element keeps it (#380 R8).
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent, Class: "ui-alert"}) {
				{ v.Notice }
			}
		}
		<div class="goen-admin__layout">
			<div class="goen-admin__orderpanel">
				@components.Card(components.CardProps{Class: "goen-admin__op"}) {
					<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueItems) }</h2>
					<ul class="goen-order__lines" role="list">
						for _, l := range v.Lines {
							<li class="goen-order__line">
								<div>
									<p class="goen-order__name">{ l.Name }</p>
									if l.Label != "" {
										<span class="goen-admin__meta">{ l.Label }</span>
									}
									<span class="goen-admin__meta">{ l.SKU } · { l.UnitPrice() } × { l.QuantityText() }</span>
								</div>
								<span class="goen-admin__linetotal">{ l.LineTotal() }</span>
							</li>
						}
					</ul>
				}
				@components.Card(components.CardProps{Class: "goen-admin__op"}) {
					<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDelivery) }</h2>
					<dl class="ui-dl">
						<div class="ui-dl__row">
							<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</dt>
							<dd class="ui-dl__desc">{ v.RecipientText(ctx) }</dd>
						</div>
						<div class="ui-dl__row">
							<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyFieldPhoneShort) }</dt>
							<dd class="ui-dl__desc">{ v.Phone }</dd>
						</div>
						<div class="ui-dl__row">
							<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyFieldEmail) }</dt>
							<dd class="ui-dl__desc">{ v.Email }</dd>
						</div>
						<div class="ui-dl__row">
							<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminQueueAddress) }</dt>
							<dd class="ui-dl__desc">{ v.Address }</dd>
						</div>
						if v.HasInvoice() {
							<div class="ui-dl__row">
								<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeySectionInvoice) }</dt>
								<dd class="ui-dl__desc">{ v.InvoiceText(ctx) }</dd>
							</div>
						}
					</dl>
				}
				if v.Correctable {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDeliverySave) }</h2>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/delivery") }>
							<div class="goen-admin__row">
								<div class="ui-field">
									<label class="ui-label" for="d-recipient">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</label>
									<input class="ui-input" id="d-recipient" name="recipient" value={ v.Delivery.Recipient } required maxlength="60"/>
								</div>
								<div class="ui-field">
									<label class="ui-label" for="d-phone">{ i18n.T(ctx, i18n.KeyFieldPhoneShort) }</label>
									<input class="ui-input" id="d-phone" name="phone" type="tel" value={ v.Delivery.Phone } required maxlength="30"/>
								</div>
								<div class="ui-field">
									<label class="ui-label" for="d-email">{ i18n.T(ctx, i18n.KeyFieldEmail) }</label>
									<input class="ui-input" id="d-email" name="email" type="email" value={ v.Delivery.Email } required maxlength="254"/>
								</div>
							</div>
							if v.PickupDestination {
								<div class="goen-admin__row">
									<div class="ui-field">
										<label class="ui-label" for="d-brand">{ i18n.T(ctx, i18n.KeyFieldPickupBrand) }</label>
										<select class="ui-select" id="d-brand" name="pickup_brand" required>
											for _, b := range v.PickupBrands {
												<option value={ string(b.Value) } selected?={ b.Value == v.Delivery.PickupBrand }>{ b.Label }</option>
											}
										</select>
									</div>
									// The chain is the destination. The store behind it is
									// filled in by the carrier's picker and is absent on an
									// order placed before one exists, so neither field is
									// required here — cart.Address.Validate refuses one
									// without the other and accepts both empty.
									<div class="ui-field">
										<label class="ui-label" for="d-store-code">{ i18n.T(ctx, i18n.KeyFieldStoreCode) }</label>
										<input class="ui-input" id="d-store-code" name="pickup_store_code" value={ v.Delivery.PickupStoreCode } maxlength="10"/>
									</div>
									<div class="ui-field">
										<label class="ui-label" for="d-store-name">{ i18n.T(ctx, i18n.KeyFieldStoreName) }</label>
										<input class="ui-input" id="d-store-name" name="pickup_store_name" value={ v.Delivery.PickupStoreName } maxlength="40"/>
									</div>
								</div>
							} else {
								<div class="goen-admin__row">
									<div class="ui-field">
										<label class="ui-label" for="d-postal">{ i18n.T(ctx, i18n.KeyFieldPostalCode) }</label>
										<div>
											<input
												class="ui-input"
												id="d-postal"
												name="postal_code"
												value={ v.Delivery.PostalCode }
												required
												maxlength="6"
												if v.DeliveryError != "" {
													aria-invalid="true"
													aria-describedby="d-postal-error"
												}
											/>
										</div>
									</div>
									<div class="ui-field">
										<label class="ui-label" for="d-city">{ i18n.T(ctx, i18n.KeyFieldCity) }</label>
										<input class="ui-input" id="d-city" name="city" value={ v.Delivery.City } required maxlength="20"/>
									</div>
									<div class="ui-field">
										<label class="ui-label" for="d-district">{ i18n.T(ctx, i18n.KeyFieldDistrict) }</label>
										<input class="ui-input" id="d-district" name="district" value={ v.Delivery.District } required maxlength="20"/>
									</div>
									<div class="ui-field goen-admin__wide">
										<label class="ui-label" for="d-street">{ i18n.T(ctx, i18n.KeyFieldStreet) }</label>
										<input class="ui-input" id="d-street" name="street" value={ v.Delivery.Street } required maxlength="200"/>
									</div>
								</div>
							}
							if v.DeliveryError != "" {
								<p id="d-postal-error" class="ui-error-text" role="alert">{ v.DeliveryError }</p>
							}
							<p class="goen-admin__hint">
								{ i18n.T(ctx, i18n.KeyAdminQueueDeliveryHint) }
							</p>
							@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
								{ i18n.T(ctx, i18n.KeyAdminQueueDeliverySave) }
							}
						</form>
					}
				}
				if len(v.Shipments) > 0 {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDispatch) }</h2>
						<ul class="goen-admin__timeline" role="list">
							for _, sh := range v.Shipments {
								<li class="goen-admin__event">
									<span class="goen-admin__eventhead">{ sh.Carrier } · { sh.Tracking }</span>
									if sh.Delivered() {
										<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueDelivered), sh.DeliveredAt) }</span>
									} else {
										<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueDispatched), sh.ShippedAt) }</span>
									}
								</li>
							}
						</ul>
					}
				}
				if len(v.Timeline) > 0 {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueTimeline) }</h2>
						<ul class="goen-admin__timeline" role="list">
							for _, e := range v.Timeline {
								<li class="goen-admin__event">
									<span class="goen-admin__eventhead">{ i18n.T(ctx, e.LabelKey()) }</span>
									<span class="goen-admin__meta">{ e.At } · { e.By(ctx) }</span>
									if e.Note != "" {
										<span class="goen-admin__meta">{ e.Note }</span>
									}
								</li>
							}
						</ul>
					}
				}
				if v.HasCustomerNote() {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueCustomerNote) }</h2>
						<p class="goen-admin__note">{ v.CustomerNote }</p>
					}
				}
				@components.Card(components.CardProps{Class: "goen-admin__op"}) {
					<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueStaffNote) }</h2>
					<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/note") }>
						<label class="goen-sr-only" for="staff-note">{ i18n.T(ctx, i18n.KeyAdminQueueStaffNote) }</label>
						<textarea class="ui-textarea" id="staff-note" name="note" rows="3" maxlength="1000">{ v.StaffNote }</textarea>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueStaffNoteHint) }</p>
						@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminQueueNoteSave) }
						}
					</form>
				}
			</div>
			<aside class="goen-admin__orderside">
				@components.Card(components.CardProps{Class: "goen-admin__ordersummary"}) {
					<div class="goen-admin__totalrow">
						<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
						<span class="goen-admin__totalval">{ v.Subtotal() }</span>
					</div>
					<div class="goen-admin__totalrow">
						<span>{ i18n.T(ctx, i18n.KeyShippingFee) }</span>
						<span class="goen-admin__totalval">{ v.Shipping() }</span>
					</div>
					if v.Discounted() {
						<div class="goen-admin__totalrow">
							<span>
								{ i18n.T(ctx, i18n.KeyDiscount) }
								if v.DiscountReason != "" {
									({ v.DiscountReason })
								}
							</span>
							<span class="goen-admin__totalval">{ v.Discount() }</span>
						</div>
					}
					<div class="goen-admin__totalrow goen-admin__totalrow--grand">
						<span>{ i18n.T(ctx, i18n.KeyOrderGrandTotal) }</span>
						<span class="goen-admin__totalval">{ v.Total() }</span>
					</div>
				}
				if v.CanShip {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDispatch) }</h2>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/ship") }>
							<div class="ui-field">
								<label class="ui-label" for="ship-carrier">{ i18n.T(ctx, i18n.KeyAdminColCarrier) }</label>
								<input class="ui-input" id="ship-carrier" name="carrier" required maxlength="60" autocomplete="off"/>
							</div>
							<div class="ui-field">
								<label class="ui-label" for="ship-tracking">{ i18n.T(ctx, i18n.KeyAdminQueueTracking) }</label>
								<input class="ui-input" id="ship-tracking" name="tracking" required maxlength="60" autocomplete="off"/>
							</div>
							for _, l := range v.Shippable {
								<div class="ui-field">
									<label class="ui-label" for={ "qty-" + l.OrderLineID }>
										{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueRemaining), l.Line(), l.RemainingText()) }
									</label>
									<input
										class="ui-input"
										id={ "qty-" + l.OrderLineID }
										type="number"
										name={ "qty_" + l.OrderLineID }
										value={ l.RemainingText() }
										min="0"
										max={ l.RemainingText() }
									/>
									// A line holding less than it owes cannot ship: no movement is posted.
									if l.Short() {
										<p class="goen-admin__hint">
											{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueShortHold), l.HeldText()) }
										</p>
									}
								</div>
							}
							@components.Button(components.ButtonProps{Variant: components.VariantPrimary, Block: true}, "submit") {
								{ i18n.T(ctx, i18n.KeyAdminQueueDispatch) }
							}
							<p class="goen-admin__hint">
								{ i18n.T(ctx, i18n.KeyAdminQueueDispatchHint) }
							</p>
						</form>
					}
				}
				if v.CanAdvance() {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueNextStatus) }</h2>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/status") }>
							<div class="ui-field">
								<label class="ui-label" for="next-status">{ i18n.T(ctx, i18n.KeyAdminQueueNextStatus) }</label>
								<select class="ui-select" id="next-status" name="status">
									for _, n := range v.Next {
										<option value={ string(n.Value) }>{ n.Label }</option>
									}
								</select>
							</div>
							if v.CanShip {
								@components.Button(components.ButtonProps{Variant: components.VariantOutline, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueStatusSave) }
								}
							} else {
								@components.Button(components.ButtonProps{Variant: components.VariantPrimary, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueStatusSave) }
								}
							}
							<p class="goen-admin__hint">
								{ i18n.T(ctx, i18n.KeyAdminQueueNextHint) }
							</p>
						</form>
					}
				} else {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueFinal) }</p>
				}
				@components.Card(components.CardProps{Class: "goen-admin__op", Attrs: templ.Attributes{"aria-labelledby": "invoice-heading"}}) {
					<h2 class="goen-admin__optitle" id="invoice-heading">{ i18n.T(ctx, i18n.KeyAdminDocInvoice) }</h2>
					if !v.InvoicingEnabled {
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminQueueNoInvoicing) }
						</p>
					} else {
						if len(v.InvoiceDocuments) > 0 {
							<ul class="goen-admin__timeline" role="list">
								for _, d := range v.InvoiceDocuments {
									<li class="goen-admin__event">
										<span class="goen-admin__eventhead">
											{ d.KindText(ctx) } { d.Number } · { d.Amount() }
										</span>
										if d.Voided() {
											@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
												{ i18n.T(ctx, i18n.KeyAdminQueueVoided) }
											}
										}
										if d.Pending() {
											@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
												{ i18n.T(ctx, i18n.KeyAdminQueuePending) }
											}
										}
										<span class="goen-admin__meta">{ d.IssuedAt }</span>
										if d.ProviderRef != "" {
											<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueRandomCode), d.ProviderRef) }</span>
										}
										for _, l := range d.Lines {
											<span class="goen-admin__meta">{ l.Line() }</span>
										}
									</li>
								}
							</ul>
						}
						if v.CanIssueInvoice() {
							<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/invoice") }>
								@components.Button(components.ButtonProps{Variant: components.VariantOutline, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueIssue) }
								}
								<p class="goen-admin__hint">
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueIssueHint), v.InvoiceText(ctx)) }
								</p>
							</form>
						}
						if v.CanVoidInvoice() {
							<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/invoice/void") }>
								<div class="ui-field">
									<label class="ui-label" for="void-reason">{ i18n.T(ctx, i18n.KeyAdminQueueVoidReason) }</label>
									<input class="ui-input" id="void-reason" name="reason" required maxlength="20" autocomplete="off"/>
								</div>
								@components.Button(components.ButtonProps{Variant: components.VariantOutline, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueVoid) }
								}
								<p class="goen-admin__hint">
									{ i18n.T(ctx, i18n.KeyAdminQueueVoidHint) }
								</p>
							</form>
						}
						if v.CanAllowInvoice() {
							// The door 折讓 never had. internal/invoice has filed
							// them since the feature shipped; nothing could reach
							// it, so a refunded customer left the 統一發票 still
							// recording the whole sale.
							<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/invoice/allowance") }>
								<input type="hidden" name="operation_id" value={ v.AllowanceOperationID }/>
								@components.Button(components.ButtonProps{Variant: components.VariantOutline, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueAllowance) }
								}
								<p class="goen-admin__hint">
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueAllowanceHint), v.AllowanceAmount()) }
								</p>
							</form>
						}
						if !v.CanIssueInvoice() && !v.CanVoidInvoice() && len(v.InvoiceDocuments) == 0 {
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueNotCommitted) }</p>
						}
					}
				}
			</aside>
		</div>
	}
}

// AdminVariants renders the stock list and its editing forms.
templ AdminVariants(p layouts.Page, v AdminVariantsView) {
	@layouts.Admin(p, "stock") {
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminQueueStock) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminQueueStockLead) }
				</p>
			</div>
		</div>
		if v.HasNotice() {
			<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
		}
		<div class="ui-filterbar">
			<a class={ "ui-filter", templ.KV("is-active", !v.LowOnly) } href="/admin/stock">{ i18n.T(ctx, i18n.KeyAdminTabAll) }</a>
			<a class={ "ui-filter", templ.KV("is-active", v.LowOnly) } href="/admin/stock?low=1">{ i18n.T(ctx, i18n.KeyAdminQueueLowOnly) }</a>
		</div>
		if v.Empty() {
			<div class="ui-empty">
				<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeyAdminQueueNoVariants) }</p>
			</div>
		} else {
			<div class="goen-admin__tablewrap">
				@adminVariantTable(v.Variants)
			</div>
			// Ordered by how short of stock each line is, then by name — not by
			// time — so this one says "the first", not "the most recent". And
			// no second sentence: the All / low-only pair above is a toggle,
			// not a way to reach the fifty-first row of either.
			@listBound(v.ListBound, ByOwnOrder, false)
		}
	}
}

templ adminVariantTable(variants []AdminVariant) {
	<table class="ui-table goen-admin__table">
		<thead>
			<tr>
				<th scope="col">SKU</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColProduct) }</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminQueueColStock) }</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminQueueColPrice) }</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminQueueAdjust) }</th>
			</tr>
		</thead>
		<tbody>
			for _, x := range variants {
				<tr class={ templ.KV("goen-admin__row--low", x.Low()) }>
					<td>
						<a href={ templ.SafeURL("/admin/stock/" + x.SKU) }>{ x.SKU }</a>
						<span class="ui-cart-line__meta">
							<a href={ templ.URL("/p/" + x.Slug) }>{ i18n.T(ctx, i18n.KeyAdminQueueViewProduct) }</a>
						</span>
						if !x.Active {
							<span class="ui-badge">{ i18n.T(ctx, i18n.KeyAdminQueueVariantOff) }</span>
						}
					</td>
					<td>
						{ x.ProductName }
						<span class="ui-cart-line__meta">{ x.Brand }</span>
					</td>
					<td>
						{ x.StockText() } / { x.SafetyText() } /
						<strong>{ x.SellableText() }</strong>
					</td>
					<td>
						<form class="goen-admin__inline" method="post" action="/admin/stock/price">
							<input type="hidden" name="sku" value={ x.SKU }/>
							<label class="goen-sr-only" for={ "price-" + x.SKU }>{ i18n.T(ctx, i18n.KeyAdminQueuePrice) }</label>
							<input class="ui-input ui-input--sm goen-admin__num" id={ "price-" + x.SKU } type="number" name="price" value={ x.PriceText() } min="0" step="1"/>
							<label class="goen-sr-only" for={ "cmp-" + x.SKU }>{ i18n.T(ctx, i18n.KeyAdminQueueComparePrice) }</label>
							<input
								class="ui-input ui-input--sm goen-admin__num"
								id={ "cmp-" + x.SKU }
								type="number"
								name="compare_at"
								value={ x.CompareText() }
								min="0"
								step="1"
								placeholder={ i18n.T(ctx, i18n.KeyAdminQueueComparePrice) }
							/>
							<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminQueuePriceSave) }</button>
						</form>
					</td>
					<td>
						<form class="goen-admin__inline" method="post" action="/admin/stock/adjust">
							<input type="hidden" name="sku" value={ x.SKU }/>
							<input type="hidden" name="idempotency" value={ x.AdjustKey() }/>
							<label class="goen-sr-only" for={ "adj-" + x.SKU }>{ i18n.T(ctx, i18n.KeyAdminQueueAdjustQty) }</label>
							<input class="ui-input ui-input--sm goen-admin__num" id={ "adj-" + x.SKU } type="number" name="delta" placeholder="+10" step="1"/>
							<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminQueueAdjust) }</button>
						</form>
						<form class="goen-admin__inline" method="post" action="/admin/stock/active">
							<input type="hidden" name="sku" value={ x.SKU }/>
							if x.Active {
								<input type="hidden" name="active" value="0"/>
								<button class="ui-btn ui-btn--ghost ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminToggleOff) }</button>
							} else {
								<input type="hidden" name="active" value="1"/>
								<button class="ui-btn ui-btn--ghost ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminToggleOn) }</button>
							}
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
