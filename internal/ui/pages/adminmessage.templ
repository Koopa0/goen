package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminMessages renders the customer-service inbox.
templ AdminMessages(p layouts.Page, v AdminMessagesView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("messages")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageMessages) }</h1>
					<p class="ui-page-head__sub">
						{ i18n.T(ctx, i18n.KeyAdminMessagesLead) }
					</p>
				</div>
				if !v.Empty() {
					<div class="ui-page-head__actions">
						<span class="ui-badge">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminMessagesOpen), v.OpenCountText()) }</span>
					</div>
				}
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			if v.Empty() {
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminMessagesEmpty) }</p>
			} else {
				<ul class="goen-admin__returns" role="list">
					for _, m := range v.Rows {
						<li
							class={ "goen-admin__return",
								templ.KV("is-hidden", m.Handled),
								templ.KV("is-urgent", m.Overdue()) }
						>
							<div class="goen-admin__returninfo">
								<p class="goen-admin__returnorder">{ m.Subject }</p>
								<span class="ui-cart-line__meta">
									{ m.Name } · { m.Email } · { m.At } · { m.Waiting(ctx) }
								</span>
								if m.HasOrderRef() {
									<span class="ui-cart-line__meta">
										{ i18n.T(ctx, i18n.KeyAdminMessagesOrder) } <a class="goen-admin__productname" href={ templ.SafeURL(m.OrderHref()) }>{ m.OrderRef }</a>
									</span>
								}
								<p class="goen-admin__note">{ m.Message }</p>
							</div>
							<form class="goen-admin__decide" method="post" action={ templ.SafeURL(m.Action()) }>
								<input type="hidden" name="message" value={ m.ID }/>
								<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ m.ActionLabel(ctx) }</button>
							</form>
						</li>
					}
				</ul>
			}
		</div>
	}
}
