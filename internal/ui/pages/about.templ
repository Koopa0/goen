package pages

import (
	"context"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

func AboutMeta(ctx context.Context) layouts.Page {
	return layouts.Page{
		Title:       i18n.T(ctx, i18n.KeyAboutTitle),
		Description: describeDepartments(ctx, i18n.KeyAboutDescription),
	}
}

templ About(p layouts.Page) {
	@layouts.Base(p) {
		<article class="about">
			@aboutArt()
			<h1 class="about__title">{ i18n.T(ctx, i18n.KeyAboutTitle) }</h1>
			<p class="about__lede">
				{ i18n.T(ctx, i18n.KeyAboutName) }
			</p>
			<p class="about__lede">
				{ i18n.T(ctx, i18n.KeyAboutSelection) }
			</p>
			<div class="about__values">
				<section class="about__value">
					<h2 class="about__valuetitle">{ i18n.T(ctx, i18n.KeyAboutSpecs) }</h2>
					<p class="about__valuebody">{ i18n.T(ctx, i18n.KeyAboutSpecsBody) }</p>
				</section>
				<section class="about__value">
					<h2 class="about__valuetitle">{ i18n.T(ctx, i18n.KeyAboutWarranty) }</h2>
					<p class="about__valuebody">{ i18n.T(ctx, i18n.KeyAboutWarrantyBody) }</p>
				</section>
				if list := departments(ctx); list != "" {
					<section class="about__value">
						<h2 class="about__valuetitle">{ i18n.T(ctx, i18n.KeyAboutCurated) }</h2>
						<p class="about__valuebody">{ list }</p>
					</section>
				}
			</div>
		</article>
	}
}

// aboutArt is the mark drawn large and hidden from assistive technology.
// Colours come from app.css classes because the site's CSP refuses inline style.
templ aboutArt() {
	<svg class="about__art" data-tone="paper" viewBox="0 0 1600 900" aria-hidden="true" focusable="false">
		<path class="about__lens" d="M 715.6 534.4 A 193 193 0 0 0 884.4 365.6 A 193 193 0 0 0 715.6 534.4 Z"></path>
		<circle class="about__ring" cx="692.8" cy="342.8" r="193" vector-effect="non-scaling-stroke"></circle>
		<circle class="about__ring about__ring--accent" cx="907.2" cy="557.2" r="193" vector-effect="non-scaling-stroke"></circle>
	</svg>
}
