package pages

import (
	"context"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AboutMeta is the chrome view model for the about page.
func AboutMeta(ctx context.Context) layouts.Page {
	return layouts.Page{
		Title:       i18n.T(ctx, i18n.KeyAboutTitle),
		Description: i18n.T(ctx, i18n.KeyAboutDescription),
	}
}

// About renders the about page.
templ About(p layouts.Page) {
	@layouts.Base(p) {
		<article class="about">
			<img
				class="about__photo"
				src={ assets.URL(assets.AboutImage) }
				srcset={ assets.AboutSrcset() }
				sizes="(min-width: 768px) 720px, calc(100vw - 32px)"
				alt={ i18n.T(ctx, i18n.KeyAboutImageAlt) }
				width="1600"
				height="900"
				decoding="async"
			/>
			<h1 class="about__title">{ i18n.T(ctx, i18n.KeyTagline) }</h1>
			<p class="about__lede">
				{ i18n.T(ctx, i18n.KeyAboutName) }
			</p>
			<p class="about__lede">
				{ i18n.T(ctx, i18n.KeyAboutSelection) }
			</p>
			<div class="about__values">
				<section class="about__value">
					<h2 class="about__valuetitle">{ i18n.T(ctx, i18n.KeyAboutSpecs) }</h2>
					<p class="about__valuebody">{ i18n.T(ctx, i18n.KeyAboutSpecsBody) }</p>
				</section>
				<section class="about__value">
					<h2 class="about__valuetitle">{ i18n.T(ctx, i18n.KeyAboutWarranty) }</h2>
					<p class="about__valuebody">{ i18n.T(ctx, i18n.KeyAboutWarrantyBody) }</p>
				</section>
				<section class="about__value">
					<h2 class="about__valuetitle">{ i18n.T(ctx, i18n.KeyAboutCurated) }</h2>
					<p class="about__valuebody">{ i18n.T(ctx, i18n.KeyAboutCuratedBody) }</p>
				</section>
			</div>
			<hr class="goen-separator"/>
			<p class="about__legal">
				// i18n-exempt: a company registration line: the legal name and a Taiwanese tax number.
				goen Co., Ltd. · 統編 90123456
				<br/>
				// i18n-exempt: a street address; a courier reads it.
				台北市信義區松高路 68 號 12F · est. 2026
			</p>
		</article>
	}
}
