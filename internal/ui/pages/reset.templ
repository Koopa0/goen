package pages

import (
	"github.com/koopa0/goen/internal/fieldrule"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Forgot(p layouts.Page, v ForgotView) {
	@layouts.Base(p) {
		<div class="goen-auth">
			<div class="goen-auth__panel">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyForgotTitle) }</h1>
				<p class="goen-auth__lede">{ i18n.T(ctx, i18n.KeyForgotSub) }</p>
				if v.Sent {
					@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "forgot-sent"}) {
						{ i18n.T(ctx, i18n.KeyForgotSent) }
					}
				}
				if v.Notice != "" {
					@components.Notice(components.NoticeProps{Intent: components.IntentWarn}) {
						{ v.Notice }
					}
				}
				<form class="goen-auth__form" method="post" action="/forgot">
					<div class="goen-field">
						@components.Label(components.LabelProps{For: "email"}) {
							{ i18n.T(ctx, i18n.KeyFieldEmail) }
						}
						@components.Input(components.FieldProps{
							ID:   "email",
							Name: "email",
							Type: "email",
							Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
								"autocomplete": "email",
								"autofocus":    true,
								"maxlength":    "254",
								"required":     true,
							}),
						})
					</div>
					@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge, Block: true}, "submit") {
						{ i18n.T(ctx, i18n.KeyForgotSubmit) }
					}
				</form>
				<p class="goen-auth__alt">
					{ i18n.T(ctx, i18n.KeyRemembered) }
					<a href="/signin">{ i18n.T(ctx, i18n.KeyBackToSignIn) }</a>
				</p>
			</div>
		</div>
	}
}

templ Reset(p layouts.Page, v ResetView) {
	if v.Usable() {
		@layouts.Base(p) {
			<div class="goen-auth">
				<div class="goen-auth__panel">
					<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyResetTitle) }</h1>
					<form class="goen-auth__form" method="post" action="/reset">
						<input type="hidden" name="token" value={ v.Token }/>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "password"}) {
								{ i18n.T(ctx, i18n.KeyFieldNewPassword) }
							}
							@components.Input(components.FieldProps{
								ID:        "password",
								Name:      "password",
								Type:      "password",
								Invalid:   v.Invalid("password"),
								Describes: "reset-error",
								Attrs: v.PasswordAttrs(templ.Attributes{
									"autocomplete": "new-password",
									"autofocus":    true,
									"minlength":    "10",
									"required":     true,
								}),
							})
							if v.Invalid("password") {
								<p class="ui-error-text" id="reset-error" role="alert">{ v.Error }</p>
							} else {
								<p class="goen-auth__hint" id="password-hint">{ i18n.T(ctx, i18n.KeyPasswordHint) }</p>
							}
						</div>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "confirm"}) {
								{ i18n.T(ctx, i18n.KeyFieldConfirmPassword) }
							}
							@components.Input(components.FieldProps{
								ID:        "confirm",
								Name:      "confirm",
								Type:      "password",
								Invalid:   v.Invalid("confirm"),
								Describes: "reset-error",
								Attrs: templ.Attributes{
									"autocomplete": "new-password",
									"minlength":    "10",
									"required":     true,
								},
							})
							if v.Invalid("confirm") {
								<p class="ui-error-text" id="reset-error" role="alert">{ v.Error }</p>
							}
						</div>
						<p class="goen-auth__hint">{ i18n.T(ctx, i18n.KeyResetEndsSessions) }</p>
						@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge, Block: true}, "submit") {
							{ i18n.T(ctx, i18n.KeyResetTitle) }
						}
					</form>
				</div>
			</div>
		}
	} else {
		@EmailLinkPage(p, v.RecoveryView(ctx))
	}
}
