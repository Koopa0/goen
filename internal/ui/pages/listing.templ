package pages

import (
	"fmt"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Listing renders a category page: a head on the department's ground with its
// photograph, a lead row on a long shelf, the filter rail and the product grid.
// The rail is a native <details> at every width; above 1024 the stylesheet
// holds it open and hides its summary.
templ Listing(p layouts.Page, v ListingView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<div class="goen-pagehead" data-tone={ v.Theme.ToneAttr() }>
				<div class="goen-pagehead__text">
					@components.Breadcrumb(components.BreadcrumbProps{
						Label:  i18n.T(ctx, i18n.KeyBreadcrumb),
						Crumbs: v.Trail(ctx),
					})
					<h1 class="goen-pagehead__title">{ v.Name }</h1>
					if len(v.Children()) > 0 {
						<nav class="goen-pagehead__chips" aria-label={ i18n.T(ctx, i18n.KeySubcategories) }>
							for _, c := range v.Children() {
								if c.Slug == v.Slug {
									<a class="goen-pagehead__chip" href={ templ.URL("/c/" + c.Slug) } aria-current="page">{ c.Name }</a>
								} else {
									<a class="goen-pagehead__chip" href={ templ.URL("/c/" + c.Slug) }>{ c.Name }</a>
								}
							}
						</nav>
					}
				</div>
				if v.Theme.Image().Shown() {
					// Lazy because the stylesheet drops the photograph below 1024: a
					// hidden lazy image is never fetched, an eager one always is.
					<img
						class="goen-pagehead__photo"
						src={ v.Theme.Image().URL }
						srcset={ v.Theme.Image().Srcset }
						sizes="(min-width: 1344px) 36rem, 45vw"
						alt={ v.Theme.Image().Alt }
						loading="lazy"
						decoding="async"
					/>
				}
			</div>
			if len(v.Featured()) > 0 {
				// The lead row sits outside the layout the gate reads as rail and
				// results, and its compare boxes join the grid's form by id.
				<section class="goen-featured" aria-labelledby="featured-heading">
					<h2 class="goen-sr-only" id="featured-heading">{ i18n.T(ctx, i18n.KeyFeaturedHeading) }</h2>
					<ul class="goen-featured__grid" role="list">
						for _, t := range v.Featured() {
							@Tile(t)
						}
					</ul>
				</section>
			}
			<div class="goen-listing__layout">
				@listingFilters(v)
				<div
					class="goen-listing__results"
					id="listing-results"
					tabindex="-1"
					autofocus?={ v.Filtered && !isPartial(ctx) }
				>
					if v.Empty() {
						<div class="ui-empty">
							@emptyArt(assets.EmptySearchImage)
							<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyListingEmpty) }</p>
							<p class="goen-empty__text">
								{ i18n.T(ctx, i18n.KeyListingEmptyHint) }
								<a href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyListingEmptyLink) }</a>
							</p>
						</div>
					} else {
						// The grid's heading, visually hidden: without it a tile's h3 skips a level.
						<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
						<p class="goen-listing__count" aria-hidden="true">{ i18n.Count(ctx, i18n.KeyListingCount, v.Total, v.TotalText()) }</p>
						@compareForm(AnyComparable(v.Grid()) || AnyComparable(v.Featured())) {
							<ul class="goen-tiles__grid" role="list">
								for _, t := range v.Grid() {
									@Tile(t)
								}
							</ul>
						}
						@numberedPager(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageLinks())
					}
				</div>
			</div>
		</div>
	}
}

templ listingFilters(v ListingView) {
	<div class="goen-listing__filters">
		<details class="goen-filters__shell">
			<summary class="goen-filters__shell-summary">{ i18n.T(ctx, i18n.KeyFiltersAndSort) }</summary>
			// With script, a changed control fetches the same URL the button would
			// have navigated to and swaps the results, the active chips and the
			// announced count; the button stays for a browser without script.
			// Typing in a price box fires nothing until the box is left or Enter.
			<form
				class="goen-filters"
				method="get"
				action={ templ.SafeURL(v.FilterAction()) }
				hx-get={ "/c/" + v.Slug }
				hx-trigger="change delay:300ms"
				hx-target="#listing-results"
				hx-select="#listing-results"
				hx-select-oob="#filters-applied, #listing-status:innerHTML"
				hx-swap="outerHTML"
				hx-push-url="true"
				hx-sync="this:replace"
				hx-status:4xx="swap:none"
				hx-status:5xx="swap:none"
			>
				// The rail's own heading. It keeps the outline unbroken: without an h2
				// between the page title and a tile's h3 the document skips a level,
				// which `check-layout.mjs:370-378` reads as a defect.
				<h2 class="goen-filters__title">{ i18n.T(ctx, i18n.KeyFilters) }</h2>
				if len(v.Brands) > 0 {
					<details class="goen-filters__group" open>
						<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetBrand) }</summary>
						<div class="goen-filters__options">
							for _, b := range v.Brands {
								<label class="goen-filters__option">
									<input
										type="checkbox"
										name="brand"
										value={ b.Value }
										class="goen-check"
										checked?={ b.Selected }
									/>
									<span class="goen-filters__label">{ b.Label }</span>
									<span class="goen-filters__count">{ b.CountText() }</span>
								</label>
							}
						</div>
					</details>
				}
				<details class="goen-filters__group" open>
					<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetStock) }</summary>
					<div class="goen-filters__options">
						<label class="goen-filters__option">
							<input type="checkbox" name="in_stock" value="1" class="goen-check" checked?={ v.InStockOnly }/>
							<span class="goen-filters__label">{ i18n.T(ctx, i18n.KeyFacetInStock) }</span>
						</label>
					</div>
				</details>
				<details class="goen-filters__group" open>
					<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetPrice) }</summary>
					<div class="goen-filters__prices">
						<label class="goen-sr-only" for="min-price">{ i18n.T(ctx, i18n.KeyPriceMin) }</label>
						// ui-input is what `check-layout.mjs:668` looks for to decide the
						// desktop rail rendered at all, and what its tap sweep at :805
						// measures. The spelling is the hook; app.css writes the recipe.
						<input
							class="ui-input"
							id="min-price"
							type="number"
							name="min_price"
							inputmode="numeric"
							min="0"
							placeholder={ i18n.T(ctx, i18n.KeyPriceMinShort) }
							value={ v.MinPriceText() }
						/>
						<span class="goen-filters__dash" aria-hidden="true">–</span>
						<label class="goen-sr-only" for="max-price">{ i18n.T(ctx, i18n.KeyPriceMax) }</label>
						<input
							class="ui-input"
							id="max-price"
							type="number"
							name="max_price"
							inputmode="numeric"
							min="0"
							placeholder={ i18n.T(ctx, i18n.KeyPriceMaxShort) }
							value={ v.MaxPriceText() }
						/>
					</div>
				</details>
				<div class="goen-filters__field">
					@components.Label(components.LabelProps{For: "sort"}) {
						{ i18n.T(ctx, i18n.KeySort) }
					}
					<select class="ui-select" id="sort" name="sort">
						for _, o := range v.SortOptions(ctx) {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</div>
				@components.Button(components.ButtonProps{
					Variant: components.VariantPrimary,
					Block:   true,
					Class:   "goen-filters__apply",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyApplyFilters) }
				}
			</form>
		</details>
		// Shown by script when an update fails: the old results stay on the page
		// and this says why they did not change.
		<p class="goen-filters__error" role="alert" hidden>{ i18n.T(ctx, i18n.KeyCannotLoadListing) }</p>
		<div id="filters-applied">
			if v.Filtered {
				<div class="goen-filters__applied">
					<span class="goen-filters__applied-label">{ i18n.T(ctx, i18n.KeyFiltersActive) }</span>
					<ul class="goen-filters__chips" role="list">
						for _, chip := range v.AppliedChips(ctx) {
							<li class="goen-filters__chip">{ chip }</li>
						}
					</ul>
					<a class="ui-filterbar__clear" href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyClearFilters) }</a>
				</div>
			}

		</div>
		// The count is announced from here, a region that stays in the page while
		// the results around it are replaced, and focus is left where it is.
		<p id="listing-status" class="goen-sr-only" role="status" aria-live="polite">{ i18n.Count(ctx, i18n.KeyListingCount, v.Total, v.TotalText()) }</p>
	</div>
}

// pager is two links and a sentence. The end of the run stays visible as a
// disabled span rather than disappearing, so the control does not move.
templ pager(label string, hasPrev, hasNext bool, prev, next, page, pages string) {
	if hasPrev || hasNext {
		<nav class="goen-pager" aria-label={ label }>
			if hasPrev {
				<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(prev) } rel="prev">{ i18n.T(ctx, i18n.KeyPrevPage) }</a>
			} else {
				<span class="goen-btn goen-btn--outline goen-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyPrevPage) }</span>
			}
			<span class="goen-pager__at">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPageOf), page, pages) }</span>
			if hasNext {
				<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(next) } rel="next">{ i18n.T(ctx, i18n.KeyNextPage) }</a>
			} else {
				<span class="goen-btn goen-btn--outline goen-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyNextPage) }</span>
			}
		</nav>
	}
}

// numberedPager is the listing's pager: the pages as numbers with the current
// one marked, and an arrow either side. The end of the run stays visible as a
// disabled span rather than disappearing, so the control does not move.
templ numberedPager(hasPrev, hasNext bool, prev, next string, links []PageLink) {
	if len(links) > 1 {
		<nav class="goen-pager goen-pager--numbered" aria-label={ i18n.T(ctx, i18n.KeyPagination) }>
			if hasPrev {
				<a class="goen-pager__step" href={ templ.URL(prev) } rel="prev" aria-label={ i18n.T(ctx, i18n.KeyPrevPage) }><span aria-hidden="true">‹</span></a>
			} else {
				<span class="goen-pager__step" aria-disabled="true"><span aria-hidden="true">‹</span><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyPrevPage) }</span></span>
			}
			for _, l := range links {
				if l.Gap {
					<span class="goen-pager__gap" aria-hidden="true">…</span>
				} else if l.Current {
					<span class="goen-pager__page" aria-current="page"><span class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPageNumber), l.Label) }</span><span aria-hidden="true">{ l.Label }</span></span>
				} else {
					<a class="goen-pager__page" href={ templ.URL(l.Href) } aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyPageNumber), l.Label) }>{ l.Label }</a>
				}
			}
			if hasNext {
				<a class="goen-pager__step" href={ templ.URL(next) } rel="next" aria-label={ i18n.T(ctx, i18n.KeyNextPage) }><span aria-hidden="true">›</span></a>
			} else {
				<span class="goen-pager__step" aria-disabled="true"><span aria-hidden="true">›</span><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyNextPage) }</span></span>
			}
		</nav>
	}
}

// Search renders the search results page: a plain head, then the grid. The
// search has no facets of its own, so there is no filter rail.
templ Search(p layouts.Page, v SearchView) {
	@layouts.Base(p) {
		<div class="goen-listing goen-listing--search">
			<div class="goen-pagehead goen-pagehead--search">
				<h1 class="goen-pagehead__title">
					if v.Searched() {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchFor), v.Query) }
					} else {
						{ i18n.T(ctx, i18n.KeySearchHeading) }
					}
				</h1>
				if v.Searched() {
					<p class="goen-pagehead__sub">{ i18n.Count(ctx, i18n.KeySearchResults, v.Total, v.TotalText()) }</p>
				}
			</div>
			if !v.Searched() {
				<div class="ui-empty">
					@emptyArt(assets.EmptySearchImage)
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeySearchPrompt) }</p>
					<p class="goen-empty__text">{ i18n.T(ctx, i18n.KeySearchPromptHint) }</p>
				</div>
			} else if v.Empty() {
				<div class="ui-empty">
					@emptyArt(assets.EmptySearchImage)
					<p class="goen-empty__title">{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchNoResults), v.Query) }</p>
					<p class="goen-empty__text">{ i18n.T(ctx, i18n.KeySearchNoResultsHint) }</p>
					if len(layouts.TopNavFrom(ctx)) > 0 {
						<ul class="goen-empty__links" role="list">
							for _, n := range layouts.TopNavFrom(ctx) {
								<li><a class="goen-pagehead__chip" href={ templ.URL(n.Href) }>{ n.Name }</a></li>
							}
						</ul>
					}
				</div>
			} else {
				// The grid's heading, visually hidden: without it a tile's h3 skips a level.
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				@compareForm(AnyComparable(v.Products)) {
					<ul class="goen-tiles__grid" role="list">
						for _, t := range FirstRowEager(v.Products) {
							@Tile(t)
						}
					</ul>
				}
				@numberedPager(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageLinks())
			}
		</div>
	}
}
