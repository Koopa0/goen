package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Listing renders a category page: crumbs, the filter panel, and the product
// grid.
//
// Everything here is the design system's own vocabulary — ui-crumbs, ui-check,
// ui-filterbar, ui-pagination, ui-empty, ui-product — because it already
// defines all of it. goen-* owns only the two-column composition and the fold
// that puts the filters above the grid on a small screen.
//
// The filter panel is a plain GET form. Filtering is a read, so it needs no
// POST, and with scripting off the browser submits it and the server answers a
// whole page. Each group is a native <details>, which discloses without script.
templ Listing(p layouts.Page, v ListingView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<nav class="ui-crumbs goen-listing__crumbs" aria-label={ i18n.T(ctx, i18n.KeyBreadcrumb) }>
				<a href="/">{ i18n.T(ctx, i18n.KeyHome) }</a>
				for _, c := range v.Crumbs {
					<span class="ui-crumbs__sep" aria-hidden="true">/</span>
					<a href={ templ.URL("/c/" + c.Slug) }>{ c.Name }</a>
				}
				<span class="ui-crumbs__sep" aria-hidden="true">/</span>
				<span class="ui-crumbs__current" aria-current="page">{ v.Name }</span>
			</nav>
			<div class="ui-page-head goen-listing__head">
				<div>
					<h1 class="ui-page-head__title">{ v.Name }</h1>
					<p class="ui-page-head__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyListingCount), v.TotalText()) }</p>
				</div>
			</div>
			<div class="goen-listing__layout">
				@listingFilters(v)
				<div class="goen-listing__results">
					if v.Empty() {
						<div class="ui-empty">
							<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeyListingEmpty) }</p>
							<p class="ui-empty__desc">
								{ i18n.T(ctx, i18n.KeyListingEmptyHint) }
								<a href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyListingEmptyLink) }</a>
							</p>
						</div>
					} else {
						<ul class="goen-tiles__grid" role="list">
							for _, t := range v.Products {
								@Tile(t)
							}
						</ul>
						@pager(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
					}
				</div>
			</div>
		</div>
	}
}

// listingFilters is the filter panel: a GET form whose submit button is the
// only thing needed to apply it. The button is not hidden when scripting is on
// — goen has no client-side filtering, so hiding it would leave nothing to
// press.
templ listingFilters(v ListingView) {
	<form class="goen-filters" method="get" action={ templ.SafeURL("/c/" + v.Slug) }>
		<div class="goen-filters__head">
			<h2 class="goen-filters__title">{ i18n.T(ctx, i18n.KeyFilters) }</h2>
			if v.Filtered {
				<a class="ui-filterbar__clear" href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyClearFilters) }</a>
			}
		</div>
		if len(v.Brands) > 0 {
			<details class="goen-filters__group" open>
				<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetBrand) }</summary>
				<div class="goen-filters__options">
					for _, b := range v.Brands {
						<label class="ui-check goen-filters__option">
							<input
								type="checkbox"
								name="brand"
								value={ b.Value }
								checked?={ b.Selected }
							/>
							<span class="ui-check__box" aria-hidden="true"></span>
							<span class="goen-filters__label">{ b.Label }</span>
							<span class="ui-filter__count">{ b.CountText() }</span>
						</label>
					}
				</div>
			</details>
		}
		<details class="goen-filters__group" open>
			<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetStock) }</summary>
			<div class="goen-filters__options">
				<label class="ui-check goen-filters__option">
					<input type="checkbox" name="in_stock" value="1" checked?={ v.InStockOnly }/>
					<span class="ui-check__box" aria-hidden="true"></span>
					<span class="goen-filters__label">{ i18n.T(ctx, i18n.KeyFacetInStock) }</span>
				</label>
			</div>
		</details>
		<details class="goen-filters__group" open>
			<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetPrice) }</summary>
			<div class="goen-filters__prices">
				<label class="goen-sr-only" for="min-price">{ i18n.T(ctx, i18n.KeyPriceMin) }</label>
				<input
					class="ui-input ui-input--sm"
					id="min-price"
					type="number"
					name="min_price"
					inputmode="numeric"
					min="0"
					placeholder={ i18n.T(ctx, i18n.KeyPriceMinShort) }
					value={ v.MinPriceText() }
				/>
				<span class="goen-filters__dash" aria-hidden="true">–</span>
				<label class="goen-sr-only" for="max-price">{ i18n.T(ctx, i18n.KeyPriceMax) }</label>
				<input
					class="ui-input ui-input--sm"
					id="max-price"
					type="number"
					name="max_price"
					inputmode="numeric"
					min="0"
					placeholder={ i18n.T(ctx, i18n.KeyPriceMaxShort) }
					value={ v.MaxPriceText() }
				/>
			</div>
		</details>
		<div class="ui-field goen-filters__group">
			<label class="ui-label" for="sort">{ i18n.T(ctx, i18n.KeySort) }</label>
			<select class="ui-select" id="sort" name="sort">
				for _, o := range v.SortOptions(ctx) {
					<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
				}
			</select>
		</div>
		<button class="ui-btn ui-btn--primary ui-btn--block goen-filters__apply" type="submit">
			{ i18n.T(ctx, i18n.KeyApplyFilters) }
		</button>
	</form>
}

// pager is the previous/next control. Numbered links are deliberately absent:
// the catalogue is small, and a numbered pager over a filtered listing means
// building every page's URL to render links most visitors never use.
templ pager(hasPrev, hasNext bool, prev, next, page, pages string) {
	if hasPrev || hasNext {
		<nav class="goen-pager" aria-label={ i18n.T(ctx, i18n.KeyPagination) }>
			if hasPrev {
				<a class="ui-btn ui-btn--secondary ui-btn--sm" href={ templ.URL(prev) } rel="prev">{ i18n.T(ctx, i18n.KeyPrevPage) }</a>
			} else {
				<span class="ui-btn ui-btn--secondary ui-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyPrevPage) }</span>
			}
			<span class="goen-pager__at">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPageOf), page, pages) }</span>
			if hasNext {
				<a class="ui-btn ui-btn--secondary ui-btn--sm" href={ templ.URL(next) } rel="next">{ i18n.T(ctx, i18n.KeyNextPage) }</a>
			} else {
				<span class="ui-btn ui-btn--secondary ui-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyNextPage) }</span>
			}
		</nav>
	}
}

// Search renders the search results page. It has no filter panel: a visitor who
// typed a term is answering "do you have this", and facets over a cross-category
// result set would filter on options most of the matches do not share.
templ Search(p layouts.Page, v SearchView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<div class="ui-page-head goen-listing__head">
				<div>
					<h1 class="ui-page-head__title">
						if v.Searched() {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchFor), v.Query) }
						} else {
							{ i18n.T(ctx, i18n.KeySearchHeading) }
						}
					</h1>
					if v.Searched() {
						<p class="ui-page-head__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchResults), v.TotalText()) }</p>
					}
				</div>
			</div>
			if !v.Searched() {
				<div class="ui-empty">
					<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeySearchPrompt) }</p>
					<p class="ui-empty__desc">{ i18n.T(ctx, i18n.KeySearchPromptHint) }</p>
				</div>
			} else if v.Empty() {
				<div class="ui-empty">
					<p class="ui-empty__title">{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchNoResults), v.Query) }</p>
					<p class="ui-empty__desc">
						{ i18n.T(ctx, i18n.KeySearchNoResultsHint) }
						<a href="/">{ i18n.T(ctx, i18n.KeySearchNoResultsLink) }</a>
					</p>
				</div>
			} else {
				// The grid's heading, visually hidden. A product tile's name is an
				// h3, and on this page the nearest heading above it is the page's own
				// h1 — a skipped level, which breaks the outline a screen-reader user
				// navigates by. The listing page never had the problem because its
				// filter panel supplies an h2.
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				<ul class="goen-tiles__grid" role="list">
					for _, t := range v.Products {
						@Tile(t)
					}
				</ul>
				@pager(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
			}
		</div>
	}
}
