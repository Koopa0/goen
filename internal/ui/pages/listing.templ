package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Listing renders a category page: the trail, the page head, the filter rail
// and the product grid. The rail is a native <details> at every width; above
// 1024 the stylesheet holds it open and hides its summary.
templ Listing(p layouts.Page, v ListingView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			@components.Breadcrumb(components.BreadcrumbProps{
				Label:  i18n.T(ctx, i18n.KeyBreadcrumb),
				Crumbs: v.Trail(ctx),
			})
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ v.Name }</h1>
				<p class="goen-pagehead__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyListingCount), v.TotalText()) }</p>
			</div>
			<div class="goen-listing__layout">
				@listingFilters(v)
				<div
					class="goen-listing__results"
					id="listing-results"
					tabindex="-1"
					autofocus?={ v.Filtered }
				>
					if v.Empty() {
						<div class="ui-empty">
							<span class="goen-medallion" aria-hidden="true">
								@icons.Search()
							</span>
							<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyListingEmpty) }</p>
							<p class="goen-empty__text">
								{ i18n.T(ctx, i18n.KeyListingEmptyHint) }
								<a href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyListingEmptyLink) }</a>
							</p>
						</div>
					} else {
						// The grid's heading, visually hidden: without it a tile's h3 skips a level.
						<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
						@compareForm() {
							<ul class="goen-tiles__grid" role="list">
								for _, t := range v.Products {
									@Tile(t)
								}
							</ul>
						}
						@pager(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
					}
				</div>
			</div>
		</div>
	}
}

templ listingFilters(v ListingView) {
	<div class="goen-listing__filters">
		<details class="goen-filters__shell">
			<summary class="goen-filters__shell-summary">{ i18n.T(ctx, i18n.KeyFiltersAndSort) }</summary>
			<form class="goen-filters" method="get" action={ templ.SafeURL(v.FilterAction()) }>
				// The rail's own heading. It keeps the outline unbroken: without an h2
				// between the page title and a tile's h3 the document skips a level,
				// which `check-layout.mjs:370-378` reads as a defect.
				<h2 class="goen-filters__title">{ i18n.T(ctx, i18n.KeyFilters) }</h2>
				if len(v.Brands) > 0 {
					<details class="goen-filters__group" open>
						<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetBrand) }</summary>
						<div class="goen-filters__options">
							for _, b := range v.Brands {
								<label class="goen-filters__option">
									<input
										type="checkbox"
										name="brand"
										value={ b.Value }
										class="goen-check"
										checked?={ b.Selected }
									/>
									<span class="goen-filters__label">{ b.Label }</span>
									<span class="goen-filters__count">{ b.CountText() }</span>
								</label>
							}
						</div>
					</details>
				}
				<details class="goen-filters__group" open>
					<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetStock) }</summary>
					<div class="goen-filters__options">
						<label class="goen-filters__option">
							<input type="checkbox" name="in_stock" value="1" class="goen-check" checked?={ v.InStockOnly }/>
							<span class="goen-filters__label">{ i18n.T(ctx, i18n.KeyFacetInStock) }</span>
						</label>
					</div>
				</details>
				<details class="goen-filters__group" open>
					<summary class="goen-filters__summary">{ i18n.T(ctx, i18n.KeyFacetPrice) }</summary>
					<div class="goen-filters__prices">
						<label class="goen-sr-only" for="min-price">{ i18n.T(ctx, i18n.KeyPriceMin) }</label>
						// ui-input is what `check-layout.mjs:668` looks for to decide the
						// desktop rail rendered at all, and what its tap sweep at :805
						// measures. The spelling is the hook; app.css writes the recipe.
						<input
							class="ui-input"
							id="min-price"
							type="number"
							name="min_price"
							inputmode="numeric"
							min="0"
							placeholder={ i18n.T(ctx, i18n.KeyPriceMinShort) }
							value={ v.MinPriceText() }
						/>
						<span class="goen-filters__dash" aria-hidden="true">–</span>
						<label class="goen-sr-only" for="max-price">{ i18n.T(ctx, i18n.KeyPriceMax) }</label>
						<input
							class="ui-input"
							id="max-price"
							type="number"
							name="max_price"
							inputmode="numeric"
							min="0"
							placeholder={ i18n.T(ctx, i18n.KeyPriceMaxShort) }
							value={ v.MaxPriceText() }
						/>
					</div>
				</details>
				<div class="goen-filters__field">
					@components.Label(components.LabelProps{For: "sort"}) {
						{ i18n.T(ctx, i18n.KeySort) }
					}
					<select class="ui-select" id="sort" name="sort">
						for _, o := range v.SortOptions(ctx) {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</div>
				@components.Button(components.ButtonProps{
					Variant: components.VariantPrimary,
					Block:   true,
					Class:   "goen-filters__apply",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyApplyFilters) }
				}
			</form>
		</details>
		if v.Filtered {
			<div class="goen-filters__applied" role="status">
				<span class="goen-filters__applied-label">{ i18n.T(ctx, i18n.KeyFiltersActive) }</span>
				<ul class="goen-filters__chips" role="list">
					for _, chip := range v.AppliedChips(ctx) {
						<li class="goen-filters__chip">{ chip }</li>
					}
				</ul>
				<a class="ui-filterbar__clear" href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyClearFilters) }</a>
			</div>
		}
	</div>
}

// pager is two links and a sentence. The end of the run stays visible as a
// disabled span rather than disappearing, so the control does not move.
templ pager(hasPrev, hasNext bool, prev, next, page, pages string) {
	if hasPrev || hasNext {
		<nav class="goen-pager" aria-label={ i18n.T(ctx, i18n.KeyPagination) }>
			if hasPrev {
				<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(prev) } rel="prev">{ i18n.T(ctx, i18n.KeyPrevPage) }</a>
			} else {
				<span class="goen-btn goen-btn--outline goen-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyPrevPage) }</span>
			}
			<span class="goen-pager__at">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPageOf), page, pages) }</span>
			if hasNext {
				<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(next) } rel="next">{ i18n.T(ctx, i18n.KeyNextPage) }</a>
			} else {
				<span class="goen-btn goen-btn--outline goen-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyNextPage) }</span>
			}
		</nav>
	}
}

// Search renders the search results page, which has no filter panel.
templ Search(p layouts.Page, v SearchView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">
					if v.Searched() {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchFor), v.Query) }
					} else {
						{ i18n.T(ctx, i18n.KeySearchHeading) }
					}
				</h1>
				if v.Searched() {
					<p class="goen-pagehead__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchResults), v.TotalText()) }</p>
				}
			</div>
			if !v.Searched() {
				<div class="ui-empty">
					<span class="goen-medallion" aria-hidden="true">
						@icons.Search()
					</span>
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeySearchPrompt) }</p>
					<p class="goen-empty__text">{ i18n.T(ctx, i18n.KeySearchPromptHint) }</p>
				</div>
			} else if v.Empty() {
				<div class="ui-empty">
					<span class="goen-medallion" aria-hidden="true">
						@icons.Search()
					</span>
					<p class="goen-empty__title">{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchNoResults), v.Query) }</p>
					<p class="goen-empty__text">
						{ i18n.T(ctx, i18n.KeySearchNoResultsHint) }
						<a href="/">{ i18n.T(ctx, i18n.KeySearchNoResultsLink) }</a>
					</p>
				</div>
			} else {
				// The grid's heading, visually hidden: without it a tile's h3 skips a level.
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				@compareForm() {
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.Products {
							@Tile(t)
						}
					</ul>
				}
				@pager(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
			}
		</div>
	}
}
