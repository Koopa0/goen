package pages

import "github.com/koopa0/goen/internal/i18n"

// One line of words, all of it the link to the campaign: which one runs here, its last day and what is left.
// Each part wraps whole, a dot stays with the words before it and the arrow with the last words, so a wrapped
// line never starts on a dot or an arrow.
templ departmentNotice(n *DepartmentNotice) {
	{{ before, after := n.End.Until(ctx) }}
	<section class="goen-deptnotice" aria-label={ i18n.T(ctx, i18n.KeyCampaignEyebrow) }>
		<div class="goen-deptnotice__in">
			<a class="goen-deptnotice__name" href={ templ.URL(n.Href) }>
				<span class="goen-deptnotice__eyebrow">{ i18n.T(ctx, i18n.KeyCampaignEyebrow) }</span>
				<b>{ n.Title }</b>&nbsp;<span aria-hidden="true">·</span>
				if n.End.EndsByTomorrow() {
					<span class="goen-deptnotice__left"><time datetime={ n.End.Datetime() }>{ n.End.Left(ctx) }</time>&nbsp;<span aria-hidden="true">&rarr;</span></span>
				} else {
					<span class="goen-deptnotice__until">{ before }<time datetime={ n.End.Datetime() }>{ n.End.Day(ctx) }</time><span class="goen-sr-only">{ after }</span>&nbsp;<span aria-hidden="true">·</span></span>
					<span class="goen-deptnotice__left">{ n.End.Left(ctx) }&nbsp;<span aria-hidden="true">&rarr;</span></span>
				}
			</a>
		</div>
	</section>
}

templ departmentSlot(h *DepartmentHead) {
	switch h.Slot() {
		case SlotCompare:
			@comparePreview(h.Preview)
		case SlotStory:
			@colourStory(h.Story)
	}
}

templ comparePreview(p *ComparePreview) {
	<section class="goen-deptcompare" aria-labelledby="dept-compare-title">
		<header class="goen-deptcompare__head">
			<h2 class="goen-deptcompare__title" id="dept-compare-title">{ i18n.T(ctx, i18n.KeyDeptCompareTitle) }</h2>
			<p class="goen-deptcompare__meta">{ p.Category }</p>
			<a class="goen-deptcompare__more" href={ templ.URL(p.Table.SelfHref()) }>{ i18n.T(ctx, i18n.KeyViewCompare) } <span aria-hidden="true">&rarr;</span></a>
		</header>
		@compareTable(p.Table, true)
	</section>
}

// The title is serif in zh: it is read as a line of colour names, not as a heading to scan.
templ colourStory(s *ColourStory) {
	<section class="goen-story" aria-labelledby="dept-story-title">
		<div class="goen-story__copy">
			if s.Brand != "" {
				<p class="goen-story__eyebrow">{ s.Brand }</p>
			}
			<h2 class="goen-story__title" id="dept-story-title">{ s.Title(ctx) }</h2>
			if s.Summary != "" {
				<p class="goen-story__deck">{ s.Summary }</p>
			}
			<p class="goen-story__buy">
				@tilePrice(s.Price)
			</p>
			<a class="goen-story__link" href={ templ.URL("/p/" + s.Slug) }>{ s.Name } <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="goen-story__plates">
			for _, plate := range s.Plates {
				<figure class="goen-story__plate">
					<div class="goen-story__well">
						<img
							src={ plate.Image.URL }
							srcset={ plate.Image.Srcset }
							sizes="(min-width: 1024px) 28rem, 90vw"
							alt={ plate.Image.Alt }
							width="800"
							height="600"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<figcaption>
						<svg class="goen-story__swatch" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
							<circle cx="6" cy="6" r="5.5" fill={ plate.Swatch }></circle>
						</svg>
						{ plate.Colour }
					</figcaption>
				</figure>
			}
		</div>
	</section>
}
