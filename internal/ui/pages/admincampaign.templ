package pages

import "github.com/koopa0/goen/internal/ui/layouts"

// AdminCampaigns renders the promotions and the form that starts one.
templ AdminCampaigns(p layouts.Page, v AdminCampaignsView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("campaigns")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">後台</p>
					<h1 class="ui-page-head__title">限時活動</h1>
					<p class="ui-page-head__sub">
						活動只能收錄有標示原價的商品。新活動一開始是空的,建立後再挑選商品。
					</p>
				</div>
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			<div class="goen-admin__productlayout">
				<form class="goen-admin__form" method="post" action="/admin/campaigns">
					<div class="ui-field">
						<label class="ui-label" for="k-title">活動標題</label>
						<input
							class="ui-input"
							id="k-title"
							name="title"
							required
							maxlength="60"
							placeholder="夏季 3C 展"
							value={ v.Draft.Title }
							if v.HasErr("title") {
								aria-invalid="true"
							}
						/>
						if v.HasErr("title") {
							<p class="ui-error-text">{ v.Err("title") }</p>
						}
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="k-slug">網址代稱</label>
							<input
								class="ui-input"
								id="k-slug"
								name="slug"
								required
								maxlength="120"
								placeholder="summer-3c"
								value={ v.Draft.Slug }
								if v.HasErr("slug") {
									aria-invalid="true"
								}
							/>
							if v.HasErr("slug") {
								<p class="ui-error-text">{ v.Err("slug") }</p>
							}
						</div>
						<div class="ui-field">
							<label class="ui-label" for="k-days">活動天數</label>
							<input
								class="ui-input"
								id="k-days"
								name="days"
								type="number"
								min="1"
								max="90"
								step="1"
								required
								inputmode="numeric"
								value={ v.Draft.Days }
							/>
							if v.HasErr("days") {
								<p class="ui-error-text">{ v.Err("days") }</p>
							}
						</div>
					</div>
					<button class="ui-btn ui-btn--primary" type="submit">建立活動</button>
				</form>
				<aside class="goen-admin__side">
					<h2 class="goen-admin__subhead">目前的活動</h2>
					if v.Empty() {
						<p class="goen-admin__hint">還沒有任何活動。</p>
					} else {
						<ul class="goen-admin__coupons" role="list">
							for _, c := range v.Rows {
								<li class="goen-admin__coupon">
									<div class="goen-admin__couponhead">
										<a class="goen-admin__sku" href={ templ.SafeURL(c.Href()) }>{ c.Title }</a>
										<span class={ "ui-badge", templ.KV("ui-badge--brand", c.Live()) }>{ c.State() }</span>
									</div>
									<span class="ui-cart-line__meta">/s/{ c.Slug }</span>
									<span class="ui-cart-line__meta">{ c.ProductsText() } 件商品 · 至 { c.EndsAt }</span>
									<form method="post" action={ templ.SafeURL(c.ToggleAction()) }>
										<input type="hidden" name="active" value={ c.NextActive() }/>
										<button class="ui-btn ui-btn--secondary" type="submit">{ c.ToggleLabel() }</button>
									</form>
								</li>
							}
						</ul>
					}
				</aside>
			</div>
		</div>
	}
}

// AdminCampaignForm renders one campaign's product selection.
templ AdminCampaignForm(p layouts.Page, v AdminCampaignView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("campaigns")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">
						<a href="/admin/campaigns">限時活動</a>
					</p>
					<h1 class="ui-page-head__title">{ v.Slug }</h1>
				</div>
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			<form class="goen-admin__form goen-admin__grant" method="post" action={ templ.SafeURL(v.FeatureAction()) }>
				<div class="ui-field">
					<label class="ui-label" for="k-product">商品網址代稱</label>
					<input class="ui-input" id="k-product" name="product" required maxlength="120" placeholder="pixelight-9" autocomplete="off"/>
					<p class="goen-admin__hint">商品必須已經標示原價,否則無法加入。</p>
				</div>
				<button class="ui-btn ui-btn--primary" type="submit">加入活動</button>
			</form>
			<h2 class="goen-admin__subhead">活動商品</h2>
			if v.Empty() {
				<p class="goen-admin__hint">這個活動還沒有收錄商品,顧客看到的會是空頁面。</p>
			} else {
				<ul class="goen-admin__catalogue" role="list">
					for _, item := range v.Products {
						<li class="goen-admin__product">
							<a class="goen-admin__productname" href={ templ.SafeURL("/admin/products/" + item.Slug) }>
								{ item.Name }
							</a>
							<span class="ui-cart-line__meta">/p/{ item.Slug }</span>
							<form method="post" action={ templ.SafeURL(v.FeatureAction()) }>
								<input type="hidden" name="product" value={ item.Slug }/>
								<input type="hidden" name="action" value="remove"/>
								<button class="ui-btn ui-btn--secondary" type="submit">移除</button>
							</form>
						</li>
					}
				</ul>
			}
		</div>
	}
}
