package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// NewsletterAction is the page a newsletter link opens; it writes nothing.
templ NewsletterAction(p layouts.Page, v NewsletterActionView) {
	@layouts.Base(p) {
		<div class="notice">
			<span class="goen-medallion" aria-hidden="true">
				@icons.Mail()
			</span>
			<h1 class="notice__title">{ v.Heading }</h1>
			<p class="notice__body">{ v.Body }</p>
			if v.Token != "" {
				<form class="notice__form" method="post" action={ templ.SafeURL(v.Action) }>
					<input type="hidden" name="token" value={ v.Token }/>
					@components.Button(components.ButtonProps{Variant: components.VariantPrimary, Size: components.SizeLarge, Block: true}, "submit") {
						{ v.Submit }
					}
				</form>
			}
			<div class="notice__actions">
				@components.ButtonLink(components.ButtonProps{Variant: components.VariantOutline, Size: components.SizeLarge, Class: "notice__back"}, "/") {
					{ i18n.T(ctx, i18n.KeyBackToShop) }
				}
			</div>
		</div>
	}
}
