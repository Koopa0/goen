package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// NewsletterAction is the page a link in a newsletter email opens. Following
// the link writes nothing: link scanners fetch the URLs in a message before a
// human sees it, and a confirmation a scanner can complete is not one.
templ NewsletterAction(p layouts.Page, v NewsletterActionView) {
	@layouts.Base(p) {
		<div class="notice">
			<h1 class="h2 notice__title">{ v.Heading }</h1>
			<p class="body notice__body">{ v.Body }</p>
			if v.Token != "" {
				<form class="notice__form" method="post" action={ templ.SafeURL(v.Action) }>
					<input type="hidden" name="token" value={ v.Token }/>
					<button class="ui-btn ui-btn--primary ui-btn--lg" type="submit">{ v.Submit }</button>
				</form>
			}
			<a class="notice__back body-sm" href="/">{ i18n.T(ctx, i18n.KeyBackToShop) }</a>
		</div>
	}
}
