package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
)

// listBound keeps navigation usable through ordinary links, including an empty
// later page whose boundary row no longer exists.
templ listBound(b ListBound, order ListOrder, searchable bool) {
	if b.Paged {
		if b.Empty {
			<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminPageEmpty) }</p>
		}
		if b.First != "" || b.Next != "" {
			<nav class="goen-pager" aria-label={ i18n.T(ctx, i18n.KeyPagination) }>
				if b.First != "" {
					<a class="goen-btn goen-btn--outline" href={ templ.URL(b.First) }>{ i18n.T(ctx, i18n.KeyAdminFirstPage) }</a>
				}
				if b.Next != "" {
					<a class="goen-btn goen-btn--outline" href={ templ.URL(b.Next) } rel="next">{ i18n.T(ctx, i18n.KeyNextPage) }</a>
				}
			</nav>
		}
	} else if b.More {
		<p class="goen-admin__hint goen-admin__bound">
			if order == ByRecency {
				{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminListCappedRecent), b.Limit) }
			} else {
				{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminListCappedFirst), b.Limit) }
			}
			if searchable {
				{ " " + i18n.T(ctx, i18n.KeyAdminListCappedSearch) }
			}
		</p>
	}
}
