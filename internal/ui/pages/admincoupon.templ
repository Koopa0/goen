package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminCoupons renders the promotions and the form that issues one.
templ AdminCoupons(p layouts.Page, v AdminCouponsView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("coupons")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageCoupons) }</h1>
					<p class="ui-page-head__sub">
						{ i18n.T(ctx, i18n.KeyAdminCoupLead) }
					</p>
				</div>
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			<div class="goen-admin__productlayout">
				<form class="goen-admin__form" method="post" action="/admin/coupons">
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="c-code">{ i18n.T(ctx, i18n.KeyAdminCoupCode) }</label>
							<input
								class="ui-input"
								id="c-code"
								name="code"
								required
								maxlength="32"
								placeholder="SUMMER20"
								autocomplete="off"
								value={ v.Draft.Code }
								if v.HasErr("code") {
									aria-invalid="true"
									aria-describedby="c-code-error"
								}
							/>
							if v.HasErr("code") {
								<p class="ui-error-text" id="c-code-error">{ v.Err("code") }</p>
							}
						</div>
						<div class="ui-field">
							<label class="ui-label" for="c-kind">{ i18n.T(ctx, i18n.KeyAdminCoupKind) }</label>
							<select class="ui-select" id="c-kind" name="kind" required>
								<option value="amount" selected?={ v.Draft.IsKind("amount") }>{ i18n.T(ctx, i18n.KeyCouponKindAmount) }</option>
								<option value="percent" selected?={ v.Draft.IsKind("percent") }>{ i18n.T(ctx, i18n.KeyCouponKindPercent) }</option>
								<option value="free_shipping" selected?={ v.Draft.IsKind("free_shipping") }>{ i18n.T(ctx, i18n.KeyCouponKindShipping) }</option>
							</select>
						</div>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="c-description">{ i18n.T(ctx, i18n.KeyAdminCoupDescription) }</label>
						<input
							class="ui-input"
							id="c-description"
							name="description"
							required
							maxlength="60"
							placeholder={ i18n.T(ctx, i18n.KeyAdminCoupDescriptionExample) }
							value={ v.Draft.Description }
							if v.HasErr("description") {
								aria-invalid="true"
								aria-describedby="c-description-error"
							}
						/>
						if v.HasErr("description") {
							<p class="ui-error-text" id="c-description-error">{ v.Err("description") }</p>
						}
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="c-value">{ i18n.T(ctx, i18n.KeyAdminCoupValue) }</label>
							<input class="ui-input" id="c-value" name="value" type="number" min="0" step="1" inputmode="numeric" value={ v.Draft.Value }/>
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupValueHint) }</p>
							if v.HasErr("value") {
								<p class="ui-error-text">{ v.Err("value") }</p>
							}
						</div>
						<div class="ui-field">
							<label class="ui-label" for="c-cap">{ i18n.T(ctx, i18n.KeyAdminCoupCap) }</label>
							<input class="ui-input" id="c-cap" name="cap" type="number" min="0" step="1" inputmode="numeric" value={ v.Draft.Cap }/>
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupCapHint) }</p>
							if v.HasErr("cap") {
								<p class="ui-error-text">{ v.Err("cap") }</p>
							}
						</div>
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="c-min">{ i18n.T(ctx, i18n.KeyAdminCoupMinSpend) }</label>
							<input class="ui-input" id="c-min" name="min" type="number" min="0" step="1" inputmode="numeric" value={ v.Draft.MinSpend }/>
						</div>
						<div class="ui-field">
							<label class="ui-label" for="c-days">{ i18n.T(ctx, i18n.KeyAdminCoupDays) }</label>
							<input class="ui-input" id="c-days" name="days" type="number" min="0" step="1" inputmode="numeric" value={ v.Draft.Days }/>
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupDaysHint) }</p>
						</div>
					</div>
					<div class="goen-checkout__fields">
						<div class="ui-field">
							<label class="ui-label" for="c-max">{ i18n.T(ctx, i18n.KeyAdminCoupMaxRedeem) }</label>
							<input class="ui-input" id="c-max" name="max" type="number" min="0" step="1" inputmode="numeric" value={ v.Draft.MaxRedeem }/>
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupMaxHint) }</p>
						</div>
						<div class="ui-field">
							<label class="ui-label" for="c-percustomer">{ i18n.T(ctx, i18n.KeyAdminCoupPerCustomer) }</label>
							<input class="ui-input" id="c-percustomer" name="percustomer" type="number" min="1" step="1" inputmode="numeric" value={ v.Draft.PerCustomer } placeholder="1"/>
							if v.HasErr("percustomer") {
								<p class="ui-error-text">{ v.Err("percustomer") }</p>
							}
						</div>
					</div>
					<button class="ui-btn ui-btn--primary" type="submit">{ i18n.T(ctx, i18n.KeyAdminCoupCreate) }</button>
				</form>
				<aside class="goen-admin__side">
					<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminCoupCurrent) }</h2>
					if v.Empty() {
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupEmpty) }</p>
					} else {
						<ul class="goen-admin__coupons" role="list">
							for _, c := range v.Rows {
								<li class="goen-admin__coupon">
									<div class="goen-admin__couponhead">
										<span class="goen-admin__sku">{ c.Code }</span>
										<span class={ "ui-badge", templ.KV("ui-badge--brand", c.Live()) }>{ c.State(ctx) }</span>
									</div>
									<span class="ui-cart-line__meta">{ c.Description }</span>
									<span class="ui-cart-line__meta">{ c.KindText } · { c.Value(ctx) }</span>
									<span class="ui-cart-line__meta">{ c.Conditions(ctx) }</span>
									<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminCoupUsed), c.Used(ctx)) }</span>
									if c.EndsAt != "" {
										<span class="ui-cart-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminCoupEndsAt), c.EndsAt) }</span>
									}
									<form method="post" action={ templ.SafeURL(c.Action()) }>
										<input type="hidden" name="active" value={ c.NextActive() }/>
										<button class="ui-btn ui-btn--secondary" type="submit">{ c.ToggleLabel(ctx) }</button>
									</form>
								</li>
							}
						</ul>
					}
				</aside>
			</div>
		</div>
	}
}
