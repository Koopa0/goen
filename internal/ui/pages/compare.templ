package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Compare renders the comparison table. One table at every width: it scrolls
// inside its own box while the page stays put, and the label column stays where
// it is so a reader never loses which row they are on.
templ Compare(p layouts.Page, v CompareView) {
	@layouts.Base(p) {
		<div class="goen-compare">
			<div class="goen-pagehead">
				<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, i18n.KeyCompareTitle) }</p>
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCompareHeading) }</h1>
				if v.Enough() {
					<p class="goen-pagehead__sub">
						{ i18n.T(ctx, i18n.KeyCompareSub) }
					</p>
				}
			</div>
			if v.Notice != "" {
				<p class="goen-pdp__hint" role="status">{ v.Notice }</p>
			}
			if v.Snapshot {
				<p>{ i18n.T(ctx, i18n.KeyCompareSnapshot) }</p>
				<form method="post" action="/compare/save">
					@comparisonSnapshot(v)
					@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
						{ i18n.T(ctx, i18n.KeyCompareUse) }
					}
				</form>
			}
			if !v.Empty() {
				<ul class="goen-filters__chips" role="list">
					for _, item := range v.Products {
						<li class="goen-filters__chip">
							<span>{ item.Name }</span>
							if v.Snapshot {
								<a href={ templ.URL(v.RemoveHref(item.Slug)) }>{ i18n.T(ctx, i18n.KeyRemove) }</a>
							} else {
								<form method="post" action="/compare/remove">
									<input type="hidden" name="slug" value={ item.Slug }/>
									@components.Button(components.ButtonProps{Variant: components.VariantOutline, Size: components.SizeSmall}, "submit") {
										{ i18n.T(ctx, i18n.KeyRemove) }
									}
								</form>
							}
						</li>
					}
				</ul>
				<a href={ templ.URL(v.ShareHref()) }>{ i18n.T(ctx, i18n.KeyCompareShare) }</a>
				if !v.Snapshot {
					<form method="post" action="/compare/clear">
						@components.Button(components.ButtonProps{Variant: components.VariantOutline, Size: components.SizeSmall}, "submit") {
							{ i18n.T(ctx, i18n.KeyCompareClear) }
						}
					</form>
				}
			}
			<form method="get" action="/compare" class="goen-compare__search">
				<div>
					@components.Label(components.LabelProps{For: "compare-search"}) {
						{ i18n.T(ctx, i18n.KeyCompareSearch) }
					}
					<input class="goen-input" id="compare-search" type="search" name="q" value={ v.Query } maxlength="100"/>
				</div>
				if v.Snapshot {
					if v.Empty() {
						<input type="hidden" name="p" value=""/>
					}
					for _, item := range v.Products {
						<input type="hidden" name="p" value={ item.Slug }/>
					}
				}
				@components.Button(components.ButtonProps{Variant: components.VariantPrimary}, "submit") {
					{ i18n.T(ctx, i18n.KeySearch) }
				}
			</form>
			if v.Query != "" && len(v.Candidates) == 0 {
				<p>{ i18n.T(ctx, i18n.KeySearchNoResults) }</p>
			}
			if len(v.Candidates) > 0 {
				<ul class="goen-tiles__grid" role="list">
					for _, candidate := range v.Candidates {
						<li>
							@tileCard(candidate)
							if !v.Contains(candidate.Slug) && !v.Full() {
								<form method="post" action="/compare/add">
									<input type="hidden" name="slug" value={ candidate.Slug }/>
									@comparisonSnapshot(v)
									@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
										{ i18n.T(ctx, i18n.KeyAddToCompare) }
									}
								</form>
							}
						</li>
					}
				</ul>
			}
			if !v.Enough() {
				<div class="ui-empty">
					<span class="goen-medallion" aria-hidden="true">
						@icons.Search()
					</span>
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyCompareTooFew) }</p>
					<p class="goen-empty__text">
						{ i18n.T(ctx, i18n.KeyCompareTooFewHint) }<a href="/">{ i18n.T(ctx, i18n.KeyCompareTooFewLink) }</a>{ i18n.T(ctx, i18n.KeyCompareTooFewTail) }
					</p>
				</div>
			} else {
				<div class="goen-compare__scroll">
					<table class="goen-compare__table">
						<caption class="goen-sr-only">{ i18n.T(ctx, i18n.KeyCompareCaption) }</caption>
						<thead>
							<tr>
								<th scope="col">
									<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyCompareRowLabel) }</span>
								</th>
								for _, item := range v.Products {
									<th scope="col">
										<div class="goen-compare__head">
											if item.ImageURL != "" {
												<img
													class="goen-compare__image"
													src={ item.ImageURL }
													srcset={ item.ImageSrcset }
													sizes="96px"
													alt={ item.ImageAlt }
													loading="lazy"
													width="160"
													height="120"
												/>
											}
											<a class="goen-compare__name" href={ templ.SafeURL(v.ProductHref(item.Slug)) }>{ item.Name }</a>
											<span class="goen-compare__brand">{ item.Brand }</span>
										</div>
									</th>
								}
							</tr>
						</thead>
						<tbody>
							<tr>
								<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowPrice) }</th>
								for _, item := range v.Products {
									<td class="goen-compare__price">{ item.Price() }</td>
								}
							</tr>
							<tr>
								<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowStock) }</th>
								for _, item := range v.Products {
									<td>{ item.Stock(ctx) }</td>
								}
							</tr>
							<tr>
								<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowRating) }</th>
								for _, item := range v.Products {
									<td>{ item.RatingText() }</td>
								}
							</tr>
							<tr>
								<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowWarranty) }</th>
								for _, item := range v.Products {
									<td>{ item.Warranty(ctx) }</td>
								}
							</tr>
							<tr>
								<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowCategory) }</th>
								for _, item := range v.Products {
									<td>{ item.Category }</td>
								}
							</tr>
							for _, row := range v.Rows {
								<tr class={ templ.KV("is-partial", !row.Comparable(v.Count())) }>
									<th scope="row">{ row.Label }</th>
									for i := range v.Products {
										<td>{ row.Value(i) }</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// Explicit POST actions may adopt a shared snapshot; opening it never does.
templ comparisonSnapshot(v CompareView) {
	if v.Snapshot {
		<input type="hidden" name="snapshot" value="1"/>
		for _, item := range v.Products {
			<input type="hidden" name="p" value={ item.Slug }/>
		}
	}
}
