package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Compare(p layouts.Page, v CompareView) {
	@layouts.Base(p) {
		<div class="goen-compare">
			<div class="goen-pagehead">
				<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, i18n.KeyCompareTitle) }</p>
				if v.Enough() {
					<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCompareHeading) }</h1>
					<p class="goen-pagehead__sub">
						{ i18n.T(ctx, i18n.KeyCompareSub) }
					</p>
				} else {
					<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCompareChoose) }</h1>
				}
			</div>
			if v.Dropped {
				<p class="goen-compare__note" role="status">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareOverflow), MaxCompare, MaxCompare) }</p>
			}
			if v.Enough() {
				@comparePicker(v)
			}
			if !v.Enough() {
				<div class="ui-empty">
					<span class="goen-medallion" aria-hidden="true">
						@icons.Search()
					</span>
					if v.Count() == 1 {
						<p class="goen-empty__title">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareOneChosen), v.Products[0].Name) }</p>
					} else {
						<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyCompareTooFew) }</p>
						<p class="goen-empty__text">
							{ i18n.T(ctx, i18n.KeyCompareTooFewHint) }<a href={ templ.SafeURL(v.StartHref()) }>{ i18n.T(ctx, i18n.KeyCompareTooFewLink) }</a>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareTooFewTail), MaxCompare) }
						</p>
					}
				</div>
				if v.Count() > 0 {
					<ul class="goen-compare__chosen" role="list">
						for _, item := range v.Products {
							<li>
								<a href={ templ.SafeURL(v.ProductHref(item.Slug)) }>{ item.Name }</a>
								@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, templ.SafeURL(v.RemoveHref(item.Slug))) {
									{ i18n.T(ctx, i18n.KeyRemove) }
								}
							</li>
						}
					</ul>
				}
				@compareSuggestions(v)
				@comparePicker(v)
			} else {
				@compareTable(v, false)
			}
		</div>
	}
}

// A GET search and plain links: works with scripting off and the address stays the comparison.
templ comparePicker(v CompareView) {
	if v.Full() {
		<p class="goen-compare__note" role="status">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareFull), MaxCompare) }</p>
	} else {
		<form class="goen-compare__picker" method="get" action="/compare" role="search" aria-label={ i18n.T(ctx, i18n.KeyCompareSearchLabel) }>
			for _, item := range v.Products {
				<input type="hidden" name="p" value={ item.Slug }/>
			}
			<label class="goen-sr-only" for="compare-q">{ i18n.T(ctx, i18n.KeyCompareSearchLabel) }</label>
			<input class="ui-input" id="compare-q" type="search" name="q" value={ v.Query } maxlength="100"/>
			@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
				{ i18n.T(ctx, i18n.KeySearch) }
			}
		</form>
		if v.Query != "" && len(v.Candidates) == 0 {
			<p class="goen-compare__note">{ i18n.T(ctx, i18n.KeyCompareNoMatch) }</p>
		}
		if len(v.Candidates) > 0 {
			<ul class="goen-compare__chosen" role="list">
				for _, c := range v.Candidates {
					<li>
						{ c.Name }
						if c.Brand != "" {
							{ " · " + c.Brand }
						}
						@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, templ.SafeURL(v.AddHref(c.Slug))) {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareAddNamed), c.Name) }
						}
					</li>
				}
			</ul>
		}
	}
}

templ compareSuggestions(v CompareView) {
	if len(v.Suggestions) > 0 {
		<section class="goen-compare__suggest" aria-labelledby="compare-suggest-heading">
			<h2 id="compare-suggest-heading" class="goen-compare__suggesthead">{ i18n.T(ctx, i18n.KeySectionRelated) }</h2>
			<ul class="goen-compare__suggestlist" role="list">
				for _, t := range v.Suggestions {
					<li class="goen-compare__suggestion">
						if t.ImageURL != "" {
							<span class="goen-compare__suggestmedia">
								<img
									src={ t.ImageURL }
									srcset={ t.ImageSrcset }
									sizes="(min-width: 1024px) 12rem, 45vw"
									alt=""
									loading="lazy"
									decoding="async"
								/>
							</span>
						}
						<a class="goen-compare__name" href={ templ.SafeURL(v.ProductHref(t.Slug)) }>{ t.Name }</a>
						if t.Brand != "" {
							<span class="goen-compare__brand">{ t.Brand }</span>
						}
						<span class="goen-compare__price">{ t.Price() }</span>
						@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, templ.SafeURL(v.AddHref(t.Slug))) {
							{ i18n.T(ctx, i18n.KeyAddToCompare) }
							<span class="goen-sr-only">{ " " + t.Name }</span>
						}
					</li>
				}
			</ul>
		</section>
	}
	if v.ShelfHref() != "" {
		<p class="goen-compare__shelf">
			<a href={ templ.SafeURL(v.ShelfHref()) }>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareBrowse), v.Products[0].Category) } <span aria-hidden="true">&rarr;</span></a>
		</p>
	}
}

// The table /compare shows and the department page previews: preview leaves out the rows every
// product has and the links that change the set, and keeps the specifications.
templ compareTable(v CompareView, preview bool) {
	<div class="goen-compare__scroll">
		<table class="goen-compare__table">
			<caption class="goen-sr-only">{ i18n.T(ctx, i18n.KeyCompareCaption) }</caption>
			<thead>
				<tr>
					<th scope="col">
						<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyCompareRowLabel) }</span>
					</th>
					for _, item := range v.Products {
						<th scope="col">
							<div class="goen-compare__head">
								if item.ImageURL != "" {
									<img
										class="goen-compare__image"
										src={ item.ImageURL }
										srcset={ item.ImageSrcset }
										sizes="96px"
										alt={ item.ImageAlt }
										loading="lazy"
										width="160"
										height="120"
									/>
								}
								<a class="goen-compare__name" href={ templ.SafeURL(v.ProductHref(item.Slug)) }>{ item.Name }</a>
								if item.Brand != "" {
									<span class="goen-compare__brand">{ item.Brand }</span>
								}
								if preview {
									<span class="goen-compare__price">
										@tilePrice(item.PriceTile())
									</span>
								} else {
									// A link, not a form button: the comparison set is the URL, so removing writes nothing.
									<a class="goen-compare__remove" href={ templ.SafeURL(v.RemoveHref(item.Slug)) }>
										{ i18n.T(ctx, i18n.KeyRemove) }
									</a>
								}
							</div>
						</th>
					}
				</tr>
			</thead>
			<tbody>
				if !preview {
					<tr>
						<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowPrice) }</th>
						for _, item := range v.Products {
							<td class="goen-compare__price">
								@tilePrice(item.PriceTile())
							</td>
						}
					</tr>
					<tr>
						<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowStock) }</th>
						for _, item := range v.Products {
							<td>{ item.Stock(ctx) }</td>
						}
					</tr>
					<tr>
						<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowRating) }</th>
						for _, item := range v.Products {
							<td>{ item.RatingText() }</td>
						}
					</tr>
					<tr>
						<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowWarranty) }</th>
						for _, item := range v.Products {
							<td>{ item.Warranty(ctx) }</td>
						}
					</tr>
					<tr>
						<th scope="row">{ i18n.T(ctx, i18n.KeyCompareRowCategory) }</th>
						for _, item := range v.Products {
							<td>{ item.Category }</td>
						}
					</tr>
				}
				for _, row := range v.Rows {
					<tr class={ templ.KV("is-partial", !row.Comparable(v.Count())), templ.KV("is-differs", row.Marked(v.Count())) }>
						<th scope="row">
							{ row.Label }
							if row.Marked(v.Count()) {
								<span class="goen-sr-only">{ " · " + i18n.T(ctx, i18n.KeyCompareDiffers) }</span>
							}
						</th>
						for i := range v.Products {
							<td>{ row.Value(i) }</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}
