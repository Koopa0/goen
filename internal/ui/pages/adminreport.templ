package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminReport renders the shop's numbers over one window.
templ AdminReport(p layouts.Page, v *AdminReportView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("reports")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageReports) }</h1>
					<p class="ui-page-head__sub">
						{ i18n.T(ctx, i18n.KeyAdminRepLead) }
					</p>
				</div>
				<nav class="ui-segmented" aria-label={ i18n.T(ctx, i18n.KeyAdminRepWindow) }>
					for _, d := range v.Windows {
						<a
							class={ "ui-segmented__item", templ.KV("is-active", v.IsWindow(d)) }
							href={ templ.SafeURL(v.WindowHref(d)) }
							if v.IsWindow(d) {
								aria-current="page"
							}
						>
							{ v.WindowLabel(ctx, d) }
						</a>
					}
				</nav>
			</div>
			if v.Empty() {
				<div class="ui-empty">
					<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeyAdminRepEmpty) }</p>
				</div>
			} else {
				<ul class="goen-report__figures" role="list">
					<li class="goen-report__figure">
						<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepRevenue) }</span>
						<span class="goen-report__value">{ v.Revenue() }</span>
					</li>
					<li class="goen-report__figure">
						<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepPaidOrders) }</span>
						<span class="goen-report__value">{ v.OrdersText() }</span>
					</li>
					<li class="goen-report__figure">
						<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepAverage) }</span>
						<span class="goen-report__value">{ v.Average() }</span>
					</li>
					<li class="goen-report__figure">
						<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepCompletion) }</span>
						<span class="goen-report__value">{ v.Completion() }</span>
						// The two counts are shown beside the percentage, because
						// a rate of eleven orders reads very differently from a
						// rate of eleven thousand.
						<span class="ui-cart-line__meta">
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminRepCounts), v.CommittedText(), v.PlacedText()) }
						</span>
					</li>
				</ul>
				<p class="goen-admin__hint">
					{ i18n.T(ctx, i18n.KeyAdminRepNote) }
				</p>
				<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminRepSellers) }</h2>
				if len(v.Sellers) == 0 {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRepSellersEmpty) }</p>
				} else {
					<ul class="goen-report__rows" role="list">
						for _, item := range v.Sellers {
							<li class="goen-report__row">
								<a class="goen-admin__productname" href={ templ.SafeURL(item.Href()) }>{ item.Name }</a>
								<span class="ui-cart-line__meta">{ item.Brand }</span>
								<span class="goen-report__num">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminRepUnits), item.UnitsText()) }</span>
								<span class="goen-report__num">{ item.Revenue() }</span>
							</li>
						}
					</ul>
				}
				<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminRepStock) }</h2>
				<p class="goen-admin__hint">
					{ i18n.T(ctx, i18n.KeyAdminRepStockLead) }
				</p>
				if len(v.AtRisk) == 0 {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRepStockEmpty) }</p>
				} else {
					<ul class="goen-report__rows" role="list">
						for _, item := range v.AtRisk {
							<li class={ "goen-report__row", templ.KV("is-urgent", item.Urgent()) }>
								<a class="goen-admin__productname" href={ templ.SafeURL(item.Href()) }>{ item.Name }</a>
								<span class="ui-cart-line__meta">{ item.SKU }</span>
								<span class="goen-report__num">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminRepLeft), item.StockText()) }</span>
								// The units that produced the cover figure. "14
								// days left" means nothing without knowing it
								// came from three sales or three hundred.
								<span class="goen-report__num">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminRepSold), item.SoldText()) }</span>
								<span class="goen-report__num">{ item.Cover(ctx) }</span>
							</li>
						}
					</ul>
				}
			}
		</div>
	}
}
