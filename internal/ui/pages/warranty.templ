package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ WarrantyList(p layouts.Page, v WarrantyListView) {
	@layouts.Base(p) {
		<div class="goen-account goen-account--narrow goen-account--warranty">
			@components.Breadcrumb(components.BreadcrumbProps{
				Label: i18n.T(ctx, i18n.KeyBreadcrumb),
				Crumbs: []components.Crumb{
					{Label: i18n.T(ctx, i18n.KeyAccountTitle), Href: "/account"},
					{Label: i18n.T(ctx, i18n.KeyWarrantyTitle)},
				},
			})
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyWarrantyTitle) }</h1>
				<p class="goen-pagehead__sub">{ i18n.T(ctx, i18n.KeyWarrantySub) }</p>
			</div>
			if v.Notice != "" {
				@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "warranty-notice"}) {
					{ v.Notice }
				}
			}
			if v.Empty() {
				<div class="goen-empty">
					<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeyWarrantyNone) }</p>
					<p class="ui-empty__desc">
						{ i18n.T(ctx, i18n.KeyWarrantyNoneHint) }<a href="/account">{ i18n.T(ctx, i18n.KeyAccountTitle) }</a>{ i18n.T(ctx, i18n.KeyWarrantyNoneTail) }
					</p>
				</div>
			} else {
				<ul class="goen-warranty" role="list">
					for _, item := range v.Rows {
						<li class={ "goen-warranty__item", templ.KV("is-expired", !item.InForce) }>
							<div class="goen-warranty__head">
								if item.Href() != "" {
									<a class="goen-warranty__name" href={ templ.SafeURL(item.Href()) }>{ item.Name }</a>
								} else {
									<span class="goen-warranty__name">{ item.Name }</span>
								}
								@components.Badge(components.BadgeProps{}) {
									{ item.State(ctx) }
								}
							</div>
							if item.Label != "" {
								<span class="goen-warranty__meta">{ item.Label }</span>
							}
							if !item.Returned {
								@components.StatLine(item.Facts(ctx), components.StatLineSmall)
							}
							<span class="goen-warranty__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyWarrantyOrderMeta), item.Order, item.RegisteredAt) }</span>
							if item.Serial != "" {
								<span class="goen-warranty__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyWarrantySerialShown), item.Serial) }</span>
							}
						</li>
					}
				</ul>
			}
		</div>
	}
}

templ WarrantyOrder(p layouts.Page, v WarrantyOrderView) {
	@layouts.Base(p) {
		<div class="goen-account goen-account--narrow goen-account--warranty">
			@components.Breadcrumb(components.BreadcrumbProps{
				Label: i18n.T(ctx, i18n.KeyBreadcrumb),
				Crumbs: []components.Crumb{
					{Label: i18n.T(ctx, i18n.KeyAccountTitle), Href: "/account"},
					{Label: i18n.T(ctx, i18n.KeyWarrantyTitle), Href: "/account/warranty"},
					{Label: v.Number},
				},
			})
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOrderMeta), v.Number) }</h1>
			</div>
			if v.Refusal != "" {
				@components.Notice(components.NoticeProps{Intent: components.IntentDanger, ID: "warranty-refusal"}) {
					{ v.Refusal }
				}
			}
			if v.Notice != "" {
				@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "warranty-notice"}) {
					{ v.Notice }
				}
			}
			if !v.AnyRegistrable() {
				<div class="goen-empty">
					<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeyWarrantyNothingHere) }</p>
					if v.EmptyHint(ctx) != "" {
						<p class="ui-empty__desc">{ v.EmptyHint(ctx) }</p>
					}
				</div>
			}
			<ul class="goen-warranty" role="list">
				for _, line := range v.Lines {
					<li class="goen-warranty__item">
						<div class="goen-warranty__head">
							<span class="goen-warranty__name">{ line.Name }</span>
							if line.TermText(ctx) != "" {
								@components.Badge(components.BadgeProps{}) {
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyWarrantyTerm), line.TermText(ctx)) }
								}
							}
						</div>
						if line.Label != "" {
							<span class="goen-warranty__meta">{ line.Label }</span>
						}
						if line.Note != "" {
							<p class="goen-warranty__meta">{ line.Note }</p>
						}
						if line.Registrable() {
							<form class="goen-warranty__form" method="post" action={ templ.SafeURL(v.Action()) }>
								<input type="hidden" name="line" value={ line.ID }/>
								<input type="hidden" name="unit" value={ line.NextUnit() }/>
								<div class="goen-field goen-warranty__field">
									@components.Label(components.LabelProps{For: "serial-" + line.ID}) {
										{ i18n.T(ctx, i18n.KeyFieldSerialOpt) }
									}
									@components.Input(line.serialField(ctx))
									if line.SerialRefusal != "" {
										<p class="ui-error-text" id={ "serial-" + line.ID + "-error" } role="alert">{ line.SerialRefusal }</p>
									}
									<p class="goen-warranty__hint" id={ "serial-hint-" + line.ID }>
										{ i18n.T(ctx, i18n.KeySerialHint) }
									</p>
								</div>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
									{ i18n.T(ctx, i18n.KeyWarrantyRegister) }
								}
							</form>
						} else {
							<p class="goen-warranty__meta">{ line.Why(ctx) }</p>
						}
					</li>
				}
			</ul>
		</div>
	}
}
