package pages

import (
	"fmt"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Campaign(p layouts.Page, v CampaignView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<header class="goen-campaign__band">
				if v.Image.Shown() {
					<img
						class="goen-campaign__header"
						src={ v.Image.URL }
						if v.Image.Srcset != "" {
							srcset={ v.Image.Srcset }
							sizes="(min-width: 1024px) 600px, 100vw"
						}
						alt={ v.Image.Alt }
						width="1600"
						height="600"
						fetchpriority="high"
					/>
				}
				<div class="goen-pagehead" data-tone={ v.Tone.Attr() }>
					<h1 class="goen-pagehead__title">{ v.Title }</h1>
					@components.StatLine(v.Schedule.Facts, components.StatLinePlain)
					if v.Schedule.HasPeriod {
						@components.Period(v.Schedule.Period)
					}
				</div>
			</header>
			if v.Empty() {
				<div class="ui-empty">
					@emptyArt(assets.EmptyCampaignImage)
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyCampaignEmpty) }</p>
					<p class="goen-empty__text">
						{ i18n.T(ctx, i18n.KeyCampaignEmptyHint) } <a href="/deals">{ i18n.T(ctx, i18n.KeyCampaignEmptyLink) }</a>
					</p>
				</div>
			} else {
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				<ul class="goen-tiles__grid" role="list">
					for _, t := range FirstRowEager(v.Tiles()) {
						@Tile(t)
					}
				</ul>
			}
		</div>
	}
}

// A campaign is a destination and a product an item; drawn apart so they do not read as one kind of thing.
templ campaignStrip(campaigns []CampaignSummary) {
	<section class="goen-campaigns" aria-labelledby="campaigns-heading">
		<h2 id="campaigns-heading" class="goen-campaigns__heading">{ i18n.T(ctx, i18n.KeyCampaignsRunning) }</h2>
		<ul class="goen-campaigns__list" role="list">
			for _, c := range campaigns {
				<li>
					<a class="goen-campaigns__item" href={ templ.SafeURL(c.Href()) }>
						<span class="goen-campaigns__title">{ c.Title }</span>
						<span class="goen-campaigns__meta">
							{ i18n.Count(ctx, i18n.KeyCampaignProducts, c.Products, c.ProductsText()) }
							if c.EndsOn != "" {
								· { fmt.Sprintf(i18n.T(ctx, i18n.KeyCampaignUntil), c.EndsOn) }
							}
						</span>
					</a>
				</li>
			}
		</ul>
	</section>
}
