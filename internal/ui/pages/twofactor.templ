package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// TwoFactor renders the step-up challenge and the enrolment flow.
//
// One card in the middle of the column, the shape the storefront gives a
// sign-in, inside the back office's own chrome: there is one thing to do here
// and the rail's 23 links are not it, but somebody who has not passed the
// second factor yet still needs to see where they are and how to leave.
//
// It borrows none of the storefront's auth classes. Those belong to a surface
// this screen does not live on, and a rebuild there would take this page's
// look with it.
//
// Nothing about the credential itself moved: the field is still named code,
// still posts to the same three actions, and still carries the one-time-code
// autofill token, the numeric keyboard and the pattern the handler validates
// against. The secret is rendered exactly as it was, in the groups the view
// model already cuts it into.
templ TwoFactor(p layouts.Page, v TwoFactorView) {
	@layouts.Admin(p, "") {
		<div class="goen-twofa">
			@components.Card(components.CardProps{Class: "goen-twofa__card"}) {
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="goen-twofa__title">{ i18n.T(ctx, i18n.KeyAdminPageTwoFactor) }</h1>
				<p class="goen-twofa__lead">
					{ i18n.T(ctx, i18n.KeyTwoFALead) }
				</p>
				if v.Notice != "" {
					@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
						{ v.Notice }
					}
				}
				if !v.Enabled {
					<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyTwoFAOffHeading) }</h2>
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyTwoFAOffBody) }
					</p>
				} else if v.Enrolling {
					<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyTwoFAEnrolHeading) }</h2>
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyTwoFAEnrolBody) }
						<strong>{ i18n.T(ctx, i18n.KeyTwoFAEnrolOnce) }</strong>
					</p>
					<p class="goen-twofa__secret">
						for _, group := range v.SecretGroups() {
							<code>{ group }</code>
						}
					</p>
					<details class="goen-disclosure">
						<summary class="goen-disclosure__summary">{ i18n.T(ctx, i18n.KeyTwoFAEnrolURI) }</summary>
						<div class="goen-disclosure__panel">
							<code class="goen-twofa__uri">{ v.URI }</code>
						</div>
					</details>
					<form class="goen-twofa__form" method="post" action="/admin/verify/confirm">
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "code"}) {
								{ i18n.T(ctx, i18n.KeyTwoFAEnrolCode) }
							}
							@components.Input(components.FieldProps{
								ID:    "code",
								Name:  "code",
								Class: "goen-twofa__code",
								Attrs: templ.Attributes{
									"autocomplete": "one-time-code",
									"autofocus":    true,
									"inputmode":    "numeric",
									"maxlength":    "8",
									"pattern":      "[0-9 ]{6,8}",
									"required":     true,
								},
							})
						</div>
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Block:   true,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyTwoFAEnrolSubmit) }
						}
					</form>
				} else if v.NeedsEnrolment() {
					<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyTwoFAStartHeading) }</h2>
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyTwoFAStartBody) }</p>
					<form method="post" action="/admin/verify/enrol">
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Block:   true,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyTwoFAStartSubmit) }
						}
					</form>
				} else if v.CanVerify() {
					<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyTwoFAChallengeHeading) }</h2>
					<form class="goen-twofa__form" method="post" action="/admin/verify">
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "code"}) {
								{ i18n.T(ctx, i18n.KeyTwoFAChallengeCode) }
							}
							@components.Input(components.FieldProps{
								ID:    "code",
								Name:  "code",
								Class: "goen-twofa__code",
								Attrs: templ.Attributes{
									"autocomplete": "one-time-code",
									"autofocus":    true,
									"inputmode":    "numeric",
									"maxlength":    "8",
									"pattern":      "[0-9 ]{6,8}",
									"required":     true,
								},
							})
						</div>
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Block:   true,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyTwoFAChallengeSubmit) }
						}
					</form>
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyTwoFALost) }
					</p>
				}
			}
		</div>
	}
}
