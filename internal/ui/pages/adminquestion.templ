package pages

import "github.com/koopa0/goen/internal/ui/layouts"

// AdminQuestions renders the customer questions waiting for the shop.
templ AdminQuestions(p layouts.Page, v AdminQuestionsView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("questions")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">後台</p>
					<h1 class="ui-page-head__title">顧客提問</h1>
					<p class="ui-page-head__sub">
						等最久的排在最前面 —— 問了三天沒人回的比今天早上剛問的更急。
						回覆會標示「官方回覆」,並排在該問題的最上面。
					</p>
				</div>
				if v.Waiting() > 0 {
					<span class="ui-badge ui-badge--brand">{ v.WaitingText() } 則待回覆</span>
				}
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			if v.Empty() {
				<div class="ui-empty">
					<p class="ui-empty__title">還沒有人提問</p>
				</div>
			} else {
				<ul class="goen-admin__questions" role="list">
					for _, q := range v.Rows {
						<li class={ "goen-admin__question", templ.KV("is-waiting", q.Waiting()) }>
							<div class="goen-admin__couponhead">
								<a class="goen-admin__sku" href={ templ.SafeURL(q.ProductHref()) }>{ q.ProductName }</a>
								<span class={ "ui-badge", templ.KV("ui-badge--brand", q.Waiting()) }>{ q.State() }</span>
							</div>
							<p class="goen-qa__question">{ q.Body }</p>
							<span class="ui-cart-line__meta">
								{ q.Who() } · { q.Asked } · { q.AnswersText() } 則回覆
							</span>
							<form class="goen-admin__form" method="post" action={ templ.SafeURL(q.AnswerAction()) }>
								<div class="ui-field">
									<label class="goen-sr-only" for={ "answer-" + q.ID }>回覆</label>
									<textarea
										class="ui-input"
										id={ "answer-" + q.ID }
										name="body"
										rows="2"
										maxlength="1000"
										placeholder="以 goen 的名義回覆"
									></textarea>
								</div>
								<div class="goen-admin__heroactions">
									<button class="ui-btn ui-btn--primary" type="submit" name="action" value="answer">
										送出官方回覆
									</button>
									<button class="ui-btn ui-btn--secondary" type="submit" name="action" value="hide">
										隱藏這則提問
									</button>
								</div>
							</form>
						</li>
					}
				</ul>
			}
		</div>
	}
}
