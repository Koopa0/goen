package pages

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Product renders the detail page: gallery, the buy panel, specs and reviews.
templ Product(p layouts.Page, v *ProductView) {
	@layouts.Base(p) {
		<div class="goen-pdp">
			@components.Breadcrumb(components.BreadcrumbProps{
				Label:  i18n.T(ctx, i18n.KeyBreadcrumb),
				Crumbs: v.Trail(ctx),
			})
			<div class="goen-pdp__top">
				@productGallery(v)
				@productBuy(v)
			</div>
			if v.Description != "" || v.HasSpecs() || v.HasWarranty() || v.WarrantyNote != "" {
				<div class="goen-pdp__detail">
					if v.Description != "" {
						<section class="goen-pdp__desc" aria-labelledby="desc-heading">
							<h2 id="desc-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionDescription) }</h2>
							<p class="goen-pdp__prose">{ v.Description }</p>
						</section>
					}
					if v.HasWarranty() || v.WarrantyNote != "" || v.HasSpecs() {
						<div class="goen-pdp__facts">
							if v.HasWarranty() || v.WarrantyNote != "" {
								<section class="goen-pdp__desc" aria-labelledby="warranty-heading">
									<h2 id="warranty-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionWarranty) }</h2>
									@components.Card(components.CardProps{}) {
										if v.HasWarranty() {
											<p class="goen-pdp__warranty">{ v.WarrantyText(ctx) }</p>
										}
										if v.WarrantyNote != "" {
											<p class="goen-pdp__warranty">{ v.WarrantyNote }</p>
										}
									}
								</section>
							}
							if v.HasSpecs() {
								<section class="goen-pdp__specs" aria-labelledby="specs-heading">
									<h2 id="specs-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionSpecs) }</h2>
									@components.Card(components.CardProps{}) {
										<dl class="goen-pdp__speclist">
											for _, s := range v.Specs {
												<div class="goen-pdp__specrow">
													<dt class="goen-pdp__specterm">{ s.Label }</dt>
													<dd class="goen-pdp__specvalue">{ s.Value }</dd>
												</div>
											}
										</dl>
									}
								</section>
							}
						</div>
					}
				</div>
			}
			@productReviews(v)
			@productQuestions(v)
			if v.HasRelated() {
				<section class="goen-pdp__related" aria-labelledby="related-heading">
					<h2 id="related-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionRelated) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.Related {
							@Tile(t)
						}
					</ul>
				</section>
			}
			if v.HasRecommendations() {
				<section class="goen-pdp__also" aria-labelledby="also-heading">
					<h2 id="also-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionAlsoBought) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.AlsoBought {
							@Tile(t)
						}
					</ul>
				</section>
			}
		</div>
	}
}

// productGallery stacks every shot. No carousel and no lightbox: a stacked
// gallery needs no script, and every image is reachable by scrolling.
templ productGallery(v *ProductView) {
	<div class="goen-pdp__gallery" id="gallery">
		if v.HasImages() {
			for i, img := range v.Images {
				<figure class="goen-pdp__shot">
					<img
						class="goen-pdp__shotimg"
						src={ img.URL }
						srcset={ img.Srcset }
						sizes="(min-width: 1024px) calc((100vw - 96px) * 0.55), calc(100vw - 32px)"
						alt={ img.Alt }
						if img.HasDimensions() {
							width={ img.WidthText() }
							height={ img.HeightText() }
						}
						if i == 0 {
							fetchpriority="high"
						} else {
							loading="lazy"
						}
						decoding="async"
					/>
				</figure>
			}
		} else {
			<div class="goen-pdp__shot goen-pdp__shot--empty">
				<span class="goen-ph">{ i18n.T(ctx, i18n.KeyImagePlaceholder) }</span>
			</div>
		}
	</div>
}

templ productBuy(v *ProductView) {
	<div class="goen-pdp__buy" id="buybox">
		<div class="goen-pdp__head">
			<p class="goen-pdp__brand">{ v.Brand }</p>
			<div class="goen-pdp__titlerow">
				<h1 class="goen-pdp__title">{ v.Name }</h1>
				if v.SelectionOK {
					if v.AllSoldOut() {
						@components.Badge(components.BadgeProps{Tone: components.ToneDanger}) {
							{ i18n.T(ctx, i18n.KeyAllSoldOut) }
						}
					} else if v.SoldOut() {
						@components.Badge(components.BadgeProps{Tone: components.ToneDanger}) {
							{ i18n.T(ctx, i18n.KeySoldOut) }
						}
					} else if v.LowStock() {
						@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOnlyLeft), v.AvailableText()) }
						}
					} else if v.InStock() {
						@components.Badge(components.BadgeProps{}) {
							{ i18n.T(ctx, i18n.KeyInStock) }
						}
					}
				}
			</div>
			if v.HasRating() {
				<a class="goen-pdp__rating" href="#reviews">
					<span class="goen-pdp__ratingstars" aria-hidden="true">{ v.Stars() }</span>
					<span class="goen-pdp__ratingcount" aria-hidden="true">({ v.ReviewCountText() })</span>
					<span class="goen-sr-only">{ v.RatingLabel(ctx) }</span>
				</a>
			}
			if v.Summary != "" {
				<p class="goen-pdp__lede">{ v.Summary }</p>
			}
		</div>
		if v.SelectionOK {
			<div class="goen-pdp__pricebox">
				<span class="goen-pdp__price">
					if v.PriceFrom() {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFromPrice), v.Price()) }
					} else {
						{ v.Price() }
					}
				</span>
				if v.OnSale() {
					<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyWasPrice) }</span>
					<s class="goen-pdp__was">{ v.Compare() }</s>
					@components.Badge(components.BadgeProps{Tone: components.ToneAccent}) {
						{ i18n.T(ctx, i18n.KeyOnSale) }
					}
				}
			</div>
		}
		for _, o := range v.Options {
			<fieldset class="goen-pdp__option">
				<legend class="goen-pdp__optname">
					{ o.Label }
					if o.SelectedLabel() != "" {
						<span class="goen-pdp__optchosen">{ o.SelectedLabel() }</span>
					}
				</legend>
				<div class={ "goen-pdp__values", templ.KV("goen-pdp__values--swatches", o.HasSwatches()) }>
					for _, val := range o.Values {
						// Still a link, and still the whole answer with scripting
						// off: the href navigates, the URL carries the choice, and
						// the server renders the page it always did. The hx-
						// attributes ask for that same URL and keep only the part
						// that changes, so there is no second server path to keep
						// in step with the first.
						//
						// What changes is the buy column and nothing else. The
						// photography is per PRODUCT — product_images has no
						// variant column — so the gallery the server sends for one
						// colour is the gallery it sends for every other, byte for
						// byte, and a test holds that. Selecting it into the swap
						// would destroy the <img> and build an identical one, which
						// is a fetch, a decode and an empty frame in between for a
						// picture that did not change. It is left alone instead.
						<a
							class={ "goen-swatch",
								templ.KV("goen-swatch--dot", o.HasSwatches()),
								templ.KV("goen-swatch--on", val.Selected),
								templ.KV("goen-swatch--out", !val.Available) }
							href={ templ.URL(val.Href) }
							hx-get={ val.Href }
							hx-select="#buybox"
							hx-target="#buybox"
							hx-swap="outerHTML"
							hx-push-url="true"
							if val.Selected {
								aria-current="true"
							}
						>
							if o.HasSwatches() {
								// The colour is the control; the name is what a
								// screen reader is given, because a fill is not
								// a label. A presentation attribute and not a
								// style one, so the policy has nothing to refuse.
								<svg class="goen-swatch__dot" viewBox="0 0 36 36" width="36" height="36" aria-hidden="true">
									<circle cx="18" cy="18" r="17.5" fill={ val.SwatchHex }></circle>
									if !val.Available {
										// Struck through, not dimmed: a line SAYS
										// sold out where a lower opacity only says
										// the page is tired. Two strokes on one
										// diagonal, the page's ground under the
										// page's ink, so the mark reads on a colour
										// of any darkness — the same answer the
										// selected ring gives, for the same reason.
										<line class="goen-swatch__barground" x1="7.4" y1="28.6" x2="28.6" y2="7.4"></line>
										<line class="goen-swatch__bar" x1="7.4" y1="28.6" x2="28.6" y2="7.4"></line>
									}
								</svg>
								<span class="goen-sr-only">{ val.Label }</span>
							} else {
								{ val.Label }
							}
							if !val.Available {
								<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyVariantUnavailable) }</span>
							}
						</a>
					}
				</div>
			</fieldset>
		}
		if !v.SelectionOK {
			@components.Notice(components.NoticeProps{Tone: components.ToneWarn, Class: "goen-pdp__note"}) {
				{ i18n.T(ctx, i18n.KeyVariantNotFound) }
			}
		} else if v.AllSoldOut() && len(v.Options) > 0 {
			@components.Notice(components.NoticeProps{Tone: components.ToneWarn, Class: "goen-pdp__note"}) {
				{ i18n.T(ctx, i18n.KeyAllSoldOutHint) }
			}
		} else if v.NeedsChoice() {
			// Guidance, not a state. A variant not found and a product sold out
			// are things that went wrong; this one is an instruction, and a
			// filled panel gives it the weight of a refusal on the page's
			// landing view — which every link on the site opens.
			<p class="goen-pdp__hint" role="status">
				@icons.AlertCircle()
				<span>{ i18n.T(ctx, i18n.KeyChooseBeforeAdding) }</span>
			</p>
		}
		@productAddForm(v)
		if v.SoldOut() {
			@productNotifyForm(v)
		}
		if !v.AlreadyComparing() && !v.ComparingFull() {
			@components.ButtonLink(components.ButtonProps{
				Variant: components.VariantSecondary, Block: true, Class: "goen-pdp__compare",
			}, templ.SafeURL(v.CompareHref())) {
				{ i18n.T(ctx, i18n.KeyAddToCompare) }
			}
		} else if v.AlreadyComparing() {
			@components.ButtonLink(components.ButtonProps{
				Variant: components.VariantSecondary, Block: true, Class: "goen-pdp__compare",
			}, templ.SafeURL(v.CompareHref())) {
				{ i18n.T(ctx, i18n.KeyViewCompare) }
			}
		}
		<ul class="goen-pdp__assurances" role="list">
			<li class="goen-pdp__assurance">
				@icons.Shield()
				<span>{ i18n.T(ctx, i18n.KeyGuaranteeWarranty) }</span>
			</li>
			if v.FreeDelivery() != "" {
				<li class="goen-pdp__assurance">
					@icons.Truck()
					<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyGuaranteeShipping), v.FreeDelivery()) }</span>
				</li>
			}
			<li class="goen-pdp__assurance">
				@icons.Return()
				<span>{ i18n.T(ctx, i18n.KeyGuaranteeReturns) }</span>
			</li>
		</ul>
	</div>
}

// productAddForm is the page's one filled action, with the wishlist beside it
// as an icon. The outcome of the last press sits directly under the button
// with nothing between them: a phone has to show the two together, or the
// confirmation is a sentence about a control that has scrolled away.
//
// The wishlist is a second form rather than a second button, because it posts
// somewhere else and a form cannot nest inside a form. The wrapper is what
// puts them on one row.
templ productAddForm(v *ProductView) {
	<div class="goen-pdp__actions">
		// Still a form, still a POST, still /cart/items, and with scripting off
		// nothing below this line exists: the browser posts, the server answers
		// 303 and the visitor lands on the product page with the notice on it.
		//
		// With script, the same POST goes through htmx and the answer is used
		// rather than navigated to. There is no second server path: the 303 is
		// followed, the page that comes back is the page a reload would give,
		// and hx-select takes the buy column out of it. hx-select-oob names the
		// header's cart link in that same response, so the count and the link's
		// accessible name change from the document the server just rendered
		// instead of from a number this page would have to keep.
		<form
			class="goen-pdp__form"
			method="post"
			action="/cart/items"
			hx-post="/cart/items"
			hx-target="#buybox"
			hx-swap="outerHTML"
			hx-select="#buybox"
			hx-select-oob="#cart-link"
			hx-push-url="true"
		>
			<input type="hidden" name="variant" value={ v.VariantID }/>
			<input type="hidden" name="back" value={ v.Slug }/>
			<div class="goen-pdp__buyrow">
				@components.Label(components.LabelProps{For: "quantity", Class: "goen-sr-only"}) {
					{ i18n.T(ctx, i18n.KeyQuantity) }
				}
				@components.Stepper(components.StepperProps{
					ID: "quantity", Name: "quantity", Value: "1",
					Min: "1", Max: v.MaxQuantity(), Disabled: !v.CanBuy(),
					DecreaseLabel: i18n.T(ctx, i18n.KeyQuantityDecrease),
					IncreaseLabel: i18n.T(ctx, i18n.KeyQuantityIncrease),
					Class:         "goen-pdp__qty",
				})
				@components.Button(components.ButtonProps{
					Variant: components.VariantPrimary,
					Class:   "goen-pdp__add",
					Attrs:   templ.Attributes{"disabled": !v.CanBuy()},
				}, "submit") {
					@icons.Cart()
					<span>
						if v.AllSoldOut() {
							{ i18n.T(ctx, i18n.KeyAllSoldOut) }
						} else if v.SoldOut() {
							{ i18n.T(ctx, i18n.KeySoldOut) }
						} else if v.NeedsChoice() {
							{ i18n.T(ctx, i18n.KeyChooseOptions) }
						} else {
							{ i18n.T(ctx, i18n.KeyAddToCart) }
						}
					</span>
				}
			</div>
			if v.JustAdded() {
				@components.Notice(components.NoticeProps{
					Tone: components.ToneAccent, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyAddedToCart) }
					<a class="goen-pdp__addedlink" href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
				}
			}
			if v.AddAdjusted() {
				@components.Notice(components.NoticeProps{Tone: components.ToneAccent, ID: "added", Class: "goen-pdp__added"}) {
					{ i18n.T(ctx, i18n.KeyAddAdjusted) }
					<a class="goen-pdp__addedlink" href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
				}
			}
			if v.AddRefused() {
				@components.Notice(components.NoticeProps{
					Tone: components.ToneDanger, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyAddRefused) }
				}
			}
			if v.CartFull() {
				@components.Notice(components.NoticeProps{
					Tone: components.ToneDanger, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyCartLineLimit) }
				}
			}
		</form>
		<form method="post" action="/account/wishlist" class="goen-pdp__wish">
			<input type="hidden" name="slug" value={ v.Slug }/>
			<input type="hidden" name="return" value={ "/p/" + v.Slug }/>
			if v.Saved {
				<input type="hidden" name="action" value="remove"/>
			}
			@components.Button(components.ButtonProps{
				Variant: components.VariantOutline, Icon: true,
				Attrs: templ.Attributes{
					"aria-label":   v.WishlistLabel(ctx),
					"aria-pressed": v.SavedText(),
				},
			}, "submit") {
				@icons.Heart()
			}
		</form>
	</div>
}

templ productNotifyForm(v *ProductView) {
	<form class="goen-pdp__notify" method="post" action={ templ.SafeURL(v.NotifyAction()) }>
		<input type="hidden" name="variant" value={ v.VariantID }/>
		// h2 and not h3: the nearest heading above is the product's own h1.
		<h2 class="goen-pdp__notifyhead">{ i18n.T(ctx, i18n.KeyRestockHeading) }</h2>
		if v.NotifyTaken() {
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
				{ i18n.T(ctx, i18n.KeyRestockDone) }
			}
		} else {
			<div class="goen-pdp__notifyrow">
				@components.Label(components.LabelProps{For: "notify-email", Class: "goen-sr-only"}) {
					{ i18n.T(ctx, i18n.KeyFieldEmail) }
				}
				@components.Input(components.FieldProps{
					ID: "notify-email", Name: "email", Type: "email",
					Invalid: v.NotifyRefused(), Describes: "notify-email-error",
					Attrs: templ.Attributes{
						"required": true, "maxlength": "254", "autocomplete": "email",
						"placeholder": i18n.T(ctx, i18n.KeyFieldEmail),
					},
				})
				@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
					{ i18n.T(ctx, i18n.KeyRestockSubmit) }
				}
			</div>
			if v.NotifyRefused() {
				<p class="ui-error-text" id="notify-email-error">{ i18n.T(ctx, i18n.KeyRestockBadEmail) }</p>
			}
		}
	</form>
}

templ productReviews(v *ProductView) {
	<section class="goen-pdp__reviews" id="reviews" aria-labelledby="reviews-heading">
		<h2 id="reviews-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionReviews) }</h2>
		// The SUMMARY is what depends on there being ratings, not the section:
		// the form that writes the first one is inside here, so gating the whole
		// section on RatingCount > 0 meant a product could never receive one.
		if !v.HasRating() {
			<p class="goen-pdp__noreviews">{ i18n.T(ctx, i18n.KeyNoReviewsYet) }</p>
		}
		if v.HasRating() {
			<div class="goen-pdp__reviewlayout">
				@components.Card(components.CardProps{Class: "goen-pdp__summary"}) {
					<p class="goen-pdp__score">{ v.RatingText() }</p>
					<p class="goen-pdp__scorecount">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReviewCount), v.ReviewCountText()) }</p>
					<div class="goen-pdp__bars">
						for _, b := range v.RatingBars {
							<div class="goen-pdp__bar">
								<span class="goen-pdp__barlabel">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyStarsLabel), b.StarsText()) }</span>
								<span class="goen-pdp__bartrack">
									<span class={ "goen-pdp__barfill", b.WidthClass() }></span>
								</span>
								<span class="goen-pdp__barcount">{ b.CountText() }</span>
							</div>
						}
					</div>
				}
				<div class="goen-pdp__reviewlist">
					for _, r := range v.Reviews {
						<article class="goen-pdp__review">
							<div class="goen-pdp__reviewhead">
								<span class="goen-pdp__reviewname">{ r.DisplayAuthor(ctx) }</span>
								<span class="goen-pdp__reviewstars" aria-label={ r.RatingLabel(ctx) }>{ r.ReviewStars() }</span>
								if r.Verified {
									@components.Badge(components.BadgeProps{}) {
										{ i18n.T(ctx, i18n.KeyVerifiedBuyer) }
									}
								}
								<span class="goen-pdp__reviewdate">{ r.Date }</span>
							</div>
							<p class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyRatingScore), r.RatingText()) }</p>
							if r.Title != "" {
								<p class="goen-pdp__reviewtitle">{ r.Title }</p>
							}
							<p class="goen-pdp__reviewbody">{ r.Body }</p>
						</article>
					}
				</div>
			</div>
		}
		@reviewForm(v)
	</section>
}

templ productQuestions(v *ProductView) {
	<section class="goen-pdp__qa" id="questions" aria-labelledby="qa-heading">
		<h2 id="qa-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionQA) }</h2>
		if v.AskTaken() {
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
				{ i18n.T(ctx, i18n.KeyQuestionPosted) }
			}
		}
		if v.HasQuestions() {
			<ul class="goen-qa" role="list">
				for _, q := range v.Questions {
					<li class="goen-qa__item">
						<p class="goen-qa__question">{ q.Body }</p>
						<span class="goen-pdp__meta">{ q.Who(ctx) } · { q.Asked }</span>
						if q.Answered() {
							<ul class="goen-qa__answers" role="list">
								for _, a := range q.Answers {
									<li class="goen-qa__answer">
										<p class="goen-qa__answerbody">{ a.Body }</p>
										<span class="goen-pdp__meta">
											{ a.Who(ctx) }
											if a.IsStaff {
												@components.Badge(components.BadgeProps{Tone: components.ToneAccent}) {
													{ i18n.T(ctx, i18n.KeyStaffAnswer) }
												}
											}
											· { a.At }
										</span>
									</li>
								}
							</ul>
						} else {
							<p class="goen-pdp__meta">{ i18n.T(ctx, i18n.KeyNoAnswerYet) }</p>
						}
					</li>
				}
			</ul>
		} else {
			<p class="goen-pdp__meta">{ i18n.T(ctx, i18n.KeyNoQuestionsYet) }</p>
		}
		@askForm(v)
	</section>
}

templ askForm(v *ProductView) {
	if !v.SignedIn {
		<p class="goen-pdp__reviewnote">
			<a href={ templ.SafeURL(v.AskSignInHref()) }>{ i18n.T(ctx, i18n.KeySignInFirst) }</a>{ i18n.T(ctx, i18n.KeySignInToAsk) }
		</p>
	} else {
		<form class="goen-qa__form" method="post" action={ templ.SafeURL(v.AskAction()) }>
			<div class="goen-field">
				@components.Label(components.LabelProps{For: "ask-body"}) {
					{ i18n.T(ctx, i18n.KeyAskLabel) }
				}
				@components.Textarea(components.FieldProps{
					ID: "ask-body", Name: "body",
					Invalid: v.AskRefused(), Describes: "ask-body-error",
					Attrs: templ.Attributes{
						"rows": "3", "required": true, "maxlength": "300",
						"placeholder": i18n.T(ctx, i18n.KeyAskPlaceholder),
					},
				}) {
					{ v.AskDraft }
				}
				if v.AskRefused() {
					<p class="ui-error-text" id="ask-body-error">{ i18n.T(ctx, i18n.KeyQuestionRefused) }</p>
				}
			</div>
			@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
				{ i18n.T(ctx, i18n.KeyAskSubmit) }
			}
		</form>
	}
}

templ reviewForm(v *ProductView) {
	if !v.SignedIn {
		<p class="goen-pdp__reviewnote">
			<a href={ templ.SafeURL("/signin?next=/p/" + v.Slug) }>{ i18n.T(ctx, i18n.KeySignInFirst) }</a>{ i18n.T(ctx, i18n.KeySignInToReview) }
		</p>
	} else if !v.CanReview {
		<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyAlreadyReviewed) }</p>
	} else {
		@components.Card(components.CardProps{Class: "goen-pdp__reviewform"}) {
			<form method="post" action={ templ.SafeURL(v.ReviewAction()) }>
				<h3 class="goen-pdp__reviewformhead">{ i18n.T(ctx, i18n.KeyWriteReview) }</h3>
				if v.WouldVerify {
					<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyReviewWillBeVerified) }</p>
				}
				<fieldset class="goen-pdp__stars">
					<legend class="goen-label">{ i18n.T(ctx, i18n.KeyFieldRating) }</legend>
					for _, n := range []int{5, 4, 3, 2, 1} {
						<label class="goen-pdp__star">
							<input
								class="goen-pdp__starinput"
								type="radio"
								name="rating"
								value={ n }
								required
								checked?={ v.ReviewDraft.IsRating(n) }
							/>
							<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyStarsLabel), strconv.Itoa(n)) }</span>
						</label>
					}
				</fieldset>
				if v.HasReviewErr("rating") {
					<p class="ui-error-text">{ v.ReviewErr("rating") }</p>
				}
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "review-title"}) {
						{ i18n.T(ctx, i18n.KeyFieldReviewTitle) }
					}
					@components.Input(components.FieldProps{
						ID: "review-title", Name: "title", Value: v.ReviewDraft.Title,
						Attrs: templ.Attributes{"maxlength": "80"},
					})
				</div>
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "review-body"}) {
						{ i18n.T(ctx, i18n.KeyFieldReviewBody) }
					}
					@components.Textarea(components.FieldProps{
						ID: "review-body", Name: "body", Class: "goen-pdp__reviewbody",
						Invalid: v.HasReviewErr("body"), Describes: "review-body-error",
						Attrs: templ.Attributes{"rows": "5", "required": true, "maxlength": "2000"},
					}) {
						{ v.ReviewDraft.Body }
					}
					if v.HasReviewErr("body") {
						<p class="ui-error-text" id="review-body-error">{ v.ReviewErr("body") }</p>
					}
				</div>
				@components.Button(components.ButtonProps{Variant: components.VariantPrimary}, "submit") {
					{ i18n.T(ctx, i18n.KeyReviewSubmit) }
				}
			</form>
		}
	}
}
