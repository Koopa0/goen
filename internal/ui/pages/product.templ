package pages

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Product renders the detail page: gallery, the buy panel, specs and reviews.
templ Product(p layouts.Page, v *ProductView) {
	@layouts.Base(p) {
		<div class="goen-pdp">
			<nav class="ui-crumbs goen-pdp__crumbs" aria-label={ i18n.T(ctx, i18n.KeyBreadcrumb) }>
				<a href="/">{ i18n.T(ctx, i18n.KeyHome) }</a>
				for _, c := range v.Crumbs {
					<span class="ui-crumbs__sep" aria-hidden="true">/</span>
					<a href={ templ.URL("/c/" + c.Slug) }>{ c.Name }</a>
				}
				<span class="ui-crumbs__sep" aria-hidden="true">/</span>
				<a href={ templ.URL("/c/" + v.CategorySlug) }>{ v.CategoryName }</a>
				<span class="ui-crumbs__sep" aria-hidden="true">/</span>
				<span class="ui-crumbs__current" aria-current="page">{ v.Name }</span>
			</nav>
			<div class="goen-pdp__top">
				@productGallery(v)
				@productBuy(v)
			</div>
			if v.Description != "" || v.HasSpecs() {
				<div class="goen-pdp__detail">
					if v.Description != "" {
						<section class="goen-pdp__desc" aria-labelledby="desc-heading">
							<h2 id="desc-heading" class="h4 goen-section__title">{ i18n.T(ctx, i18n.KeySectionDescription) }</h2>
							<p class="goen-pdp__prose">{ v.Description }</p>
						</section>
					}
					if v.HasWarranty() || v.WarrantyNote != "" {
						<section class="goen-pdp__desc" aria-labelledby="warranty-heading">
							<h2 id="warranty-heading" class="h4 goen-section__title">{ i18n.T(ctx, i18n.KeySectionWarranty) }</h2>
							if v.HasWarranty() {
								<p class="goen-pdp__warranty">{ v.WarrantyText(ctx) }</p>
							}
							if v.WarrantyNote != "" {
								<p class="goen-pdp__warranty">{ v.WarrantyNote }</p>
							}
						</section>
					}
					if v.HasSpecs() {
						<section class="goen-pdp__specs" aria-labelledby="specs-heading">
							<h2 id="specs-heading" class="h4 goen-section__title">{ i18n.T(ctx, i18n.KeySectionSpecs) }</h2>
							<dl class="ui-dl">
								for _, s := range v.Specs {
									<div class="ui-dl__row">
										<dt class="ui-dl__term">{ s.Label }</dt>
										<dd class="ui-dl__desc">{ s.Value }</dd>
									</div>
								}
							</dl>
						</section>
					}
				</div>
			}
			if v.HasRating() {
				@productReviews(v)
			}
			if v.HasRelated() {
				<section class="goen-pdp__related" aria-labelledby="related-heading">
					<h2 id="related-heading" class="h3 goen-section__title">{ i18n.T(ctx, i18n.KeySectionRelated) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.Related {
							@Tile(t)
						}
					</ul>
				</section>
			}
			<section class="goen-pdp__qa" id="questions" aria-labelledby="qa-heading">
				<h2 id="qa-heading" class="h4">{ i18n.T(ctx, i18n.KeySectionQA) }</h2>
				if v.AskTaken() {
					<p class="ui-alert ui-alert--info" role="status">
						{ i18n.T(ctx, i18n.KeyQuestionPosted) }
					</p>
				}
				if v.AskRefused() {
					<p class="ui-alert" role="status">
						{ i18n.T(ctx, i18n.KeyQuestionRefused) }
					</p>
				}
				if v.HasQuestions() {
					<ul class="goen-qa" role="list">
						for _, q := range v.Questions {
							<li class="goen-qa__item">
								<p class="goen-qa__question">{ q.Body }</p>
								<span class="ui-cart-line__meta">{ q.Who(ctx) } · { q.Asked }</span>
								if q.Answered() {
									<ul class="goen-qa__answers" role="list">
										for _, a := range q.Answers {
											<li class={ "goen-qa__answer", templ.KV("is-staff", a.IsStaff) }>
												<p>{ a.Body }</p>
												<span class="ui-cart-line__meta">
													{ a.Who(ctx) }
													if a.IsStaff {
														<span class="ui-badge ui-badge--brand">{ i18n.T(ctx, i18n.KeyStaffAnswer) }</span>
													}
													· { a.At }
												</span>
											</li>
										}
									</ul>
								} else {
									<p class="ui-cart-line__meta">{ i18n.T(ctx, i18n.KeyNoAnswerYet) }</p>
								}
							</li>
						}
					</ul>
				} else {
					<p class="ui-cart-line__meta">{ i18n.T(ctx, i18n.KeyNoQuestionsYet) }</p>
				}
				<form class="goen-qa__form" method="post" action={ templ.SafeURL(v.AskAction()) }>
					<div class="ui-field">
						<label class="ui-label" for="ask-body">{ i18n.T(ctx, i18n.KeyAskLabel) }</label>
						<textarea
							class="ui-input"
							id="ask-body"
							name="body"
							rows="3"
							required
							maxlength="300"
							placeholder={ i18n.T(ctx, i18n.KeyAskPlaceholder) }
							if v.AskRefused() {
								aria-invalid="true"
							}
						></textarea>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAskNeedsSignIn) }</p>
					</div>
					<button class="ui-btn ui-btn--secondary" type="submit">{ i18n.T(ctx, i18n.KeyAskSubmit) }</button>
				</form>
			</section>
			if v.HasRecommendations() {
				<section class="goen-pdp__also" aria-labelledby="also-heading">
					<h2 id="also-heading" class="h4">{ i18n.T(ctx, i18n.KeySectionAlsoBought) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.AlsoBought {
							@Tile(t)
						}
					</ul>
				</section>
			}
		</div>
	}
}

templ productGallery(v *ProductView) {
	<div class="goen-pdp__gallery">
		if v.HasImages() {
			for i, img := range v.Images {
				<div class="goen-pdp__shot">
					<img
						src={ img.URL }
						srcset={ img.Srcset }
						sizes="(min-width: 1024px) calc((100vw - 96px) * 0.55), calc(100vw - 32px)"
						alt={ img.Alt }
						if img.HasDimensions() {
							width={ img.WidthText() }
							height={ img.HeightText() }
						}
						if i == 0 {
							fetchpriority="high"
						} else {
							loading="lazy"
						}
						decoding="async"
					/>
				</div>
			}
		} else {
			<div class="goen-pdp__shot goen-pdp__shot--empty">
				<span class="goen-ph">{ i18n.T(ctx, i18n.KeyImagePlaceholder) }</span>
			</div>
		}
	</div>
}

templ productBuy(v *ProductView) {
	<div class="goen-pdp__buy">
		<p class="ui-product__brand goen-pdp__brand">{ v.Brand }</p>
		<h1 class="goen-pdp__title">{ v.Name }</h1>
		if v.Summary != "" {
			<p class="goen-pdp__lede">{ v.Summary }</p>
		}
		if v.HasRating() {
			<a class="ui-rating goen-pdp__rating" href="#reviews">
				<span class="ui-rating__stars" aria-hidden="true">
					@icons.Star()
				</span>
				<span class="goen-tile__score" aria-hidden="true">{ v.RatingText() }</span>
				<span class="ui-rating__count" aria-hidden="true">({ v.ReviewCountText() })</span>
				<span class="goen-sr-only">{ v.RatingLabel(ctx) }</span>
			</a>
		}
		if v.SelectionOK {
			<div class="goen-pdp__pricebox">
				<span class={ "ui-price", "goen-pdp__price", templ.KV("ui-price--sale", v.OnSale()) }>
					<span class="ui-price__now">
						if v.PriceFrom() {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFromPrice), v.Price()) }
						} else {
							{ v.Price() }
						}
					</span>
					if v.OnSale() {
						<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyWasPrice) }</span>
						<s class="ui-price__was">{ v.Compare() }</s>
					}
				</span>
				if v.SoldOut() {
					<span class="ui-badge">{ i18n.T(ctx, i18n.KeySoldOut) }</span>
				} else if v.LowStock() {
					<span class="ui-badge ui-badge--warn">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOnlyLeft), v.AvailableText()) }</span>
				}
			</div>
		}
		for _, o := range v.Options {
			<fieldset class="goen-pdp__option">
				<legend class="goen-pdp__optname">{ o.Label }</legend>
				<div class="goen-pdp__values">
					for _, val := range o.Values {
						<a
							class={ "goen-swatch",
								templ.KV("goen-swatch--on", val.Selected),
								templ.KV("goen-swatch--out", !val.Available) }
							href={ templ.URL(val.Href) }
							if val.Selected {
								aria-current="true"
							}
						>
							{ val.Label }
							if !val.Available {
								<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyVariantUnavailable) }</span>
							}
						</a>
					}
				</div>
			</fieldset>
		}
		if !v.SelectionOK {
			<p class="ui-alert ui-alert--warn goen-pdp__note" role="status">
				{ i18n.T(ctx, i18n.KeyVariantNotFound) }
			</p>
		} else if v.NeedsChoice() {
			<p class="goen-pdp__note" role="status">{ i18n.T(ctx, i18n.KeyChooseBeforeAdding) }</p>
		}
		<form class="goen-pdp__form" method="post" action="/cart/items">
			<input type="hidden" name="variant" value={ v.VariantID }/>
			<input type="hidden" name="back" value={ v.Slug }/>
			<div class="goen-pdp__qty">
				<label class="ui-label" for="quantity">{ i18n.T(ctx, i18n.KeyQuantity) }</label>
				<input
					class="ui-input goen-pdp__qtyinput"
					id="quantity"
					type="number"
					name="quantity"
					value="1"
					min="1"
					max={ v.MaxQuantity() }
					step="1"
					inputmode="numeric"
					disabled?={ !v.CanBuy() }
				/>
			</div>
			<button
				class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block goen-pdp__add"
				type="submit"
				disabled?={ !v.CanBuy() }
			>
				if v.SoldOut() {
					{ i18n.T(ctx, i18n.KeySoldOut) }
				} else if v.NeedsChoice() {
					{ i18n.T(ctx, i18n.KeyChooseOptions) }
				} else {
					{ i18n.T(ctx, i18n.KeyAddToCart) }
				}
			</button>
			// The outcome of the last press. The redirect has carried it since it
			// was written and nothing showed it, so a refusal rendered the same
			// page as a success — on the one control a shopper presses most.
			if v.JustAdded() {
				<p class="ui-alert ui-alert--info" role="status">
					{ i18n.T(ctx, i18n.KeyAddedToCart) }
				</p>
			}
			if v.AddRefused() {
				<p class="ui-alert ui-alert--error" role="alert">
					{ i18n.T(ctx, i18n.KeyAddRefused) }
				</p>
			}
		</form>
		if v.SoldOut() {
			<form class="goen-pdp__notify" method="post" action={ templ.SafeURL(v.NotifyAction()) }>
				<input type="hidden" name="variant" value={ v.VariantID }/>
				// h2 and not h3: the nearest heading above is the product's own h1.
				<h2 class="h4">{ i18n.T(ctx, i18n.KeyRestockHeading) }</h2>
				if v.NotifyTaken() {
					<p class="ui-alert ui-alert--info" role="status">
						{ i18n.T(ctx, i18n.KeyRestockDone) }
					</p>
				} else {
					<div class="ui-field">
						<label class="ui-label" for="notify-email">Email</label>
						<input
							class="ui-input"
							type="email"
							id="notify-email"
							name="email"
							required
							maxlength="254"
							autocomplete="email"
							if v.NotifyRefused() {
								aria-invalid="true"
							}
						/>
						if v.NotifyRefused() {
							<p class="ui-error-text">{ i18n.T(ctx, i18n.KeyRestockBadEmail) }</p>
						}
					</div>
					<button class="ui-btn ui-btn--secondary ui-btn--block" type="submit">
						{ i18n.T(ctx, i18n.KeyRestockSubmit) }
					</button>
				}
			</form>
		}
		if !v.AlreadyComparing() && !v.ComparingFull() {
			<a class="ui-btn ui-btn--secondary ui-btn--block" href={ templ.SafeURL(v.CompareHref()) }>
				{ i18n.T(ctx, i18n.KeyAddToCompare) }
			</a>
		} else if v.AlreadyComparing() {
			<a class="ui-btn ui-btn--secondary ui-btn--block" href={ templ.SafeURL(v.CompareHref()) }>
				{ i18n.T(ctx, i18n.KeyViewCompare) }
			</a>
		}
		<form method="post" action="/account/wishlist" class="goen-pdp__wish">
			<input type="hidden" name="slug" value={ v.Slug }/>
			<input type="hidden" name="return" value={ "/p/" + v.Slug }/>
			if v.Saved {
				<input type="hidden" name="action" value="remove"/>
				<button class="ui-btn ui-btn--secondary ui-btn--block" type="submit">
					{ i18n.T(ctx, i18n.KeyWishlistRemove) }
				</button>
			} else {
				<button class="ui-btn ui-btn--secondary ui-btn--block" type="submit">
					{ i18n.T(ctx, i18n.KeyWishlistAdd) }
				</button>
			}
		</form>
		<ul class="goen-pdp__assurances" role="list">
			<li>{ i18n.T(ctx, i18n.KeyGuaranteeWarranty) }</li>
			if v.FreeDelivery() != "" {
				<li>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyGuaranteeShipping), v.FreeDelivery()) }</li>
			}
			<li>{ i18n.T(ctx, i18n.KeyGuaranteeReturns) }</li>
		</ul>
	</div>
}

templ productReviews(v *ProductView) {
	<section class="goen-pdp__reviews" id="reviews" aria-labelledby="reviews-heading">
		<h2 id="reviews-heading" class="h3 goen-section__title">{ i18n.T(ctx, i18n.KeySectionReviews) }</h2>
		<div class="goen-pdp__reviewlayout">
			<div class="goen-pdp__summary">
				<p class="goen-pdp__score">{ v.RatingText() }</p>
				<p class="caption">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReviewCount), v.ReviewCountText()) }</p>
				<div class="goen-pdp__bars">
					for _, b := range v.RatingBars {
						<div class="goen-pdp__bar">
							<span class="goen-pdp__barlabel">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyStarsLabel), b.StarsText()) }</span>
							<span class="ui-progress goen-pdp__bartrack">
								<span class="ui-progress__fill" style={ b.PercentStyle() }></span>
							</span>
							<span class="goen-pdp__barcount">{ b.CountText() }</span>
						</div>
					}
				</div>
			</div>
			<div class="goen-pdp__reviewlist">
				for _, r := range v.Reviews {
					<article class="ui-review">
						<div class="ui-review__head">
							<span class="ui-review__name">{ r.DisplayAuthor(ctx) }</span>
							<span class="ui-review__stars" aria-label={ r.RatingLabel(ctx) }>{ r.ReviewStars() }</span>
							if r.Verified {
								<span class="ui-review__verified">{ i18n.T(ctx, i18n.KeyVerifiedBuyer) }</span>
							}
							<span class="ui-review__date">{ r.Date }</span>
						</div>
						<p class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyRatingScore), r.RatingText()) }</p>
						if r.Title != "" {
							<p class="ui-review__name">{ r.Title }</p>
						}
						<p class="ui-review__body">{ r.Body }</p>
					</article>
				}
			</div>
		</div>
		@reviewForm(v)
	</section>
}

templ reviewForm(v *ProductView) {
	if !v.SignedIn {
		<p class="goen-pdp__reviewnote">
			<a href={ templ.SafeURL("/signin?next=/p/" + v.Slug) }>{ i18n.T(ctx, i18n.KeySignInFirst) }</a>{ i18n.T(ctx, i18n.KeySignInToReview) }
		</p>
	} else if !v.CanReview {
		<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyAlreadyReviewed) }</p>
	} else {
		<form class="goen-pdp__reviewform" method="post" action={ templ.SafeURL(v.ReviewAction()) }>
			<h3 class="h4">{ i18n.T(ctx, i18n.KeyWriteReview) }</h3>
			if v.WouldVerify {
				<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyReviewWillBeVerified) }</p>
			}
			<fieldset class="goen-pdp__stars">
				<legend class="ui-label">{ i18n.T(ctx, i18n.KeyFieldRating) }</legend>
				for _, n := range []int{5, 4, 3, 2, 1} {
					<label class="goen-pdp__star">
						<input
							class="ui-radio"
							type="radio"
							name="rating"
							value={ n }
							required
							checked?={ v.ReviewDraft.IsRating(n) }
						/>
						<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyStarsLabel), strconv.Itoa(n)) }</span>
					</label>
				}
			</fieldset>
			if v.HasReviewErr("rating") {
				<p class="ui-error-text">{ v.ReviewErr("rating") }</p>
			}
			<div class="ui-field">
				<label class="ui-label" for="review-title">{ i18n.T(ctx, i18n.KeyFieldReviewTitle) }</label>
				<input class="ui-input" id="review-title" name="title" maxlength="80" value={ v.ReviewDraft.Title }/>
			</div>
			<div class="ui-field">
				<label class="ui-label" for="review-body">{ i18n.T(ctx, i18n.KeyFieldReviewBody) }</label>
				<textarea
					class="ui-input goen-pdp__reviewbody"
					id="review-body"
					name="body"
					rows="5"
					required
					maxlength="2000"
					if v.HasReviewErr("body") {
						aria-invalid="true"
					}
				>{ v.ReviewDraft.Body }</textarea>
				if v.HasReviewErr("body") {
					<p class="ui-error-text">{ v.ReviewErr("body") }</p>
				}
			</div>
			<button class="ui-btn ui-btn--primary" type="submit">{ i18n.T(ctx, i18n.KeyReviewSubmit) }</button>
		</form>
	}
}
