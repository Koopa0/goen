package pages

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/fieldrule"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/shoptime"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Product(p layouts.Page, v *ProductView) {
	@layouts.Base(awaiting(p, layouts.AwaitGallery)) {
		<div class="goen-pdp">
			<div class="goen-pdp__intro">
				@components.Breadcrumb(components.BreadcrumbProps{
					Label:  i18n.T(ctx, i18n.KeyBreadcrumb),
					Crumbs: v.Trail(ctx),
				})
				<div class="goen-pdp__top">
					@productGallery(v)
					@productBuy(v)
				</div>
			</div>
		</div>
		@productBand(v)
		<div class="goen-pdp goen-pdp--after">
			<div class="goen-pdp__more">
				if v.HasSpecs() || v.HasWarranty() || v.WarrantyNote != "" {
					<div class="goen-pdp__detail">
						if v.HasSpecs() {
							<details class="goen-pdp__acc goen-pdp__specs" open>
								<summary class="goen-pdp__accsummary">
									<h2 id="specs-heading" class="goen-pdp__acctitle">{ i18n.T(ctx, i18n.KeySectionSpecs) }</h2>
								</summary>
								<div class="goen-pdp__accpanel">
									<dl class="goen-pdp__speclist">
										for _, s := range v.Specs {
											<div class="goen-pdp__specrow">
												<dt class="goen-pdp__specterm">{ s.Label }</dt>
												<dd class="goen-pdp__specvalue">{ s.Value }</dd>
											</div>
										}
									</dl>
									@productCompare(v)
								</div>
							</details>
						}
						if v.HasWarranty() || v.WarrantyNote != "" {
							<details class="goen-pdp__acc">
								<summary class="goen-pdp__accsummary">
									<h2 id="warranty-heading" class="goen-pdp__acctitle">{ i18n.T(ctx, i18n.KeySectionWarranty) }</h2>
								</summary>
								<div class="goen-pdp__accpanel">
									if v.HasWarranty() {
										<p class="goen-pdp__warranty">{ v.WarrantyText(ctx) }</p>
									}
									if v.WarrantyNote != "" {
										<p class="goen-pdp__warranty">{ v.WarrantyNote }</p>
									}
								</div>
							</details>
						}
					</div>
				}
				if len(v.LabelRows(ctx))>0 {
					<section class="goen-pdp__desc" aria-labelledby="product-label-heading">
						<h2 class="goen-pdp__sectiontitle" id="product-label-heading">{ i18n.T(ctx,i18n.KeyProductLabel) }</h2>
						<dl class="goen-pdp__speclist">
							for _, fact := range v.LabelRows(ctx) {
								<div class="goen-pdp__specrow">
									<dt class="goen-pdp__specterm">{ i18n.T(ctx,fact.Term) }</dt>
									<dd class="goen-pdp__specvalue">{ fact.Value }</dd>
								</div>
							}
						</dl>
					</section>
				}
				<details class="goen-pdp__acc">
					<summary class="goen-pdp__accsummary">
						<h2 id="delivery-heading" class="goen-pdp__acctitle">{ i18n.T(ctx, i18n.KeySectionDelivery) }</h2>
					</summary>
					<div class="goen-pdp__accpanel">
						<ul class="goen-pdp__policies" role="list">
							<li><a href="/shipping">{ i18n.T(ctx, i18n.KeyShippingPolicy) } <span aria-hidden="true">&rarr;</span></a></li>
							<li><a href="/returns">{ i18n.T(ctx, i18n.KeyReturnsPolicy) } <span aria-hidden="true">&rarr;</span></a></li>
						</ul>
					</div>
				</details>
				if !v.HasSpecs() {
					@productCompare(v)
				}
			</div>
			@productReviews(v)
			@productQuestions(v)
			if v.HasRelated() {
				<section class="goen-pdp__related" aria-labelledby="related-heading">
					<h2 id="related-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionRelated) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.Related {
							@Tile(t)
						}
					</ul>
				</section>
			}
			if v.HasRecommendations() {
				<section class="goen-pdp__also" aria-labelledby="also-heading">
					<h2 id="also-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionAlsoBought) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.AlsoBought {
							@Tile(t)
						}
					</ul>
				</section>
			}
		</div>
		@productBuyBar(v)
	}
}

// A radio group drawn with CSS alone: works with scripting off, and a swap of
// #gallery by the colour swatches keeps no state.
//
// Every shot sits in the same cell and the unchosen ones are only hidden with
// visibility, none lazy: choosing a thumbnail must show its photograph at once.
templ productGallery(v *ProductView) {
	<div class="goen-pdp__gallery" id="gallery" data-tone={ v.Tone.Attr() }>
		if v.HasImages() {
			for i, img := range v.Images {
				<div class="goen-pdp__item">
					if len(v.Images) > 1 {
						<input
							class="goen-sr-only goen-pdp__pick"
							type="radio"
							name="shot"
							id={ "shot-" + strconv.Itoa(i) }
							checked?={ i == 0 }
						/>
					}
					<figure class="goen-pdp__shot">
						<img
							class="goen-pdp__shotimg"
							src={ img.URL }
							srcset={ img.Srcset }
							sizes="(min-width: 1024px) 42rem, calc(100vw - 2rem)"
							alt={ img.Alt }
							if img.HasDimensions() {
								width={ img.WidthText() }
								height={ img.HeightText() }
							}
							if i == 0 {
								fetchpriority="high"
							}
							decoding="async"
						/>
					</figure>
					if len(v.Images) > 1 {
						<label class="goen-pdp__thumb" for={ "shot-" + strconv.Itoa(i) }>
							<img
								class="goen-pdp__thumbimg"
								src={ img.URL }
								srcset={ img.Srcset }
								sizes="6rem"
								alt={ img.Alt }
								if img.HasDimensions() {
									width={ img.WidthText() }
									height={ img.HeightText() }
								}
								decoding="async"
							/>
						</label>
					}
				</div>
			}
		} else {
			<div class="goen-pdp__shot goen-pdp__shot--empty">
				<span class="goen-ph">{ i18n.T(ctx, i18n.KeyImagePlaceholder) }</span>
			</div>
		}
	</div>
}

templ productBand(v *ProductView) {
	if v.Description != "" {
		{{ photo, hasPhoto := v.BandPhoto() }}
		<section class={ "goen-band goen-band--product", templ.KV("goen-band--text", !hasPhoto) } data-tone={ v.Tone.Attr() } aria-labelledby="desc-heading">
			<div class="goen-band__grid">
				if hasPhoto {
					@bandMedia("goen-band__photo", "", Photo{URL: photo.URL, Srcset: photo.Srcset, Alt: photo.Alt}, true, "(min-width: 1024px) 42vw, 100vw", true)
				}
				<div class="goen-band__body goen-pdp__desc">
					if v.Brand != "" {
						<p class="goen-pdp__brand">{ v.Brand }</p>
					}
					<h2 id="desc-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionDescription) }</h2>
					<p
						class="goen-pdp__prose"
						if v.DescriptionUntranslated {
							lang={ i18n.ZhHant.Tag() }
						}
					>{ v.Description }</p>
				</div>
			</div>
		</section>
	}
}

templ ratingStars(halves int) {
	<span class="goen-pdp__rate" aria-hidden="true">
		for i := 1; i <= 5; i++ {
			if halves == 2*i-1 {
				<span class="goen-pdp__rate--half">
					@icons.Star()
					<span class="goen-pdp__ratehalf">
						@icons.Star()
					</span>
				</span>
			} else {
				<span class={ templ.KV("goen-pdp__rate--on", halves >= 2*i) }>
					@icons.Star()
				</span>
			}
		}
	</span>
}

templ productBuy(v *ProductView) {
	<div class="goen-pdp__buy" id="buybox">
		<div class="goen-pdp__head">
			if v.Brand != "" {
				<p class="goen-pdp__brand">{ v.Brand }</p>
			}
			<div class="goen-pdp__titlerow">
				<h1 class="goen-pdp__title">{ v.Name }</h1>
				if v.SelectionOK {
					if v.LowStock() {
						@components.Badge(components.BadgeProps{}) {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOnlyLeft), v.AvailableText()) }
						}
					} else if v.InStock() {
						@components.Badge(components.BadgeProps{}) {
							{ i18n.T(ctx, i18n.KeyInStock) }
						}
					}
				}
			</div>
			if highlights := v.Highlights(); len(highlights) > 0 {
				<p class="goen-pdp__keyspecs">
					for _, h := range highlights {
						<span>{ h }</span>
					}
				</p>
			}
			if v.HasRating() {
				<a class="goen-pdp__rating" href="#reviews">
					@ratingStars(v.StarHalves())
					<span class="goen-pdp__ratingcount" aria-hidden="true">{ v.RatingText() } ({ v.ReviewCountText() })</span>
					<span class="goen-sr-only">{ v.RatingLabel(ctx) }</span>
				</a>
			}
		</div>
		if v.SelectionOK {
			<div class="goen-pdp__pricebox">
				<span class="goen-pdp__price">
					if v.PriceFrom() {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFromPrice), v.Price()) }
					} else {
						{ v.Price() }
					}
				</span>
				if v.OnSale() {
					<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyWasPrice) }</span>
					<s class="goen-pdp__was">{ v.Compare() }</s>
					@components.Badge(components.BadgeProps{}) {
						{ i18n.T(ctx, i18n.KeyOnSale) }
					}
				}
			</div>
			if v.OnSale() {
				{{ before, middle, after := v.Campaign.Source(ctx) }}
				<p class="goen-pdp__source">{ before }<a href={ templ.SafeURL(v.Campaign.Href()) }>{ v.Campaign.Title }</a>{ middle }<span class="goen-pdp__left">{ v.Campaign.End.Left(ctx) }</span>{ after }</p>
			}
		}
		if v.Summary != "" {
			<p class="goen-pdp__lede">{ v.Summary }</p>
		}
		for oi, o := range v.Options {
			if o.Fixed() {
				<p class="goen-pdp__fact">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOptionChosen), o.Label) }<span class="goen-pdp__optchosen">{ o.Values[0].Label }</span>
				</p>
			} else {
				<fieldset
					class="goen-pdp__option"
					if v.OptionInvalid(o) {
						aria-invalid="true"
						aria-describedby="notify-option-error"
					}
				>
					<legend class="goen-pdp__optname">
						if o.SelectedLabel() != "" {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOptionChosen), o.Label) }<span class="goen-pdp__optchosen">{ o.SelectedLabel() }</span>
						} else {
							{ o.Label }
						}
					</legend>
					<div class={ "goen-pdp__values", templ.KV("goen-pdp__values--swatches", o.HasSwatches()) }>
						for vi, val := range o.Values {
							// Still a link and the whole answer with scripting off. The hx- attributes ask for
							// the same URL and keep only the part that changes: no second server path.
							//
							// The gallery comes along only when a photograph shows one option value, because
							// only then can the choice reorder it; otherwise a test holds that the server sends
							// the same gallery byte for byte, and swapping it would rebuild an identical <img>.
							// The id lets htmx restore focus to the activated control after a swap.
							<a
								id={ "swatch-" + strconv.Itoa(oi) + "-" + strconv.Itoa(vi) }
								class={ "goen-swatch",
								templ.KV("goen-swatch--dot", o.HasSwatches()),
								templ.KV("goen-swatch--on", val.Selected),
								templ.KV("goen-swatch--out", !val.Available) }
								href={ templ.URL(val.Href) }
								if o.HasSwatches() {
									title={ val.Label }
								}
								hx-get={ val.Href }
								hx-select="#buybox"
								hx-target="#buybox"
								hx-select-oob={ v.ChoiceSwap() }
								hx-swap="outerHTML"
								hx-push-url="true"
								if val.Selected {
									aria-current="true"
								}
							>
								if o.HasSwatches() {
									// A presentation attribute, not a style, so the CSP has nothing to refuse. The
									// colour is the control; the name is what a screen reader is given.
									<svg class="goen-swatch__dot" viewBox="0 0 36 36" width="32" height="32" aria-hidden="true">
										<circle cx="18" cy="18" r="17.5" fill={ val.SwatchHex }></circle>
										if !val.Available {
											// Struck through, not dimmed: a line says sold out where lower opacity says
											// nothing. Two strokes, the ground under the ink, so the mark reads on a colour of any darkness.
											<line class="goen-swatch__barground" x1="7.4" y1="28.6" x2="28.6" y2="7.4"></line>
											<line class="goen-swatch__bar" x1="7.4" y1="28.6" x2="28.6" y2="7.4"></line>
										}
									</svg>
									<span class="goen-sr-only">{ val.Label }</span>
								} else {
									{ val.Label }
								}
								if !val.Available {
									if v.AllSoldOut() && !o.HasSwatches() {
										<small class="goen-swatch__note">{ v.ValueSoldOut(ctx) }</small>
									} else {
										<span class="goen-sr-only">{ v.ValueSoldOut(ctx) }</span>
									}
								}
							</a>
						}
					</div>
				</fieldset>
			}
		}
		if !v.SelectionOK {
			@components.Notice(components.NoticeProps{Intent: components.IntentWarn, Class: "goen-pdp__note"}) {
				{ i18n.T(ctx, i18n.KeyVariantNotFound) }
			}
		}
		if v.NotifyUnavailable() {
			@components.Notice(components.NoticeProps{Intent: components.IntentDanger, ID: "notify-unavailable"}) {
				{ i18n.T(ctx, i18n.KeyRestockUnavailable) }
			}
		}
		@productAddForm(v)
		if v.SoldOut() && v.ArrivalText() != "" {
			@components.Notice(components.NoticeProps{Intent: components.IntentWarn, Class: "goen-pdp__note"}) {
				<time datetime={ v.ArrivalDay() }>{ v.ArrivalText() }</time>
			}
		}
		if v.NotifyOffered() {
			@productNotifyForm(v)
		}
		@productLinks(v)
		@components.StatLine(v.BuyFacts(ctx), components.StatLinePairs)
	</div>
}

templ productLinks(v *ProductView) {
	<div class="goen-pdp__links">
		if v.SignedIn {
			// Toggling swaps the form alone; the plain post and its redirect serve a browser without script.
			<form
				method="post"
				action="/account/wishlist"
				class="goen-pdp__wish"
				hx-post="/account/wishlist"
				hx-target="this"
				hx-select=".goen-pdp__wish"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="slug" value={ v.Slug }/>
				<input type="hidden" name="return" value={ "/p/" + v.Slug }/>
				if v.Saved {
					<input type="hidden" name="action" value="remove"/>
				}
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleGhost,
					Attrs: templ.Attributes{
						"aria-label":   v.WishlistLabel(ctx),
						"aria-pressed": v.SavedText(),
					},
				}, "submit") {
					@icons.Heart()
					<span>{ v.WishlistLabel(ctx) }</span>
				}
			</form>
		} else {
			@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost}, templ.SafeURL("/signin?next=/p/"+v.Slug)) {
				@icons.Heart()
				<span>{ i18n.T(ctx, i18n.KeyWishlistSignIn) }</span>
			}
		}
	</div>
}

templ productAddForm(v *ProductView) {
	<div class="goen-pdp__actions">
		// With scripting off nothing below exists: the browser posts, the server answers
		// 303 and the visitor lands on the product page with the notice on it.
		//
		// With script, the same POST goes through htmx, the 303 is followed and hx-select
		// takes the buy column out of the page a reload would give. hx-select-oob names the
		// header's cart link in that response, so the count changes from the document the
		// server just rendered. The address is not pushed: ?added= is not a page to come back to.
		<form
			id="pdp-add"
			class="goen-pdp__form"
			method="post"
			action="/cart/items"
			hx-post="/cart/items"
			hx-target="#buybox"
			hx-swap="outerHTML"
			hx-select="#buybox"
			hx-select-oob="#cart-link,#buybar"
			hx-push-url="false"
		>
			<input type="hidden" name="variant" value={ v.VariantID }/>
			<input type="hidden" name="back" value={ v.Slug }/>
			<div class="goen-pdp__buyrow">
				@components.Label(components.LabelProps{For: "quantity", Class: "goen-sr-only"}) {
					{ i18n.T(ctx, i18n.KeyQuantity) }
				}
				@components.Stepper(components.StepperProps{
					ID: "quantity", Name: "quantity", Value: "1",
					Min: "1", Max: v.MaxQuantity(), Disabled: !v.CanBuy(),
					DecreaseLabel: i18n.T(ctx, i18n.KeyQuantityDecrease),
					IncreaseLabel: i18n.T(ctx, i18n.KeyQuantityIncrease),
					Class:         "goen-pdp__qty",
				})
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStylePrimary,
					Class:       "goen-pdp__add",
					Attrs:       templ.Attributes{"id": "add-to-cart", "disabled": !v.CanBuy()},
				}, "submit") {
					@icons.Cart()
					<span>
						if v.AllSoldOut() || v.SoldOut() {
							{ i18n.T(ctx, i18n.KeySoldOut) }
						} else if v.NeedsChoice() {
							{ i18n.T(ctx, i18n.KeyChooseOptions) }
						} else {
							{ i18n.T(ctx, i18n.KeyAddToCart) }
						}
					</span>
				}
			</div>
			if v.JustAdded() {
				@components.Notice(components.NoticeProps{
					Intent: components.IntentAccent, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyAddedToCart) }
					<a class="goen-pdp__addedlink" href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
				}
			}
			if v.AddAdjusted() {
				@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "added", Class: "goen-pdp__added"}) {
					{ i18n.T(ctx, i18n.KeyAddAdjusted) }
					<a class="goen-pdp__addedlink" href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
				}
			}
			if v.AddRefused() {
				@components.Notice(components.NoticeProps{
					Intent: components.IntentDanger, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyAddRefused) }
				}
			}
			if v.CartFull() {
				@components.Notice(components.NoticeProps{
					Intent: components.IntentDanger, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyCartLineLimit) }
				}
			}
		</form>
	</div>
}

// Outside #buybox because a region with a view-transition-name contains its fixed
// descendants; rides every swap through hx-select-oob. It renders even when empty,
// or a swap would leave the previous bar standing.
templ productBuyBar(v *ProductView) {
	<div id="buybar" class="goen-buybar" data-follows={ v.BuyBarFollows() }>
		if msg := v.BuyBarOutcome(ctx); msg != "" {
			<p class="goen-buybar__msg" role="status">{ msg }</p>
			if v.JustAdded() || v.AddAdjusted() {
				@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Class: "goen-buybar__btn"}, templ.SafeURL("/cart")) {
					{ i18n.T(ctx, i18n.KeyViewCart) }
				}
			}
		} else if v.CanBuy() {
			<p class="goen-buybar__price">{ v.Price() }</p>
			@components.Button(components.ButtonProps{
				ButtonStyle: components.ButtonStylePrimary,
				Class:       "goen-buybar__btn",
				Attrs:       templ.Attributes{"form": "pdp-add"},
			}, "submit") {
				@icons.Cart()
				<span>{ i18n.T(ctx, i18n.KeyAddToCart) }</span>
			}
		} else if v.NotifyOffered() {
			@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Class: "goen-buybar__btn"}, templ.SafeURL("#restock")) {
				{ i18n.T(ctx, i18n.KeyRestockHeading) }
			}
		}
	</div>
}

// A plain link: the set is the address.
templ productCompare(v *ProductView) {
	if v.Comparable {
		<div class="goen-pdp__similar">
			if !v.AlreadyComparing() && !v.ComparingFull() {
				@components.ButtonLink(components.ButtonProps{
					ButtonStyle: components.ButtonStyleGhost, Class: "goen-pdp__compare",
				}, templ.SafeURL(v.CompareHref())) {
					{ i18n.T(ctx, i18n.KeyCompareSimilar) }
				}
			} else if v.AlreadyComparing() {
				@components.ButtonLink(components.ButtonProps{
					ButtonStyle: components.ButtonStyleGhost, Class: "goen-pdp__compare",
				}, templ.SafeURL(v.CompareHref())) {
					{ i18n.T(ctx, i18n.KeyViewCompare) }
				}
			} else {
				<p class="goen-pdp__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareFull), MaxCompare) }</p>
			}
		</div>
	}
}

templ productNotifyForm(v *ProductView) {
	<form id="restock" class="goen-pdp__notify" method="post" action={ templ.SafeURL(v.NotifyAction()) }>
		<input type="hidden" name="variant" value={ v.NotifyVariant() }/>
		<p class="goen-pdp__notifyhead">{ v.RestockNote(ctx) }</p>
		if v.NotifyTaken() {
			@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
				{ v.NotifyConfirmation(ctx) }
			}
		} else {
			<div class="goen-pdp__notifyrow">
				@components.Label(components.LabelProps{For: "notify-email", Class: "goen-sr-only"}) {
					{ i18n.T(ctx, i18n.KeyFieldEmail) }
				}
				@components.Input(components.FieldProps{
					ID: "notify-email", Name: "email", Type: "email", Value: v.NotifyEmailValue(),
					Invalid: v.NotifyRefused(), Describes: "notify-email-error",
					Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
						"required": true, "maxlength": "254", "autocomplete": "email",
						"placeholder": i18n.T(ctx, i18n.KeyFieldEmail),
					}, fieldrule.Message(i18n.KeyRestockBadEmail), fieldrule.ErrorID("notify-email-error")),
				})
				@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
					{ i18n.T(ctx, i18n.KeyRestockSubmit) }
				}
			</div>
			if v.NotifyNeedsOption() {
				<p class="ui-error-text" id="notify-option-error">{ i18n.T(ctx, i18n.KeyRestockNoOption) }</p>
			}
			if v.NotifyRefused() {
				<p class="ui-error-text" id="notify-email-error">{ i18n.T(ctx, i18n.KeyRestockBadEmail) }</p>
			} else {
				<p class="ui-error-text" id="notify-email-error" hidden></p>
			}
		}
	</form>
}

templ productReviews(v *ProductView) {
	<section class="goen-pdp__reviews" id="reviews" aria-labelledby="reviews-heading">
		<h2 id="reviews-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionReviews) }</h2>
		// The summary depends on there being ratings, not the section: the form that
		// writes the first rating is inside.
		if !v.HasRating() {
			<p class="goen-pdp__noreviews">{ i18n.T(ctx, i18n.KeyNoReviewsYet) }</p>
		}
		if v.HasRating() {
			<div class="goen-pdp__reviewlayout">
				<div class="goen-pdp__summary">
					<p class="goen-pdp__score">{ v.RatingText() }</p>
					@ratingStars(v.StarHalves())
					<p class="goen-pdp__scorecount">{ i18n.Count(ctx, i18n.KeyReviewCount, v.RatingCount, v.ReviewCountText()) }</p>
					<div class="goen-pdp__bars">
						for _, b := range v.RatingBars {
							<div class="goen-pdp__bar">
								<span class="goen-pdp__barlabel">{ i18n.Count(ctx, i18n.KeyStarsLabel, int64(b.Stars), b.StarsText()) }</span>
								<span class="goen-pdp__bartrack">
									<span class={ "goen-pdp__barfill", b.WidthClass() }></span>
								</span>
								<span class="goen-pdp__barcount">{ b.CountText() }</span>
							</div>
						}
					</div>
				</div>
				<div class="goen-pdp__reviewlist">
					for _, r := range v.Reviews {
						<article class="goen-pdp__review">
							<div class="goen-pdp__reviewhead">
								<span class="goen-pdp__reviewname">{ r.DisplayAuthor(ctx) }</span>
								<span class="goen-pdp__reviewstars" aria-hidden="true">
									@ratingStars(r.Rating * 2)
								</span>
								if r.Verified {
									@components.Badge(components.BadgeProps{}) {
										{ i18n.T(ctx, i18n.KeyVerifiedBuyer) }
									}
								}
								<time class="goen-pdp__reviewdate" datetime={ r.Date.ISO() }>{ shoptime.DateText(ctx, r.Date) }</time>
							</div>
							<p class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyRatingScore), r.RatingText()) }</p>
							if r.Title != "" {
								<p class="goen-pdp__reviewtitle">{ r.Title }</p>
							}
							<p class="goen-pdp__reviewbody">{ r.Body }</p>
						</article>
					}
				</div>
			</div>
		}
		if v.ReviewPosted {
			@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
				{ i18n.T(ctx, i18n.KeyReviewThanks) }
			}
		}
		@reviewForm(v)
	</section>
}

templ productQuestions(v *ProductView) {
	<section class="goen-pdp__qa" id="questions" aria-labelledby="qa-heading">
		<h2 id="qa-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionQA) }</h2>
		if v.AskTaken() {
			@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
				{ i18n.T(ctx, i18n.KeyQuestionPosted) }
			}
		}
		if v.HasQuestions() {
			<ul class="goen-qa" role="list">
				for _, q := range v.Questions {
					<li class="goen-qa__item">
						<p class="goen-qa__question">{ q.Body }</p>
						<span class="goen-pdp__meta">{ q.Who(ctx) } · { q.Asked }</span>
						if q.Answered() {
							<ul class="goen-qa__answers" role="list">
								for _, a := range q.Answers {
									<li class="goen-qa__answer">
										<p class="goen-qa__answerbody">{ a.Body }</p>
										<span class="goen-pdp__meta">
											{ a.Who(ctx) }
											if a.IsStaff {
												@components.Badge(components.BadgeProps{}) {
													{ i18n.T(ctx, i18n.KeyStaffAnswer) }
												}
											}
											{ " · " + a.At }
										</span>
									</li>
								}
							</ul>
						} else {
							<p class="goen-pdp__meta">{ i18n.T(ctx, i18n.KeyNoAnswerYet) }</p>
						}
					</li>
				}
			</ul>
		} else {
			<p class="goen-pdp__meta">{ i18n.T(ctx, i18n.KeyNoQuestionsYet) }</p>
		}
		@askForm(v)
	</section>
}

templ askForm(v *ProductView) {
	if !v.SignedIn {
		<p class="goen-pdp__reviewnote">
			<a href={ templ.SafeURL(v.AskSignInHref()) }>{ i18n.T(ctx, i18n.KeySignInFirst) }</a>{ i18n.T(ctx, i18n.KeySignInToAsk) }
		</p>
	} else {
		<form class="goen-qa__form" method="post" action={ templ.SafeURL(v.AskAction()) }>
			<div class="goen-field">
				@components.Label(components.LabelProps{For: "ask-body"}) {
					{ i18n.T(ctx, i18n.KeyAskLabel) }
				}
				@components.Textarea(components.FieldProps{
					ID: "ask-body", Name: "body",
					Invalid: v.AskRefused(), Describes: "ask-body-error",
					Attrs: templ.Attributes{
						"rows": "3", "required": true, "maxlength": "300",
						"placeholder": i18n.T(ctx, i18n.KeyAskPlaceholder),
					},
				}) {
					{ v.AskDraft }
				}
				if v.AskRefused() {
					<p class="ui-error-text" id="ask-body-error">{ i18n.T(ctx, i18n.KeyQuestionRefused) }</p>
				}
			</div>
			@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
				{ i18n.T(ctx, i18n.KeyAskSubmit) }
			}
		</form>
	}
}

templ reviewForm(v *ProductView) {
	if v.ReviewStanding == ReviewSignedOut {
		<p class="goen-pdp__reviewnote">
			<a href={ templ.SafeURL("/signin?next=/p/" + v.Slug) }>{ i18n.T(ctx, i18n.KeySignInFirst) }</a>{ i18n.T(ctx, i18n.KeySignInToReview) }
		</p>
	} else if v.ReviewStanding == ReviewNotDelivered {
		<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyReviewAfterDelivery) }</p>
	} else if v.ReviewStanding == ReviewAlreadyWritten {
		<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyAlreadyReviewed) }</p>
	} else {
		<div class="goen-pdp__reviewform">
			<form id="write-review" method="post" action={ templ.SafeURL(v.ReviewAction()) }>
				<h3 class="goen-pdp__reviewformhead">{ i18n.T(ctx, i18n.KeyWriteReview) }</h3>
				<fieldset class="goen-pdp__stars">
					<legend class="goen-label">{ i18n.T(ctx, i18n.KeyFieldRating) }</legend>
					<div class="goen-pdp__starrow">
						for _, n := range []int{1, 2, 3, 4, 5} {
							<label class="goen-pdp__star">
								<input
									class="goen-pdp__starinput goen-sr-only"
									type="radio"
									name="rating"
									value={ n }
									required
									checked?={ v.ReviewDraft.IsRating(n) }
								/>
								<span class="goen-pdp__starmark" aria-hidden="true">
									@icons.Star()
								</span>
								<span class="goen-sr-only">{ i18n.Count(ctx, i18n.KeyStarsLabel, int64(n), strconv.Itoa(n)) }</span>
							</label>
						}
					</div>
				</fieldset>
				if v.HasReviewErr("rating") {
					<p class="ui-error-text">{ v.ReviewErr("rating") }</p>
				}
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "review-title"}) {
						{ i18n.T(ctx, i18n.KeyFieldReviewTitle) }
					}
					@components.Input(components.FieldProps{
						ID: "review-title", Name: "title", Value: v.ReviewDraft.Title,
						Attrs: templ.Attributes{"maxlength": "80"},
					})
				</div>
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "review-body"}) {
						{ i18n.T(ctx, i18n.KeyFieldReviewBody) }
					}
					@components.Textarea(components.FieldProps{
						ID: "review-body", Name: "body", Class: "goen-pdp__reviewbody",
						Invalid: v.HasReviewErr("body"), Describes: "review-body-error review-body-hint",
						Attrs: v.reviewBodyAttrs(),
					}) {
						{ v.ReviewDraft.Body }
					}
					<p class="goen-pdp__reviewnote" id="review-body-hint">{ v.ReviewBodyHint(ctx) }</p>
					if v.HasReviewErr("body") {
						<p class="ui-error-text" id="review-body-error">{ v.ReviewErr("body") }</p>
					}
				</div>
				@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
					{ i18n.T(ctx, i18n.KeyReviewSubmit) }
				}
			</form>
		</div>
	}
}
