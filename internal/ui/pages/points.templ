package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Points renders the customer's points, what they are worth, and the ledger.
templ Points(p layouts.Page, v PointsView) {
	@layouts.Base(p) {
		<div class="goen-account goen-account--narrow">
			@components.Breadcrumb(components.BreadcrumbProps{
				Label: i18n.T(ctx, i18n.KeyBreadcrumb),
				Crumbs: []components.Crumb{
					{Label: i18n.T(ctx, i18n.KeyAccountTitle), Href: "/account"},
					{Label: i18n.T(ctx, i18n.KeyPointsTitle)},
				},
			})
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyPointsTitle) }</h1>
				<p class="goen-pagehead__sub">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPointsSub), v.RateText(ctx)) }
				</p>
			</div>
			if v.Notice != "" {
				@components.Notice(components.NoticeProps{Tone: components.ToneAccent, ID: "points-notice", Class: "ui-alert--info"}) {
					{ v.Notice }
				}
			}
			<ul class="goen-points__figures" role="list">
				<li class="goen-points__figure">
					<span class="goen-points__label">{ i18n.T(ctx, i18n.KeyPointsBalance) }</span>
					<span class="goen-points__value">{ v.BalanceText() }</span>
				</li>
				<li class="goen-points__figure">
					<span class="goen-points__label">{ i18n.T(ctx, i18n.KeyPointsRedeemable) }</span>
					<span class="goen-points__value">{ v.Credit() }</span>
					<span class="goen-points__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPointsUsing), v.RedeemableText()) }</span>
				</li>
			</ul>
			if v.Expiring() {
				@components.Notice(components.NoticeProps{Tone: components.ToneWarn, ID: "points-expiring"}) {
					{ v.ExpiringText(ctx) }
				}
			}
			if v.CanRedeem() {
				<form class="goen-card goen-qa__form" method="post" action="/account/points">
					<input type="hidden" name="operation_id" value={ v.OperationID }/>
					<div class="goen-field">
						@components.Label(components.LabelProps{For: "points"}) {
							{ i18n.T(ctx, i18n.KeyPointsHowMany) }
						}
						@components.Input(components.FieldProps{
							ID:    "points",
							Name:  "points",
							Type:  "number",
							Value: v.RedeemableText(),
							Class: "ui-input goen-points__field",
							Attrs: templ.Attributes{
								"aria-describedby": "points-rule",
								"inputmode":        "numeric",
								"max":              v.RedeemableText(),
								"min":              v.MinimumText(),
								"required":         true,
								"step":             v.StepText(),
							},
						})
						<p class="goen-points__rule" id="points-rule">
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPointsRule), v.MinimumText(), v.RateText(ctx)) }
						</p>
					</div>
					@components.Button(components.ButtonProps{Variant: components.VariantPrimary, Class: "ui-btn goen-points__submit"}, "submit") {
						{ i18n.T(ctx, i18n.KeyPointsRedeem) }
					}
				</form>
			}
			<section class="goen-points__ledger" aria-labelledby="ledger-heading">
				<h2 class="goen-points__ledgerhead" id="ledger-heading">{ i18n.T(ctx, i18n.KeyPointsLedger) }</h2>
				if v.Empty() {
					<p class="goen-points__meta">{ i18n.T(ctx, i18n.KeyPointsEmpty) }</p>
				} else {
					<ul class="goen-points" role="list">
						for _, e := range v.Entries {
							<li class={ "goen-points__item", templ.KV("is-expired", e.Expired) }>
								<span class={ "goen-points__amount", templ.KV("is-earned", e.Earned()) }>
									{ e.Amount() }
								</span>
								<span class="goen-points__what">{ e.What(ctx) }</span>
								<span class="goen-points__meta">
									if e.Detail(ctx) != "" {
										{ e.Detail(ctx) }
									}
									{ e.At }
									if e.ExpiresOn != "" {
										if e.Expired {
											{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPointsExpired), e.ExpiresOn) }
										} else {
											{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPointsExpiresOn), e.ExpiresOn) }
										}
									}
								</span>
							</li>
						}
					</ul>
				}
			</section>
		</div>
	}
}
