package pages

import (
	"context"
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// DealsMeta is the chrome view model for the deals page.
func DealsMeta(ctx context.Context) layouts.Page {
	return layouts.Page{Title: i18n.T(ctx, i18n.KeyDeals2)}
}

// Deals renders the marked-down products, reusing SearchView.
templ Deals(p layouts.Page, v SearchView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<div class="goen-pagehead">
				<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, i18n.KeyDeals2) }</p>
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyDealsTitle) }</h1>
				if v.Total > 0 {
					<p class="goen-pagehead__sub">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyDealsCount), v.TotalText()) }</p>
				}
			</div>
			if v.HasCampaigns() {
				<section id="campaigns">
					@campaignStrip(v.Campaigns.Rows)
					if v.Campaigns.Pages() > 1 {
						<nav class="goen-pager" aria-label={ i18n.T(ctx, i18n.KeyCampaignPagination) }>
							if v.Campaigns.Page > 1 {
								<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(v.CampaignPageHref(v.Campaigns.Page - 1)) }>{ i18n.T(ctx, i18n.KeyPrevPage) }</a>
							}
							<span class="goen-pager__at">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCampaignPageCount), v.Campaigns.Page, v.Campaigns.Pages()) }</span>
							if v.Campaigns.Page < v.Campaigns.Pages() {
								<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(v.CampaignPageHref(v.Campaigns.Page + 1)) }>{ i18n.T(ctx, i18n.KeyNextPage) }</a>
							}
						</nav>
					}
				</section>
			}
			if v.Total == 0 {
				@components.Notice(components.NoticeProps{}) {
					{ i18n.T(ctx, i18n.KeyDealsEmpty) }
				}
			} else {
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				<ul class="goen-tiles__grid" role="list">
					for _, t := range v.Products {
						@Tile(t)
					}
				</ul>
				@pager(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
			}
		</div>
	}
}
