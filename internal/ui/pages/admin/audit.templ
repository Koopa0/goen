package admin

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/pages"
)

// A feed rather than a table: the detail line is a recorded payload of no fixed
// width, and a column that held one would turn every other row into empty space.
templ Audit(p layouts.Page, v AuditView) {
	@layouts.Admin(p, "audit") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageAudit) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminAuditLead) }
				</p>
			</div>
		</div>
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminAuditEmpty) }</p>
			</div>
		} else if !v.Empty() {
			<ul class="goen-admin__audit" role="list">
				for _, e := range v.Rows {
					<li class={ "goen-admin__auditrow", templ.KV("is-money", e.Money()) }>
						<div class="goen-admin__audithead">
							<span class="goen-admin__auditaction">{ e.Label(ctx) }</span>
							if e.Money() {
								@components.Badge(components.BadgeProps{Intent: components.IntentNeutral}) {
									{ i18n.T(ctx, i18n.KeyAuditMoneyTag) }
								}
							}
							<span class="goen-admin__meta">{ e.At }</span>
						</div>
						<span class="goen-admin__meta">
							{ e.ActorText(ctx) } · { e.EntityLabel(ctx) }
							if e.Subject != "" && e.Href != "" {
								· <a href={ templ.URL(e.Href) }>{ e.Subject }</a>
							} else if e.Subject != "" {
								· { e.Subject }
							}
						</span>
						if len(e.Changes) > 0 {
							<dl class="goen-admin__auditdetail">
								for _, c := range e.ReadableChanges(ctx) {
									<dt>{ c.Label }</dt>
									if c.Href != "" {
										<dd><a href={ templ.URL(c.Href) }>{ c.Text }</a></dd>
									} else {
										<dd>{ c.Text }</dd>
									}
								}
							</dl>
						}
						if e.RequestID != "" {
							<span class="goen-admin__meta">req { e.ShortRequestID() }</span>
						}
					</li>
				}
			</ul>
		}
		@pages.ListPager(v.Bound)
	}
}
