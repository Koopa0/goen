package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/pages"
)

// A table rather than a list of blocks: what a staff member opens this page to do is
// find one row among a hundred.
templ Products(p layouts.Page, v ProductsView) {
	@layouts.Admin(p, "products") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageProducts) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminProdLead) }
				</p>
				<p class="ui-page-head__sub">{ i18n.Count(ctx, i18n.KeyAdminProdPublished, v.Published, v.Published) }</p>
			</div>
			@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "/admin/products/new") {
				{ i18n.T(ctx, i18n.KeyAdminPageNewProduct) }
			}
		</div>
		@Announce(v.Notice)
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminProdEmpty) }</p>
			</div>
		} else if !v.Empty() {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColProduct) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminProdBrand) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminProdVariants) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range v.Rows {
							<tr>
								<td class="goen-admin__cellkey">
									<a href={ templ.SafeURL(row.Href()) }>{ row.Name }</a>
									<span class="goen-admin__meta">/p/{ row.Slug }</span>
								</td>
								<td>
									{ row.Brand }
									<span class="goen-admin__meta">{ row.Category }</span>
								</td>
								<td>
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminProdVariantsFrom), row.VariantsText(), row.From()) }
								</td>
								<td>
									// display:flex belongs to a division inside the cell: setting it on
									// the <td> stops the element being a table cell and the columns
									// stop lining up.
									<div class="goen-admin__cellbadges">
										if row.Sellable() {
											@components.Badge(components.BadgeProps{Intent: components.IntentDone}) {
												{ row.StatusText }
											}
										} else {
											@components.Badge(components.BadgeProps{Intent: components.IntentNeutral}) {
												{ row.StatusText }
											}
										}
										if !row.Translated {
											@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
												{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
											}
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@pages.ListPager(v.Bound)
	}
}

// One card per job, because they are done at different times and a single column of
// forty fields hides which one you are in.
templ ProductForm(p layouts.Page, v ProductView) {
	@layouts.Admin(p, "products") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">
					<a href="/admin/products">{ i18n.T(ctx, i18n.KeyAdminPageProducts) }</a>
				</p>
				<h1 class="ui-page-head__title">{ v.Title(ctx) }</h1>
				if !v.IsNew {
					<p class="ui-page-head__sub">{ v.StatusText } · /p/{ v.Slug }</p>
				}
			</div>
			if !v.IsNew {
				<div class="ui-page-head__actions">
					@productPublishing(v)
				</div>
			}
		</div>
		@Announce(v.Notice)
		@RefusalSummary(summarizeRefusal(i18n.KeyAdminProdBasics, v.Errors, refusalField{"name", "p-name"}, refusalField{"slug", "p-slug"}, refusalField{"brand", "p-brand"}, refusalField{"category", "p-category"}, refusalField{"summary", "p-summary"}, refusalField{"description", "p-description"}, refusalField{"name_en", "p-name-en"}, refusalField{"summary_en", "p-summary-en"}, refusalField{"description_en", "p-description-en"}, refusalField{"warranty_months", "p-warranty-months"}))
		@RefusalSummary(v.VariantRefusal())
		@RefusalSummary(summarizeRefusal(i18n.KeyAdminProdOptionAdd, v.Errors, refusalField{"option", "opt-name"}, refusalField{"option_en", "opt-name-en"}))
		@RefusalSummary(summarizeRefusal(i18n.KeyAdminProdValueAdd, v.Errors, refusalField{"value", "optval-value"}, refusalField{"value_en", "optval-value-en"}, refusalField{"swatch_hex", "optval-swatch"}))
		@RefusalSummary(summarizeRefusal(i18n.KeyAdminProdSpecs, v.Errors, refusalField{"spec_label", "spec-label"}, refusalField{"spec_value", "spec-value"}, refusalField{"spec_label_en", "spec-label-en"}, refusalField{"spec_value_en", "spec-value-en"}))
		if !v.IsNew {
			<nav class="goen-admin__sectionnav" aria-label={ i18n.T(ctx, i18n.KeyAdminProdSectionNav) }>
				<a href="#sec-details">{ i18n.T(ctx, i18n.KeyAdminProdBasics) }</a>
				<a href="#sec-label">{ i18n.T(ctx, i18n.KeyProductLabel) }</a>
				<a href="#sec-invoice">{ i18n.T(ctx,i18n.KeyProductInvoiceLine) }</a>
				<a href="#sec-images">{ i18n.T(ctx, i18n.KeyAdminProdImages) }</a>
				<a href="#sec-options">{ i18n.T(ctx, i18n.KeyAdminProdOptions) }</a>
				<a href="#sec-variants">{ i18n.T(ctx, i18n.KeyAdminProdVariants) }</a>
				<a href="#sec-specs">{ i18n.T(ctx, i18n.KeyAdminProdSpecs) }</a>
				<a href="#sec-standing">{ i18n.T(ctx, i18n.KeyAdminProdStanding) }</a>
			</nav>
		}
		@productDetails(v)
		if !v.IsNew {
			@productLabel(v)
			@productInvoiceLine(v)
			@productImages(v)
			@productOptions(v)
			@productVariants(v)
			@productSpecs(v)
			@productStanding(v)
		}
	}
}

templ productDetails(v ProductView) {
	@components.Card(components.CardProps{Class: "goen-admin__section", Attrs: templ.Attributes{"id": "sec-details"}}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminProdBasics) }</h2>
		<form class="goen-admin__form" method="post" action={ templ.SafeURL(v.Action() + "#sec-details") }>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "p-name"}) {
					{ i18n.T(ctx, i18n.KeyAdminProdName) }
				}
				<input
					class="goen-input"
					id="p-name"
					name="name"
					required
					maxlength="200"
					value={ v.Name }
					if v.HasErr("name") {
						aria-invalid="true"
						aria-describedby="p-name-error"
					}
				/>
				if v.HasErr("name") {
					<p class="ui-error-text" id="p-name-error">{ v.Err("name") }</p>
				}
			</div>
			if v.IsNew {
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "p-slug"}) {
						{ i18n.T(ctx, i18n.KeyAdminColSlug) }
					}
					<input
						class="goen-input"
						id="p-slug"
						name="slug"
						required
						maxlength="120"
						value={ v.Slug }
						if v.HasErr("slug") {
							aria-invalid="true"
							aria-describedby="p-slug-error"
						}
					/>
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminProdSlugHint) }</p>
					<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminExample), "ceramic-mug") }</p>
					if v.HasErr("slug") {
						<p class="ui-error-text" id="p-slug-error">{ v.Err("slug") }</p>
					}
				</div>
			}
			<div class="goen-admin__fields">
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "p-brand"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdBrand) }
					}
					<select
						class="goen-input"
						id="p-brand"
						name="brand"
						if v.HasErr("brand") {
							aria-invalid="true"
							aria-describedby="p-brand-error"
						}
					>
						<option value="" selected?={ v.Selected("brand", "") }>{ i18n.T(ctx, i18n.KeyAdminProdNoBrand) }</option>
						for _, c := range v.Brands {
							<option value={ c.Value } selected?={ v.Selected("brand", c.Value) }>{ c.Label }</option>
						}
					</select>
					if v.HasErr("brand") {
						<p class="ui-error-text" id="p-brand-error">{ v.Err("brand") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "p-category"}) {
						{ i18n.T(ctx, i18n.KeyAdminColCategory) }
					}
					<select
						class="goen-input"
						id="p-category"
						name="category"
						required
						if v.HasErr("category") {
							aria-invalid="true"
							aria-describedby="p-category-error"
						}
					>
						<option value="">{ i18n.T(ctx, i18n.KeyAdminProdChoose) }</option>
						for _, c := range v.Categories {
							<option value={ c.Value } selected?={ v.Selected("category", c.Value) }>{ c.Label }</option>
						}
					</select>
					if v.HasErr("category") {
						<p class="ui-error-text" id="p-category-error">{ v.Err("category") }</p>
					}
				</div>
			</div>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "p-summary"}) {
					{ i18n.T(ctx, i18n.KeyAdminProdSummary) }
				}
				<input
					class="goen-input"
					id="p-summary"
					name="summary"
					maxlength="500"
					value={ v.Summary }
					if v.HasErr("summary") {
						aria-invalid="true"
						aria-describedby="p-summary-error"
					}
				/>
				if v.HasErr("summary") {
					<p class="ui-error-text" id="p-summary-error">{ v.Err("summary") }</p>
				}
			</div>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "p-description"}) {
					{ i18n.T(ctx, i18n.KeyAdminProdDescription) }
				}
				<textarea
					class="goen-input goen-input--area"
					id="p-description"
					name="description"
					rows="8"
					if v.HasErr("description") {
						aria-invalid="true"
						aria-describedby="p-description-error"
					}
				>{ v.Description }</textarea>
				if v.HasErr("description") {
					<p class="ui-error-text" id="p-description-error">{ v.Err("description") }</p>
				}
			</div>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "p-name-en"}) {
					{ i18n.T(ctx, i18n.KeyAdminProdNameEn) }
				}
				<input
					class="goen-input"
					id="p-name-en"
					name="name_en"
					maxlength="200"
					value={ v.NameEn }
					if v.HasErr("name_en") {
						aria-invalid="true"
						aria-describedby="p-name-en-error"
					}
				/>
				if v.HasErr("name_en") {
					<p class="ui-error-text" id="p-name-en-error">{ v.Err("name_en") }</p>
				}
			</div>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "p-summary-en"}) {
					{ i18n.T(ctx, i18n.KeyAdminProdSummaryEn) }
				}
				<input
					class="goen-input"
					id="p-summary-en"
					name="summary_en"
					maxlength="500"
					value={ v.SummaryEn }
					if v.HasErr("summary_en") {
						aria-invalid="true"
						aria-describedby="p-summary-en-error"
					}
				/>
				if v.HasErr("summary_en") {
					<p class="ui-error-text" id="p-summary-en-error">{ v.Err("summary_en") }</p>
				}
			</div>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "p-description-en"}) {
					{ i18n.T(ctx, i18n.KeyAdminProdDescriptionEn) }
				}
				<textarea
					class="goen-input goen-input--area"
					id="p-description-en"
					name="description_en"
					rows="8"
					if v.HasErr("description_en") {
						aria-invalid="true"
						aria-describedby="p-description-en-error"
					}
				>{ v.DescriptionEn }</textarea>
				if v.HasErr("description_en") {
					<p class="ui-error-text" id="p-description-en-error">{ v.Err("description_en") }</p>
				}
			</div>
			<div class="goen-admin__fields">
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "p-warranty-months"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdWarrantyMonths) }
					}
					<input
						class="goen-input"
						id="p-warranty-months"
						name="warranty_months"
						type="text"
						inputmode="numeric"
						value={ v.WarrantyMonthsText() }
						if v.HasErr("warranty_months") {
							aria-invalid="true"
							aria-describedby="p-warranty-months-error"
						}
					/>
					if v.HasErr("warranty_months") {
						<p class="ui-error-text" id="p-warranty-months-error">{ v.Err("warranty_months") }</p>
					}
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminProdWarrantyHint) }
					</p>
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "p-warranty"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdWarrantyNote) }
					}
					<input class="goen-input" id="p-warranty" name="warranty" maxlength="300" value={ v.WarrantyNote }/>
				</div>
			</div>
			@components.Button(components.ButtonProps{
				ButtonStyle: components.ButtonStylePrimary,
				Class:       "goen-admin__submit",
			}, "submit") {
				if v.IsNew {
					{ i18n.T(ctx, i18n.KeyAdminProdCreateDraft) }
				} else {
					{ i18n.T(ctx, i18n.KeyAdminProdSave) }
				}
			}
		</form>
	}
}

// imageMoveForm is one plain POST: with scripting off it is a form, and a stale
// page answers 422 with the current order.
templ imageMoveForm(v ProductView, digest, move string, label i18n.Key) {
	<form method="post" action={ templ.SafeURL(v.ImageMoveAction()) }>
		<input type="hidden" name="digest" value={ digest }/>
		<input type="hidden" name="move" value={ move }/>
		@components.Button(components.ButtonProps{
			ButtonStyle: components.ButtonStyleOutline,
			Size:        components.SizeSmall,
		}, "submit") {
			{ i18n.T(ctx, label) }
		}
	</form>
}

templ productImages(v ProductView) {
	@components.Card(components.CardProps{Class: "goen-admin__section", Attrs: templ.Attributes{"id": "sec-images"}}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminProdImages) }</h2>
		if v.HasImages() {
			<ul class="goen-admin__images" role="list">
				for i, img := range v.Images {
					<li class="goen-admin__image">
						<img src={ img.URL() } srcset={ img.Srcset() } sizes="120px" alt={ img.Alt } loading="lazy" width="120" height="120"/>
						<span class="goen-admin__meta">{ img.Alt }</span>
						if i > 0 {
							@imageMoveForm(v, img.Key, "cover", i18n.KeyAdminImageCover)
							@imageMoveForm(v, img.Key, "up", i18n.KeyAdminImageUp)
						}
						if i < len(v.Images)-1 {
							@imageMoveForm(v, img.Key, "down", i18n.KeyAdminImageDown)
						}
						if v.HasOptions() {
							<form method="post" action={ templ.SafeURL(v.ImageOptionAction()) }>
								<input type="hidden" name="digest" value={ img.Key }/>
								<label class="goen-sr-only" for={ "image-option-" + img.Key }>{ i18n.T(ctx, i18n.KeyAdminProdImageOption) }</label>
								<select class="goen-input" id={ "image-option-" + img.Key } name="option_value">
									@imageOptionChoices(v, img.OptionValueID)
								</select>
								@components.Button(components.ButtonProps{
									ButtonStyle: components.ButtonStyleOutline,
									Size:        components.SizeSmall,
								}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminProdSave) }
								}
							</form>
						}
						<form method="post" action={ templ.SafeURL(v.ImageRemoveAction()) }>
							<input type="hidden" name="digest" value={ img.Key }/>
							@components.Button(components.ButtonProps{
								ButtonStyle: components.ButtonStyleOutline,
								Size:        components.SizeSmall,
							}, "submit") {
								{ i18n.T(ctx, i18n.KeyAdminRemove) }
							}
						</form>
					</li>
				}
			</ul>
		} else {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminProdNoImages) }</p>
			</div>
		}
		// Without enctype a browser posts only the filename.
		<form
			class="goen-admin__form"
			method="post"
			action={ templ.SafeURL(v.ImageAction()) }
			enctype="multipart/form-data"
		>
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: "p-image"}) {
					{ i18n.T(ctx, i18n.KeyAdminProdUpload) }
				}
				<input
					class="goen-input"
					id="p-image"
					name="image"
					type="file"
					accept="image/*"
					required
					if v.HasErr("image") {
						aria-invalid="true"
						aria-describedby="p-image-error"
					}
				/>
				if v.HasErr("image") {
					<p class="ui-error-text" id="p-image-error" role="alert">{ v.Err("image") }</p>
				}
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminProdUploadHint) }</p>
			</div>
			<div class="goen-admin__fields">
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "p-alt"}) {
						{ i18n.T(ctx, i18n.KeyAdminAltText) }
					}
					<input
						class="goen-input"
						id="p-alt"
						name="alt"
						value={ v.ImageUploadDraft.Alt }
						if v.HasErr("alt") {
							aria-invalid="true"
							aria-describedby="p-alt-error"
						}
						required
						maxlength="200"
						placeholder={ altExample }
					/>
					if v.HasErr("alt") {
						<p class="ui-error-text" id="p-alt-error" role="alert">{ v.Err("alt") }</p>
					}
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminProdAltHint) }</p>
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "p-alt-en"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdAltEn) }
					}
					<input
						class="goen-input"
						id="p-alt-en"
						name="alt_en"
						value={ v.ImageUploadDraft.AltEn }
						if v.HasErr("alt_en") {
							aria-invalid="true"
							aria-describedby="p-alt-en-error"
						}
						maxlength="200"
						placeholder="White ceramic mug, side view, handle on the right"
					/>
					if v.HasErr("alt_en") {
						<p class="ui-error-text" id="p-alt-en-error" role="alert">{ v.Err("alt_en") }</p>
					}
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminProdAltEnHint) }
					</p>
				</div>
				if v.HasOptions() || v.ImageUploadDraft.OptionValue != "" {
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "p-image-option"}) {
							{ i18n.T(ctx, i18n.KeyAdminProdImageOption) }
						}
						<select
							class="goen-input"
							id="p-image-option"
							name="option_value"
							if v.HasErr("image_option") {
								aria-invalid="true"
								aria-describedby="p-image-option-hint p-image-option-error"
							} else {
								aria-describedby="p-image-option-hint"
							}
						>
							@imageOptionChoices(v, v.ImageUploadDraft.OptionValue)
						</select>
						if v.HasErr("image_option") {
							<p class="ui-error-text" id="p-image-option-error" role="alert">{ v.Err("image_option") }</p>
						}
						<p class="goen-admin__hint" id="p-image-option-hint">{ i18n.T(ctx, i18n.KeyAdminProdImageOptionHint) }</p>
					</div>
				}
			</div>
			@components.Button(components.ButtonProps{
				ButtonStyle: components.ButtonStyleOutline,
				Class:       "goen-admin__submit",
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminProdAddImage) }
			}
		</form>
		if v.HasLibrary() {
			<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminProdLibrary) }</h3>
			<div class="goen-admin__library">
				for _, img := range v.Library {
					<form class="goen-admin__libraryitem" method="post" action={ templ.SafeURL(v.ReuseAction()) }>
						<input type="hidden" name="digest" value={ img.Key }/>
						<img src={ img.URL() } srcset={ img.Srcset() } sizes="80px" alt="" width="80" height="80" loading="lazy" decoding="async"/>
						<label class="goen-sr-only" for={ "reuse-alt-" + img.Key }>{ i18n.T(ctx, i18n.KeyAdminAltText) }</label>
						<input
							class="goen-input"
							id={ "reuse-alt-" + img.Key }
							name="alt"
							if v.ImageReuseDraft.Digest == img.Key {
								value={ v.ImageReuseDraft.Alt }
								if v.HasErr("reuse_alt") {
									aria-invalid="true"
									aria-describedby={ "reuse-alt-" + img.Key + "-error" }
								}
							}
							required
							maxlength="200"
							placeholder={ i18n.T(ctx, i18n.KeyAdminAltText) }
						/>
						if v.ImageReuseDraft.Digest == img.Key && v.HasErr("reuse_alt") {
							<p class="ui-error-text" id={ "reuse-alt-" + img.Key + "-error" } role="alert">{ v.Err("reuse_alt") }</p>
						}
						<label class="goen-sr-only" for={ "reuse-alt-en-" + img.Key }>{ i18n.T(ctx, i18n.KeyAdminProdAltEn) }</label>
						<input
							class="goen-input"
							id={ "reuse-alt-en-" + img.Key }
							name="alt_en"
							maxlength="200"
							placeholder="English alt text"
							if v.ImageReuseDraft.Digest == img.Key {
								value={ v.ImageReuseDraft.AltEn }
								if v.HasErr("reuse_alt_en") {
									aria-invalid="true"
									aria-describedby={ "reuse-alt-en-" + img.Key + "-error" }
								}
							}
						/>
						if v.ImageReuseDraft.Digest == img.Key && v.HasErr("reuse_alt_en") {
							<p class="ui-error-text" id={ "reuse-alt-en-" + img.Key + "-error" } role="alert">{ v.Err("reuse_alt_en") }</p>
						}
						{{ reuseAttrs := templ.Attributes{"id": "reuse-image-" + img.Key} }}
						if v.ImageReuseDraft.Digest == img.Key && v.HasErr("reuse_image") {
							{{ reuseAttrs["aria-invalid"] = "true" }}
							{{ reuseAttrs["aria-describedby"] = "reuse-image-" + img.Key + "-error" }}
							<p class="ui-error-text" id={ "reuse-image-" + img.Key + "-error" } role="alert">{ v.Err("reuse_image") }</p>
						}
						@components.Button(components.ButtonProps{
							ButtonStyle: components.ButtonStyleOutline,
							Size:        components.SizeSmall,
							Attrs:       reuseAttrs,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminProdReuse) }
						}
					</form>
				}
			</div>
		}
	}
}

// imageOptionChoices lists every option value, not only a colour: the schema has no
// colour axis, only the shop's own names.
templ imageOptionChoices(v ProductView, chosen string) {
	if chosen != "" && !v.HasOptionValue(chosen) {
		<option value={ chosen } selected>{ i18n.T(ctx, i18n.KeyAdminNoticeBadOption) }</option>
	}
	<option value="" selected?={ chosen == "" }>{ i18n.T(ctx, i18n.KeyAdminProdImageAnyOption) }</option>
	for _, o := range v.Options {
		if o.HasValues() {
			<optgroup label={ o.Name }>
				for _, val := range o.Values {
					<option value={ val.ID } selected?={ val.ID == chosen }>{ val.Value }</option>
				}
			</optgroup>
		}
	}
}

templ productOptions(v ProductView) {
	@components.Card(components.CardProps{Class: "goen-admin__section", Attrs: templ.Attributes{"id": "sec-options"}}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminProdOptions) }</h2>
		<p class="goen-admin__hint">
			{ i18n.T(ctx, i18n.KeyAdminProdOptionsLead) }
		</p>
		if v.HasOptions() {
			<ul class="goen-admin__options" role="list">
				for _, o := range v.Options {
					<li class="goen-admin__option">
						<span class="goen-admin__sku">
							{ o.Name }
							if o.Translated() {
								<span class="goen-admin__meta">{ o.NameEn }</span>
							} else {
								@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
									{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
								}
							}
						</span>
						if o.HasValues() {
							<span class="goen-admin__meta">
								for _, val := range o.Values {
									{ val.Value }
									if val.Label != "" {
										({ val.Label })
									}
								}
							</span>
						} else {
							<span class="goen-admin__meta">{ i18n.T(ctx, i18n.KeyAdminProdNoValues) }</span>
						}
					</li>
				}
			</ul>
		} else {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminProdNoOptions) }</p>
			</div>
		}
		if v.OptionsFrozen() {
			<div id="opt-frozen" class="goen-admin__hint">
				<p>{ i18n.T(ctx, i18n.KeyFormOptionBeforeVariants) }</p>
				if v.HasErr("option") {
					<p class="ui-error-text" id="opt-name-error" role="alert">{ v.Err("option") }</p>
				}
			</div>
		} else {
			<form class="goen-admin__form" method="post" action={ templ.SafeURL(v.OptionAction() + "#sec-options") }>
				<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminProdOptionAdd) }</h3>
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "opt-name"}) {
							{ i18n.T(ctx, i18n.KeyAdminProdOptionName) }
						}
						<input
							class="goen-input"
							id="opt-name"
							name="name"
							required
							maxlength="40"
							autocomplete="off"
							value={ v.VariantDraft.OptionName }
							placeholder={ optionExample }
							if v.HasErr("option") {
								aria-invalid="true"
								aria-describedby="opt-name-error"
							}
						/>
						if v.HasErr("option") {
							<p class="ui-error-text" id="opt-name-error">{ v.Err("option") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "opt-name-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminProdOptionNameEn) }
						}
						<input
							class="goen-input"
							id="opt-name-en"
							name="name_en"
							maxlength="40"
							autocomplete="off"
							value={ v.VariantDraft.OptionNameEn }
							placeholder="Colour"
							if v.HasErr("option_en") {
								aria-invalid="true"
								aria-describedby="opt-name-en-error"
							}
						/>
						if v.HasErr("option_en") {
							<p class="ui-error-text" id="opt-name-en-error">{ v.Err("option_en") }</p>
						}
					</div>
				</div>
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminProdOptionAdd) }
				}
			</form>
		}
		if v.HasOptions() {
			<form class="goen-admin__form" method="post" action={ templ.SafeURL(v.OptionValueAction() + "#sec-options") }>
				<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminProdValueAdd) }</h3>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "optval-option"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdValueOption) }
					}
					<select class="goen-input" id="optval-option" name="option" required>
						for _, o := range v.Options {
							<option value={ o.ID } selected?={ v.VariantDraft.ValueOption == o.ID }>{ o.Name }</option>
						}
					</select>
				</div>
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "optval-value"}) {
							{ i18n.T(ctx, i18n.KeyAdminProdValue) }
						}
						<input
							class="goen-input"
							id="optval-value"
							name="value"
							required
							maxlength="40"
							autocomplete="off"
							value={ v.VariantDraft.Value }
							placeholder={ optionValExample }
							if v.HasErr("value") {
								aria-invalid="true"
								aria-describedby="optval-value-error"
							}
						/>
						if v.HasErr("value") {
							<p class="ui-error-text" id="optval-value-error">{ v.Err("value") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "optval-value-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminProdValueEn) }
						}
						<input
							class="goen-input"
							id="optval-value-en"
							name="value_en"
							maxlength="40"
							autocomplete="off"
							value={ v.VariantDraft.ValueEn }
							placeholder="Mist Blue"
							if v.HasErr("value_en") {
								aria-invalid="true"
								aria-describedby="optval-value-en-error"
							}
						/>
						if v.HasErr("value_en") {
							<p class="ui-error-text" id="optval-value-en-error">{ v.Err("value_en") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "optval-swatch"}) {
							{ i18n.T(ctx, i18n.KeyAdminProdValueSwatch) }
						}
						<input
							class="goen-input"
							id="optval-swatch"
							name="swatch_hex"
							maxlength="7"
							autocomplete="off"
							pattern="#[0-9a-f]{6}"
							value={ v.VariantDraft.Swatch }
							placeholder="#1c1c1e"
							if v.HasErr("swatch_hex") {
								aria-invalid="true"
								aria-describedby="optval-swatch-error"
							}
						/>
						if v.HasErr("swatch_hex") {
							<p class="ui-error-text" id="optval-swatch-error">{ v.Err("swatch_hex") }</p>
						}
					</div>
				</div>
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminProdValueAdd) }
				}
			</form>
		}
	}
}

templ productVariants(v ProductView) {
	@components.Card(components.CardProps{Class: "goen-admin__section", Attrs: templ.Attributes{"id": "sec-variants"}}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminProdVariants) }</h2>
		if len(v.Variants) == 0 {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminProdNoVariants) }</p>
			</div>
		} else {
			<ul class="goen-admin__variants" role="list">
				for _, sv := range v.Variants {
					<li class="goen-admin__variant">
						<span class="goen-admin__sku">
							{ sv.SKU }
							if sv.OptionText() != "" {
								<span class="goen-admin__meta">{ sv.OptionText() }</span>
							}
						</span>
						<span class="goen-admin__meta">
							{ sv.Price() }
							if sv.Compare() != "" {
								{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminProdWasPrice), sv.Compare()) }
							}
						</span>
						<span class="goen-admin__meta">{ sv.StockText(ctx) }</span>
					</li>
				}
			</ul>
		}
		<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/products/" + v.Slug + "/variants#sec-variants") }>
			<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminProdVariantAdd) }</h3>
			<div class="goen-admin__fields">
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "v-sku"}) {
						SKU
					}
					<input
						class="goen-input"
						id="v-sku"
						name="sku"
						required
						maxlength="60"
						autocomplete="off"
						value={ v.VariantDraft.SKU }
						if v.HasErr("sku") {
							aria-invalid="true"
							aria-describedby="v-sku-error"
						}
					/>
					if v.HasErr("sku") {
						<p class="ui-error-text" id="v-sku-error">{ v.Err("sku") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "v-price"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdPrice) }
					}
					<input
						class="goen-input"
						id="v-price"
						name="price"
						type={ dollarInputType(v.VariantDraft.Price) }
						min="1"
						step="1"
						required
						inputmode="numeric"
						value={ v.VariantDraft.Price }
						if v.HasErr("price") {
							aria-invalid="true"
							aria-describedby="v-price-error"
						}
					/>
					if v.HasErr("price") {
						<p class="ui-error-text" id="v-price-error">{ v.Err("price") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "v-compare"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdCompare) }
					}
					<input
						class="goen-input"
						id="v-compare"
						name="compare"
						type={ dollarInputType(v.VariantDraft.Compare) }
						min="0"
						step="1"
						inputmode="numeric"
						value={ v.VariantDraft.Compare }
						if v.HasErr("compare") {
							aria-invalid="true"
							aria-describedby="v-compare-error"
						}
					/>
					if v.HasErr("compare") {
						<p class="ui-error-text" id="v-compare-error">{ v.Err("compare") }</p>
					}
				</div>
				if v.HasOptions() {
					for _, o := range v.Options {
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "v-opt-" + o.ID}) {
								{ o.Name }
							}
							<select
								class="goen-input"
								id={ "v-opt-" + o.ID }
								name="option_value"
								required
								if v.HasErr("options") {
									aria-invalid="true"
									aria-describedby={ "v-opt-" + o.ID + "-error" }
								}
							>
								for _, val := range o.Values {
									<option value={ val.ID } selected?={ v.VariantDraft.Chose(val.ID) }>{ val.Value }</option>
								}
							</select>
							if v.HasErr("options") {
								<p class="ui-error-text" id={ "v-opt-" + o.ID + "-error" }>{ v.Err("options") }</p>
							}
						</div>
					}
				}
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "v-safety"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdSafety) }
					}
					<input
						class="goen-input"
						id="v-safety"
						name="safety"
						type="text"
						inputmode="numeric"
						value={ v.VariantDraft.Safety }
						if v.HasErr("safety") {
							aria-invalid="true"
							aria-describedby="v-safety-error"
						}
					/>
					if v.HasErr("safety") {
						<p class="ui-error-text" id="v-safety-error">{ v.Err("safety") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "v-longest"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdLongest) }
					}
					<input
						class="goen-input"
						id="v-longest"
						name="parcel_longest"
						type="text"
						inputmode="numeric"
						value={ v.VariantDraft.ParcelLongest }
						if v.HasErr("parcel_longest") {
							aria-invalid="true"
							aria-describedby="v-longest-error"
						}
					/>
					if v.HasErr("parcel_longest") {
						<p class="ui-error-text" id="v-longest-error">{ v.Err("parcel_longest") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "v-sum"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdParcelSum) }
					}
					<input
						class="goen-input"
						id="v-sum"
						name="parcel_sum"
						type="text"
						inputmode="numeric"
						value={ v.VariantDraft.ParcelSum }
						if v.HasErr("parcel_sum") {
							aria-invalid="true"
							aria-describedby="v-sum-error"
						}
					/>
					if v.HasErr("parcel_sum") {
						<p class="ui-error-text" id="v-sum-error">{ v.Err("parcel_sum") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "v-weight"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdWeight) }
					}
					<input
						class="goen-input"
						id="v-weight"
						name="parcel_weight"
						type="text"
						inputmode="numeric"
						value={ v.VariantDraft.ParcelWeight }
						if v.HasErr("parcel_weight") {
							aria-invalid="true"
							aria-describedby="v-weight-error"
						}
					/>
					if v.HasErr("parcel_weight") {
						<p class="ui-error-text" id="v-weight-error">{ v.Err("parcel_weight") }</p>
					}
				</div>
			</div>
			if v.HasOptions() && v.HasErr("options") {
				<p class="ui-error-text" role="alert">{ v.Err("options") }</p>
			}
			@components.Button(components.ButtonProps{
				ButtonStyle: components.ButtonStyleOutline,
				Class:       "goen-admin__submit",
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminProdVariantAdd) }
			}
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminProdVariantStockHint) }
			</p>
		</form>
	}
}

// productSpecs is the 規格表 the product page prints, a table because it is one there.
templ productSpecs(v ProductView) {
	@components.Card(components.CardProps{Class: "goen-admin__section", Attrs: templ.Attributes{"id": "sec-specs"}}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminProdSpecs) }</h2>
		<p class="goen-admin__hint">
			{ i18n.T(ctx, i18n.KeyAdminProdSpecsLead) }
		</p>
		if v.HasSpecs() {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminProdSpecLabel) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminProdSpecValue) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColEnglish) }</th>
							<th class="goen-admin__cellactions" scope="col">
								<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminColActions) }</span>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, sp := range v.Specs {
							<tr>
								<td class="goen-admin__cellkey">{ sp.Label }</td>
								<td>{ sp.Value }</td>
								<td>
									if sp.Translated() {
										{ sp.LabelEn }
										if sp.ValueEn != "" {
											<span class="goen-admin__meta">{ sp.ValueEn }</span>
										}
									} else {
										@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
											{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
										}
									}
								</td>
								<td class="goen-admin__cellactions">
									<form method="post" action={ templ.SafeURL(v.SpecRemoveAction()) }>
										<input type="hidden" name="spec" value={ sp.ID }/>
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStyleGhost,
											Size:        components.SizeSmall,
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminRemove) }
										}
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminProdNoSpecs) }</p>
			</div>
		}
		<form class="goen-admin__form" method="post" action={ templ.SafeURL(v.SpecAction() + "#sec-specs") }>
			<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminProdSpecAdd) }</h3>
			<div class="goen-admin__fields">
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "spec-label"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdSpecLabel) }
					}
					<input
						class="goen-input"
						id="spec-label"
						value={ v.SpecDraft.Label }
						name="label"
						required
						maxlength="40"
						autocomplete="off"
						placeholder={ specLabelExample }
						if v.HasErr("spec_label") {
							aria-invalid="true"
							aria-describedby="spec-label-error"
						}
					/>
					if v.HasErr("spec_label") {
						<p class="ui-error-text" id="spec-label-error">{ v.Err("spec_label") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "spec-value"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdSpecValue) }
					}
					<input
						class="goen-input"
						id="spec-value"
						value={ v.SpecDraft.Value }
						name="value"
						required
						maxlength="200"
						autocomplete="off"
						placeholder={ specValueExample }
						if v.HasErr("spec_value") {
							aria-invalid="true"
							aria-describedby="spec-value-error"
						}
					/>
					if v.HasErr("spec_value") {
						<p class="ui-error-text" id="spec-value-error">{ v.Err("spec_value") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "spec-label-en"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdSpecLabelEn) }
					}
					<input
						class="goen-input"
						id="spec-label-en"
						value={ v.SpecDraft.LabelEn }
						name="label_en"
						maxlength="40"
						autocomplete="off"
						placeholder="Capacity"
						if v.HasErr("spec_label_en") {
							aria-invalid="true"
							aria-describedby="spec-label-en-error"
						}
					/>
					if v.HasErr("spec_label_en") {
						<p class="ui-error-text" id="spec-label-en-error">{ v.Err("spec_label_en") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "spec-value-en"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdSpecValueEn) }
					}
					<input
						class="goen-input"
						id="spec-value-en"
						value={ v.SpecDraft.ValueEn }
						name="value_en"
						maxlength="200"
						autocomplete="off"
						placeholder="350 ml"
						if v.HasErr("spec_value_en") {
							aria-invalid="true"
							aria-describedby="spec-value-en-error"
						}
					/>
					if v.HasErr("spec_value_en") {
						<p class="ui-error-text" id="spec-value-en-error">{ v.Err("spec_value_en") }</p>
					}
				</div>
			</div>
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminProdSpecHint) }
			</p>
			@components.Button(components.ButtonProps{
				ButtonStyle: components.ButtonStyleOutline,
				Class:       "goen-admin__submit",
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminProdSpecAdd) }
			}
		</form>
	}
}

templ productPublishing(v ProductView) {
	if v.NeedsVariant() {
		<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminProdNeedsVariant) }</p>
	} else {
		<form method="post" action={ templ.SafeURL("/admin/products/" + v.Slug + "/status") } aria-label={ i18n.T(ctx, i18n.KeyAdminProdPublishing) }>
			<div class="goen-admin__decidebtns">
				if v.CanPublish() {
					@components.Button(components.ButtonProps{
						ButtonStyle: components.ButtonStyleOutline,
						Attrs:       templ.Attributes{"name": "status", "value": string(pages.ProductActive)},
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyAdminProdPublish) }
					}
				}
				if v.Status == pages.ProductActive {
					@components.Button(components.ButtonProps{
						ButtonStyle: components.ButtonStyleOutline,
						Attrs:       templ.Attributes{"name": "status", "value": string(pages.ProductDraft)},
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyAdminProdUnpublish) }
					}
				}
				if v.Status != pages.ProductArchived {
					@components.Button(components.ButtonProps{
						ButtonStyle: components.ButtonStyleGhost,
						Attrs:       templ.Attributes{"name": "status", "value": string(pages.ProductArchived)},
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyAdminProdArchive) }
					}
				}
			</div>
		</form>
	}
}
