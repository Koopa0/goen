package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/destination"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// A fee is never edited in place: the form publishes a new VERSION, and the card says
// which version is live and since when, so a reader can see what an order placed
// yesterday was quoted. The one filled button is the method create.
templ Shipping(p layouts.Page, v ShippingView) {
	@layouts.Admin(p, "shipping") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageShipping) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminShipLead) }
				</p>
			</div>
		</div>
		@Announce(v.Notice)
		@RefusalSummary(summarizeRefusal(i18n.KeyAdminShipAddMethod, v.Errors, refusalField{"code", "m-code"}, refusalField{"destination", "m-destination"}, refusalField{"max_parcel_longest", "m-max-longest"}, refusalField{"max_parcel_sum", "m-max-sum"}, refusalField{"max_parcel_weight", "m-max-weight"}, refusalField{"name", "m-name"}, refusalField{"fee", "m-fee"}, refusalField{"free_over", "m-free"}))
		@RefusalSummary(summarizeRefusal(i18n.KeyAdminShipAddZone, v.Errors, refusalField{"zone_code", "z-code"}, refusalField{"zone_name", "z-name"}, refusalField{"prefixes", "z-prefixes"}))
		for _, m := range v.Methods {
			{{ d := v.VersionValues(&m) }}
			@components.Card(components.CardProps{Class: "goen-admin__section"}) {
				<h2 class="goen-admin__heading">
					{ m.DisplayName(ctx) }
					if other := m.OtherName(ctx); other != "" {
						<span class="goen-admin__othername" lang={ otherTag(ctx) }>{ other }</span>
					}
					if m.NameEn == "" {
						@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
							{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
						}
					}
					if m.PickupUnavailable {
						@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
							{ i18n.T(ctx, i18n.KeyAdminShipPickupNotOffered) }
						}
					}
					<span class="goen-admin__meta">{ m.DestinationText(ctx) }</span>
				</h2>
				if m.PickupUnavailable {
					<p class="goen-admin__hint"><strong>{ i18n.T(ctx, i18n.KeyAdminShipPickupOff) }</strong></p>
				}
				<p class="goen-admin__hint">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminShipCurrent), m.Fee(), m.FreeOver(ctx)) }
					{ i18n.Count(ctx, i18n.KeyAdminShipSince, m.VersionCount, m.EffectiveAt, m.VersionCount) }
				</p>
				<form class="goen-admin__form" method="post" action="/admin/shipping/version">
					<input type="hidden" name="method" value={ m.MethodID }/>
					<div class="goen-admin__fields">
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "name-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminColName) }
							}
							<input
								class="goen-input"
								id={ "name-" + m.MethodID }
								name="name"
								value={ d.Name }
								required
								maxlength="60"
								if v.VersionRefusal(m.MethodID, "name") != "" {
									aria-invalid="true"
									aria-describedby={ "name-" + m.MethodID + "-error" }
								}
							/>
							if message := v.VersionRefusal(m.MethodID, "name"); message != "" {
								<p class="ui-error-text" id={ "name-" + m.MethodID + "-error" }>{ message }</p>
							}
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "carrier-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipCarrierOptional) }
							}
							<input
								class="goen-input"
								id={ "carrier-" + m.MethodID }
								name="carrier"
								value={ d.Carrier }
								maxlength="60"
							/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "name-en-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminColNameEn) }
							}
							<input
								class="goen-input"
								id={ "name-en-" + m.MethodID }
								name="name_en"
								value={ d.NameEn }
								maxlength="60"
							/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "carrier-en-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipCarrierEn) }
							}
							<input
								class="goen-input"
								id={ "carrier-en-" + m.MethodID }
								name="carrier_en"
								value={ d.CarrierEn }
								maxlength="60"
							/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "fee-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipFee) }
							}
							<input
								class="goen-input"
								id={ "fee-" + m.MethodID }
								name="fee"
								type={ dollarInputType(d.Fee) }
								min="0"
								max={ v.FeeLimit() }
								step="1"
								value={ d.Fee }
								required
								inputmode="numeric"
								if v.VersionRefusal(m.MethodID, "fee") != "" {
									aria-invalid="true"
									aria-describedby={ "fee-" + m.MethodID + "-error" }
								}
							/>
							if message := v.VersionRefusal(m.MethodID, "fee"); message != "" {
								<p class="ui-error-text" id={ "fee-" + m.MethodID + "-error" }>{ message }</p>
							}
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "free-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipFreeOver) }
							}
							<input
								class="goen-input"
								id={ "free-" + m.MethodID }
								name="free_over"
								type={ dollarInputType(d.FreeOver) }
								min="0"
								max={ v.FreeOverLimit() }
								step="1"
								value={ d.FreeOver }
								inputmode="numeric"
								if v.VersionRefusal(m.MethodID, "free_over") != "" {
									aria-invalid="true"
									aria-describedby={ "free-" + m.MethodID + "-error" }
								}
							/>
							if message := v.VersionRefusal(m.MethodID, "free_over"); message != "" {
								<p class="ui-error-text" id={ "free-" + m.MethodID + "-error" }>{ message }</p>
							}
						</div>
					</div>
					if message := v.VersionRefusal(m.MethodID, "form"); message != "" {
						<p class="ui-error-text" id={ "version-" + m.MethodID + "-error" } role="alert">{ message }</p>
					}
					@components.Button(components.ButtonProps{
						ButtonStyle: components.ButtonStyleOutline,
						Class:       "goen-admin__submit",
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyAdminShipPublish) }
					}
				</form>
				<form method="post" action={ templ.SafeURL("/admin/shipping/method/" + m.MethodID + "/active") }>
					if m.Active {
						<input type="hidden" name="active" value="0"/>
						@components.Button(components.ButtonProps{
							ButtonStyle: components.ButtonStyleGhost,
							Size:        components.SizeSmall,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminShipDisable) }
						}
					} else {
						<input type="hidden" name="active" value="1"/>
						@components.Button(components.ButtonProps{
							ButtonStyle: components.ButtonStyleOutline,
							Size:        components.SizeSmall,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminShipReenable) }
						}
					}
				</form>
				if m.Zoned() {
					<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminShipSurcharges) }</h3>
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminShipSurchargeLead) }
					</p>
					<div class="goen-admin__fields">
						for _, z := range v.Zones {
							<form class="goen-admin__field" method="post" action="/admin/shipping/surcharge">
								<input type="hidden" name="version" value={ m.VersionID }/>
								<input type="hidden" name="zone" value={ z.ID }/>
								@components.Label(components.LabelProps{For: "sur-" + m.VersionID + "-" + z.ID}) {
									{ z.DisplayName(ctx) }
									<span class="goen-admin__meta">{ i18n.Count(ctx, i18n.KeyAdminShipPrefixCount, z.PrefixCount, z.PrefixCount) }</span>
								}
								<div class="goen-admin__inline">
									<input
										class="goen-input goen-admin__surcharge"
										id={ "sur-" + m.VersionID + "-" + z.ID }
										name="amount"
										type={ dollarInputType(v.SurchargeValue(&m, z.ID)) }
										min="0"
										max={ v.FeeLimit() }
										step="1"
										value={ v.SurchargeValue(&m, z.ID) }
										inputmode="numeric"
										if v.SurchargeRefusal(m.MethodID, z.ID) != "" {
											aria-invalid="true"
											aria-describedby={ "sur-" + m.VersionID + "-" + z.ID + "-error" }
										}
									/>
									if message := v.SurchargeRefusal(m.MethodID, z.ID); message != "" {
										<p class="ui-error-text" id={ "sur-" + m.VersionID + "-" + z.ID + "-error" }>{ message }</p>
									}
									@components.Button(components.ButtonProps{
										ButtonStyle: components.ButtonStyleOutline,
										Size:        components.SizeSmall,
									}, "submit") {
										{ i18n.T(ctx, i18n.KeyAdminShipSet) }
									}
								</div>
							</form>
						}
					</div>
				} else {
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminShipNoZone) }
					</p>
				}
			}
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminShipAddMethod) }</h2>
			<form class="goen-admin__form" id="new-method" method="post" action="/admin/shipping/method#new-method">
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-code"}) {
							{ i18n.T(ctx, i18n.KeyAdminColCode) }
						}
						<input
							class="goen-input"
							id="m-code"
							name="code"
							required
							maxlength="30"
							pattern="[a-z0-9_]+"
							value={ v.MethodDraft.Code }
							if v.HasErr("code") {
								aria-invalid="true"
								aria-describedby="m-code-error"
							}
						/>
						if v.HasErr("code") {
							<p class="ui-error-text" id="m-code-error">{ v.Err("code") }</p>
						}
						<div class="goen-admin__hints">
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminShipCodeHint) }</p>
							<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminExample), "express_delivery") }</p>
						</div>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-destination"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipDestination) }
						}
						<select
							class="goen-input"
							id="m-destination"
							name="destination"
							required
							if v.HasErr("destination") {
								aria-invalid="true"
								aria-describedby="m-destination-error"
							}
						>
							<option value={ string(destination.Address) } selected?={ !v.PickupSelected() }>{ i18n.T(ctx, i18n.KeyAdminShipToAddress) }</option>
							<option value={ string(destination.PickupPoint) } selected?={ v.PickupSelected() }>{ i18n.T(ctx, i18n.KeyAdminDestPickup) }</option>
						</select>
						if v.HasErr("destination") {
							<p class="ui-error-text" id="m-destination-error">{ v.Err("destination") }</p>
						}
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminShipDestinationHint) }
						</p>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-max-longest"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipMaxLongest) }
						}
						// Blank is no stated limit; store pickup is 450mm / 1050mm / 10000g (Hi-Life 5000g).
						<input
							class="goen-input"
							id="m-max-longest"
							name="max_parcel_longest"
							type="text"
							inputmode="numeric"
							value={ v.MethodDraft.MaxLongest }
							if v.HasErr("max_parcel_longest") {
								aria-invalid="true"
								aria-describedby="m-max-longest-error"
							}
						/>
						if v.HasErr("max_parcel_longest") {
							<p class="ui-error-text" id="m-max-longest-error">{ v.Err("max_parcel_longest") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-max-sum"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipMaxSum) }
						}
						<input
							class="goen-input"
							id="m-max-sum"
							name="max_parcel_sum"
							type="text"
							inputmode="numeric"
							value={ v.MethodDraft.MaxSum }
							if v.HasErr("max_parcel_sum") {
								aria-invalid="true"
								aria-describedby="m-max-sum-error"
							}
						/>
						if v.HasErr("max_parcel_sum") {
							<p class="ui-error-text" id="m-max-sum-error">{ v.Err("max_parcel_sum") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-max-weight"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipMaxWeight) }
						}
						<input
							class="goen-input"
							id="m-max-weight"
							name="max_parcel_weight"
							type="text"
							inputmode="numeric"
							value={ v.MethodDraft.MaxWeight }
							if v.HasErr("max_parcel_weight") {
								aria-invalid="true"
								aria-describedby="m-max-weight-error"
							}
						/>
						if v.HasErr("max_parcel_weight") {
							<p class="ui-error-text" id="m-max-weight-error">{ v.Err("max_parcel_weight") }</p>
						}
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminShipLimitsHint) }
						</p>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-name"}) {
							{ i18n.T(ctx, i18n.KeyAdminColName) }
						}
						<input
							class="goen-input"
							id="m-name"
							name="name"
							required
							maxlength="60"
							value={ v.MethodDraft.Name }
							if v.HasErr("name") {
								aria-invalid="true"
								aria-describedby="m-name-error"
							}
						/>
						if v.HasErr("name") {
							<p class="ui-error-text" id="m-name-error">{ v.Err("name") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-name-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminColNameEn) }
						}
						<input class="goen-input" id="m-name-en" name="name_en" maxlength="60" value={ v.MethodDraft.NameEn }/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-carrier"}) {
							{ i18n.T(ctx, i18n.KeyAdminColCarrier) }
						}
						<input class="goen-input" id="m-carrier" name="carrier" maxlength="60" value={ v.MethodDraft.Carrier }/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-carrier-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipCarrierEn) }
						}
						<input class="goen-input" id="m-carrier-en" name="carrier_en" maxlength="60" value={ v.MethodDraft.CarrierEn }/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-fee"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipFee) }
						}
						<input
							class="goen-input"
							id="m-fee"
							name="fee"
							type={ dollarInputType(v.MethodDraft.Fee) }
							min="0"
							step="1"
							required
							inputmode="numeric"
							value={ v.MethodDraft.Fee }
							if v.HasErr("fee") {
								aria-invalid="true"
								aria-describedby="m-fee-error"
							}
						/>
						if v.HasErr("fee") {
							<p class="ui-error-text" id="m-fee-error">{ v.Err("fee") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-free"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipFreeOver) }
						}
						<input
							class="goen-input"
							id="m-free"
							name="free_over"
							type={ dollarInputType(v.MethodDraft.FreeOver) }
							min="0"
							step="1"
							inputmode="numeric"
							value={ v.MethodDraft.FreeOver }
							if v.HasErr("free_over") {
								aria-invalid="true"
								aria-describedby="m-free-error"
							}
						/>
						if v.HasErr("free_over") {
							<p class="ui-error-text" id="m-free-error">{ v.Err("free_over") }</p>
						}
					</div>
				</div>
				<p class="goen-admin__hint">
					{ i18n.T(ctx, i18n.KeyAdminShipFirstVersion) }
				</p>
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStylePrimary,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminShipAddMethod) }
				}
			</form>
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminShipZones) }</h2>
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table goen-admin__zones">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminShipColZone) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminShipPrefixes) }</th>
							<th class="goen-admin__cellactions" scope="col">
								<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminColActions) }</span>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, z := range v.Zones {
							<tr>
								<td class="goen-admin__cellkey">
									{ z.DisplayName(ctx) }
									if other := z.OtherName(ctx); other != "" {
										<span class="goen-admin__othername" lang={ otherTag(ctx) }>{ other }</span>
									}
									<span class="goen-admin__meta">{ z.Code }</span>
									if z.NameEn == "" {
										@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
											{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
										}
									}
								</td>
								<td class="goen-admin__prefixes">
									<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/shipping/zone/" + z.ID + "/prefixes") }>
										<label class="ui-label" for={ "pre-" + z.ID }>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminShipZonePrefixes), z.DisplayName(ctx)) }</label>
										<textarea
											class="ui-textarea goen-input--area"
											id={ "pre-" + z.ID }
											name="prefixes"
											rows={ zonePrefixRows(v.ZonePrefixesValue(z)) }
											if v.PrefixDraft.ZoneID == z.ID && v.HasErr("zone_prefixes") {
												aria-invalid="true"
												aria-describedby={ "pre-" + z.ID + "-error" }
											}
										>{ zonePrefixTextareaText(v.ZonePrefixesValue(z)) }</textarea>
										@zonePrefixDistricts(v.ZonePrefixesValue(z))
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStyleOutline,
											Size:        components.SizeSmall,
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminShipSet) }
										}
										if v.PrefixDraft.ZoneID == z.ID && v.HasErr("zone_prefixes") {
											<p class="ui-error-text" id={ "pre-" + z.ID + "-error" }>{ v.Err("zone_prefixes") }</p>
										}
									</form>
								</td>
								<td class="goen-admin__cellactions">
									<form method="post" action={ templ.SafeURL("/admin/shipping/zone/" + z.ID + "/delete") }>
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStyleGhost,
											Size:        components.SizeSmall,
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminDelete) }
										}
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<form class="goen-admin__form" id="new-zone" method="post" action="/admin/shipping/zone#new-zone">
				<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminShipAddZone) }</h3>
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "z-code"}) {
							{ i18n.T(ctx, i18n.KeyAdminColCode) }
						}
						<input
							class="goen-input"
							id="z-code"
							name="code"
							required
							maxlength="30"
							pattern="[a-z0-9_]+"
							value={ v.ZoneDraft.Code }
							if v.HasErr("zone_code") {
								aria-invalid="true"
								aria-describedby="z-code-error"
							}
						/>
						if v.HasErr("zone_code") {
							<p class="ui-error-text" id="z-code-error">{ v.Err("zone_code") }</p>
						}
						<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminExample), "mountain") }</p>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "z-name"}) {
							{ i18n.T(ctx, i18n.KeyAdminColName) }
						}
						<input
							class="goen-input"
							id="z-name"
							name="name"
							required
							maxlength="60"
							value={ v.ZoneDraft.Name }
							if v.HasErr("zone_name") {
								aria-invalid="true"
								aria-describedby="z-name-error"
							}
						/>
						if v.HasErr("zone_name") {
							<p class="ui-error-text" id="z-name-error">{ v.Err("zone_name") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "z-name-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminColNameEn) }
						}
						<input class="goen-input" id="z-name-en" name="name_en" maxlength="60" value={ v.ZoneDraft.NameEn }/>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminShipZoneNameEnHint) }</p>
					</div>
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "z-prefixes"}) {
						{ i18n.T(ctx, i18n.KeyAdminShipPrefixes) }
					}
					<textarea
						class="ui-textarea goen-input--area"
						id="z-prefixes"
						name="prefixes"
						required
						rows={ zonePrefixRows(v.ZoneDraft.Prefixes) }
						if v.HasErr("prefixes") {
							aria-invalid="true"
							aria-describedby="z-prefixes-error"
						}
					>{ zonePrefixTextareaText(v.ZoneDraft.Prefixes) }</textarea>
					@zonePrefixDistricts(v.ZoneDraft.Prefixes)
					if v.HasErr("prefixes") {
						<p class="ui-error-text" id="z-prefixes-error">{ v.Err("prefixes") }</p>
					}
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminShipPrefixesHint) }
					</p>
					<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminExample), "313 546 556") }</p>
				</div>
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminShipAddZone) }
				}
			</form>
		}
	}
}

templ zonePrefixDistricts(raw string) {
	if entries := zonePrefixEntries(raw); len(entries) > 0 {
		<ul class="goen-admin__hint goen-admin__districts">
			for _, entry := range entries {
				<li>
					{ entry.Prefix }
					for _, district := range entry.Districts {
						<span>{ " " + district }</span>
					}
				</li>
			}
		</ul>
	}
}
