package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/pages"
)

templ Returns(p layouts.Page, v ReturnsView) {
	@layouts.Admin(p, "returns") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageReturns) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminRetLead) }
				</p>
			</div>
		</div>
		@Announce(v.Notice)
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminRetEmpty) }</p>
			</div>
		} else if !v.Empty() {
			<ul class="goen-admin__returns" role="list">
				for _, r := range v.Rows {
					<li class="goen-admin__return">
						<div class="goen-admin__returninfo">
							<p class="goen-admin__returnorder"><a href={ templ.SafeURL(r.OrderAction()) }>{ r.OrderNumber }</a></p>
							<div class="goen-admin__cellbadges">
								@components.Badge(components.BadgeProps{Intent: r.StatusIntent()}) {
									{ r.StatusLabel(ctx) }
								}
							</div>
							<span class="goen-admin__meta">{ r.CreatedAt }</span>
							<span class="goen-admin__meta">
								{ i18n.Count(ctx, i18n.KeyAdminRetUnitsAmount, int64(r.Units), r.UnitsText(), r.Amount()) }
							</span>
							if ch := r.PayoutChannel(ctx); ch != "" {
								<span class="goen-admin__meta">{ ch }</span>
							}
							// Consumer Protection Act §19 I: seven days from receipt, unwaivable under §19 V.
							if r.Rescission() {
								<span class="goen-admin__meta">
									<strong>{ r.WindowText(ctx) }</strong>
									{ i18n.T(ctx, i18n.KeyAdminRetMustAccept) }
								</span>
							} else if r.Goodwill() || r.Mixed() {
								<span class="goen-admin__meta">
									<strong>{ r.WindowText(ctx) }</strong>
									{ i18n.T(ctx, i18n.KeyAdminRetGoodwillHint) }
								</span>
							} else if r.Late() {
								<span class="goen-admin__meta">
									{ r.WindowText(ctx) }
									{ i18n.T(ctx, i18n.KeyAdminRetLateHint) }
								</span>
							} else {
								<span class="goen-admin__meta">{ r.WindowText(ctx) }</span>
							}
							<span class="goen-admin__meta">{ r.Reason }</span>
							if len(r.Lines) > 0 {
								<ul class="goen-admin__returnlines" role="list">
									for _, l := range r.Lines {
										<li>
											<span class="goen-admin__meta">{ l.Line() }</span>
											<span class="goen-admin__meta">{ l.SKU } · { l.UnitPrice() }</span>
											if l.Window != "" {
												<span class="goen-admin__meta">{ ReturnLineWindowText(ctx, l.Window) }</span>
											}
											if l.Inspected {
												<span class="goen-admin__meta">
													{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminRetReceivedRestocked), l.ReceivedText(), l.RestockedText()) }
													// Nothing shipped on a refund before shipment, so nothing can be short.
													if l.Shortfall() && !r.BeforeShipment {
														<strong>{ i18n.T(ctx, i18n.KeyAdminRetShortfall) }</strong>
													}
													if l.Scrapped() {
														<strong>{ i18n.T(ctx, i18n.KeyAdminRetScrapped) }</strong>
													}
												</span>
												if l.Note != "" {
													<span class="goen-admin__meta">{ l.Note }</span>
												}
											}
										</li>
									}
								</ul>
							}
						</div>
						if r.BeforeShipment {
							// Its payout, cancellation and invoice correction resume
							// together on the order page, never one at a time here.
							<p class="goen-admin__hint"><a href={ templ.SafeURL(r.OrderAction()) }>{ i18n.T(ctx, i18n.KeyAdminRefundTitle) }</a></p>
						} else if !r.Decided {
							if r.Goodwill() || r.Mixed() {
								<form class="goen-admin__decide" method="post" action={ templ.SafeURL(r.AssessAction()) }>
									<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRetAssessHint) }</p>
									if stamp := r.AssessmentStamp(ctx); stamp != "" {
										<p class="goen-admin__meta">{ stamp }</p>
									}
									for _, l := range r.Lines {
										<fieldset class="goen-admin__inspectline">
											<legend class="goen-admin__meta">{ l.Line() }</legend>
											@eligibilityFactRadios(r.ID, l, "unused", i18n.KeyAdminRetFactUnused, v)
											@eligibilityFactRadios(r.ID, l, "packaging", i18n.KeyAdminRetFactPackaging, v)
											@eligibilityFactRadios(r.ID, l, "accessories", i18n.KeyAdminRetFactAccessories, v)
										</fieldset>
									}
									<div class="ui-field">
										<label class="ui-label" for={ "basis-" + r.ID }>{ i18n.T(ctx, i18n.KeyAdminRetAssessBasis) }</label>
										<input
											class="ui-input"
											id={ "basis-" + r.ID }
											name="basis"
											maxlength="500"
											autocomplete="off"
											value={ r.AssessmentBasis }
											aria-describedby={ "basis-" + r.ID + "-error" }
											if v.FieldInvalid(r.ID, "basis") {
												aria-invalid="true"
											}
										/>
										<p class="ui-error-text" id={ "basis-" + r.ID + "-error" }>{ v.FieldRefusal(r.ID, "basis") }</p>
									</div>
									<div class="goen-admin__decidebtns">
										@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminRetAssessButton) }
										}
									</div>
								</form>
							}
							<form class="goen-admin__decide" method="post" action={ templ.SafeURL(r.Action()) }>
								<input type="hidden" name="assessment_version" value={ r.AssessmentVersionText() }/>
								<p class="ui-error-text" id={ "decision-" + r.ID + "-error" } role="alert">{ v.FieldRefusal(r.ID, "decision") }</p>
								<div class="ui-field">
									<label class="ui-label" for={ "res-" + r.ID }>{ i18n.T(ctx, i18n.KeyAdminRetResolution) }</label>
									<input
										class="ui-input"
										id={ "res-" + r.ID }
										name="resolution"
										maxlength="300"
										autocomplete="off"
										value={ r.Resolution }
										aria-describedby={ "res-" + r.ID + "-error" }
										if v.FieldInvalid(r.ID, "resolution") {
											aria-invalid="true"
										}
									/>
									<p class="ui-error-text" id={ "res-" + r.ID + "-error" }>{ v.FieldRefusal(r.ID, "resolution") }</p>
								</div>
								<div class="goen-admin__decidebtns">
									if !r.Late() {
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStylePrimary,
											Attrs:       templ.Attributes{"name": "decision", "value": "approved"},
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminRetApprove) }
										}
									}
									if r.Goodwill() || r.Mixed() || r.Late() {
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStyleOutline,
											Attrs:       templ.Attributes{"name": "decision", "value": "exception"},
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminRetException) }
										}
									}
									if !r.Rescission() {
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStyleOutline,
											Attrs:       templ.Attributes{"name": "decision", "value": "rejected"},
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminRetReject) }
										}
									}
								</div>
							</form>
						} else if r.CanRetryPayout() {
							<form class="goen-admin__decide" method="post" action={ templ.SafeURL(r.Action()) }>
								<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRetPayoutOutstanding) }</p>
								<input type="hidden" name="decision" value="approved"/>
								<div class="goen-admin__decidebtns">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
										{ i18n.T(ctx, i18n.KeyAdminRetRetryPayout) }
									}
								</div>
							</form>
						} else if r.PayoutStranded() {
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRetPayoutStranded) }</p>
						}
						if r.AwaitingGoods() {
							<form class="goen-admin__decide" method="post" action={ templ.SafeURL(r.InspectAction()) }>
								<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRetInspectHint) }</p>
								for _, l := range r.Lines {
									<fieldset class="goen-admin__inspectline">
										<legend class="goen-admin__meta">{ l.Line() }</legend>
										<div class="ui-field">
											<label class="ui-label" for={ "recv-" + r.ID + "-" + l.OrderLineID }>{ i18n.T(ctx, i18n.KeyAdminRetReceivedQty) }</label>
											<input
												class="ui-input"
												id={ "recv-" + r.ID + "-" + l.OrderLineID }
												type="number"
												name={ "received_" + l.OrderLineID }
												value={ l.ReceivedField() }
												min="0"
												max={ l.MaxQuantityText() }
												required
												if v.FieldInvalid(r.ID, "inspect") {
													aria-invalid="true"
													aria-describedby={ "inspect-error-" + r.ID }
												}
											/>
										</div>
										if l.Restockable {
											<div class="ui-field">
												<label class="ui-label" for={ "stock-" + r.ID + "-" + l.OrderLineID }>{ i18n.T(ctx, i18n.KeyAdminRetRestockedQty) }</label>
												<input
													class="ui-input"
													id={ "stock-" + r.ID + "-" + l.OrderLineID }
													type="number"
													name={ "restocked_" + l.OrderLineID }
													value={ l.RestockedField() }
													min="0"
													max={ l.MaxQuantityText() }
													if v.FieldInvalid(r.ID, "inspect") {
														aria-invalid="true"
														aria-describedby={ "inspect-error-" + r.ID }
													}
												/>
											</div>
										} else {
											<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRetNoVariant) }</p>
										}
										<div class="ui-field">
											<label class="ui-label" for={ "note-" + r.ID + "-" + l.OrderLineID }>{ i18n.T(ctx, i18n.KeyAdminRetNote) }</label>
											<input
												class="ui-input"
												id={ "note-" + r.ID + "-" + l.OrderLineID }
												name={ "note_" + l.OrderLineID }
												value={ l.DraftNote }
												maxlength="500"
												autocomplete="off"
												placeholder={ i18n.T(ctx, i18n.KeyAdminRetNotePlaceholder) }
											/>
										</div>
									</fieldset>
								}
								if v.FieldInvalid(r.ID, "inspect") {
									<p class="ui-error-text" id={ "inspect-error-" + r.ID } role="alert">{ v.FieldRefusal(r.ID, "inspect") }</p>
								}
								<div class="goen-admin__decidebtns">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
										{ i18n.T(ctx, i18n.KeyAdminRetInspectButton) }
									}
								</div>
							</form>
						}
						if r.CanComplete() {
							<form class="goen-admin__decide" method="post" action={ templ.SafeURL(r.CompleteAction()) }>
								<p class="goen-admin__hint">
									{ i18n.Count(ctx, i18n.KeyAdminRetRestockedUnits, int64(r.RestockedUnits()), r.RestockedUnitsText()) }
								</p>
								<div class="ui-field">
									<label class="ui-label" for={ "done-" + r.ID }>{ i18n.T(ctx, i18n.KeyAdminRetCloseNote) }</label>
									<input class="ui-input" id={ "done-" + r.ID } name="resolution" maxlength="300" autocomplete="off"/>
								</div>
								<div class="goen-admin__decidebtns">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
										{ i18n.T(ctx, i18n.KeyAdminRetCloseButton) }
									}
								</div>
							</form>
						}
					</li>
				}
			</ul>
		}
		@pages.ListPager(v.Bound)
	}
}

templ eligibilityFactRadios(returnID string, l ReturnLine, name string, label i18n.Key, v ReturnsView) {
	<fieldset class="ui-field">
		<legend class="ui-label">{ i18n.T(ctx, label) }</legend>
		<p class="ui-error-text" id={ name + "-" + l.OrderLineID + "-error" } role="alert">{ v.FieldRefusal(returnID, name+"-"+l.OrderLineID) }</p>
		<label>
			<input
				type="radio"
				name={ name + "_" + l.OrderLineID }
				value="unknown"
				aria-describedby={ name + "-" + l.OrderLineID + "-error" }
				if l.FactChecked(name, "unknown") {
					checked
				}
				if v.FieldInvalid(returnID, name+"-"+l.OrderLineID) {
					aria-invalid="true"
				}
			/>
			{ i18n.T(ctx, i18n.KeyAdminRetFactUnknown) }
		</label>
		<label>
			<input
				type="radio"
				name={ name + "_" + l.OrderLineID }
				value="met"
				if l.FactChecked(name, "met") {
					checked
				}
			/>
			{ i18n.T(ctx, i18n.KeyAdminRetFactMet) }
		</label>
		<label>
			<input
				type="radio"
				name={ name + "_" + l.OrderLineID }
				value="unmet"
				if l.FactChecked(name, "unmet") {
					checked
				}
			/>
			{ i18n.T(ctx, i18n.KeyAdminRetFactUnmet) }
		</label>
	</fieldset>
}
