package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/order"
	"github.com/koopa0/goen/internal/returns"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// The tabs are links and the selected one is marked with aria-current alone: a second
// class saying the same thing is a second source of truth for which tab is on.
templ Orders(p layouts.Page, v OrdersView) {
	@layouts.Admin(p, "orders") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminQueueOrders) }</h1>
			</div>
		</div>
		@layouts.Announce(v.Notice)
		<form class="goen-admin__search" method="get" action="/admin/orders">
			<label class="goen-sr-only" for="order-search">{ i18n.T(ctx, i18n.KeyAdminQueueSearchLabel) }</label>
			<input
				class="ui-input"
				id="order-search"
				type="search"
				name="q"
				value={ v.Term }
				placeholder={ i18n.T(ctx, i18n.KeyAdminQueueSearchPlaceholder) }
				autocomplete="off"
			/>
			@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminSearch) }
			}
			if v.Searching() {
				@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost}, "/admin/orders") {
					{ i18n.T(ctx, i18n.KeyAdminQueueClear) }
				}
			}
		</form>
		if v.Searching() {
			<p class="goen-admin__hint">
				{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueSearchNote), v.Term) }
			</p>
		}
		if v.TermTooShort() {
			@components.Notice(components.NoticeProps{Intent: components.IntentWarn}) {
				{ i18n.T(ctx, i18n.KeyAdminQueueSearchShort) }
			}
		}
		<nav class="ui-filterbar goen-admin__tabs" aria-label={ i18n.T(ctx, i18n.KeyAdminOrderStatus) }>
			for _, t := range v.Tabs {
				<a
					class="ui-filter"
					href={ templ.URL("/admin/orders?status=" + string(t.Value)) }
					if t.Selected {
						aria-current="page"
					}
				>
					{ t.Label }
					<span class="ui-filter__count">{ t.CountText() }</span>
				</a>
			}
		</nav>
		if v.Status == QueuePicking && !v.Searching() {
			@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "/admin/orders/picking/slips") {
				{ i18n.T(ctx, i18n.KeyAdminPickingSlips) }
			}
		}
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ v.EmptyText(ctx) }</p>
			</div>
		} else if !v.Empty() {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyFieldOrderNumber) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColPlacedAt) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
						</tr>
					</thead>
					<tbody>
						for _, o := range v.Orders {
							<tr>
								<td class="goen-admin__cellkey">
									<a href={ templ.URL("/admin/orders/" + o.Number) }>{ o.Number }</a>
								</td>
								<td>
									<div class="goen-admin__cellbadges">
										@components.Badge(components.BadgeProps{Intent: o.StatusIntent}) {
											{ o.StatusText }
										}
									</div>
								</td>
								<td>{ o.RecipientText(ctx) }</td>
								<td>{ o.PlacedAt }</td>
								<td class="goen-admin__cellnum">{ o.Total() }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@components.ListPager(v.Bound)
	}
}

// Each operation is one card with one form and one button: a column of forms sharing
// a panel reads as one long form, and the staff member who means to dispatch presses
// whatever button is nearest.
templ Order(p layouts.Page, v *OrderView) {
	@layouts.Admin(p, "orders") {
		@components.Breadcrumb(components.BreadcrumbProps{
			Label: i18n.T(ctx, i18n.KeyBreadcrumb),
			Crumbs: []components.Crumb{
				{Label: i18n.T(ctx, i18n.KeyAdminQueueOrders), Href: "/admin/orders"},
				{Label: v.Number},
			},
		})
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ v.Number }</h1>
				<p class="ui-page-head__sub">{ v.PlacedAt } · { v.ShippingName }</p>
				<p id="order-next-step" class="goen-admin__hint">{ v.nextStepSummary(ctx) }</p>
			</div>
			<div class="ui-page-head__actions">
				@components.Badge(components.BadgeProps{Intent: v.StatusIntent}) {
					{ v.StatusText }
				}
				if v.Committed {
					@components.Badge(components.BadgeProps{Intent: components.IntentNeutral}) {
						{ i18n.T(ctx, i18n.KeyAdminQueueCommitted) }
					}
				}
			</div>
		</div>
		@layouts.AnnounceOrder(v.Notice)
		<div class="goen-admin__layout">
			<div class="goen-admin__orderpanel">
				@orderItemsAndDelivery(v)
				if v.Correctable {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDeliverySave) }</h2>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/delivery") }>
							<div class="goen-admin__row">
								<div class="ui-field">
									<label class="ui-label" for="d-recipient">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</label>
									<input
										class="ui-input"
										id="d-recipient"
										name="recipient"
										value={ v.Delivery.Recipient }
										required
										maxlength="60"
										if v.DeliveryErrors["recipient"] != "" {
											aria-invalid="true"
											aria-describedby="d-recipient-error"
										}
									/>
									if v.DeliveryErrors["recipient"] != "" {
										<p id="d-recipient-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["recipient"] }</p>
									}
								</div>
								<div class="ui-field">
									<label class="ui-label" for="d-phone">{ i18n.T(ctx, i18n.KeyFieldPhoneShort) }</label>
									<input
										class="ui-input"
										id="d-phone"
										name="phone"
										type="tel"
										value={ v.Delivery.Phone }
										required
										maxlength="30"
										if v.DeliveryErrors["phone"] != "" {
											aria-invalid="true"
											aria-describedby="d-phone-error"
										}
									/>
									if v.DeliveryErrors["phone"] != "" {
										<p id="d-phone-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["phone"] }</p>
									}
								</div>
								<div class="ui-field">
									<label class="ui-label" for="d-email">{ i18n.T(ctx, i18n.KeyFieldEmail) }</label>
									<input
										class="ui-input"
										id="d-email"
										name="email"
										type="email"
										value={ v.Delivery.Email }
										required
										maxlength="254"
										if v.DeliveryErrors["email"] != "" {
											aria-invalid="true"
											aria-describedby="d-email-error"
										}
									/>
									if v.DeliveryErrors["email"] != "" {
										<p id="d-email-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["email"] }</p>
									}
								</div>
							</div>
							if v.PickupDestination {
								<div class="goen-admin__row">
									<div class="ui-field">
										<label class="ui-label" for="d-chain">{ i18n.T(ctx, i18n.KeyFieldPickupChain) }</label>
										<select
											class="ui-select"
											id="d-chain"
											name="pickup_chain"
											required
											if v.DeliveryErrors["pickup_chain"] != "" {
												aria-invalid="true"
												aria-describedby="d-chain-error"
											}
										>
											if !v.Delivery.PickupChain.Known() {
												if v.Delivery.PickupChain == "" {
													<option value="" selected disabled>{ i18n.T(ctx, i18n.KeyPickupChainRequired) }</option>
												} else {
													<option value={ string(v.Delivery.PickupChain) } selected>{ string(v.Delivery.PickupChain) }</option>
												}
											}
											for _, b := range v.PickupChains {
												<option value={ string(b.Value) } selected?={ b.Value == v.Delivery.PickupChain }>{ b.Label }</option>
											}
										</select>
										if v.DeliveryErrors["pickup_chain"] != "" {
											<p id="d-chain-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["pickup_chain"] }</p>
										}
									</div>
									// The chain is the destination. The store behind it is
									// filled in by the carrier's picker and is absent on an
									// order placed before one exists, so neither field is
									// required here — cart.Address.Validate refuses one
									// without the other and accepts both empty.
									<div class="ui-field">
										<label class="ui-label" for="d-store-code">{ i18n.T(ctx, i18n.KeyFieldStoreCode) }</label>
										<input
											class="ui-input"
											id="d-store-code"
											name="pickup_store_code"
											value={ v.Delivery.PickupStoreCode }
											maxlength="10"
											if v.DeliveryErrors["pickup_store_code"] != "" {
												aria-invalid="true"
												aria-describedby="d-store-code-error"
											}
										/>
										if v.DeliveryErrors["pickup_store_code"] != "" {
											<p id="d-store-code-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["pickup_store_code"] }</p>
										}
									</div>
									<div class="ui-field">
										<label class="ui-label" for="d-store-name">{ i18n.T(ctx, i18n.KeyFieldStoreName) }</label>
										<input
											class="ui-input"
											id="d-store-name"
											name="pickup_store_name"
											value={ v.Delivery.PickupStoreName }
											maxlength="40"
											if v.DeliveryErrors["pickup_store_name"] != "" {
												aria-invalid="true"
												aria-describedby="d-store-name-error"
											}
										/>
										if v.DeliveryErrors["pickup_store_name"] != "" {
											<p id="d-store-name-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["pickup_store_name"] }</p>
										}
									</div>
								</div>
							} else {
								<div class="goen-admin__row">
									<div class="ui-field">
										<label class="ui-label" for="d-postal">{ i18n.T(ctx, i18n.KeyFieldPostalCode) }</label>
										<input
											class="ui-input"
											id="d-postal"
											name="postal_code"
											value={ v.Delivery.PostalCode }
											required
											maxlength="6"
											if v.DeliveryErrors["postal_code"] != "" {
												aria-invalid="true"
												aria-describedby="d-postal-error"
											}
										/>
										if v.DeliveryErrors["postal_code"] != "" {
											<p id="d-postal-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["postal_code"] }</p>
										}
									</div>
									<div class="ui-field">
										<label class="ui-label" for="d-city">{ i18n.T(ctx, i18n.KeyFieldCity) }</label>
										<input
											class="ui-input"
											id="d-city"
											name="city"
											value={ v.Delivery.City }
											required
											maxlength="20"
											if v.DeliveryErrors["city"] != "" {
												aria-invalid="true"
												aria-describedby="d-city-error"
											}
										/>
										if v.DeliveryErrors["city"] != "" {
											<p id="d-city-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["city"] }</p>
										}
									</div>
									<div class="ui-field">
										<label class="ui-label" for="d-district">{ i18n.T(ctx, i18n.KeyFieldDistrict) }</label>
										<input
											class="ui-input"
											id="d-district"
											name="district"
											value={ v.Delivery.District }
											required
											maxlength="20"
											if v.DeliveryErrors["district"] != "" {
												aria-invalid="true"
												aria-describedby="d-district-error"
											}
										/>
										if v.DeliveryErrors["district"] != "" {
											<p id="d-district-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["district"] }</p>
										}
									</div>
									<div class="ui-field goen-admin__wide">
										<label class="ui-label" for="d-street">{ i18n.T(ctx, i18n.KeyFieldStreet) }</label>
										<input
											class="ui-input"
											id="d-street"
											name="street"
											value={ v.Delivery.Street }
											required
											maxlength="200"
											if v.DeliveryErrors["street"] != "" {
												aria-invalid="true"
												aria-describedby="d-street-error"
											}
										/>
										if v.DeliveryErrors["street"] != "" {
											<p id="d-street-error" class="ui-error-text" role="alert">{ v.DeliveryErrors["street"] }</p>
										}
									</div>
								</div>
							}
							<p class="goen-admin__hint">
								{ i18n.T(ctx, i18n.KeyAdminQueueDeliveryHint) }
							</p>
							@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
								{ i18n.T(ctx, i18n.KeyAdminQueueDeliverySave) }
							}
						</form>
					}
				}
				if len(v.Shipments) > 0 {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDispatch) }</h2>
						<ul class="goen-admin__timeline" role="list">
							for _, sh := range v.Shipments {
								<li class="goen-admin__event">
									<span class="goen-admin__eventhead">{ i18n.CarrierName(ctx, sh.Carrier) } · { sh.Tracking }</span>
									if sh.Delivered() {
										<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueDelivered), sh.DeliveredAt) }</span>
									} else {
										<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueDispatched), sh.ShippedAt) }</span>
										if v.Status == order.FulfillmentDelivered {
											<form method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/shipments/" + sh.ID + "/delivered") }>
												@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
													{ i18n.T(ctx, i18n.KeyAdminMarkDelivered) }
													<span class="goen-sr-only">{ " " + sh.Tracking }</span>
												}
											</form>
										}
									}
								</li>
							}
						</ul>
					}
				}
				if len(v.Timeline) > 0 {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueTimeline) }</h2>
						<ul class="goen-admin__timeline" role="list">
							for _, e := range v.Timeline {
								<li class="goen-admin__event">
									<span class="goen-admin__eventhead">{ i18n.T(ctx, e.Label) }</span>
									<span class="goen-admin__meta">{ e.When(ctx) } · { e.By(ctx) }</span>
									if e.Status != "" {
										<span class="goen-admin__meta">{ e.StatusText(ctx) }</span>
									}
									if e.Unrecognized != "" {
										<span class="goen-admin__meta">{ e.Unrecognized }</span>
									}
									if e.Note != "" {
										<span class="goen-admin__meta">{ e.noteText(ctx) }</span>
									}
								</li>
							}
						</ul>
						<p class="goen-admin__hint">{ v.MailKeptText(ctx) }</p>
					}
				}
				@components.Card(components.CardProps{Class: "goen-admin__op"}) {
					<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueStaffNote) }</h2>
					<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/note") }>
						<label class="goen-sr-only" for="staff-note">{ i18n.T(ctx, i18n.KeyAdminQueueStaffNote) }</label>
						<textarea class="ui-textarea" id="staff-note" name="note" rows="3" maxlength="1000">{ v.StaffNote }</textarea>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueStaffNoteHint) }</p>
						@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminQueueNoteSave) }
						}
					</form>
				}
			</div>
			<aside class="goen-admin__orderside">
				@components.Card(components.CardProps{Class: "goen-admin__ordersummary"}) {
					<div class="goen-admin__totalrow">
						<span>{ i18n.T(ctx, i18n.KeySubtotal) }</span>
						<span class="goen-admin__totalval">{ v.Subtotal() }</span>
					</div>
					<div class="goen-admin__totalrow">
						<span>{ i18n.T(ctx, i18n.KeyShippingFee) }</span>
						<span class="goen-admin__totalval">{ v.Shipping() }</span>
					</div>
					if v.Discounted() {
						<div class="goen-admin__totalrow">
							<span>{ components.DiscountLabel(ctx, v.DiscountReason) }</span>
							<span class="goen-admin__totalval">{ v.Discount() }</span>
						</div>
					}
					<div class="goen-admin__totalrow goen-admin__totalrow--grand">
						<span>{ i18n.T(ctx, i18n.KeyOrderGrandTotal) }</span>
						<span class="goen-admin__totalval">{ v.Total() }</span>
					</div>
					if v.UsedCredit() {
						<div class="goen-admin__totalrow">
							<span>{ i18n.T(ctx, i18n.KeyOrderCreditApplied) }</span>
							<span class="goen-admin__totalval">{ v.Credit() }</span>
						</div>
						<div class="goen-admin__totalrow goen-admin__totalrow--grand">
							<span>{ i18n.T(ctx, i18n.KeyOrderAmountDue) }</span>
							<span class="goen-admin__totalval">{ v.Owed() }</span>
						</div>
					}
				}
				@components.Card(components.CardProps{Class: "goen-admin__op", Attrs: templ.Attributes{"aria-labelledby": "payment-heading"}}) {
					<h2 class="goen-admin__optitle" id="payment-heading">{ i18n.T(ctx, i18n.KeyAdminPayTitle) }</h2>
					if v.Payment.Paid() {
						<p class="goen-admin__meta">
							{ v.Payment.Method }
							if v.Payment.Card != "" {
								· { v.Payment.Card }
							}
						</p>
						if v.Payment.Captured != "" {
							<p class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminPayReceived), v.Payment.Captured, v.Payment.PaidAt) }</p>
						}
					} else {
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminPayNone) }</p>
					}
					if len(v.Refunds) > 0 {
						<ul class="goen-admin__refunds" role="list">
							for _, r := range v.Refunds {
								<li>
									<span class="goen-admin__meta"><strong>{ r.Amount }</strong> · { r.Channel } · { r.At }</span>
									if r.Reason != "" {
										<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminPayReason), r.Reason) }</span>
									}
									if r.Staff != "" {
										<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminPayBy), r.Staff) }</span>
									}
								</li>
							}
						</ul>
					}
				}
				if v.CanShip {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDispatch) }</h2>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/ship") }>
							<div class="ui-field">
								<label class="ui-label" for="ship-carrier">{ i18n.T(ctx, i18n.KeyAdminColCarrier) }</label>
								<select
									class="ui-select"
									id="ship-carrier"
									name="carrier"
									required
									if v.ShipCarrierError != "" {
										aria-invalid="true"
										aria-describedby="ship-carrier-error"
									}
								>
									<option value="" selected?={ v.ShipCarrier == "" } disabled>{ i18n.T(ctx, i18n.KeyAdminCarrierChoose) }</option>
									for _, c := range v.ShipCarriers {
										<option value={ string(c) } selected?={ string(c) == v.ShipCarrier }>{ i18n.CarrierName(ctx, c) }</option>
									}
								</select>
								if v.ShipCarrierError != "" {
									<p id="ship-carrier-error" class="ui-error-text" role="alert">{ v.ShipCarrierError }</p>
								}
							</div>
							<div class="ui-field">
								<label class="ui-label" for="ship-tracking">{ i18n.T(ctx, i18n.KeyAdminQueueTracking) }</label>
								<input
									class="ui-input"
									id="ship-tracking"
									name="tracking"
									value={ v.ShipTracking }
									required
									maxlength="60"
									autocomplete="off"
									if v.TrackingError != "" {
										aria-invalid="true"
										aria-describedby="ship-tracking-error"
									}
								/>
								if v.TrackingError != "" {
									<p id="ship-tracking-error" class="ui-error-text" role="alert">{ v.TrackingError }</p>
								}
							</div>
							for _, l := range v.Shippable {
								<div class="ui-field">
									<label class="ui-label" for={ "qty-" + l.OrderLineID }>
										{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueRemaining), l.Line(), l.RemainingText()) }
									</label>
									<input
										class="ui-input"
										id={ "qty-" + l.OrderLineID }
										type="number"
										name={ "qty_" + l.OrderLineID }
										value={ v.QtyValue(&l) }
										min="0"
										max={ l.RemainingText() }
										if v.ShipQtyError != "" {
											aria-invalid="true"
											aria-describedby="ship-qty-error"
										}
									/>
									if l.Short() {
										<p class="goen-admin__hint">
											{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueShortHold), l.HeldText()) }
										</p>
									}
								</div>
							}
							if v.ShipQtyError != "" {
								<p id="ship-qty-error" class="ui-error-text" role="alert">{ v.ShipQtyError }</p>
							}
							@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Block: true}, "submit") {
								{ i18n.T(ctx, i18n.KeyAdminQueueDispatch) }
							}
							<p class="goen-admin__hint">
								{ i18n.T(ctx, i18n.KeyAdminQueueDispatchHint) }
							</p>
						</form>
					}
				}
				if v.RefundOpen || v.RefundOffered {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminRefundTitle) }</h2>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/refund") }>
							if v.RefundOpen {
								<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRefundOpen) }</p>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminRefundResume) }
								}
							} else {
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleDanger, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminRefundTitle) }
								}
								if v.RefundCreditPaid {
									<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRefundCreditHint) }</p>
								} else {
									<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRefundHint) }</p>
								}
							}
						</form>
					}
				}
				if v.UnsentOpen || v.UnsentOffered {
					@components.Card(components.CardProps{Class: "goen-admin__op", Attrs: templ.Attributes{"aria-labelledby": "unsent-heading"}}) {
						<h2 class="goen-admin__optitle" id="unsent-heading">{ i18n.T(ctx, i18n.KeyAdminUnsentTitle) }</h2>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/refund-unsent") }>
							if v.UnsentOpen {
								<p class="goen-admin__hint">{ v.UnsentOpenText(ctx) }</p>
								// The same units as the open refund: the door refuses a press that names others.
								for _, l := range v.UnsentOpenLines {
									<input type="hidden" name={ l.Field() } value={ l.QuantityText() }/>
								}
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminRefundResume) }
								}
							} else {
								for _, l := range v.Shippable {
									<div class="ui-field">
										<label class="ui-label" for={ "unsent-qty-" + l.OrderLineID }>
											{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminUnsentQty), l.Line(), l.RemainingText()) }
										</label>
										<input
											class="ui-input"
											id={ "unsent-qty-" + l.OrderLineID }
											type="number"
											name={ "qty_" + l.OrderLineID }
											value="0"
											min="0"
											max={ l.RemainingText() }
										/>
									</div>
								}
								<div class="ui-field">
									<label class="ui-label" for="unsent-reason">
										{ i18n.T(ctx, i18n.KeyAdminUnsentReason) }
										@components.RequiredMark()
									</label>
									<select class="ui-select" id="unsent-reason" name="reason" required>
										<option value="" selected disabled>{ i18n.T(ctx, i18n.KeyAdminUnsentReasonChoose) }</option>
										for _, reason := range returns.UnsentReasons {
											<option value={ string(reason) }>{ reason.Label(ctx) }</option>
										}
									</select>
								</div>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleDanger, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminUnsentTitle) }
								}
								<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminUnsentHint) }</p>
							}
						</form>
					}
				}
				if v.CanAdvance() {
					@components.Card(components.CardProps{Class: "goen-admin__op"}) {
						<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueNextStatus) }</h2>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueNextHint) }</p>
						{{ primary := v.primaryStepIndex() }}
						if primary >= 0 {
							<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/status") }>
								<input type="hidden" name="status" value={ string(v.Next[primary].Value) }/>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Block: true, Attrs: templ.Attributes{"id": "order-primary-step"}}, "submit") {
									{ v.Next[primary].submitLabel(ctx) }
								}
							</form>
						}
						if primary < 0 || len(v.Next) > 1 {
							<details class="goen-disclosure">
								<summary class="goen-btn goen-btn--outline goen-btn--block">{ i18n.T(ctx, i18n.KeyAdminOrderOtherSteps) }</summary>
								for i, step := range v.Next {
									if i != primary {
										<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/status") }>
											<input type="hidden" name="status" value={ string(step.Value) }/>
											@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Block: true}, "submit") {
												{ step.submitLabel(ctx) }
											}
										</form>
									}
								}
							</details>
						}
						if v.Status == order.FulfillmentPending {
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminOrderUnpaidStepHint) }</p>
						}
						if v.PickupDestination {
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueuePickupCompleteHint) }</p>
						}
					}
				} else if v.Final() {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueFinal) }</p>
				}
				@components.Card(components.CardProps{Class: "goen-admin__op", Attrs: templ.Attributes{"aria-labelledby": "invoice-heading"}}) {
					<h2 class="goen-admin__optitle" id="invoice-heading">{ i18n.T(ctx, i18n.KeyAdminDocInvoice) }</h2>
					if len(v.InvoiceDocuments) > 0 {
						<ul class="goen-admin__timeline" role="list">
							for _, d := range v.InvoiceDocuments {
								<li class="goen-admin__event">
									<span class="goen-admin__eventhead">
										{ d.KindText(ctx) } { d.Number } · { d.Amount() }
									</span>
									if d.Voided() {
										@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
											{ i18n.T(ctx, i18n.KeyAdminQueueVoided) }
										}
									}
									<span class="goen-admin__meta">{ d.IssuedAt }</span>
									if d.ProviderRef != "" {
										<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueRandomCode), d.ProviderRef) }</span>
									}
									for _, l := range d.Lines {
										<span class="goen-admin__meta">{ l.Line() }</span>
									}
								</li>
							}
						</ul>
					}
					if v.AllowanceAwaitingUntil != "" && v.InvoicingEnabled {
						<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueAllowanceAwaiting), v.AllowanceAwaitingUntil) }</p>
					}
					if v.AllowanceAwaitingUntil != "" && !v.InvoicingEnabled {
						<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueAllowanceAwaitingUnreconciled), v.AllowanceAwaitingUntil) }</p>
					}
					if v.AllowanceAttention != "" {
						<p class="ui-alert ui-alert--error" role="status">{ v.AllowanceAttentionText(ctx) }</p>
						@technicalDetail(v.allowanceAttentionDetail())
					}
					if !v.InvoicingEnabled {
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminQueueNoInvoicing) }
						</p>
					} else {
						if v.CanIssueInvoice() {
							<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/invoice") }>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueIssue) }
								}
								<p class="goen-admin__hint">
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueIssueHint), v.InvoiceText(ctx)) }
								</p>
							</form>
						}
						if v.CanVoidInvoice() {
							<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/invoice/void") }>
								<div class="ui-field">
									<label class="ui-label" for="void-reason">{ i18n.T(ctx, i18n.KeyAdminQueueVoidReason) }</label>
									<input class="ui-input" id="void-reason" name="reason" required maxlength="20" autocomplete="off"/>
								</div>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleDanger, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueVoid) }
								}
								<p class="goen-admin__hint">
									{ i18n.T(ctx, i18n.KeyAdminQueueVoidHint) }
								</p>
							</form>
						}
						if v.CanAllowInvoice() {
							<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/orders/" + v.Number + "/invoice/allowance") }>
								<input type="hidden" name="operation_id" value={ v.AllowanceOperationID }/>
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Block: true}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQueueAllowance) }
								}
								<p class="goen-admin__hint">
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueAllowanceHint), v.AllowanceAmount()) }
								</p>
								<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueAllowanceOnline) }</p>
							</form>
						}
						if !v.CanIssueInvoice() && !v.CanVoidInvoice() && len(v.InvoiceDocuments) == 0 {
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueNotCommitted) }</p>
						}
					}
				}
			</aside>
		</div>
	}
}

templ orderItemsAndDelivery(v *OrderView) {
	@components.Card(components.CardProps{Class: "goen-admin__op"}) {
		<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueItems) }</h2>
		<ul class="goen-order__lines" role="list">
			for _, l := range v.Lines {
				<li class="goen-order__line">
					if !v.OutstandingQuantities {
						<span class="goen-order__photo">
							if l.HasImage() {
								<img class="goen-order__image" src={ l.ImageURL } srcset={ l.ImageSrcset } sizes="40px" alt={ l.ImageAlt } width="40" height="40" loading="lazy" decoding="async"/>
							} else {
								<span class="goen-line__ph" aria-hidden="true"></span>
							}
						</span>
					}
					<div class="goen-order__linebody">
						<p class="goen-order__name">{ l.Name }</p>
						if l.Label != "" {
							<span class="goen-admin__meta">{ l.Label }</span>
						}
						<span class="goen-admin__meta">{ l.SKU } · { l.UnitPrice() } × { l.QuantityText() }</span>
					</div>
					if !v.OutstandingQuantities {
						<span class="goen-admin__linetotal">{ l.LineTotal() }</span>
					}
				</li>
			}
		</ul>
	}
	@components.Card(components.CardProps{Class: "goen-admin__op"}) {
		<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueDelivery) }</h2>
		<dl class="ui-dl">
			<div class="ui-dl__row">
				<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</dt>
				<dd class="ui-dl__desc">{ v.RecipientText(ctx) }</dd>
			</div>
			<div class="ui-dl__row">
				<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyFieldPhoneShort) }</dt>
				<dd class="ui-dl__desc">{ v.Phone }</dd>
			</div>
			<div class="ui-dl__row">
				<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyFieldEmail) }</dt>
				<dd class="ui-dl__desc">{ v.Email }</dd>
			</div>
			<div class="ui-dl__row">
				<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminQueueAddress) }</dt>
				<dd class="ui-dl__desc">{ v.Address }</dd>
			</div>
			if v.HasInvoice() {
				<div class="ui-dl__row">
					<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeySectionInvoice) }</dt>
					<dd class="ui-dl__desc">{ v.InvoiceText(ctx) }</dd>
				</div>
			}
		</dl>
	}
	if v.HasCustomerNote() {
		@components.Card(components.CardProps{Class: "goen-admin__op"}) {
			<h2 class="goen-admin__optitle">{ i18n.T(ctx, i18n.KeyAdminQueueCustomerNote) }</h2>
			<p class="goen-admin__note">{ v.CustomerNote }</p>
		}
	}
}
