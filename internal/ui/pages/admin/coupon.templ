package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/coupon"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/chart"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/pages"
)

// Each row leads with its code and whether it works RIGHT NOW: a coupon switched on
// but past its window is refused at the till while the list says it is fine.
templ Coupons(p layouts.Page, v CouponsView) {
	@layouts.Admin(p, "coupons") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageCoupons) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminCoupLead) }
				</p>
			</div>
		</div>
		@Announce(v.Notice)
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminCoupEmpty) }</p>
			</div>
		} else if !v.Empty() {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCoupCode) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCoupValue) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCoupConditions) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCoupUsage) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCoupExpiry) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
							<th class="goen-admin__cellactions" scope="col">
								<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminColActions) }</span>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range v.Rows {
							<tr>
								<td class="goen-admin__cellkey">
									{ c.Code }
									<span class="goen-admin__meta">{ c.Description }</span>
								</td>
								<td>
									{ c.KindText }
									<span class="goen-admin__meta">{ c.Value(ctx) }</span>
								</td>
								<td>
									<span class="goen-admin__meta">{ c.Conditions(ctx) }</span>
								</td>
								<td>
									<span class="goen-admin__meta">
										{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminCoupUsed), c.Used(ctx)) }
									</span>
									if c.MaxRedeem > 0 {
										@chart.Meter(c.UsesMeter())
									}
								</td>
								<td>
									if c.EndsAt != "" {
										<span class="goen-admin__meta">
											{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminCoupEndsAt), c.EndsAt) }
										</span>
									}
								</td>
								<td>
									if c.Live() {
										@components.Badge(components.BadgeProps{Intent: components.IntentProgress}) {
											{ c.State(ctx) }
										}
									} else {
										@components.Badge(components.BadgeProps{Intent: components.IntentNeutral}) {
											{ c.State(ctx) }
										}
									}
								</td>
								<td class="goen-admin__cellactions">
									<form method="post" action={ templ.SafeURL(c.Action()) }>
										<input type="hidden" name="active" value={ c.NextActive() }/>
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStyleOutline,
											Size:        components.SizeSmall,
										}, "submit") {
											{ c.ToggleLabel(ctx) }
										}
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminCoupCreate) }</h2>
			<form class="goen-admin__form" method="post" action="/admin/coupons">
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-code"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupCode) }
						}
						<input
							class="goen-input"
							id="c-code"
							name="code"
							required
							maxlength="32"
							placeholder="SUMMER20"
							autocomplete="off"
							value={ v.Draft.Code }
							if v.HasErr("code") {
								aria-invalid="true"
								aria-describedby="c-code-error"
							}
						/>
						if v.HasErr("code") {
							<p class="ui-error-text" id="c-code-error">{ v.Err("code") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-kind"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupKind) }
						}
						<select class="goen-input" id="c-kind" name="kind" required>
							<option value={ string(coupon.Amount) } selected?={ v.Draft.IsKind(coupon.Amount) }>{ i18n.T(ctx, i18n.KeyCouponKindAmount) }</option>
							<option value={ string(coupon.Percent) } selected?={ v.Draft.IsKind(coupon.Percent) }>{ i18n.T(ctx, i18n.KeyCouponKindPercent) }</option>
							<option value={ string(coupon.FreeShipping) } selected?={ v.Draft.IsKind(coupon.FreeShipping) }>{ i18n.T(ctx, i18n.KeyCouponKindShipping) }</option>
						</select>
					</div>
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "c-description"}) {
						{ i18n.T(ctx, i18n.KeyAdminCoupDescription) }
					}
					<input
						class="goen-input"
						id="c-description"
						name="description"
						required
						maxlength="60"
						placeholder={ i18n.T(ctx, i18n.KeyAdminCoupDescriptionExample) }
						value={ v.Draft.Description }
						if v.HasErr("description") {
							aria-invalid="true"
							aria-describedby="c-description-error"
						}
					/>
					if v.HasErr("description") {
						<p class="ui-error-text" id="c-description-error">{ v.Err("description") }</p>
					}
				</div>
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-value"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupValue) }
						}
						<input
							class="goen-input"
							id="c-value"
							name="value"
							type="number"
							min="0"
							step="1"
							inputmode="numeric"
							value={ v.Draft.Value }
							if v.HasErr("value") {
								aria-invalid="true"
								aria-describedby="c-value-error"
							}
						/>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupValueHint) }</p>
						if v.HasErr("value") {
							<p class="ui-error-text" id="c-value-error">{ v.Err("value") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-cap"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupCap) }
						}
						<input
							class="goen-input"
							id="c-cap"
							name="cap"
							type="number"
							min="0"
							step="1"
							inputmode="numeric"
							value={ v.Draft.Cap }
							if v.HasErr("cap") {
								aria-invalid="true"
								aria-describedby="c-cap-error"
							}
						/>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupCapHint) }</p>
						if v.HasErr("cap") {
							<p class="ui-error-text" id="c-cap-error">{ v.Err("cap") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-min"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupMinSpend) }
						}
						<input
							class="goen-input"
							id="c-min"
							name="min"
							type="number"
							min="0"
							step="1"
							inputmode="numeric"
							value={ v.Draft.MinSpend }
							if v.HasErr("min") {
								aria-invalid="true"
								aria-describedby="c-min-error"
							}
						/>
						if v.HasErr("min") {
							<p class="ui-error-text" id="c-min-error">{ v.Err("min") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-days"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupDays) }
						}
						<input
							class="goen-input"
							id="c-days"
							name="days"
							type="number"
							min="0"
							step="1"
							inputmode="numeric"
							value={ v.Draft.Days }
							if v.HasErr("days") {
								aria-invalid="true"
								aria-describedby="c-days-error"
							}
						/>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupDaysHint) }</p>
						if v.HasErr("days") {
							<p class="ui-error-text" id="c-days-error">{ v.Err("days") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-max"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupMaxRedeem) }
						}
						<input
							class="goen-input"
							id="c-max"
							name="max"
							type="number"
							min="0"
							step="1"
							inputmode="numeric"
							value={ v.Draft.MaxRedeem }
							if v.HasErr("max") {
								aria-invalid="true"
								aria-describedby="c-max-error"
							}
						/>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupMaxHint) }</p>
						if v.HasErr("max") {
							<p class="ui-error-text" id="c-max-error">{ v.Err("max") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "c-percustomer"}) {
							{ i18n.T(ctx, i18n.KeyAdminCoupPerCustomer) }
						}
						<input
							class="goen-input"
							id="c-percustomer"
							name="percustomer"
							type="number"
							min="1"
							step="1"
							inputmode="numeric"
							value={ v.Draft.PerCustomer }
							placeholder="1"
							if v.HasErr("percustomer") {
								aria-invalid="true"
								aria-describedby="c-percustomer-error"
							}
						/>
						if v.HasErr("percustomer") {
							<p class="ui-error-text" id="c-percustomer-error">{ v.Err("percustomer") }</p>
						}
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCoupPerCustomerHint) }</p>
					</div>
				</div>
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStylePrimary,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminCoupCreate) }
				}
			</form>
		}
		@pages.ListPager(v.Bound)
	}
}
