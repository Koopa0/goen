package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/pages"
)

// Messages renders the customer-service inbox.
//
// How long a message has waited is a badge and not a shade of the row. It was
// both before — the row was dimmed when it had been handled and marked when it
// was overdue — and the dimming said "handled" in a colour nobody had been told
// to read, while the overdue mark had no rule behind it at all and painted
// nothing. The sentence the view model already writes says both facts, so the
// badge carries it and the row stays legible.
//
// The list keeps the class the layout gate finds the page by
// (scripts/check-layout.mjs:285-286); that rule stacks the list and this file's
// divided-list rules shape the rows inside it.
templ Messages(p layouts.Page, v MessagesView) {
	@layouts.Admin(p, "messages") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageMessages) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminMessagesLead) }
				</p>
			</div>
			if !v.Empty() {
				@components.Badge(components.BadgeProps{Intent: components.IntentAccent}) {
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminMessagesOpen), v.OpenCountText()) }
				}
			}
		</div>
		if v.Notice != "" {
			@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
				{ v.Notice }
			}
		}
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<span class="goen-modqueue__emptyicon">
					@icons.Mail()
				</span>
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminMessagesEmpty) }</p>
			</div>
		} else if !v.Empty() {
			<ul class="goen-admin__returns" role="list">
				for _, m := range v.Rows {
					<li class="goen-modqueue__item goen-modqueue__item--split">
						<div class="goen-modqueue__record">
							<div class="goen-modqueue__head">
								<p class="goen-modqueue__title">{ m.Subject }</p>
								if m.Handled {
									@components.Badge(components.BadgeProps{}) {
										{ m.Waiting(ctx) }
									}
								} else if m.Overdue() {
									@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
										{ m.Waiting(ctx) }
									}
								} else {
									@components.Badge(components.BadgeProps{Intent: components.IntentAccent}) {
										{ m.Waiting(ctx) }
									}
								}
							</div>
							<span class="goen-admin__meta">
								{ m.Name } · { m.Email } · { m.At }
							</span>
							if m.HasOrderRef() {
								<span class="goen-admin__meta">
									{ i18n.T(ctx, i18n.KeyAdminMessagesOrder) } <a href={ templ.SafeURL(m.OrderHref()) }>{ m.OrderRef }</a>
								</span>
							}
							<p class="goen-admin__note">{ m.Message }</p>
						</div>
						<div class="goen-modqueue__actions">
							<form method="post" action={ templ.SafeURL(m.Action()) }>
								<input type="hidden" name="message" value={ m.ID }/>
								@components.Button(components.ButtonProps{
									ButtonStyle: components.ButtonStyleOutline,
									Size:        components.SizeSmall,
								}, "submit") {
									{ m.ActionLabel(ctx) }
								}
							</form>
						</div>
					</li>
				}
			</ul>
			// Oldest unhandled first, which is what an inbox is for — so a page
			// is the first fifty, not the latest, and Next reaches the rest.
		}
		@pages.ListPager(v.ListBound)
	}
}
