package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// A divided list rather than a column of cards: the queue is read down the page for
// the rows that still owe an answer, and the state is a badge, not a colour.
// Neither button is primary: a filled button on every row is a screen of them.
// The list keeps the class the layout gate finds the page by
// (scripts/check-layout.mjs); the divided list paints it.
templ Questions(p layouts.Page, v QuestionsView) {
	@layouts.Admin(p, "questions") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageQuestions) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminQuestionsLead) }
				</p>
			</div>
			if v.Waiting() > 0 {
				@components.Badge(components.BadgeProps{Intent: components.IntentAccent}) {
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQuestionsWaiting), v.WaitingText()) }
				}
			}
		</div>
		if v.Notice != "" {
			@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
				{ v.Notice }
			}
		}
		if v.Empty() {
			<div class="goen-admin__empty">
				<span class="goen-modqueue__emptyicon">
					@icons.Chat()
				</span>
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminQuestionsEmpty) }</p>
			</div>
		} else {
			<ul class="goen-admin__questions goen-modqueue" role="list">
				for _, q := range v.Rows {
					<li class="goen-modqueue__item">
						<div class="goen-modqueue__record">
							<div class="goen-modqueue__head">
								<p class="goen-modqueue__title">
									<a href={ templ.SafeURL(q.ProductHref()) }>{ q.ProductName }</a>
								</p>
								if q.Waiting() {
									@components.Badge(components.BadgeProps{Intent: components.IntentAccent}) {
										{ q.State(ctx) }
									}
								} else {
									@components.Badge(components.BadgeProps{}) {
										{ q.State(ctx) }
									}
								}
							</div>
							<p class="goen-admin__note">{ q.Body }</p>
							<span class="goen-admin__meta">
								{ q.Who(ctx) } · { q.Asked } · { fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQuestionAnswers), q.AnswersText()) }
							</span>
						</div>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL(q.AnswerAction()) }>
							<div class="goen-admin__field">
								@components.Label(components.LabelProps{For: "answer-" + q.ID}) {
									{ i18n.T(ctx, i18n.KeyAdminQuestionReply) }
								}
								@components.Textarea(components.FieldProps{
									ID:        "answer-" + q.ID,
									Name:      "body",
									Invalid:   q.Error != "",
									Describes: "answer-error-" + q.ID,
									Attrs: templ.Attributes{
										"maxlength":   "1000",
										"placeholder": i18n.T(ctx, i18n.KeyAdminQuestionHint),
										"rows":        "3",
									},
								}) {
									{ q.Draft }
								}
								if q.Error != "" {
									<p class="ui-error-text" id={ "answer-error-" + q.ID } role="alert">{ q.Error }</p>
								}
							</div>
							<div class="goen-modqueue__actions">
								@components.Button(components.ButtonProps{
									ButtonStyle: components.ButtonStyleOutline,
									Size:        components.SizeSmall,
									Attrs:       templ.Attributes{"name": "action", "value": "answer"},
								}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQuestionSend) }
								}
								@components.Button(components.ButtonProps{
									ButtonStyle: components.ButtonStyleGhost,
									Size:        components.SizeSmall,
									Attrs:       templ.Attributes{"name": "action", "value": "hide"},
								}, "submit") {
									{ i18n.T(ctx, i18n.KeyAdminQuestionHide) }
								}
							</div>
						</form>
					</li>
				}
			</ul>
		}
	}
}
