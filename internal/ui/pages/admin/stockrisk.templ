package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/chart"
	"github.com/koopa0/goen/internal/ui/components"
)

// StockRiskSection is the report's list of SKUs by days cover and the stock
// desk's: one component, so the two pages cannot say different things.
templ StockRiskSection(rows []StockRisk, moreSoldOut, days int) {
	<h2 class="goen-admin__subhead" id="stock">{ i18n.T(ctx, i18n.KeyAdminRepStock) }</h2>
	<p class="goen-admin__hint">
		{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminRepStockLead), days, coverMinOrders, coverWarnDays, coverMaxRows) }
	</p>
	@StockRiskRows(rows, moreSoldOut, days)
}

// StockRiskRows is the rows without the report's lead.
templ StockRiskRows(rows []StockRisk, moreSoldOut, days int) {
	if len(rows) == 0 {
		<div class="goen-admin__empty">
			<p class="goen-admin__emptytitle">{ i18n.Count(ctx, i18n.KeyAdminRepStockEmpty, int64(days), days) }</p>
		</div>
	} else {
		<ul class="goen-report__rows" role="list">
			for _, item := range rows {
				{{ cover := item.Estimate() }}
				@ReportRow(item.Name, item.Href(), item.Facts(ctx, days)) {
					<div class="goen-report__plot">
						switch cover.State {
							case CoverSoldOut:
								<p class="goen-report__state">
									@components.Badge(components.BadgeProps{Intent: components.IntentDanger}) {
										{ cover.Figure(ctx) }
									}
									if since := item.SoldOutSince(ctx); since != "" {
										<span class="goen-report__aside">{ since }</span>
									}
								</p>
							case CoverFewOrders:
								<p class="goen-report__aside">{ cover.Figure(ctx) }</p>
							default:
								<p class="goen-report__state">
									if cover.Urgent() {
										<span class="goen-report__figtext goen-report__figtext--warn">
											<svg class="goen-report__tri" viewBox="0 0 10 10" role="img" aria-label={ cover.Warning(ctx) } focusable="false"><title>{ cover.Warning(ctx) }</title><path d="M5 1 9.5 9h-9z"></path></svg>
											{ cover.Figure(ctx) }
										</span>
									} else {
										<span class="goen-report__figtext">{ cover.Figure(ctx) }</span>
									}
									if rng := cover.Range(ctx); rng != "" {
										<span class="goen-report__aside">{ rng }</span>
									}
								</p>
								@chart.RangeBar(cover.Bar())
						}
					</div>
				}
			}
		</ul>
		if moreSoldOut > 0 {
			<p class="goen-admin__hint">
				<a href="/admin/stock?soldout=1">{ i18n.Count(ctx, i18n.KeyAdminRepMoreSoldOut, int64(moreSoldOut), moreSoldOut) }</a>
			</p>
		}
	}
}
