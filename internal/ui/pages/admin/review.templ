package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/pages"
)

// The badge carries the rating, because nothing here waits for approval: a review is
// published as it is written, so the row somebody is looking for is the angry one.
// A hidden row is not dimmed: fading says "hidden" in a shade nobody has been told to read.
templ Reviews(p layouts.Page, v ReviewsView) {
	@layouts.Admin(p, "reviews") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageReviews) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminReviewsLead) }
				</p>
			</div>
		</div>
		@Announce(v.Notice)
		<div class="ui-filterbar goen-admin__tabs">
			<a
				class="ui-filter"
				href="/admin/reviews"
				if !v.ThreeStarsAndBelow {
					aria-current="page"
				}
			>
				{ i18n.T(ctx, i18n.KeyAdminTabAll) }
			</a>
			<a
				class="ui-filter"
				href="/admin/reviews?rating=3"
				if v.ThreeStarsAndBelow {
					aria-current="page"
				}
			>
				{ i18n.T(ctx, i18n.KeyAdminReviewsThreeStarsAndBelow) }
			</a>
		</div>
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<span class="goen-modqueue__emptyicon">
					@icons.Star()
				</span>
				<p class="goen-admin__emptytitle">{ v.EmptyLabel(ctx) }</p>
			</div>
		} else if !v.Empty() {
			<ul class="goen-modqueue" role="list">
				for _, r := range v.Rows {
					<li class="goen-modqueue__item goen-modqueue__item--split">
						<div class="goen-modqueue__record">
							<div class="goen-modqueue__head">
								<p class="goen-modqueue__title">
									<a href={ templ.SafeURL(r.Href()) }>{ r.Product }</a>
								</p>
								@components.Badge(components.BadgeProps{}) {
									<span aria-hidden="true">{ r.Stars() }</span>
									<span>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminReviewStars), r.Rating) }</span>
								}
							</div>
							<span class="goen-admin__meta">
								{ r.DisplayAuthor(ctx) } · { r.At }
								if r.Verified {
									{ i18n.T(ctx, i18n.KeyAdminReviewBought) }
								}
								if r.Hidden {
									{ i18n.T(ctx, i18n.KeyAdminReviewHidden) }
								}
							</span>
							if r.Title != "" {
								<p class="goen-modqueue__title">{ r.Title }</p>
							}
							<p class="goen-admin__note">{ r.Body }</p>
						</div>
						<div class="goen-modqueue__actions">
							<form method="post" action={ templ.SafeURL(r.Action()) }>
								<input type="hidden" name="review" value={ r.ID }/>
								@components.Button(components.ButtonProps{
									ButtonStyle: components.ButtonStyleOutline,
									Size:        components.SizeSmall,
								}, "submit") {
									{ r.ActionLabel(ctx) }
								}
							</form>
						</div>
					</li>
				}
			</ul>
		}
		@pages.ListPager(v.Bound)
	}
}
