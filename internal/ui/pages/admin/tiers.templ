package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// A table rather than a list: every tier carries the same four facts and a column of
// thresholds is read down.
templ Tiers(p layouts.Page, v TiersView) {
	@layouts.Admin(p, "tiers") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageTiers) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminTierLead) }
				</p>
			</div>
		</div>
		@Announce(v.Notice)
		if v.Empty() {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminTierEmpty) }</p>
			</div>
		} else {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColTier) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColThreshold) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColRate) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColMembers) }</th>
							<th class="goen-admin__cellactions" scope="col">
								<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminColActions) }</span>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range v.Rows {
							<tr>
								<td class="goen-admin__cellkey">
									{ t.Name }
									<span class="goen-admin__meta">{ t.Code }</span>
								</td>
								<td class="goen-admin__cellnum">{ t.Threshold() }</td>
								<td class="goen-admin__cellnum">{ t.Multiplier(ctx) }</td>
								<td class="goen-admin__cellnum">{ t.MembersText() }</td>
								<td class="goen-admin__cellactions">
									<form method="post" action="/admin/tiers/delete">
										<input type="hidden" name="tier" value={ t.ID }/>
										@components.Button(components.ButtonProps{
											ButtonStyle: components.ButtonStyleDanger,
											Size:        components.SizeSmall,
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminRemove) }
										}
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminTierAdd) }</h2>
			<form class="goen-admin__form" method="post" action="/admin/tiers">
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "tier-code"}) {
							{ i18n.T(ctx, i18n.KeyAdminColCode) }
						}
						<input class="goen-input" id="tier-code" name="code" required maxlength="30" pattern="[a-z0-9_]+"/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "tier-name"}) {
							{ i18n.T(ctx, i18n.KeyAdminColName) }
						}
						<input class="goen-input" id="tier-name" name="name" required maxlength="30"/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "tier-name-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminColNameEn) }
						}
						<input class="goen-input" id="tier-name-en" name="name_en" maxlength="30"/>
						<div class="goen-admin__hints">
							<p class="goen-admin__hint">
								{ i18n.T(ctx, i18n.KeyAdminTierNameEnHint) }
							</p>
							<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminExample), "Silver") }</p>
						</div>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "tier-threshold"}) {
							{ i18n.T(ctx, i18n.KeyAdminTierThreshold) }
						}
						<input class="goen-input" id="tier-threshold" name="threshold" type="number" min="0" step="1" required inputmode="numeric"/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "tier-percent"}) {
							{ i18n.T(ctx, i18n.KeyAdminTierRate) }
						}
						<input class="goen-input" id="tier-percent" name="percent" type="number" min="100" max="300" step="1" value="100" required inputmode="numeric"/>
					</div>
				</div>
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStylePrimary,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminAddButton) }
				}
			</form>
		}
	}
}
