package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/chart"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// The lists are not tables: each cell carries its own label ("%s units", "%s left")
// because the sentence is what internal/i18n holds, and a column header would be a
// second name for the same fact.
templ Report(p layouts.Page, v *ReportView) {
	@layouts.Admin(p, "reports") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageReports) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminRepLead) }
				</p>
				<p class="ui-page-head__sub">{ v.Heading(ctx) }</p>
			</div>
			<nav class="ui-filterbar goen-admin__tabs" aria-label={ i18n.T(ctx, i18n.KeyAdminRepWindow) }>
				for _, d := range v.Windows {
					<a
						class="ui-filter"
						href={ templ.SafeURL(v.WindowHref(d)) }
						if v.IsWindow(d) {
							aria-current="page"
						}
					>
						{ v.WindowLabel(ctx, d) }
					</a>
				}
			</nav>
		</div>
		if v.Empty() {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminRepEmpty) }</p>
			</div>
		} else {
			<ul class="goen-report__figures" role="list">
				<li class="goen-report__figure">
					<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepRevenue) }</span>
					<span class="goen-report__value">{ v.Revenue() }</span>
					<span class="goen-admin__meta">{ v.RevenueAgainst(ctx) }</span>
				</li>
				<li class="goen-report__figure">
					<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepRefunded) }</span>
					<span class="goen-report__value">{ v.Refunded() }</span>
					<span class="goen-admin__meta">{ v.RefundedAgainst(ctx) }</span>
				</li>
				<li class="goen-report__figure">
					<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepPaidOrders) }</span>
					<span class="goen-report__value">{ v.OrdersText() }</span>
					<span class="goen-admin__meta">{ v.OrdersAgainst(ctx) }</span>
				</li>
				<li class="goen-report__figure">
					<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepAverage) }</span>
					<span class="goen-report__value">{ v.Average() }</span>
					<span class="goen-admin__meta">{ v.AverageAgainst(ctx) }</span>
				</li>
				<li class="goen-report__figure">
					<span class="goen-report__label">{ i18n.T(ctx, i18n.KeyAdminRepCompletion) }</span>
					<span class="goen-report__value">{ v.Completion(ctx) }</span>
					<span class="goen-admin__meta">{ v.CompletionAgainst(ctx) }</span>
					if !v.ShowsCount() {
						<span class="goen-admin__meta">
							{ v.Counts(ctx) }
						</span>
					}
				</li>
			</ul>
			<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRepBeforeShipment) }</p>
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminRepNote) }
			</p>
			if v.DailyUnavailable {
				<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminRepRunning) }</h2>
				<p class="goen-admin__hint" role="status">{ i18n.T(ctx, i18n.KeyAdminChartUnavailable) }</p>
			} else if v.ShowsRunningTotal() {
				<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminRepRunning) }</h2>
				@chart.RunningTotal(v.RunningTotal(ctx))
			}
			<h2 class="goen-admin__subhead">{ v.PaidHeading(ctx) }</h2>
			if v.DailyUnavailable {
				<p class="goen-admin__hint" role="status">{ i18n.T(ctx, i18n.KeyAdminChartUnavailable) }</p>
			} else if v.ShowsPaidColumns() {
				@chart.Columns(v.PaidColumns(ctx))
			} else {
				<p class="goen-admin__hint">{ v.PaidSentence(ctx) }</p>
			}
			<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminRepSellers) }</h2>
			<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRepGrossNote) }</p>
			if len(v.Sellers) == 0 {
				<div class="goen-admin__empty">
					<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminRepSellersEmpty) }</p>
				</div>
			} else {
				<ul class="goen-report__rows" role="list">
					{{ top := v.TopUnits() }}
					for _, item := range v.Sellers {
						@ReportRow(item.Name, item.Href(), item.Facts(ctx)) {
							if len(v.Sellers) > 1 {
								<div class="goen-report__plot">
									@chart.Bar(chart.BarProps{Value: item.Units, Max: top, Label: item.UnitsText()})
								</div>
							}
						}
					}
				</ul>
			}
			if len(v.Departments) > 0 {
				<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminRepDepartments) }</h2>
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRepDepartmentsNote) }</p>
				if len(v.Departments) == 1 {
					<p>{ v.OnlyDepartment(ctx) }</p>
				} else {
					<ul class="goen-report__rows goen-report__departments" role="list">
						{{ top := v.TopDepartment() }}
						for _, d := range v.Departments {
							@ReportRow(d.Name, "", "") {
								<div class="goen-report__plot">
									<span class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminRepDepartmentSales), d.Sales()) }</span>
									@chart.Bar(chart.BarProps{Value: d.SalesCents, Max: top, Label: d.Sales()})
								</div>
							}
						}
					</ul>
				}
			}
		}
		@returnedProducts(v)
		@StockRiskSection(v.AtRisk, v.MoreSoldOut, v.StockDays)
	}
}
