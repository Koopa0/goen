package admin

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// The figures are divisions rather than links because no screen lists the people
// they count. Sending is the one decision here, so the only primary control;
// saving a draft is reversible and takes an outline.
templ Newsletter(p layouts.Page, v NewsletterView) {
	@layouts.Admin(p, "newsletter") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageNewsletter) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminNewsLead) }
				</p>
			</div>
		</div>
		if v.Notice != "" {
			@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
				{ v.Notice }
			}
		}
		<div class="goen-admin__stats">
			<div class="goen-stat">
				<span class="goen-stat__label">{ i18n.T(ctx, i18n.KeyAdminNewsOnList) }</span>
				<span class="goen-stat__value">{ v.ActiveText() }</span>
			</div>
			<div class="goen-stat">
				<span class="goen-stat__label">{ i18n.T(ctx, i18n.KeyAdminNewsAwaiting) }</span>
				<span class="goen-stat__value">{ v.AwaitingText() }</span>
			</div>
			<div class="goen-stat">
				<span class="goen-stat__label">{ i18n.T(ctx, i18n.KeyAdminNewsUnsubscribed) }</span>
				<span class="goen-stat__value">{ v.UnsubscribedText() }</span>
			</div>
		</div>
		@components.Card(components.CardProps{Class: "goen-admin__add"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminNewsCompose) }</h2>
			<form class="goen-admin__form" method="post" action="/admin/newsletter">
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "issue-subject"}) {
						{ i18n.T(ctx, i18n.KeyAdminNewsSubject) }
					}
					@components.Input(components.FieldProps{
						ID:        "issue-subject",
						Name:      "subject",
						Value:     v.Draft.Subject,
						Invalid:   v.HasErr("subject"),
						Describes: "issue-subject-error",
						Attrs: templ.Attributes{
							"maxlength": "120",
							"required":  true,
						},
					})
					if v.HasErr("subject") {
						<p class="ui-error-text" id="issue-subject-error" role="alert">{ v.Err("subject") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "issue-body"}) {
						{ i18n.T(ctx, i18n.KeyAdminNewsBody) }
					}
					@components.Textarea(components.FieldProps{
						ID:        "issue-body",
						Name:      "body",
						Invalid:   v.HasErr("body"),
						Describes: "issue-body-error",
						Attrs: templ.Attributes{
							"maxlength": "20000",
							"required":  true,
							"rows":      "10",
						},
					}) {
						{ v.Draft.Body }
					}
					if v.HasErr("body") {
						<p class="ui-error-text" id="issue-body-error" role="alert">{ v.Err("body") }</p>
					}
				</div>
				<p class="goen-admin__hint">
					{ i18n.T(ctx, i18n.KeyAdminNewsDraftHint) }
				</p>
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminNewsSaveDraft) }
				}
			</form>
		}
		@components.Card(components.CardProps{Class: "goen-admin__add"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminNewsIssues) }</h2>
			if v.Empty() {
				<div class="goen-admin__empty">
					<span class="goen-modqueue__emptyicon">
						@icons.Mail()
					</span>
					<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminNewsEmpty) }</p>
				</div>
			} else {
				<ul class="goen-modqueue" role="list">
					for _, issue := range v.Issues {
						<li class="goen-modqueue__item goen-modqueue__item--split">
							<div class="goen-modqueue__record">
								<div class="goen-modqueue__head">
									<p class="goen-modqueue__title">{ issue.Subject }</p>
									if issue.Sent {
										@components.Badge(components.BadgeProps{}) {
											{ i18n.T(ctx, i18n.KeyAdminNewsSent) }
										}
									}
								</div>
								<span class="goen-admin__meta">{ issue.Preview() }</span>
								if issue.Sent {
									<span class="goen-admin__meta">
										{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminNewsSentMeta), issue.SentAt, issue.RecipientsText()) }
										if issue.SentBy != "" {
											· { issue.SentBy }
										}
									</span>
								}
							</div>
							if !issue.Sent {
								<div class="goen-modqueue__actions">
									if v.CanSend() {
										<form method="post" action={ templ.SafeURL(issue.SendAction()) }>
											@components.Button(components.ButtonProps{
												ButtonStyle: components.ButtonStylePrimary,
												Size:        components.SizeSmall,
											}, "submit") {
												{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminNewsSend), v.ActiveText()) }
											}
										</form>
									} else {
										<span class="goen-admin__meta">{ i18n.T(ctx, i18n.KeyAdminNewsNobody) }</span>
									}
								</div>
							}
						</li>
					}
				</ul>
			}
		}
	}
}
