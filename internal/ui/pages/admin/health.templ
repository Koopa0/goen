package admin

import (
	"strconv"
	"time"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// The five states are always on the page and the alarm tables only when there is
// something in them: an empty page means the shop is running itself.
templ Health(p layouts.Page, v *WorkerHealthView) {
	@layouts.Admin(p, "health") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageHealth) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminHPLead) }
				</p>
			</div>
			<div class="ui-page-head__actions">
				if v.AllHealthy() {
					@components.Badge(components.BadgeProps{Intent: components.IntentDone}) {
						{ i18n.T(ctx, i18n.KeyAdminHPAllClear) }
					}
				} else {
					@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
						{ i18n.T(ctx, i18n.KeyAdminHPNeedsLook) }
					}
				}
			</div>
		</div>
		@Announce(v.Notice)
		<ul class="goen-health" role="list">
			@healthItem(v.OutboxHealthy(), i18n.T(ctx, i18n.KeyAdminHPOutboxName), v.OutboxText(ctx), i18n.T(ctx, i18n.KeyAdminHPOutboxNote))
			@healthItem(v.SweeperHealthy(), i18n.T(ctx, i18n.KeyAdminHPHoldsName), v.SweeperText(ctx), i18n.T(ctx, i18n.KeyAdminHPHoldsNote))
			@healthItem(v.RecommendHealthy(), i18n.T(ctx, i18n.KeyAdminHPProjectionName), v.RecommendText(ctx), i18n.T(ctx, i18n.KeyAdminHPProjectionNote))
			@healthItem(v.RefundsHealthy(), i18n.T(ctx, i18n.KeyAdminHPRefundsName), v.RefundsText(ctx), i18n.T(ctx, i18n.KeyAdminHPRefundsNote))
			if v.Disputes.Configured {
				@healthItem(v.Disputes.Healthy(), i18n.T(ctx, i18n.KeyAdminHPDisputesName), v.Disputes.Text(ctx), i18n.T(ctx, i18n.KeyAdminHPDisputesNote))
			}
			@healthItem(v.HousekeepingHealthy(), i18n.T(ctx, i18n.KeyAdminHPHousekeepingName), v.HousekeepingText(ctx), i18n.T(ctx, i18n.KeyAdminHPHousekeepingNote))
		</ul>
		if len(v.Pools) > 0 {
			<section class="goen-admin__queue" aria-labelledby="pools-heading">
				<h2 class="goen-admin__heading" id="pools-heading">{ i18n.T(ctx, i18n.KeyAdminHPPoolsHeading) }</h2>
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminHPPoolsHint) }</p>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPool) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPoolMax) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPoolAcquired) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPoolIdle) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPoolTotal) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPoolAcquires) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPoolEmpty) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPoolWait) }</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range v.Pools {
								<tr>
									<td class="goen-admin__cellkey">{ p.Name }</td>
									<td class="goen-admin__cellnum">{ strconv.Itoa(int(p.Max)) }</td>
									<td class="goen-admin__cellnum">{ strconv.Itoa(int(p.Acquired)) }</td>
									<td class="goen-admin__cellnum">{ strconv.Itoa(int(p.Idle)) }</td>
									<td class="goen-admin__cellnum">{ strconv.Itoa(int(p.Total)) }</td>
									<td class="goen-admin__cellnum">{ strconv.FormatInt(p.TotalAcquires, 10) }</td>
									<td class="goen-admin__cellnum">{ strconv.FormatInt(p.EmptyAcquires, 10) }</td>
									<td class="goen-admin__cellnum">{ p.AcquireWait.Round(time.Millisecond).String() }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if len(v.Stuck) > 0 {
			<section class="goen-admin__queue" aria-labelledby="stuck-heading">
				<h2 class="goen-admin__heading" id="stuck-heading">{ i18n.T(ctx, i18n.KeyAdminHPStuckHeading) }</h2>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColTopic) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColKey) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColAttempts) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColLastError) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColNextRetry) }</th>
							</tr>
						</thead>
						<tbody>
							for _, m := range v.Stuck {
								<tr>
									<td class="goen-admin__cellkey">{ m.Topic }</td>
									<td>{ m.Key }</td>
									<td class="goen-admin__cellnum">{ m.AttemptsText() }</td>
									<td>{ m.Reason(ctx) }</td>
									<td>{ m.NextAttempt }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if len(v.UnreconciledEvents) > 0 {
			// A webhook event is resolved by its event id. Keep that identity
			// concrete rather than overloading a payment-provider reference.
			<section class="goen-admin__queue" aria-labelledby="events-heading">
				<h2 class="goen-admin__heading" id="events-heading">{ i18n.T(ctx, i18n.KeyAdminHPUnreconciledHeading) }</h2>
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminHPUnreconciledHint) }</p>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColEvent) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColKind) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColProviderRef) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColReason) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColStarted) }</th>
								<th class="goen-admin__cellactions" scope="col"><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminHPEventSafeRelease) }</span></th>
							</tr>
						</thead>
						<tbody>
							for _, u := range v.UnreconciledEvents {
								<tr>
									<td class="goen-admin__cellkey">{ u.EventID }</td>
									<td>{ u.Type }</td>
									<td>{ u.Ref }</td>
									<td>
										if u.RefundOrderNumber != "" {
											<a href={ templ.SafeURL("/admin/orders/" + u.RefundOrderNumber) }>{ u.RefundOrderNumber }</a> · { u.RefundAmount() }
											<span class="goen-admin__meta">{ i18n.T(ctx, i18n.KeyAdminHPRefundFailedAtStripe) }</span>
											<span class="goen-admin__meta">{ u.Reason }</span>
										} else {
											{ u.Reason }
										}
									</td>
									<td>{ u.Since }</td>
									<td class="goen-admin__cellactions">
										<form method="post" action="/admin/health/reconcile">
											<input type="hidden" name="event" value={ u.EventID }/>
											<input type="hidden" name="event_resolution" value="fully_refunded_or_accounted"/>
											@components.Button(components.ButtonProps{
												ButtonStyle: components.ButtonStyleOutline,
												Size:        components.SizeSmall,
											}, "submit") {
												{ i18n.T(ctx, i18n.KeyAdminHPEventSafeRelease) }
											}
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if len(v.UnreconciledCompletePayments) > 0 {
			// A provider-complete payment is resolved by its provider reference;
			// it is not a synthetic webhook event.
			<section class="goen-admin__queue" aria-labelledby="payments-heading">
				<h2 class="goen-admin__heading" id="payments-heading">{ i18n.T(ctx, i18n.KeyAdminHPCompletePaymentsHeading) }</h2>
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminHPCompletePaymentsHint) }</p>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColProviderRef) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColReason) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColStarted) }</th>
								<th class="goen-admin__cellactions" scope="col"><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminHPCompletePaymentsHeading) }</span></th>
							</tr>
						</thead>
						<tbody>
							for _, p := range v.UnreconciledCompletePayments {
								<tr>
									<td class="goen-admin__cellkey">
										<a href={ templ.SafeURL("/admin/orders/" + p.OrderNumber) }>{ p.OrderNumber }</a>
									</td>
									<td>{ p.ProviderRef }</td>
									<td>{ p.Reason(ctx) }</td>
									<td>{ p.Since }</td>
									<td class="goen-admin__cellactions">
										if p.PaidAttributionAllowed {
											<form method="post" action="/admin/health/reconcile">
												<input type="hidden" name="payment" value={ p.ProviderRef }/>
												<input type="hidden" name="resolution" value="paid"/>
												@components.Button(components.ButtonProps{
													ButtonStyle: components.ButtonStyleOutline,
													Size:        components.SizeSmall,
												}, "submit") {
													{ i18n.T(ctx, i18n.KeyAdminHPCompletePaid) }
												}
											</form>
										}
										<form method="post" action="/admin/health/reconcile">
											<input type="hidden" name="payment" value={ p.ProviderRef }/>
											<input type="hidden" name="resolution" value="unpaid_or_refunded"/>
											@components.Button(components.ButtonProps{
												ButtonStyle: components.ButtonStyleOutline,
												Size:        components.SizeSmall,
											}, "submit") {
												{ i18n.T(ctx, i18n.KeyAdminHPCompleteSafeToRetry) }
											}
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if v.UninvoicedCount > 0 {
			// Read from the orders themselves, not from the outbox that should have
			// claimed their invoices: that queue is what may have lost them.
			<section class="goen-admin__queue" aria-labelledby="uninvoiced-heading">
				<h2 class="goen-admin__heading" id="uninvoiced-heading">{ i18n.T(ctx, i18n.KeyAdminHPUninvoicedHeading) }</h2>
				<p class="goen-admin__hint">{ v.UninvoicedText(ctx) }</p>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColPaid) }</th>
								<th class="goen-admin__cellactions" scope="col"><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminQueueIssue) }</span></th>
							</tr>
						</thead>
						<tbody>
							for _, o := range v.Uninvoiced {
								<tr>
									<td class="goen-admin__cellkey">
										<a href={ templ.SafeURL("/admin/orders/" + o.OrderNumber) }>{ o.OrderNumber }</a>
									</td>
									<td class="goen-admin__cellnum">{ o.Amount() }</td>
									<td>{ o.Since }</td>
									<td class="goen-admin__cellactions">
										<form method="post" action={ templ.SafeURL("/admin/orders/" + o.OrderNumber + "/invoice") }>
											@components.Button(components.ButtonProps{
												ButtonStyle: components.ButtonStyleOutline,
												Size:        components.SizeSmall,
											}, "submit") {
												{ i18n.T(ctx, i18n.KeyAdminQueueIssue) }
											}
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if v.CancelledOrderInvoiceCount > 0 {
			<section class="goen-admin__queue" aria-labelledby="cancelled-order-invoices-heading">
				<h2 class="goen-admin__heading" id="cancelled-order-invoices-heading">{ i18n.T(ctx, i18n.KeyAdminHPCancelledOrderInvoicesHeading) }</h2>
				<p class="goen-admin__hint">{ v.CancelledOrderInvoicesText(ctx) }</p>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminDocInvoice) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColIssued) }</th>
							</tr>
						</thead>
						<tbody>
							for _, inv := range v.CancelledOrderInvoices {
								<tr>
									<td class="goen-admin__cellkey">
										<a href={ templ.SafeURL("/admin/orders/" + inv.OrderNumber) }>{ inv.OrderNumber }</a>
									</td>
									<td>{ inv.Number }</td>
									<td class="goen-admin__cellnum">{ inv.Amount() }</td>
									<td>{ inv.IssuedOn }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if len(v.StrandedClaims) > 0 {
			// Ordinary ambiguity is reconciled automatically. An aged Allowance
			// becomes actionable only after an operator verifies provider absence.
			<section class="goen-admin__queue" aria-labelledby="claims-heading">
				<h2 class="goen-admin__heading" id="claims-heading">{ i18n.T(ctx, i18n.KeyAdminHPClaimsHeading) }</h2>
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminHPClaimsHint) }</p>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColKey) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColKind) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColAttempts) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColLastError) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColStarted) }</th>
								<th class="goen-admin__cellactions" scope="col"><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminHPAllowanceResendAuthorize) }</span></th>
							</tr>
						</thead>
						<tbody>
							for _, c := range v.StrandedClaims {
								<tr>
									<td class="goen-admin__cellkey">{ c.Operation }</td>
									<td>
										<a href={ templ.SafeURL("/admin/orders/" + c.OrderNumber) }>{ c.OrderNumber }</a>
									</td>
									<td>{ c.Kind }</td>
									<td class="goen-admin__cellnum">{ c.Amount() }</td>
									<td>{ c.Status }</td>
									<td class="goen-admin__cellnum">{ c.AttemptsText() }</td>
									<td>{ c.LastError }</td>
									<td>{ c.Since }</td>
									<td class="goen-admin__cellactions">
										if c.CanAuthorizeResend {
											<form method="post" action="/admin/health/reconcile">
												<input type="hidden" name="invoice_operation" value={ c.Operation }/>
												<label class="goen-admin__confirm">
													<input type="checkbox" name="invoice_resolution" value="confirmed_absent" required/>
													if c.BuyerNeverAgreed() {
														{ i18n.T(ctx, i18n.KeyAdminHPAllowanceLapsedConfirm) }
													} else {
														{ i18n.T(ctx, i18n.KeyAdminHPAllowanceAbsentConfirm) }
													}
												</label>
												@components.Button(components.ButtonProps{
													ButtonStyle: components.ButtonStyleOutline,
													Size:        components.SizeSmall,
												}, "submit") {
													{ i18n.T(ctx, i18n.KeyAdminHPAllowanceResendAuthorize) }
												}
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if len(v.Disputes.Items) > 0 {
			<section class="goen-admin__queue" aria-labelledby="disputes-heading">
				<h2 class="goen-admin__heading" id="disputes-heading">{ i18n.T(ctx, i18n.KeyAdminHPDisputesHeading) }</h2>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColRespondBy) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColDispute) }</th>
							</tr>
						</thead>
						<tbody>
							for _, d := range v.Disputes.Items {
								<tr>
									<td class="goen-admin__cellkey">
										if d.OrderNumber != "" {
											{ d.OrderNumber }
										} else if v.Disputes.OrdersUnknown {
											{ i18n.T(ctx, i18n.KeyAdminHPDisputeOrderUnknown) }
										} else {
											{ i18n.T(ctx, i18n.KeyAdminHPDisputeNoOrder) }
										}
									</td>
									<td class="goen-admin__cellnum">{ d.Amount() }</td>
									<td>
										if d.RespondBy != "" {
											{ d.RespondBy }
										} else {
											{ i18n.T(ctx, i18n.KeyAdminHPDisputeNoDeadline) }
										}
									</td>
									<td><a href={ templ.SafeURL(d.URL) } target="_blank" rel="noopener noreferrer">{ i18n.T(ctx, i18n.KeyAdminHPDisputeOpen) }</a></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if len(v.OpenRefunds) > 0 {
			<section class="goen-admin__queue" aria-labelledby="refunds-heading">
				<h2 class="goen-admin__heading" id="refunds-heading">{ i18n.T(ctx, i18n.KeyAdminHPOpenRefundsHeading) }</h2>
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
								<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColProviderRef) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColSentKey) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminHPColStarted) }</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range v.OpenRefunds {
								<tr>
									<td class="goen-admin__cellkey"><a href={ templ.SafeURL("/admin/orders/" + r.OrderNumber) }>{ r.OrderNumber }</a></td>
									<td class="goen-admin__cellnum">{ r.Amount() }</td>
									<td>
										{ r.StatusText(ctx) }
										<p class="goen-admin__hint">{ r.NextStep(ctx) }</p>
									</td>
									<td>{ r.Reference(ctx) }</td>
									<td>{ r.Key }</td>
									<td>{ r.Since }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	}
}

// The badge says what the border says, on purpose: a state told only by colour
// is a state somebody cannot read.
templ healthItem(healthy bool, name, state, note string) {
	<li class={ "goen-health__item", templ.KV("is-bad", !healthy) }>
		<div class="goen-health__head">
			<span class="goen-health__name">{ name }</span>
			if healthy {
				@components.Badge(components.BadgeProps{Intent: components.IntentDone}) {
					{ i18n.T(ctx, i18n.KeyAdminHPAllClear) }
				}
			} else {
				@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
					{ i18n.T(ctx, i18n.KeyAdminHPNeedsLook) }
				}
			}
		</div>
		<span class="goen-health__state">{ state }</span>
		<span class="goen-admin__meta">{ note }</span>
	</li>
}
