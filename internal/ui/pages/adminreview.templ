package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminReviews renders the review queue.
//
// The badge carries the rating, because the rating is what this queue is
// scanned for: nothing here waits for approval — a review is published as it is
// written — so the row somebody is looking for is the angry one, not the next
// one in line. Hiding is the exception the lead paragraph describes, and the
// row says so in its own words beside the button that reverses it.
//
// The row is no longer dimmed when it is hidden. Fading a row to 55% says
// "hidden" in a shade a reader has not been told to read, and it takes the
// review's own text down with it.
templ AdminReviews(p layouts.Page, v AdminReviewsView) {
	@layouts.Admin(p, "reviews") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageReviews) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminReviewsLead) }
				</p>
			</div>
		</div>
		if v.Notice != "" {
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
				{ v.Notice }
			}
		}
		if v.Empty() {
			<div class="goen-admin__empty">
				<span class="goen-modqueue__emptyicon">
					@icons.Star()
				</span>
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminReviewsEmpty) }</p>
			</div>
		} else {
			<ul class="goen-modqueue" role="list">
				for _, r := range v.Rows {
					<li class="goen-modqueue__item goen-modqueue__item--split">
						<div class="goen-modqueue__record">
							<div class="goen-modqueue__head">
								<p class="goen-modqueue__title">
									<a href={ templ.SafeURL(r.Href()) }>{ r.Product }</a>
								</p>
								@components.Badge(components.BadgeProps{}) {
									<span aria-hidden="true">{ r.Stars() }</span>
									<span class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminReviewStars), r.RatingText()) }</span>
								}
							</div>
							<span class="goen-admin__meta">
								{ r.DisplayAuthor(ctx) } · { r.At }
								if r.Verified {
									{ i18n.T(ctx, i18n.KeyAdminReviewBought) }
								}
								if r.Hidden {
									{ i18n.T(ctx, i18n.KeyAdminReviewHidden) }
								}
							</span>
							if r.Title != "" {
								<p class="goen-modqueue__title">{ r.Title }</p>
							}
							<p class="goen-admin__note">{ r.Body }</p>
						</div>
						<div class="goen-modqueue__actions">
							<form method="post" action={ templ.SafeURL(r.Action()) }>
								<input type="hidden" name="review" value={ r.ID }/>
								@components.Button(components.ButtonProps{
									Variant: components.VariantOutline,
									Size:    components.SizeSmall,
								}, "submit") {
									{ r.ActionLabel(ctx) }
								}
							</form>
						</div>
					</li>
				}
			</ul>
		}
	}
}
