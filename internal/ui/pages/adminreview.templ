package pages

import "github.com/koopa0/goen/internal/ui/layouts"

// AdminReviews renders the review queue.
templ AdminReviews(p layouts.Page, v AdminReviewsView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("reviews")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">後台</p>
					<h1 class="ui-page-head__title">顧客評價</h1>
					<p class="ui-page-head__sub">
						評價寫完就顯示,不先審 —— 每一則都要人核准的評價頁,讀起來就是廣告。
						隱藏是例外,而且會把那一則從評分裡一起拿掉。
					</p>
				</div>
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			if v.Empty() {
				<p class="goen-admin__hint">還沒有任何評價。</p>
			} else {
				<ul class="goen-admin__returns" role="list">
					for _, r := range v.Rows {
						<li class={ "goen-admin__return", templ.KV("is-hidden", r.Hidden) }>
							<div class="goen-admin__returninfo">
								<p class="goen-admin__returnorder">
									<a class="goen-admin__productname" href={ templ.SafeURL(r.Href()) }>{ r.Product }</a>
								</p>
								<span class="ui-cart-line__meta">
									<span aria-hidden="true">{ r.Stars() }</span>
									<span class="goen-sr-only">{ r.RatingText() } 分</span>
									· { r.DisplayAuthor(ctx) } · { r.At }
									if r.Verified {
										· 已購買
									}
									if r.Hidden {
										· 已隱藏(不計入評分)
									}
								</span>
								if r.Title != "" {
									<p class="goen-admin__returnorder">{ r.Title }</p>
								}
								<p class="goen-admin__note">{ r.Body }</p>
							</div>
							<form class="goen-admin__decide" method="post" action={ templ.SafeURL(r.Action()) }>
								<input type="hidden" name="review" value={ r.ID }/>
								<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ r.ActionLabel(ctx) }</button>
							</form>
						</li>
					}
				</ul>
			}
		</div>
	}
}
