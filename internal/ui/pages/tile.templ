package pages

import (
	"fmt"
	"strings"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
)

// A GET, because the set is the URL and a comparison writes nothing. It wraps the
// grid only when some tile carries a box: a bar with nothing to tick does nothing.
templ compareForm(offered bool) {
	if offered {
		<form class="goen-compare-pick" id="compare-pick" method="get" action="/compare">
			{ children... }
			<div class="goen-compare-pick__go">
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Size:        components.SizeSmall,
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyCompareSelected) }
				}
				<span class="goen-compare-pick__note">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCompareLimit), MaxCompare) }</span>
			</div>
		</form>
	} else {
		{ children... }
	}
}

templ tileCard(t ProductTile) {
	if t.Comparable {
		// Outside the card, never inside: the whole card is one link, and a control
		// nested in an anchor is neither clickable nor valid.
		<label class="goen-tile__compare">
			<input type="checkbox" name="p" value={ t.Slug } class="goen-check" aria-label={ t.CompareLabel(ctx) } form="compare-pick"/>
			<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyCompareAdd) }</span>
		</label>
	}
	<a class={ "goen-tile", templ.KV("goen-tile--out", t.SoldOut()) } href={ templ.URL("/p/" + t.Slug) }>
		<div class="goen-tile__media">
			if t.HasImage() {
				<img
					class="goen-tile__img"
					src={ t.ImageURL }
					srcset={ t.ImageSrcset }
					sizes={ t.Sizes() }
					alt={ t.ImageAlt }
					if t.HasImageDimensions() {
						width={ t.ImageWidthText() }
						height={ t.ImageHeightText() }
					}
					if t.Eager {
						decoding="async"
					} else {
						loading="lazy"
						decoding="async"
					}
					if t.Priority {
						fetchpriority="high"
					}
				/>
			} else {
				<span class="goen-tile__ph">{ i18n.T(ctx, i18n.KeyNoPhoto) }</span>
			}
		</div>
		<div class="goen-tile__body">
			if t.Brand != "" {
				<span class="goen-tile__brand">{ t.Brand }</span>
			}
			<h3 class="goen-tile__name">{ t.Name }</h3>
			if len(t.Highlights) > 0 {
				<span class="goen-tile__specs">{ strings.Join(t.Highlights, " · ") }</span>
			}
			@tilePrice(t) {
				if t.SoldOut() {
					<span class="goen-tile__state">{ i18n.T(ctx, i18n.KeySoldOut) }</span>
				}
			}
			if t.HasChoiceOfColour() {
				@tileColours(t)
			}
		</div>
	</a>
}

templ tilePrice(t ProductTile) {
	<span class="goen-tile__price">
		<span class="goen-tile__amount">
			if t.PriceVaries {
				{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFromPrice), t.Price()) }
			} else {
				{ t.Price() }
			}
		</span>
		if t.OnSale() {
			<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyWasPrice) }</span>
			<s class="goen-tile__was">{ t.Compare() }</s>
		}
		{ children... }
	</span>
}

// The colour is a presentation attribute, not a style, so the CSP has nothing to refuse.
templ tileColours(t ProductTile) {
	<span class="goen-tile__colours">
		for _, hex := range t.Dots() {
			<svg class="goen-tile__dot" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
				<circle cx="6" cy="6" r="5.5" fill={ hex }></circle>
			</svg>
		}
		if t.MoreColours() > 0 {
			<span class="goen-tile__more" aria-hidden="true">{ fmt.Sprintf("+%d", t.MoreColours()) }</span>
		}
		<span class="goen-sr-only">{ i18n.Count(ctx, i18n.KeyColourCount, int64(len(t.Colours)), len(t.Colours)) }</span>
	</span>
}

templ Tile(t ProductTile) {
	<li class="goen-tile__cell">
		@tileCard(t)
	</li>
}
