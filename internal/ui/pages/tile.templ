package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
)

// compareForm submits the ticked slugs to /compare. A GET, because a
// comparison writes nothing — the set is the URL and there is no state to keep.
templ compareForm() {
	<form class="goen-compare-pick" method="get" action="/compare">
		{ children... }
		<div class="goen-compare-pick__go">
			@components.Button(components.ButtonProps{
				Variant: components.VariantOutline,
				Size:    components.SizeSmall,
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyCompareSelected) }
			}
			<span class="goen-compare-pick__note">{ i18n.T(ctx, i18n.KeyCompareLimit) }</span>
		</div>
	</form>
}

// tileCard is the product card body. Tile wraps it in the grid cell; the
// wishlist wraps the same body in one list item with its remove form.
templ tileCard(t ProductTile) {
	if t.Comparable {
		// Outside the card, never inside: the whole card is one link, and a
		// control nested in an anchor is neither clickable nor valid.
		<label class="goen-tile__compare">
			<input type="checkbox" name="p" value={ t.Slug } class="goen-check" aria-label={ t.CompareLabel(ctx) }/>
			<span aria-hidden="true">{ i18n.T(ctx, i18n.KeyCompareAdd) }</span>
		</label>
	}
	<a class="goen-tile" href={ templ.URL("/p/" + t.Slug) }>
		<div class="goen-tile__media">
			if t.HasImage() {
				<img
					class="goen-tile__img"
					src={ t.ImageURL }
					srcset={ t.ImageSrcset }
					sizes="(min-width: 1344px) 286px, (min-width: 1024px) calc((100vw - 136px) / 4), (min-width: 768px) calc((100vw - 96px) / 3), calc((100vw - 48px) / 2)"
					alt={ t.ImageAlt }
					if t.HasImageDimensions() {
						width={ t.ImageWidthText() }
						height={ t.ImageHeightText() }
					}
					loading="lazy"
					decoding="async"
				/>
			} else {
				<span class="goen-tile__ph" aria-hidden="true"></span>
			}
			if t.SoldOut() {
				@components.Badge(components.BadgeProps{Tone: components.ToneDanger, Class: "goen-tile__flag"}) {
					{ i18n.T(ctx, i18n.KeySoldOut) }
				}
			} else if t.OnSale() {
				@components.Badge(components.BadgeProps{Tone: components.ToneAccent, Class: "goen-tile__flag"}) {
					{ i18n.T(ctx, i18n.KeyOnSale) }
				}
			}
		</div>
		<div class="goen-tile__body">
			<span class="goen-tile__brand">{ t.Brand }</span>
			<h3 class="goen-tile__name">{ t.Name }</h3>
			if t.HasReviews() {
				<span class="goen-tile__rating">
					@icons.Star()
					<span aria-hidden="true">{ t.RatingText() }</span>
					<span aria-hidden="true">({ t.ReviewCountText() })</span>
					<span class="goen-sr-only">{ t.RatingLabel(ctx) }</span>
				</span>
			}
			<span class="goen-tile__price">
				<span>
					if t.PriceVaries {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFromPrice), t.Price()) }
					} else {
						{ t.Price() }
					}
				</span>
				if t.OnSale() {
					<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyWasPrice) }</span>
					<s class="goen-tile__was">{ t.Compare() }</s>
				}
			</span>
		</div>
	</a>
}

// Tile is one product card; the whole card is a single link.
templ Tile(t ProductTile) {
	<li class="goen-tile__cell">
		@tileCard(t)
	</li>
}
