package pages

import (
	"github.com/koopa0/goen/internal/fieldrule"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Contact(p layouts.Page, f ContactForm) {
	@layouts.Base(p) {
		<div class="contact">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyContactTitle) }</h1>
				<p class="goen-pagehead__sub">{ i18n.T(ctx, i18n.KeyContactHours) }</p>
			</div>
			<div class="contact__layout">
				@ContactPanel(f)
				<aside class="contact__aside">
					<div class="contact__methods">
						@contactMethod("mailto:"+layouts.ContactEmail, i18n.T(ctx, i18n.KeyFieldEmail), layouts.ContactEmail) {
							@icons.Mail()
						}
					</div>
				</aside>
			</div>
		</div>
	}
}

templ contactMethod(href, label, value string) {
	<a class="contact-method" href={ templ.URL(href) }>
		<span class="contact-method__icon">
			{ children... }
		</span>
		<span class="contact-method__text">
			<span class="contact-method__label">{ label }</span>
			<span class="contact-method__value">{ value }</span>
		</span>
	</a>
}

// The two banners are written here, not through the notice component: the layout
// gate reads the refusal's sentence through a descendant pair
// (scripts/check-layout.mjs).
templ ContactPanel(f ContactForm) {
	if f.Done {
		<div class="goen-card contact__panel contact__panel--done" role="status" id="contact-form">
			<span class="contact__donemark" aria-hidden="true">
				@icons.CheckCircle()
			</span>
			<div class="ui-alert__body">
				<strong>{ i18n.T(ctx, i18n.KeyContactSent) }</strong>
				{ i18n.T(ctx, i18n.KeyContactSentBody) }
				<p><a href="/">{ i18n.T(ctx, i18n.KeyBackToShop) }</a></p>
				if f.SignedIn {
					<p><a href="/account#orders-heading">{ i18n.T(ctx, i18n.KeyContactMyOrders) }</a></p>
				}
			</div>
		</div>
	} else {
		<form
			class="contact__panel"
			id="contact-form"
			method="post"
			action="/contact"
			hx-post="/contact"
			hx-target="this"
			hx-swap="outerHTML"
		>
			<h2 class="contact__formtitle">{ i18n.T(ctx, i18n.KeyContactFormTitle) }</h2>
			if f.err("") != "" {
				<p class="goen-notice goen-notice--danger ui-alert--error" role="alert">
					<span class="ui-alert__body">{ f.err("") }</span>
				</p>
			} else if f.hasFieldErrors() {
				<p class="goen-notice goen-notice--danger ui-alert--error" role="alert">
					<span class="ui-alert__body">{ i18n.T(ctx, i18n.KeyContactFormErrors) }</span>
				</p>
			}
			<div class="contact__fields">
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "contact-name"}) {
						{ i18n.T(ctx, i18n.KeyFieldFullName) }
						<span class="contact__req" aria-hidden="true">*</span>
					}
					@components.Input(components.FieldProps{
						ID:        "contact-name",
						Name:      "name",
						Type:      "text",
						Value:     f.Name,
						Invalid:   f.err("name") != "",
						Describes: f.describedBy("name"),
						Attrs: templ.Attributes{
							"autocomplete": "name",
							"maxlength":    "80",
							"placeholder":  i18n.T(ctx, i18n.KeyNamePlaceholder),
							"required":     true,
						},
					})
					if f.err("name") != "" {
						<span class="ui-error-text" id={ errorID("name") }>{ f.err("name") }</span>
					}
				</div>
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "contact-email"}) {
						{ i18n.T(ctx, i18n.KeyFieldEmail) }
						<span class="contact__req" aria-hidden="true">*</span>
					}
					@components.Input(components.FieldProps{
						ID:        "contact-email",
						Name:      "email",
						Type:      "email",
						Value:     f.Email,
						Invalid:   f.err("email") != "",
						Describes: f.describedBy("email"),
						Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
							"autocomplete": "email",
							"maxlength":    "254",
							"placeholder":  "you@example.com",
							"required":     true,
						}, fieldrule.Message(i18n.KeyEmailMalformed), fieldrule.ErrorID(errorID("email"))),
					})
					if f.err("email") != "" {
						<span class="ui-error-text" id={ errorID("email") }>{ f.err("email") }</span>
					}
				</div>
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "contact-subject"}) {
						{ i18n.T(ctx, i18n.KeyFieldSubject) }
					}
					<select
						class="contact__select"
						id="contact-subject"
						name="subject"
						if f.err("subject") != "" {
							aria-invalid="true"
							aria-describedby={ f.describedBy("subject") }
						}
					>
						for _, s := range f.Subjects {
							<option value={ s.Value } selected?={ s.Value == f.Subject }>{ s.Label }</option>
						}
					</select>
					if f.err("subject") != "" {
						<span class="ui-error-text" id={ errorID("subject") }>{ f.err("subject") }</span>
					}
				</div>
				<div class="goen-field">
					@components.Label(components.LabelProps{For: "contact-order"}) {
						{ i18n.T(ctx, i18n.KeyFieldOrderRefOpt) }
					}
					@components.Input(components.FieldProps{
						ID:        "contact-order",
						Name:      "order_ref",
						Type:      "text",
						Value:     f.OrderRef,
						Invalid:   f.err("order_ref") != "",
						Describes: f.describedBy("order_ref"),
						Class:     "contact__ref",
						Attrs: templ.Attributes{
							"maxlength":   "32",
							"placeholder": i18n.T(ctx, i18n.KeyOrderRefPlaceholder),
						},
					})
					if f.err("order_ref") != "" {
						<span class="ui-error-text" id={ errorID("order_ref") }>{ f.err("order_ref") }</span>
					}
				</div>
				<div class="goen-field contact__field--wide">
					@components.Label(components.LabelProps{For: "contact-message"}) {
						{ i18n.T(ctx, i18n.KeyFieldMessage) }
						<span class="contact__req" aria-hidden="true">*</span>
					}
					@components.Textarea(components.FieldProps{
						ID:        "contact-message",
						Name:      "message",
						Invalid:   f.err("message") != "",
						Describes: f.describedBy("message"),
						Class:     "contact__message",
						Attrs: templ.Attributes{
							"maxlength":   "2000",
							"minlength":   "5",
							"placeholder": i18n.T(ctx, i18n.KeyMessagePlaceholder),
							"required":    true,
						},
					}) {
						{ f.Message }
					}
					if f.err("message") != "" {
						<span class="ui-error-text" id={ errorID("message") }>{ f.err("message") }</span>
					}
				</div>
			</div>
			@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge, Class: "contact__submit", Attrs: templ.Attributes{"id": "contact-submit"}}, "submit") {
				{ i18n.T(ctx, i18n.KeyContactSubmit) }
			}
		</form>
	}
}
