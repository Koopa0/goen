package pages

import (
	"fmt"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Home renders the storefront home page: a carousel of what is on now, the
// departments, one product row, one department on its own ground, one
// photograph, and what the shop guarantees.
templ Home(p layouts.Page, v HomeView) {
	@layouts.Base(p) {
		<h1 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyHomeHeading) }</h1>
		if len(v.Slides) > 0 {
			@heroCarousel(v.Slides)
		}
		<div class="goen-home">
			<section class="goen-home__section" aria-labelledby="cats-heading">
				<div class="goen-home__head">
					<h2 id="cats-heading" class="goen-home__heading">{ i18n.T(ctx, i18n.KeySectionCategories) }</h2>
				</div>
				<ul class="goen-cats__grid" role="list">
					for _, c := range v.Categories {
						<li>
							<a class="goen-cat" data-tone={ c.Tone.Attr() } href={ templ.URL("/c/" + c.Slug) }>
								<span class="goen-cat__well">
									if c.Photo.Shown() {
										// The name below is the label, so the photograph is decoration.
										<img
											class="goen-cat__photo"
											src={ c.Photo.URL }
											srcset={ c.Photo.Srcset }
											sizes="(min-width: 1024px) 200px, 33vw"
											alt=""
											width="800"
											height="600"
											loading="lazy"
											decoding="async"
										/>
									}
								</span>
								<span class="goen-cat__name">{ c.Name }</span>
							</a>
						</li>
					}
				</ul>
			</section>
			if len(v.Row.Tiles) > 0 {
				<section class="goen-home__section" aria-labelledby="row-heading">
					<div class="goen-home__head">
						@heading("row-heading", v.Row.Title, v.Row.Fact)
						@seeAll(i18n.T(ctx, i18n.KeyHomeSeeAll), v.Row.Href)
					</div>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.Row.Tiles {
							@Tile(t)
						}
					</ul>
				</section>
			}
		</div>
		if v.Band != nil {
			<section class="goen-band" data-tone={ v.Band.Tone.Attr() } aria-labelledby="band-heading">
				<div class="goen-container goen-band__grid">
					<div class="goen-band__media">
						if v.Band.Photo.Shown() {
							<img
								src={ v.Band.Photo.URL }
								srcset={ v.Band.Photo.Srcset }
								sizes="(min-width: 1024px) 40vw, 100vw"
								alt=""
								width="800"
								height="600"
								loading="lazy"
								decoding="async"
							/>
						}
					</div>
					<div class="goen-band__body">
						<div class="goen-home__head">
							@heading("band-heading", v.Band.Name, v.Band.Fact)
							@seeAll(fmt.Sprintf(i18n.T(ctx, i18n.KeyHomeDepartmentCTA), v.Band.Name), v.Band.Href)
						</div>
						<ul class="goen-band__tiles" role="list">
							for _, t := range v.Band.Tiles {
								@Tile(t)
							}
						</ul>
					</div>
				</div>
			</section>
		}
		<section class="goen-container goen-home__section goen-promo-photo" aria-labelledby="promo-heading">
			<a class="goen-promo-photo__link" href={ templ.URL(v.PromoHref()) }>
				<div class="goen-promo-photo__media">
					// The title below is the link's label, so the photograph is decoration.
					<img
						src={ assets.URL(assets.PromoDesk) }
						srcset={ assets.PromoDeskSrcset() }
						sizes="(min-width: 1344px) 1280px, 100vw"
						alt=""
						width="1600"
						height="667"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="goen-promo-photo__caption">
					<h2 id="promo-heading" class="goen-home__heading">{ i18n.T(ctx, i18n.KeyHomePromoTitle) }</h2>
					<span class="goen-home__more">
						{ i18n.T(ctx, i18n.KeyHomePromoLink) }
						<span aria-hidden="true">&nbsp;→</span>
					</span>
				</div>
			</a>
		</section>
		<section class="goen-trust" aria-labelledby="trust-heading">
			<h2 id="trust-heading" class="goen-sr-only">{ i18n.T(ctx, i18n.KeySectionTrust) }</h2>
			<div class="goen-container goen-trust__grid">
				@incentive(icons.Shield(), i18n.T(ctx, i18n.KeyGuaranteeWarranty), i18n.T(ctx, i18n.KeyTrustWarrantyBody))
				if v.FreeDelivery() != "" {
					@incentive(icons.Truck(), fmt.Sprintf(i18n.T(ctx, i18n.KeyGuaranteeShipping), v.FreeDelivery()), fmt.Sprintf(i18n.T(ctx, v.ShippingBodyKey()), v.LowestFee()))
				}
				@incentive(icons.Return(), i18n.T(ctx, i18n.KeyGuaranteeReturns), i18n.T(ctx, i18n.KeyTrustReturnsBody))
				@incentive(icons.Lock(), i18n.T(ctx, i18n.KeyTrustPayment), i18n.T(ctx, i18n.KeyTrustPaymentBody))
			</div>
		</section>
	}
}

// heading is a section name in ink, then a short grey continuation on the same
// line; it may wrap on a narrow screen.
templ heading(id, name, rest string) {
	if rest == "" {
		<h2 id={ id } class="goen-home__heading">{ name }</h2>
	} else {
		<h2 id={ id } class="goen-home__heading">{ name }<span class="goen-home__aside">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyHomeAside), rest) }</span></h2>
	}
}

templ seeAll(label, href string) {
	<a class="goen-home__more" href={ templ.URL(href) }>
		{ label }
		<span aria-hidden="true">&nbsp;→</span>
	</a>
}

// heroCarousel is native scroll-snap with arrows and dots on top. With one
// slide there is nothing to move between, so the controls are not drawn.
templ heroCarousel(slides []HeroSlide) {
	<section class="goen-hero" aria-roledescription="carousel" aria-label={ i18n.T(ctx, i18n.KeyHomeFeatured) }>
		<div class="goen-hero__track">
			for i, s := range slides {
				<div
					class={ "goen-hero__slide goen-hero__slide--" + string(s.Layout) }
					data-tone={ s.Tone.Attr() }
					role="group"
					aria-roledescription="slide"
					aria-label={ fmt.Sprintf("%d / %d", i+1, len(slides)) }
				>
					<div class="goen-hero__media">
						if s.Photo.Shown() {
							<img
								src={ s.Photo.URL }
								srcset={ s.Photo.Srcset }
								sizes={ s.PhotoSizes() }
								alt={ s.Photo.Alt }
								if s.HasPhotoSize() {
									width={ s.PhotoWidthText() }
									height={ s.PhotoHeightText() }
								}
								decoding="async"
								if i == 0 {
									fetchpriority="high"
								}
							/>
						}
					</div>
					<div class="goen-hero__body">
						<div class="goen-hero__inner">
							<h2 class="goen-hero__title">{ s.Title }</h2>
							if s.Fact != "" {
								<p class="goen-hero__lede">{ s.Fact }</p>
							}
							if s.CTA.Shown() {
								<div class="goen-hero__actions">
									// ui-btn is kept beside the goen- recipe: the home page's
									// tap sweep is `.goen-cat` plus `.goen-hero__actions .ui-btn`
									// (check-layout.mjs), and dropping the name would stop the
									// button being measured.
									<a class="goen-btn goen-btn--primary goen-btn--lg ui-btn" href={ templ.SafeURL(s.CTA.Href) }>{ s.CTA.Label }</a>
								</div>
							}
						</div>
					</div>
				</div>
			}
		</div>
		if len(slides) > 1 {
			<div class="goen-hero__controls">
				<div class="goen-hero__dots">
					for i, s := range slides {
						<button class="goen-hero__dot" type="button" aria-label={ s.Title } aria-current={ fmt.Sprint(i == 0) }></button>
					}
				</div>
				<div class="goen-hero__arrows">
					<button class="goen-hero__arrow" type="button" data-step="-1" aria-label={ i18n.T(ctx, i18n.KeyHeroPrevious) }>
						@icons.ChevronLeft()
					</button>
					<button class="goen-hero__arrow" type="button" data-step="1" aria-label={ i18n.T(ctx, i18n.KeyHeroNext) }>
						@icons.ChevronRight()
					</button>
				</div>
			</div>
		}
	</section>
}

templ incentive(icon templ.Component, title, desc string) {
	<div class="goen-trust__item">
		<div class="goen-trust__head">
			<span class="goen-trust__icon">
				@icon
			</span>
			<h3 class="goen-trust__title">{ title }</h3>
		</div>
		<p class="goen-trust__body">{ desc }</p>
	</div>
}
