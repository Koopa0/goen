package pages

import (
	"fmt"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Home renders the storefront home page: a hero band, the top-level category
// tiles, the recommended product grid, and the shopping-guarantee strip.
//
// The product card, price, rating and guarantee strip are the design system's
// commerce pack (ui-product, ui-price, ui-rating, ui-incentives) rather than
// classes of goen's own — a second product card is how two visual languages
// start. goen-* here is page composition only: the grids, the hero split, and
// the responsive fold from the 1440 and 375 artboards into one document.
//
templ Home(p layouts.Page, v HomeView) {
	@layouts.Base(p) {
		<div class="goen-home">
			<section class="goen-hero" aria-labelledby="hero-heading">
				<div class="goen-hero__body">
					if v.Hero.Eyebrow != "" {
						<span class="ui-badge ui-badge--brand">{ v.Hero.Eyebrow }</span>
					}
					<h1 id="hero-heading" class="h1 goen-hero__title">{ v.Hero.Headline }</h1>
					if v.Hero.Body != "" {
						<p class="goen-hero__lede">{ v.Hero.Body }</p>
					}
					<div class="goen-hero__actions">
						if v.Hero.PrimaryCTA.Shown() {
							<a class="ui-btn ui-btn--primary ui-btn--lg" href={ templ.SafeURL(v.Hero.PrimaryCTA.Href) }>
								{ v.Hero.PrimaryCTA.Label }
							</a>
						}
						if v.Hero.SecondaryCTA.Shown() {
							<a class="ui-btn ui-btn--secondary ui-btn--lg" href={ templ.SafeURL(v.Hero.SecondaryCTA.Href) }>
								{ v.Hero.SecondaryCTA.Label }
							</a>
						}
					</div>
				</div>
				<div class="goen-hero__media">
					if v.Hero.Custom() {
						// An uploaded hero. alt carries the editor's words —
						// hero_slides_image_has_alt makes an image without them
						// impossible to store.
						<img
							class="goen-hero__image"
							src={ assets.MediaURL(v.Hero.ImageKey) }
							srcset={ assets.ProductImageSrcsetAt(v.Hero.ImageKey, v.Hero.ImageWidth) }
							sizes="(min-width: 1344px) 640px, (min-width: 1024px) calc((100vw - 64px) / 2), (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)"
							alt={ v.Hero.ImageAlt }
							decoding="async"
							fetchpriority="high"
						/>
					} else if assets.Has(assets.HomeHeroImage) {
						// The built-in artwork. alt is empty on purpose: the
						// headline beside it already says what this is, and a
						// screen reader repeating it is noise.
						<img
							class="goen-hero__image"
							src={ assets.URL(assets.HomeHeroImage) }
							srcset={ assets.HomeHeroSrcset() }
							sizes="(min-width: 1344px) 640px, (min-width: 1024px) calc((100vw - 64px) / 2), (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)"
							alt=""
							width="1440"
							height="900"
							decoding="async"
							fetchpriority="high"
						/>
					} else {
						<span class="goen-ph">{ i18n.T(ctx, i18n.KeyHeroPlaceholder) }</span>
					}
				</div>
			</section>
			<section class="goen-cats" aria-labelledby="cats-heading">
				<h2 id="cats-heading" class="h3 goen-section__title">{ i18n.T(ctx, i18n.KeySectionCategories) }</h2>
				<ul class="goen-cats__grid" role="list">
					for _, c := range v.Categories {
						<li>
							<a class="goen-cat" href={ templ.URL("/c/" + c.Slug) }>
								<span class="goen-cat__icon">
									@icons.Category(c.IconKey)
								</span>
								<span class="goen-cat__name">{ c.Name }</span>
							</a>
						</li>
					}
				</ul>
			</section>
			<section class="goen-tiles" aria-labelledby="rec-heading">
				<h2 id="rec-heading" class="h3 goen-section__title">{ i18n.T(ctx, i18n.KeySectionRecommended) }</h2>
				<ul class="goen-tiles__grid" role="list">
					for _, t := range v.Recommended {
						@Tile(t)
					}
				</ul>
			</section>
			<section class="goen-trust" aria-labelledby="trust-heading">
				<h2 id="trust-heading" class="goen-sr-only">{ i18n.T(ctx, i18n.KeySectionTrust) }</h2>
				<div class="ui-incentives">
					@incentive(icons.Shield(), i18n.T(ctx, i18n.KeyGuaranteeWarranty), i18n.T(ctx, i18n.KeyTrustWarrantyBody))
					if v.FreeDelivery() != "" {
						@incentive(icons.Truck(), fmt.Sprintf(i18n.T(ctx, i18n.KeyGuaranteeShipping), v.FreeDelivery()), i18n.T(ctx, i18n.KeyTrustShippingBody))
					}
					@incentive(icons.Return(), i18n.T(ctx, i18n.KeyGuaranteeReturns), i18n.T(ctx, i18n.KeyTrustReturnsBody))
					@incentive(icons.Lock(), i18n.T(ctx, i18n.KeyTrustPayment), i18n.T(ctx, i18n.KeyTrustPaymentBody))
				</div>
			</section>
		</div>
	}
}

// incentive is one cell of the shopping-guarantee strip.
templ incentive(icon templ.Component, title, desc string) {
	<div class="ui-incentive">
		<span class="ui-incentive__icon">
			@icon
		</span>
		<div>
			<h3 class="ui-incentive__title">{ title }</h3>
			<p class="ui-incentive__desc">{ desc }</p>
		</div>
	</div>
}
