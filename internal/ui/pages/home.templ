package pages

import (
	"fmt"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Home renders the storefront home page: the hero, the departments, what the
// shop recommends, one promotional band, and what it guarantees.
templ Home(p layouts.Page, v HomeView) {
	@layouts.Base(p) {
		<div class="goen-home">
			<section class="goen-hero" aria-labelledby="hero-heading">
				<div class="goen-hero__body">
					<h1 id="hero-heading" class="goen-hero__title">{ v.Hero.Headline }</h1>
					if v.Hero.Body != "" {
						<p class="goen-hero__lede">{ v.Hero.Body }</p>
					}
					<div class="goen-hero__actions">
						if v.Hero.PrimaryCTA.Shown() {
							// ui-btn is kept beside the goen- recipe on these two: the
							// home page's whole tap sweep is `.goen-cat` plus
							// `.goen-hero__actions .ui-btn` (check-layout.mjs:479), and
							// dropping the name would stop the buttons being measured.
							<a class="goen-btn goen-btn--primary goen-btn--lg ui-btn" href={ templ.SafeURL(v.Hero.PrimaryCTA.Href) }>
								{ v.Hero.PrimaryCTA.Label }
							</a>
						}
						if v.Hero.SecondaryCTA.Shown() {
							<a class="goen-btn goen-btn--outline goen-btn--lg ui-btn" href={ templ.SafeURL(v.Hero.SecondaryCTA.Href) }>
								{ v.Hero.SecondaryCTA.Label }
							</a>
						}
					</div>
				</div>
				<div class="goen-hero__media">
					if v.Hero.Custom() {
						<img
							class="goen-hero__image"
							src={ assets.MediaURL(v.Hero.ImageKey) }
							srcset={ assets.ProductImageSrcsetAt(v.Hero.ImageKey, v.Hero.ImageWidth) }
							sizes="(min-width: 1344px) 1280px, (min-width: 1024px) calc(100vw - 64px), (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)"
							alt={ v.Hero.ImageAlt }
							if v.Hero.HasImageDimensions() {
								width={ v.Hero.ImageWidthText() }
								height={ v.Hero.ImageHeightText() }
							}
							decoding="async"
							fetchpriority="high"
						/>
					} else if assets.Has(assets.HomeHeroImage) {
						<img
							class="goen-hero__image"
							src={ assets.URL(assets.HomeHeroImage) }
							srcset={ assets.HomeHeroSrcset() }
							sizes="(min-width: 1344px) 1280px, (min-width: 1024px) calc(100vw - 64px), (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)"
							alt={ i18n.T(ctx, i18n.KeyHeroImageAlt) }
							width="1440"
							height="720"
							decoding="async"
							fetchpriority="high"
						/>
					} else {
						<span class="goen-ph">{ i18n.T(ctx, i18n.KeyHeroPlaceholder) }</span>
					}
				</div>
			</section>
			<section class="goen-home__section" aria-labelledby="cats-heading">
				<h2 id="cats-heading" class="goen-home__heading">{ i18n.T(ctx, i18n.KeySectionCategories) }</h2>
				<ul class="goen-cats__grid" role="list">
					for _, c := range v.Categories {
						<li>
							<a class="goen-cat" href={ templ.URL("/c/" + c.Slug) }>
								if src, srcset, ok := assets.CategoryImage(c.Slug); ok {
									// The name below is the label, so the photograph is decoration.
									<img
										class="goen-cat__photo"
										src={ src }
										srcset={ srcset }
										sizes="(min-width: 1024px) 200px, 33vw"
										alt=""
										width="800"
										height="800"
										loading="lazy"
										decoding="async"
									/>
								} else {
									<span class="goen-cat__icon">
										@icons.Category(c.IconKey)
									</span>
								}
								<span class="goen-cat__name">{ c.Name }</span>
							</a>
						</li>
					}
				</ul>
			</section>
			<section class="goen-home__section" aria-labelledby="rec-heading">
				<div class="goen-home__head">
					<h2 id="rec-heading" class="goen-home__heading">{ i18n.T(ctx, i18n.KeySectionRecommended) }</h2>
					<a class="goen-home__more" href="/search">
						{ i18n.T(ctx, i18n.KeyHomeSeeAll) }
						<span aria-hidden="true">→</span>
					</a>
				</div>
				<ul class="goen-tiles__grid" role="list">
					for _, t := range v.Recommended {
						@Tile(t)
					}
				</ul>
			</section>
			<section class="goen-promoband" aria-labelledby="promoband-heading">
				<div class="goen-promoband__body">
					<h2 id="promoband-heading" class="goen-promoband__title">{ i18n.T(ctx, i18n.KeyHomePromoTitle) }</h2>
					<a class="goen-home__more" href={ templ.URL(v.PromoHref()) }>
						{ i18n.T(ctx, i18n.KeyHomePromoLink) }
						<span aria-hidden="true">→</span>
					</a>
				</div>
				// The title is the band's label, so the photograph is decoration.
				<img
					class="goen-promoband__image"
					src={ assets.URL(assets.PromoDesk) }
					srcset={ assets.PromoDeskSrcset() }
					sizes="(min-width: 1344px) 768px, (min-width: 768px) 60vw, calc(100vw - 32px)"
					alt=""
					width="1600"
					height="667"
					loading="lazy"
					decoding="async"
				/>
			</section>
			<section class="goen-trust" aria-labelledby="trust-heading">
				<h2 id="trust-heading" class="goen-sr-only">{ i18n.T(ctx, i18n.KeySectionTrust) }</h2>
				<div class="goen-trust__grid">
					@incentive(icons.Shield(), i18n.T(ctx, i18n.KeyGuaranteeWarranty), i18n.T(ctx, i18n.KeyTrustWarrantyBody))
					if v.FreeDelivery() != "" {
						@incentive(icons.Truck(), fmt.Sprintf(i18n.T(ctx, i18n.KeyGuaranteeShipping), v.FreeDelivery()), fmt.Sprintf(i18n.T(ctx, i18n.KeyTrustShippingBody), v.LowestFee()))
					}
					@incentive(icons.Return(), i18n.T(ctx, i18n.KeyGuaranteeReturns), i18n.T(ctx, i18n.KeyTrustReturnsBody))
					@incentive(icons.Lock(), i18n.T(ctx, i18n.KeyTrustPayment), i18n.T(ctx, i18n.KeyTrustPaymentBody))
				</div>
			</section>
		</div>
	}
}

templ incentive(icon templ.Component, title, desc string) {
	<div class="goen-trust__item">
		<div class="goen-trust__head">
			<span class="goen-trust__icon">
				@icon
			</span>
			<h3 class="goen-trust__title">{ title }</h3>
		</div>
		<p class="goen-trust__body">{ desc }</p>
	</div>
}
