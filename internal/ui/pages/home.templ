package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Home(p layouts.Page, v HomeView) {
	@layouts.Base(p) {
		<h1 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyHomeHeading) }</h1>
		if len(v.Slides) > 0 {
			@heroCarousel(v.Slides)
		}
		<div class="goen-home">
			@departmentDirectory(v.Categories, v.Directory())
			@productRow(v.Row)
		</div>
		if v.Band != nil {
			@departmentBand(v.Band)
		}
		<div class="goen-home">
			@shopRules(v.Rules)
		</div>
	}
}

templ heading(id, name string) {
	<h2 id={ id } class="goen-home__heading">{ name }</h2>
}

templ seeAll(label, href string) {
	<a class="goen-home__more" href={ templ.URL(href) }>
		{ label }
		<span aria-hidden="true">&nbsp;→</span>
	</a>
}

// The carousel moves only when the visitor asks: the named tabs are links to
// the slides, and the arrows and the count are drawn by goen.js. With one slide
// there is nothing to move between, so none of them are drawn.
templ heroCarousel(slides []HeroSlide) {
	<section
		class="goen-hero"
		aria-label={ i18n.T(ctx, i18n.KeyHomeFeatured) }
		if len(slides) > 1 {
			aria-roledescription="carousel"
		}
	>
		<div class="goen-hero__track">
			for i, s := range slides {
				<article
					id={ fmt.Sprintf("hero-%d", i+1) }
					class={ "goen-hero__slide goen-hero__slide--" + string(s.Layout), templ.KV("goen-hero__slide--text", !s.Photo.Shown()) }
					data-tone={ s.Tone.Attr() }
					if len(slides) > 1 {
						aria-roledescription="slide"
						aria-label={ fmt.Sprintf("%d / %d", i+1, len(slides)) }
					}
				>
					<div class="goen-hero__body">
						<div class="goen-hero__inner">
							<h2 class={ "goen-hero__title", templ.KV("goen-hero__title--long", s.TitleLong(i18n.FromContext(ctx))) }>{ s.Title }</h2>
							if s.Fact != "" {
								<p class="goen-hero__lede">{ s.Fact }</p>
							}
							@components.StatLine(s.Stats, components.StatLinePlain)
							if s.Period != nil {
								@components.Period(*s.Period)
							}
							if s.CTA.Shown() {
								<div class="goen-hero__actions">
									// ui-btn stays beside the goen- recipe: the home page's tap sweep (check-layout.mjs)
									// measures `.goen-hero__actions .ui-btn`.
									<a class="goen-btn goen-btn--primary goen-btn--lg ui-btn" href={ templ.SafeURL(s.CTA.Href) }>{ s.CTA.Label }</a>
								</div>
							}
						</div>
					</div>
					if s.Photo.Shown() {
						<div class="goen-hero__media">
							<img
								src={ s.Photo.URL }
								srcset={ s.Photo.Srcset }
								sizes={ s.PhotoSizes() }
								alt={ s.Photo.Alt }
								if s.HasPhotoSize() {
									width={ s.PhotoWidthText() }
									height={ s.PhotoHeightText() }
								}
								decoding="async"
								if i == 0 {
									fetchpriority="high"
								}
							/>
						</div>
					}
				</article>
			}
		</div>
		if len(slides) > 1 {
			<div class="goen-hero__controls">
				<nav class="goen-hero__tabs" aria-label={ i18n.T(ctx, i18n.KeySlides) }>
					for i, s := range slides {
						<a
							href={ templ.SafeURL(fmt.Sprintf("#hero-%d", i+1)) }
							if i == 0 {
								aria-current="true"
							}
						>{ s.Title }</a>
					}
				</nav>
				<div class="goen-hero__nav" data-js hidden>
					<span class="goen-sr-only" data-count aria-live="polite">{ fmt.Sprintf("1 / %d", len(slides)) }</span>
					<button class="goen-hero__arrow" type="button" data-step="-1" aria-label={ i18n.T(ctx, i18n.KeyHeroPrevious) }>
						@icons.ChevronLeft()
					</button>
					<button class="goen-hero__arrow" type="button" data-step="1" aria-label={ i18n.T(ctx, i18n.KeyHeroNext) }>
						@icons.ChevronRight()
					</button>
				</div>
			</div>
		}
	</section>
}

templ departmentBand(b *DepartmentBand) {
	{{ photo, onWell := bandPhoto(b.Photo, b.Tiles) }}
	<section class="goen-band" data-tone={ b.Tone.Attr() } aria-labelledby="band-heading">
		<div class="goen-band__grid">
			if photo.Shown() {
				@bandMedia("goen-band__photo", Photo{URL: photo.URL, Srcset: photo.Srcset}, onWell, "(min-width: 1024px) 42vw, 100vw", true)
			}
			<div class="goen-band__body">
				<div class="goen-home__head">
					@bandHeading("band-heading", b.Name, b.Fact)
					@seeAll(i18n.Count(ctx, i18n.KeyHomeSeeAllCount, b.Items, b.Items), b.Href)
				</div>
				<ul class="goen-band__tiles" role="list">
					for _, t := range b.Tiles {
						@Tile(t)
					}
				</ul>
			</div>
		</div>
	</section>
}

templ departmentDirectory(cats []HomeCategory, layout DirectoryLayout) {
	if layout != DirectoryNone {
		<section class="goen-home__section" aria-labelledby="cats-heading">
			<div class="goen-home__head">
				@heading("cats-heading", i18n.T(ctx, i18n.KeySectionCategories))
			</div>
			<ul class={ "goen-cats__grid", "goen-cats__grid--" + string(layout) } role="list">
				for _, c := range cats {
					<li>
						if layout == DirectoryTiles {
							@departmentTile(c)
						} else {
							@departmentRow(c, layout == DirectoryRows)
						}
					</li>
				}
			</ul>
		</section>
	}
}

templ departmentTile(c HomeCategory) {
	<a class="goen-cat" data-tone={ c.Tone.Attr() } href={ templ.URL("/c/" + c.Slug) }>
		<span class="goen-cat__well">
			if c.Photo.Shown() {
				<img
					class="goen-cat__photo"
					src={ c.Photo.URL }
					srcset={ c.Photo.Srcset }
					sizes="(min-width: 704px) 50vw, 100vw"
					alt=""
					width="800"
					height="600"
					decoding="async"
				/>
			} else {
				<span class="goen-cat__mark" aria-hidden="true">{ c.Initial() }</span>
			}
		</span>
		<span class="goen-cat__line">
			<span class="goen-cat__name">{ c.Name }</span>
			<span class="goen-cat__count">{ i18n.Count(ctx, i18n.KeyUnitItems, c.Items, c.Items) }</span>
		</span>
	</a>
}

// With a stage the photograph is both the row's thumbnail and, from 1024px, the
// picture the list switches between, so no department is fetched twice.
templ departmentRow(c HomeCategory, stage bool) {
	<a class="goen-cat" data-tone={ c.Tone.Attr() } href={ templ.URL("/c/" + c.Slug) }>
		if c.Photo.Shown() {
			<img
				class="goen-cat__photo"
				src={ c.Photo.URL }
				srcset={ c.Photo.Srcset }
				if stage {
					sizes="(min-width: 1024px) 40vw, 4rem"
				} else {
					sizes="5rem"
				}
				alt=""
				width="800"
				height="600"
				decoding="async"
			/>
		} else {
			<span class="goen-cat__mark" aria-hidden="true">{ c.Initial() }</span>
			if stage {
				<span class="goen-cat__stage" aria-hidden="true">{ c.Name }</span>
			}
		}
		<span class="goen-cat__name">{ c.Name }</span>
		if c.Subs != "" {
			<span class="goen-cat__subs">{ c.Subs }</span>
		}
		<span class="goen-cat__count">{ i18n.Count(ctx, i18n.KeyUnitItems, c.Items, c.Items) }</span>
		<span class="goen-cat__go" aria-hidden="true">→</span>
	</a>
}

// A running campaign's row is its products and its facts. With a lead the
// first product is the 2×2 tile on the campaign's tone and the facts are the
// eighth cell, a card whose only link is the count; without one the facts stand
// under the heading. With no campaign the row is the newest products.
templ productRow(r ProductRow) {
	if len(r.Tiles) > 0 {
		<section class="goen-home__section" aria-labelledby="row-heading">
			<div class="goen-home__head">
				@heading("row-heading", r.Title)
				if !r.HasLead() {
					if r.Campaign != nil {
						@seeAll(i18n.Count(ctx, i18n.KeyHomeSeeAllCount, r.Campaign.Items, r.Campaign.Items), r.Href)
					} else {
						@seeAll(i18n.T(ctx, i18n.KeyHomeNewInCTA), r.Href)
					}
				}
			</div>
			if r.Campaign != nil && !r.HasLead() {
				<div class="goen-home__facts">
					@components.StatLine(r.Campaign.Facts, components.StatLinePlain)
					if r.Campaign.Period != nil {
						@components.Period(*r.Campaign.Period)
					}
				</div>
			}
			if r.HasLead() {
				<ul class="goen-tiles__grid goen-tiles__grid--lead" data-tone={ r.Campaign.Tone.Attr() } role="list">
					for i, t := range r.Shelf() {
						if i == 0 {
							<li class="goen-tile__cell goen-tile__cell--lead">
								@tileCard(t)
							</li>
						} else {
							@Tile(t)
						}
					}
					<li class="goen-rowcard">
						@components.StatLine(r.Campaign.CardFacts, components.StatLinePlain)
						if r.Campaign.Period != nil {
							@components.Period(*r.Campaign.Period)
						}
						@seeAll(i18n.Count(ctx, i18n.KeyHomeSeeAllCount, r.Campaign.Items, r.Campaign.Items), r.Href)
					</li>
				</ul>
			} else {
				<ul class="goen-tiles__grid" role="list">
					for _, t := range r.Shelf() {
						@Tile(t)
					}
				</ul>
			}
		</section>
	}
}
