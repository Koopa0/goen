package pages

import (
	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
)

// Deliberately not layouts.Base: the header would run a category query for every
// anonymous cross-site POST this route receives. The site stylesheet is linked so
// the hop is goen's own ground colour, not a white flash.
//
// target is built by the cart package from a fixed local path plus encoded query
// values: nothing posted can reach the scheme, the host or the path.
templ PickupReturn(target string) {
	<!DOCTYPE html>
	<html lang={ i18n.FromContext(ctx).Tag() } class="theme-blue">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta http-equiv="refresh" content={ "0; url=" + target }/>
			<title>{ i18n.T(ctx, i18n.KeyPickupReturning) }</title>
			<link rel="icon" type="image/svg+xml" href={ templ.URL(assets.URL(assets.MarkSVG)) }/>
			<link rel="stylesheet" href={ templ.URL(assets.URL(assets.FontsCSS)) }/>
			<link rel="stylesheet" href={ templ.URL(assets.URL(assets.BaseCSS)) }/>
			<link rel="stylesheet" href={ templ.URL(assets.URL(assets.AppCSS)) }/>
		</head>
		<body class="goen-shell">
			<main class="goen-handoff" id="main">
				// Shown after a short delay (stylesheet) so a fast return flashes no text; reduced motion shows it at once.
				<p class="goen-handoff__text">{ i18n.T(ctx, i18n.KeyPickupReturning) }</p>
				<a class="goen-handoff__link" href={ templ.URL(target) }>
					{ i18n.T(ctx, i18n.KeyPickupReturnLink) }
				</a>
			</main>
		</body>
	</html>
}
