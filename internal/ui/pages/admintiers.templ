package pages

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminTiers renders the 會員等級 bands.
templ AdminTiers(p layouts.Page, v AdminTiersView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("tiers")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
					<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageTiers) }</h1>
					<p class="ui-page-head__sub">
						{ i18n.T(ctx, i18n.KeyAdminTierLead) }
					</p>
				</div>
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			if v.Empty() {
				<p class="goen-admin__hint">
					{ i18n.T(ctx, i18n.KeyAdminTierEmpty) }
				</p>
			} else {
				<div class="goen-admin__tablewrap">
					<table class="ui-table goen-admin__table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColBand) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColThreshold) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColRate) }</th>
								<th scope="col">{ i18n.T(ctx, i18n.KeyAdminTierColMembers) }</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for _, t := range v.Rows {
								<tr>
									<td>
										{ t.Name }
										<span class="ui-cart-line__meta">{ t.Code }</span>
									</td>
									<td>{ t.Threshold() }</td>
									<td>{ t.Multiplier(ctx) }</td>
									<td>{ t.MembersText() }</td>
									<td>
										<form method="post" action="/admin/tiers/delete">
											<input type="hidden" name="tier" value={ t.ID }/>
											<button class="ui-btn ui-btn--ghost ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminRemove) }</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminTierAdd) }</h2>
			<form class="goen-admin__form" method="post" action="/admin/tiers">
				<div class="goen-admin__row">
					<div class="ui-field">
						<label class="ui-label" for="tier-code">{ i18n.T(ctx, i18n.KeyAdminColCode) }</label>
						<input class="ui-input" id="tier-code" name="code" required maxlength="30" pattern="[a-z0-9_]+"/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="tier-name">{ i18n.T(ctx, i18n.KeyAdminColName) }</label>
						<input class="ui-input" id="tier-name" name="name" required maxlength="30"/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="tier-name-en">{ i18n.T(ctx, i18n.KeyAdminColNameEn) }</label>
						<input class="ui-input" id="tier-name-en" name="name_en" maxlength="30" placeholder="Silver"/>
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminTierNameEnHint) }
						</p>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="tier-threshold">{ i18n.T(ctx, i18n.KeyAdminTierThreshold) }</label>
						<input class="ui-input" id="tier-threshold" name="threshold" type="number" min="0" step="1" required inputmode="numeric"/>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="tier-percent">{ i18n.T(ctx, i18n.KeyAdminTierRate) }</label>
						<input class="ui-input" id="tier-percent" name="percent" type="number" min="100" max="300" step="1" value="100" required inputmode="numeric"/>
					</div>
				</div>
				<button class="ui-btn ui-btn--primary" type="submit">{ i18n.T(ctx, i18n.KeyAdminAddButton) }</button>
			</form>
		</div>
	}
}
