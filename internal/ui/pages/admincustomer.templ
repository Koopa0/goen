package pages

import "github.com/koopa0/goen/internal/ui/layouts"

// AdminCustomers renders the customer search.
templ AdminCustomers(p layouts.Page, v AdminCustomersView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("customers")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">後台</p>
					<h1 class="ui-page-head__title">顧客</h1>
					<p class="ui-page-head__sub">
						用 Email 或姓名的開頭搜尋。這一頁只在搜尋之後才列出人 ——
						顧客名單不是拿來瀏覽的。
					</p>
				</div>
			</div>
			// A GET form: searching reads and writes nothing.
			<form class="goen-admin__form goen-admin__search" method="get" action="/admin/customers">
				<label class="goen-sr-only" for="customer-search">搜尋顧客</label>
				<input
					class="ui-input"
					id="customer-search"
					type="search"
					name="q"
					value={ v.Term }
					placeholder="Email 或姓名"
					autocomplete="off"
				/>
				<button class="ui-btn ui-btn--secondary" type="submit">搜尋</button>
			</form>
			if v.TermTooShort() {
				<p class="ui-alert ui-alert--warn" role="status">
					搜尋字串太短,至少要兩個字。
				</p>
			}
			if v.Searching() && v.Empty() {
				<p class="goen-admin__hint">找不到符合「{ v.Term }」的顧客。</p>
			}
			if v.Searching() && !v.Empty() {
				<div class="goen-admin__tablewrap">
					<table class="ui-table">
						<thead>
							<tr>
								<th scope="col">顧客</th>
								<th scope="col">Email</th>
								<th scope="col">訂單</th>
								<th scope="col">註冊於</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range v.Rows {
								<tr>
									<td><a href={ templ.SafeURL(c.Href()) }>{ c.DisplayName() }</a></td>
									<td>
										{ c.Email }
										if !c.Verified {
											<span class="ui-badge ui-badge--warn">未確認</span>
										}
									</td>
									<td>{ c.OrdersText() }</td>
									<td>{ c.Since }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// AdminCustomer renders one customer, whole.
templ AdminCustomer(p layouts.Page, v *AdminCustomerView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("customers")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">顧客</p>
					<h1 class="ui-page-head__title">{ v.DisplayName() }</h1>
					<p class="ui-page-head__sub">
						{ v.Email }
						if !v.Verified {
							<span class="ui-badge ui-badge--warn">Email 未確認</span>
						}
					</p>
				</div>
			</div>
			<div class="goen-admin__stats">
				<div class="ui-stat">
					<span class="ui-stat__label">訂單數</span>
					<span class="ui-stat__value">{ v.OrdersText() }</span>
				</div>
				<div class="ui-stat">
					<span class="ui-stat__label">已完成消費</span>
					<span class="ui-stat__value">{ v.Spent() }</span>
				</div>
				<div class="ui-stat">
					<span class="ui-stat__label">購物金餘額</span>
					<span class="ui-stat__value">{ v.Credit() }</span>
				</div>
				<div class="ui-stat">
					<span class="ui-stat__label">可用點數</span>
					<span class="ui-stat__value">{ v.PointsText() }</span>
				</div>
			</div>
			<dl class="ui-dl">
				<dt class="ui-dl__term">電話</dt>
				<dd class="ui-dl__desc">
					if v.Phone != "" {
						{ v.Phone }
					} else {
						—
					}
				</dd>
				<dt class="ui-dl__term">註冊於</dt>
				<dd class="ui-dl__desc">{ v.Since }</dd>
			</dl>
			<h2 class="goen-admin__subhead">訂單</h2>
			if !v.HasOrders() {
				<p class="goen-admin__hint">這位顧客還沒有下過訂單。</p>
			} else {
				<div class="goen-admin__tablewrap">
					<table class="ui-table">
						<thead>
							<tr>
								<th scope="col">編號</th>
								<th scope="col">狀態</th>
								<th scope="col">金額</th>
								<th scope="col">下單時間</th>
							</tr>
						</thead>
						<tbody>
							for _, o := range v.Recent {
								<tr>
									<td><a href={ templ.SafeURL("/admin/orders/" + o.Number) }>{ o.Number }</a></td>
									<td>{ o.StatusText }</td>
									<td>{ o.Total() }</td>
									<td>{ o.PlacedAt }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
