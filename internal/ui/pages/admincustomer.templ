package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminCustomers renders the customer search.
//
// The table appears only once somebody has searched: a back office that lists
// every customer by default is a page nobody reads and a query nobody wanted.
templ AdminCustomers(p layouts.Page, v AdminCustomersView) {
	@layouts.Admin(p, "customers") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageCustomers) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminCustLead) }
				</p>
			</div>
		</div>
		<form class="goen-admin__search" method="get" action="/admin/customers">
			<label class="goen-sr-only" for="customer-search">{ i18n.T(ctx, i18n.KeyAdminCustSearch) }</label>
			<input
				class="ui-input"
				id="customer-search"
				type="search"
				name="q"
				value={ v.Term }
				placeholder={ i18n.T(ctx, i18n.KeyAdminCustPlaceholder) }
				autocomplete="off"
			/>
			@components.Button(components.ButtonProps{Variant: components.VariantOutline}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminSearch) }
			}
		</form>
		if v.TermTooShort() {
			@components.Notice(components.NoticeProps{Tone: components.ToneWarn}) {
				{ i18n.T(ctx, i18n.KeyAdminCustSearchShort) }
			}
		}
		if v.Searching() && v.Empty() {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminCustNoneFound), v.Term) }
				</p>
			</div>
		}
		if v.Searching() && !v.Empty() {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCustColCustomer) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyFieldEmail) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCustSince) }</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range v.Rows {
							<tr>
								<td class="goen-admin__cellkey">
									<a href={ templ.SafeURL(c.Href()) }>{ c.DisplayName() }</a>
								</td>
								<td>
									{ c.Email }
									if !c.Verified {
										@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
											{ i18n.T(ctx, i18n.KeyAdminCustUnconfirmed) }
										}
									}
								</td>
								<td class="goen-admin__cellnum">{ c.OrdersText() }</td>
								<td>{ c.Since }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// AdminCustomer renders one customer, whole: the four figures a staff member
// checks first, then what the shop knows, then what they have bought.
templ AdminCustomer(p layouts.Page, v *AdminCustomerView) {
	@layouts.Admin(p, "customers") {
		@components.Breadcrumb(components.BreadcrumbProps{
			Label: i18n.T(ctx, i18n.KeyBreadcrumb),
			Crumbs: []components.Crumb{
				{Label: i18n.T(ctx, i18n.KeyAdminPageCustomers), Href: "/admin/customers"},
				{Label: v.DisplayName()},
			},
		})
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ v.DisplayName() }</h1>
				<p class="ui-page-head__sub">
					{ v.Email }
					if !v.Verified {
						@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
							{ i18n.T(ctx, i18n.KeyAdminCustEmailUnconfirmed) }
						}
					}
				</p>
			</div>
		</div>
		<div class="goen-admin__stats">
			<div class="ui-stat">
				<span class="ui-stat__label">{ i18n.T(ctx, i18n.KeyAdminCustStatOrders) }</span>
				<span class="ui-stat__value">{ v.OrdersText() }</span>
			</div>
			<div class="ui-stat">
				<span class="ui-stat__label">{ i18n.T(ctx, i18n.KeyAdminCustStatSpent) }</span>
				<span class="ui-stat__value">{ v.Spent() }</span>
			</div>
			<div class="ui-stat">
				<span class="ui-stat__label">{ i18n.T(ctx, i18n.KeyAdminCustStatCredit) }</span>
				<span class="ui-stat__value">{ v.Credit() }</span>
			</div>
			<div class="ui-stat">
				<span class="ui-stat__label">{ i18n.T(ctx, i18n.KeyAdminCustStatPoints) }</span>
				<span class="ui-stat__value">{ v.PointsText() }</span>
			</div>
		</div>
		@components.Card(components.CardProps{Class: "goen-admin__op"}) {
			<dl class="ui-dl">
				<div class="ui-dl__row">
					<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminColPhone) }</dt>
					<dd class="ui-dl__desc">
						if v.Phone != "" {
							{ v.Phone }
						} else {
							—
						}
					</dd>
				</div>
				<div class="ui-dl__row">
					<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyFieldEmail) }</dt>
					<dd class="ui-dl__desc">{ v.Email }</dd>
				</div>
				<div class="ui-dl__row">
					<dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminCustSince) }</dt>
					<dd class="ui-dl__desc">{ v.Since }</dd>
				</div>
			</dl>
		}
		<h2 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminCustOrders) }</h2>
		if !v.HasOrders() {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminCustNoOrders) }</p>
			</div>
		} else {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminCustColNumber) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColPlacedAt) }</th>
						</tr>
					</thead>
					<tbody>
						for _, o := range v.Recent {
							<tr>
								<td class="goen-admin__cellkey">
									<a href={ templ.SafeURL("/admin/orders/" + o.Number) }>{ o.Number }</a>
								</td>
								<td>
									@components.Badge(components.BadgeProps{}) {
										{ o.StatusText }
									}
								</td>
								<td class="goen-admin__cellnum">{ o.Total() }</td>
								<td>{ o.PlacedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
