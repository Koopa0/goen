package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminShipping renders the delivery configuration.
//
// One card per method, then the card that adds a method, then the zones. A fee
// is never edited in place: the form publishes a new VERSION, and the card says
// which version is live and since when, so a reader can see what an order
// placed yesterday was quoted.
//
// The one filled button is the method create. Publishing a version is the more
// frequent job but there is one of those per method, and a primary that repeats
// down the page is not a primary.
templ AdminShipping(p layouts.Page, v AdminShippingView) {
	@layouts.Admin(p, "shipping") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageShipping) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminShipLead) }
				</p>
			</div>
		</div>
		if v.Notice != "" {
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
				{ v.Notice }
			}
		}
		for _, m := range v.Methods {
			@components.Card(components.CardProps{Class: "goen-admin__section"}) {
				<h2 class="goen-admin__heading">
					{ m.Name }
					<span class="goen-admin__meta">{ m.Code } · { m.DestinationText(ctx) }</span>
				</h2>
				<p class="goen-admin__hint">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminShipCurrent), m.Fee(), m.FreeOver(ctx)) }
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminShipSince), m.EffectiveAt, m.VersionCountText()) }
				</p>
				<form class="goen-admin__form" method="post" action="/admin/shipping/version">
					<input type="hidden" name="method" value={ m.MethodID }/>
					<div class="goen-admin__fields">
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "name-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminColName) }
							}
							<input class="goen-input" id={ "name-" + m.MethodID } name="name" value={ m.Name } required maxlength="60"/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "carrier-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipCarrierOptional) }
							}
							<input class="goen-input" id={ "carrier-" + m.MethodID } name="carrier" value={ m.Carrier } maxlength="60"/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "name-en-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminColNameEn) }
							}
							<input class="goen-input" id={ "name-en-" + m.MethodID } name="name_en" value={ m.NameEn } maxlength="60" placeholder="Home delivery"/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "carrier-en-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipCarrierEn) }
							}
							<input class="goen-input" id={ "carrier-en-" + m.MethodID } name="carrier_en" value={ m.CarrierEn } maxlength="60"/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "fee-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipFee) }
							}
							<input class="goen-input" id={ "fee-" + m.MethodID } name="fee" type="number" min="0" step="1" value={ m.FeeDollars() } required inputmode="numeric"/>
						</div>
						<div class="goen-admin__field">
							@components.Label(components.LabelProps{For: "free-" + m.MethodID}) {
								{ i18n.T(ctx, i18n.KeyAdminShipFreeOver) }
							}
							<input class="goen-input" id={ "free-" + m.MethodID } name="free_over" type="number" min="0" step="1" value={ m.FreeOverDollars() } inputmode="numeric"/>
						</div>
					</div>
					@components.Button(components.ButtonProps{
						Variant: components.VariantOutline,
						Class:   "goen-admin__submit",
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyAdminShipPublish) }
					}
				</form>
				<form method="post" action={ templ.SafeURL("/admin/shipping/method/" + m.MethodID + "/active") }>
					if m.Active {
						<input type="hidden" name="active" value="0"/>
						@components.Button(components.ButtonProps{
							Variant: components.VariantGhost,
							Size:    components.SizeSmall,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminShipDisable) }
						}
					} else {
						<input type="hidden" name="active" value="1"/>
						@components.Button(components.ButtonProps{
							Variant: components.VariantOutline,
							Size:    components.SizeSmall,
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminShipReenable) }
						}
					}
				</form>
				if m.Zoned() {
					<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminShipSurcharges) }</h3>
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminShipSurchargeLead) }
					</p>
					<div class="goen-admin__fields">
						for _, z := range v.Zones {
							<form class="goen-admin__field" method="post" action="/admin/shipping/surcharge">
								<input type="hidden" name="version" value={ m.VersionID }/>
								<input type="hidden" name="zone" value={ z.ID }/>
								@components.Label(components.LabelProps{For: "sur-" + m.VersionID + "-" + z.ID}) {
									{ z.Name }
									<span class="goen-admin__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminShipPrefixCount), z.PrefixCountText()) }</span>
								}
								<div class="goen-admin__inline">
									<input
										class="goen-input"
										id={ "sur-" + m.VersionID + "-" + z.ID }
										name="amount"
										type="number"
										min="0"
										step="1"
										value={ m.SurchargeDollars(z.ID) }
										inputmode="numeric"
									/>
									@components.Button(components.ButtonProps{
										Variant: components.VariantOutline,
										Size:    components.SizeSmall,
									}, "submit") {
										{ i18n.T(ctx, i18n.KeyAdminShipSet) }
									}
								</div>
							</form>
						}
					</div>
				} else {
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminShipNoZone) }
					</p>
				}
			}
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminShipAddMethod) }</h2>
			<form class="goen-admin__form" method="post" action="/admin/shipping/method">
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-code"}) {
							{ i18n.T(ctx, i18n.KeyAdminColCode) }
						}
						<input
							class="goen-input"
							id="m-code"
							name="code"
							required
							maxlength="30"
							pattern="[a-z0-9_]+"
							value={ v.MethodDraft.Code }
							placeholder="express_delivery"
							if v.HasErr("code") {
								aria-invalid="true"
								aria-describedby="m-code-error"
							}
						/>
						if v.HasErr("code") {
							<p class="ui-error-text" id="m-code-error">{ v.Err("code") }</p>
						}
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminShipCodeHint) }</p>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-destination"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipDestination) }
						}
						<select
							class="goen-input"
							id="m-destination"
							name="destination"
							required
							if v.HasErr("destination") {
								aria-invalid="true"
								aria-describedby="m-destination-error"
							}
						>
							<option value="address" selected?={ !v.PickupSelected() }>{ i18n.T(ctx, i18n.KeyAdminShipToAddress) }</option>
							<option value="pickup_point" selected?={ v.PickupSelected() }>{ i18n.T(ctx, i18n.KeyAdminDestPickup) }</option>
						</select>
						if v.HasErr("destination") {
							<p class="ui-error-text" id="m-destination-error">{ v.Err("destination") }</p>
						}
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminShipDestinationHint) }
						</p>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-max-longest"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipMaxLongest) }
						}
						// Blank is no stated limit; store pickup is 450mm / 1050mm / 10000g (Hi-Life 5000g).
						<input
							class="goen-input"
							id="m-max-longest"
							name="max_parcel_longest"
							type="text"
							inputmode="numeric"
							value={ v.MethodDraft.MaxLongest }
							if v.HasErr("max_parcel_longest") {
								aria-invalid="true"
								aria-describedby="m-max-longest-error"
							}
						/>
						if v.HasErr("max_parcel_longest") {
							<p class="ui-error-text" id="m-max-longest-error">{ v.Err("max_parcel_longest") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-max-sum"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipMaxSum) }
						}
						<input
							class="goen-input"
							id="m-max-sum"
							name="max_parcel_sum"
							type="text"
							inputmode="numeric"
							value={ v.MethodDraft.MaxSum }
							if v.HasErr("max_parcel_sum") {
								aria-invalid="true"
								aria-describedby="m-max-sum-error"
							}
						/>
						if v.HasErr("max_parcel_sum") {
							<p class="ui-error-text" id="m-max-sum-error">{ v.Err("max_parcel_sum") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-max-weight"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipMaxWeight) }
						}
						<input
							class="goen-input"
							id="m-max-weight"
							name="max_parcel_weight"
							type="text"
							inputmode="numeric"
							value={ v.MethodDraft.MaxWeight }
							if v.HasErr("max_parcel_weight") {
								aria-invalid="true"
								aria-describedby="m-max-weight-error"
							}
						/>
						if v.HasErr("max_parcel_weight") {
							<p class="ui-error-text" id="m-max-weight-error">{ v.Err("max_parcel_weight") }</p>
						}
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminShipLimitsHint) }
						</p>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-name"}) {
							{ i18n.T(ctx, i18n.KeyAdminColName) }
						}
						<input
							class="goen-input"
							id="m-name"
							name="name"
							required
							maxlength="60"
							value={ v.MethodDraft.Name }
							placeholder={ i18n.T(ctx, i18n.KeyAdminShipNamePlaceholder) }
							if v.HasErr("name") {
								aria-invalid="true"
								aria-describedby="m-name-error"
							}
						/>
						if v.HasErr("name") {
							<p class="ui-error-text" id="m-name-error">{ v.Err("name") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-name-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminColNameEn) }
						}
						<input class="goen-input" id="m-name-en" name="name_en" maxlength="60" value={ v.MethodDraft.NameEn } placeholder="Next-day delivery"/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-carrier"}) {
							{ i18n.T(ctx, i18n.KeyAdminColCarrier) }
						}
						<input class="goen-input" id="m-carrier" name="carrier" maxlength="60" value={ v.MethodDraft.Carrier }/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-carrier-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipCarrierEn) }
						}
						<input class="goen-input" id="m-carrier-en" name="carrier_en" maxlength="60" value={ v.MethodDraft.CarrierEn }/>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-fee"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipFee) }
						}
						<input
							class="goen-input"
							id="m-fee"
							name="fee"
							type="number"
							min="0"
							step="1"
							required
							inputmode="numeric"
							value={ v.MethodDraft.Fee }
							if v.HasErr("fee") {
								aria-invalid="true"
								aria-describedby="m-fee-error"
							}
						/>
						if v.HasErr("fee") {
							<p class="ui-error-text" id="m-fee-error">{ v.Err("fee") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "m-free"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipFreeOver) }
						}
						<input class="goen-input" id="m-free" name="free_over" type="number" min="0" step="1" inputmode="numeric" value={ v.MethodDraft.FreeOver }/>
					</div>
				</div>
				<p class="goen-admin__hint">
					{ i18n.T(ctx, i18n.KeyAdminShipFirstVersion) }
				</p>
				@components.Button(components.ButtonProps{
					Variant: components.VariantPrimary,
					Class:   "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminShipAddMethod) }
				}
			</form>
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminShipZones) }</h2>
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminShipColZone) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminShipPrefixes) }</th>
							<th class="goen-admin__cellactions" scope="col">
								<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyAdminColActions) }</span>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, z := range v.Zones {
							<tr>
								<td class="goen-admin__cellkey">
									{ z.Name }
									<span class="goen-admin__meta">{ z.Code }</span>
									if z.NameEn == "" {
										@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
											{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
										}
									}
								</td>
								<td class="goen-admin__prefixes">
									<form class="goen-admin__inline" method="post" action={ templ.SafeURL("/admin/shipping/zone/" + z.ID + "/prefixes") }>
										<label class="goen-sr-only" for={ "pre-" + z.ID }>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminShipZonePrefixes), z.Name) }</label>
										<input
											class="goen-input"
											id={ "pre-" + z.ID }
											name="prefixes"
											value={ v.ZonePrefixesValue(z) }
											if v.PrefixDraft.ZoneID == z.ID && v.HasErr("zone_prefixes") {
												aria-invalid="true"
												aria-describedby={ "pre-" + z.ID + "-error" }
											}
										/>
										@components.Button(components.ButtonProps{
											Variant: components.VariantOutline,
											Size:    components.SizeSmall,
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminShipSet) }
										}
										if v.PrefixDraft.ZoneID == z.ID && v.HasErr("zone_prefixes") {
											<p class="ui-error-text" id={ "pre-" + z.ID + "-error" }>{ v.Err("zone_prefixes") }</p>
										}
									</form>
								</td>
								<td class="goen-admin__cellactions">
									<form method="post" action={ templ.SafeURL("/admin/shipping/zone/" + z.ID + "/delete") }>
										@components.Button(components.ButtonProps{
											Variant: components.VariantGhost,
											Size:    components.SizeSmall,
										}, "submit") {
											{ i18n.T(ctx, i18n.KeyAdminDelete) }
										}
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<form class="goen-admin__form" method="post" action="/admin/shipping/zone">
				<h3 class="goen-admin__subhead">{ i18n.T(ctx, i18n.KeyAdminShipAddZone) }</h3>
				<div class="goen-admin__fields">
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "z-code"}) {
							{ i18n.T(ctx, i18n.KeyAdminColCode) }
						}
						<input
							class="goen-input"
							id="z-code"
							name="code"
							required
							maxlength="30"
							pattern="[a-z0-9_]+"
							value={ v.ZoneDraft.Code }
							placeholder="offshore"
							if v.HasErr("zone_code") {
								aria-invalid="true"
								aria-describedby="z-code-error"
							}
						/>
						if v.HasErr("zone_code") {
							<p class="ui-error-text" id="z-code-error">{ v.Err("zone_code") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "z-name"}) {
							{ i18n.T(ctx, i18n.KeyAdminColName) }
						}
						<input
							class="goen-input"
							id="z-name"
							name="name"
							required
							maxlength="60"
							value={ v.ZoneDraft.Name }
							placeholder={ i18n.T(ctx, i18n.KeyAdminShipZoneNamePlaceholder) }
							if v.HasErr("zone_name") {
								aria-invalid="true"
								aria-describedby="z-name-error"
							}
						/>
						if v.HasErr("zone_name") {
							<p class="ui-error-text" id="z-name-error">{ v.Err("zone_name") }</p>
						}
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "z-name-en"}) {
							{ i18n.T(ctx, i18n.KeyAdminColNameEn) }
						}
						<input class="goen-input" id="z-name-en" name="name_en" maxlength="60" value={ v.ZoneDraft.NameEn } placeholder="Outlying islands"/>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminShipZoneNameEnHint) }</p>
					</div>
					<div class="goen-admin__field">
						@components.Label(components.LabelProps{For: "z-prefixes"}) {
							{ i18n.T(ctx, i18n.KeyAdminShipPrefixes) }
						}
						<input
							class="goen-input"
							id="z-prefixes"
							name="prefixes"
							required
							value={ v.ZoneDraft.Prefixes }
							placeholder="880 881 882 890 891"
							if v.HasErr("prefixes") {
								aria-invalid="true"
								aria-describedby="z-prefixes-error"
							}
						/>
						if v.HasErr("prefixes") {
							<p class="ui-error-text" id="z-prefixes-error">{ v.Err("prefixes") }</p>
						}
						<p class="goen-admin__hint">
							{ i18n.T(ctx, i18n.KeyAdminShipPrefixesHint) }
						</p>
					</div>
				</div>
				@components.Button(components.ButtonProps{
					Variant: components.VariantOutline,
					Class:   "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminShipAddZone) }
				}
			</form>
		}
	}
}
