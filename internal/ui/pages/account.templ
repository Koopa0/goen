package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/fieldrule"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ SignIn(p layouts.Page, v AuthView) {
	@layouts.Base(p) {
		<div class="goen-auth">
			<div class="goen-auth__panel">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeySignIn) }</h1>
				if v.ReturnMessage != "" {
					<p class="goen-auth__alt">{ v.ReturnMessage }</p>
				}
				if v.HasErr("oauth") {
					<p class="goen-notice goen-notice--danger" id="signin-google-error" role="alert">
						{ v.Err("oauth") }
						if v.Recovery != SignInNoRecovery {
							<a href={ templ.SafeURL(v.Recovery.Href()) }>{ v.Recovery.Label(ctx) }</a>
						}
					</p>
				}
				if v.HasNotice() {
					@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
						{ v.Notice }
					}
				}
				if v.HasErr("form") {
					// Not the notice component: a guard reads role="alert" from this source (aria_test.go).
					<p class="goen-notice goen-notice--danger" id="signin-error" role="alert">{ v.Err("form") }</p>
				}
				if v.OffersDemoAccount() {
					@demoAccountNote(v)
				}
				<form class="goen-auth__form" method="post" action="/signin">
					<input type="hidden" name="next" value={ v.Next }/>
					if v.HideRegister {
						<input type="hidden" name="reauth" value="erase"/>
					}
					<div class="goen-field">
						@components.Label(components.LabelProps{For: "email"}) {
							{ i18n.T(ctx, i18n.KeyFieldEmail) }
						}
						@components.Input(components.FieldProps{
							ID:    "email",
							Name:  "email",
							Type:  "email",
							Value: v.Email,
							Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
								"autocomplete": "email",
								"autofocus":    !v.PasswordFocus,
								"required":     true,
							}),
						})
					</div>
					<div class="goen-field">
						<div class="goen-auth__labelrow">
							@components.Label(components.LabelProps{For: "password"}) {
								{ i18n.T(ctx, i18n.KeyFieldPassword) }
							}
							<a class="goen-auth__forgot" href="/forgot">{ i18n.T(ctx, i18n.KeyForgotPassword) }</a>
						</div>
						@components.Input(components.FieldProps{
							ID:        "password",
							Name:      "password",
							Type:      "password",
							Invalid:   v.HasErr("form"),
							Describes: "signin-error",
							Attrs: templ.Attributes{
								"autocomplete": "current-password",
								"autofocus":    v.PasswordFocus,
								"required":     true,
							},
						})
					</div>
					@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge, Block: true}, "submit") {
						{ i18n.T(ctx, i18n.KeySignIn) }
					}
				</form>
				if v.GoogleSignIn {
					<hr class="goen-auth__divider"/>
					@components.ButtonLink(components.ButtonProps{
						ButtonStyle: components.ButtonStyleOutline,
						Size:        components.SizeLarge,
						Block:       true,
						Class:       "goen-auth__oauth",
					}, templ.SafeURL(v.GoogleLink())) {
						{ i18n.T(ctx, i18n.KeySignInWithGoogle) }
					}
				}
				if !v.HideRegister {
					<p class="goen-auth__alt">
						{ i18n.T(ctx, i18n.KeyNoAccountYet) }
						<a href="/register">{ i18n.T(ctx, i18n.KeyNoAccountLink) }</a>
					</p>
				}
			</div>
		</div>
	}
}

// Credentials as plain text for a browser without scripting; goen.js reveals the button that fills and submits the form.
templ demoAccountNote(v AuthView) {
	<section class="goen-auth__demo" aria-labelledby="demo-account-title">
		<h2 class="goen-auth__demotitle" id="demo-account-title">{ i18n.T(ctx, i18n.KeyDemoAccount) }</h2>
		<dl class="goen-auth__democreds">
			<div>
				<dt>{ i18n.T(ctx, i18n.KeyFieldEmail) }</dt>
				<dd><code>{ v.DemoEmail }</code></dd>
			</div>
			<div>
				<dt>{ i18n.T(ctx, i18n.KeyFieldPassword) }</dt>
				<dd><code>{ v.DemoPassword }</code></dd>
			</div>
		</dl>
		<p class="goen-auth__demonote">{ i18n.T(ctx, i18n.KeyDemoAccountShared) }</p>
		@components.Button(components.ButtonProps{
			ButtonStyle: components.ButtonStyleOutline,
			Block:       true,
			Class:       "goen-auth__demofill",
			Attrs: templ.Attributes{
				"hidden":         true,
				"data-demo-fill": true,
				"data-email":     v.DemoEmail,
				"data-password":  v.DemoPassword,
			},
		}, "button") {
			{ i18n.T(ctx, i18n.KeyDemoAccountSignIn) }
		}
	</section>
}

templ Register(p layouts.Page, v AuthView) {
	@layouts.Base(p) {
		<div class="goen-auth">
			<div class="goen-auth__panel goen-auth__panel--wide">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyCreateAccount) }</h1>
				if v.HasNotice() {
					@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "register-sent"}) {
						{ v.Notice }
					}
				}
				if v.AnyErrors() {
					@components.Notice(components.NoticeProps{Intent: components.IntentDanger}) {
						{ i18n.T(ctx, i18n.KeyFormHasErrors) }
					}
				}
				if v.OffersResend {
					<form class="goen-auth__form" method="post" action="/register/resend">
						<input type="hidden" name="next" value={ v.Next }/>
						if v.Email != "" {
							<input type="hidden" name="email" value={ v.Email }/>
						} else {
							<div class="goen-field">
								@components.Label(components.LabelProps{For: "email"}) {
									{ i18n.T(ctx, i18n.KeyFieldEmail) }
								}
								@components.Input(components.FieldProps{
									ID:   "email",
									Name: "email",
									Type: "email",
									Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
										"autocomplete": "email",
										"required":     true,
									}),
								})
							</div>
						}
						@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Size: components.SizeLarge, Block: true}, "submit") {
							{ i18n.T(ctx, i18n.KeyRegisterResend) }
						}
					</form>
					if v.HasNotice() {
						<p class="goen-auth__alt">
							<a href="/register">{ i18n.T(ctx, i18n.KeyRegisterOtherAddress) }</a>
						</p>
					}
				} else {
					<form class="goen-auth__form" method="post" action="/register">
						<input type="hidden" name="next" value={ v.Next }/>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "email"}) {
								{ i18n.T(ctx, i18n.KeyFieldEmail) }
							}
							@components.Input(components.FieldProps{
								ID:        "email",
								Name:      "email",
								Type:      "email",
								Value:     v.Email,
								Invalid:   v.HasErr("email"),
								Describes: "email-error",
								Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
									"autocomplete": "email",
									"autofocus":    true,
									"required":     true,
								}),
							})
							if v.HasErr("email") {
								<p class="ui-error-text" id="email-error" role="alert">{ v.Err("email") }</p>
							}
						</div>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "name"}) {
								{ i18n.T(ctx, i18n.KeyFieldNameOpt) }
							}
							@components.Input(components.FieldProps{
								ID:        "name",
								Name:      "name",
								Type:      "text",
								Value:     v.Name,
								Invalid:   v.HasErr("name"),
								Describes: "name-error",
								Attrs: templ.Attributes{
									"autocomplete": "name",
									"maxlength":    "60",
								},
							})
							if v.HasErr("name") {
								<p class="ui-error-text" id="name-error" role="alert">{ v.Err("name") }</p>
							}
						</div>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "password"}) {
								{ i18n.T(ctx, i18n.KeyFieldPassword) }
							}
							@components.Input(components.FieldProps{
								ID:        "password",
								Name:      "password",
								Type:      "password",
								Invalid:   v.HasErr("password"),
								Describes: "password-error password-hint",
								Attrs: templ.Attributes{
									"autocomplete": "new-password",
									"minlength":    "10",
									"required":     true,
								},
							})
							<p class="goen-auth__hint" id="password-hint">{ i18n.T(ctx, i18n.KeyPasswordHint) }</p>
							if v.HasErr("password") {
								<p class="ui-error-text" id="password-error" role="alert">{ v.Err("password") }</p>
							}
						</div>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "confirm"}) {
								{ i18n.T(ctx, i18n.KeyFieldConfirmPassword) }
							}
							@components.Input(components.FieldProps{
								ID:        "confirm",
								Name:      "confirm",
								Type:      "password",
								Invalid:   v.HasErr("confirm"),
								Describes: "confirm-error",
								Attrs: templ.Attributes{
									"autocomplete": "new-password",
									"required":     true,
								},
							})
							if v.HasErr("confirm") {
								<p class="ui-error-text" id="confirm-error" role="alert">{ v.Err("confirm") }</p>
							}
						</div>
						@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge, Block: true}, "submit") {
							{ i18n.T(ctx, i18n.KeyCreateAccount) }
						}
					</form>
				}
				<p class="goen-auth__alt">
					{ i18n.T(ctx, i18n.KeyHaveAccount) }
					<a href="/signin">{ i18n.T(ctx, i18n.KeySignIn) }</a>
				</p>
			</div>
		</div>
	}
}

templ RegisterComplete(p layouts.Page, v RegisterCompleteView) {
	@layouts.Base(p) {
		<div class="goen-auth">
			<div class="goen-auth__panel">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyRegisterCompleteTitle) }</h1>
				<p class="goen-auth__lede">{ i18n.T(ctx, i18n.KeyRegisterCompleteLede) }</p>
				<p class="goen-auth__hint">{ i18n.T(ctx, i18n.KeyRegisterCompleteWhy) }</p>
				<form class="goen-auth__form" method="post" action="/register/complete">
					<input type="hidden" name="token" value={ v.Token }/>
					<input type="hidden" name="next" value={ v.Next }/>
					<div class="goen-field">
						@components.Label(components.LabelProps{For: "password"}) {
							{ i18n.T(ctx, i18n.KeyFieldPassword) }
						}
						@components.Input(components.FieldProps{
							ID:        "password",
							Name:      "password",
							Type:      "password",
							Invalid:   v.HasError(),
							Describes: "complete-error",
							Attrs: templ.Attributes{
								"autocomplete": "current-password",
								"autofocus":    true,
								"required":     true,
							},
						})
						if v.HasError() {
							<p class="ui-error-text" id="complete-error" role="alert">{ v.Error }</p>
						}
					</div>
					@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge, Block: true}, "submit") {
						{ i18n.T(ctx, i18n.KeyRegisterCompleteSubmit) }
					}
				</form>
				<p class="goen-auth__alt">
					{ i18n.T(ctx, i18n.KeyRegisterCompleteNotYou) }
					<a href="/forgot">{ i18n.T(ctx, i18n.KeyForgotPassword) }</a>
				</p>
			</div>
		</div>
	}
}

templ CartRecovery(p layouts.Page, v CartRecoveryView) {
	@layouts.Base(p) {
		<div class="notice">
			<h1 class="notice__title">{ i18n.T(ctx, i18n.KeyCartMergeRecoveryTitle) }</h1>
			if v.Welcome {
				@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
					{ i18n.T(ctx, i18n.KeyAccountWelcome) }
				}
			}
			@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "cart-recovery", Class: "ui-alert--info notice__body"}) {
				{ v.Notice }
			}
			<form class="notice__form" method="post" action="/account/cart/retry">
				<input type="hidden" name="next" value={ v.Next }/>
				@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge, Block: true}, "submit") {
					{ v.Retry }
				}
			</form>
			@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost, Class: "notice__back"}, "/") {
				{ i18n.T(ctx, i18n.KeyBackToShop) }
			}
		</div>
	}
}

// A section of this page needs no hint: it is directly below.
templ accountNavItem(href, label, hint string) {
	<a class="goen-account__navitem" href={ templ.SafeURL(href) }>
		<span class="goen-account__navname">{ label }</span>
		if hint != "" {
			<span class="goen-account__navhint">{ hint }</span>
		}
	</a>
}

templ Account(p layouts.Page, v *AccountView) {
	@layouts.Base(p) {
		<div class="goen-account">
			<div class="goen-account__head ui-page-head">
				<div class="goen-pagehead">
					<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyAccountTitle) }</h1>
					<p class="goen-pagehead__sub">{ v.DisplayName() }</p>
				</div>
				<form class="goen-account__headactions" method="post" action="/signout">
					@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Class: "ui-btn"}, "submit") {
						{ i18n.T(ctx, i18n.KeySignOut) }
					}
				</form>
			</div>
			if v.HasNotice() {
				@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "account-notice"}) {
					{ v.Notice }
				}
			}
			if v.CartAdjusted {
				@components.Notice(components.NoticeProps{Intent: components.IntentWarn}) {
					{ i18n.T(ctx, i18n.KeyCartQuantityAdjusted) }
				}
			}
			if v.ReturnAfterWelcome != "" {
				@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, templ.SafeURL(v.ReturnAfterWelcome)) {
					{ i18n.T(ctx, i18n.KeyWelcomeReturn) }
				}
			}
			<div class="goen-account__layout">
				<nav class="goen-account__nav" aria-label={ i18n.T(ctx, i18n.KeyAccountNav) }>
					@accountNavItem("#standing-heading", i18n.T(ctx, i18n.KeyMembershipTier), "")
					@accountNavItem("#orders-heading", i18n.T(ctx, i18n.KeyOrderHistory2), "")
					@accountNavItem("#profile-heading", i18n.T(ctx, i18n.KeyProfile), "")
					@accountNavItem("#addresses-heading", i18n.T(ctx, i18n.KeyAddresses), "")
					@accountNavItem("#email-heading", i18n.T(ctx, i18n.KeyEmailSection), "")
					@accountNavItem("#password-heading", i18n.T(ctx, i18n.KeyChangePassword), "")
					if v.GoogleLinked {
						@accountNavItem("#google-heading", i18n.T(ctx, i18n.KeyLinkedAccounts), "")
					}
					@accountNavItem("#erase-heading", i18n.T(ctx, i18n.KeyEraseAccount), "")
					<hr class="goen-account__navrule"/>
					@accountNavItem("/account/points", i18n.T(ctx, i18n.KeyLoyaltyPoints), i18n.T(ctx, i18n.KeyLoyaltyPointsHint))
					@accountNavItem("/account/wishlist", i18n.T(ctx, i18n.KeyWishlistTitle), i18n.T(ctx, i18n.KeyWishlistHint))
					@accountNavItem("/account/warranty", i18n.T(ctx, i18n.KeyWarrantyTitle), i18n.T(ctx, i18n.KeyWarrantyHint))
					if layouts.IsStaff(ctx) {
						@accountNavItem("/admin", i18n.T(ctx, i18n.KeyBackOffice), i18n.T(ctx, i18n.KeyBackOfficeHint))
					}
				</nav>
				<div class="goen-account__panels">
					<section class="goen-card goen-account__section" aria-labelledby="standing-heading">
						<h2 class="goen-account__heading" id="standing-heading">{ i18n.T(ctx, i18n.KeyMembershipTier) }</h2>
						<div class="goen-account__standing">
							if v.Standing.HasTier() {
								<p class="goen-account__tier">{ v.Standing.TierName }</p>
								<p class="goen-account__meta">
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPointsMultiplier), v.Standing.Multiplier(ctx)) }
								</p>
							} else {
								<p class="goen-account__tier goen-account__tier--none">{ i18n.T(ctx, i18n.KeyNoTierYet) }</p>
							}
							<p class="goen-account__meta">
								{ fmt.Sprintf(i18n.T(ctx, i18n.KeySpendLastYear), v.Standing.Spend()) }
							</p>
							if v.Standing.HasNext() {
								<p class="goen-account__meta">
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyNextTier), v.Standing.NextNeeds(), v.Standing.NextName) }
								</p>
							}
						</div>
						if v.HasCredit() {
							<div class="goen-account__credit">
								<span class="goen-account__creditlabel">{ i18n.T(ctx, i18n.KeyStoreCredit) }</span>
								<span class="goen-account__creditamount">{ v.Credit() }</span>
							</div>
						}
					</section>
					<section class="goen-card goen-account__section" aria-labelledby="orders-heading">
						<h2 class="goen-account__heading" id="orders-heading">{ i18n.T(ctx, i18n.KeyOrderHistory2) }</h2>
						if v.HasOrders() {
							<table class="goen-account__orders">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, i18n.KeyFieldOrderNumber) }</th>
										<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
									</tr>
								</thead>
								<tbody>
									for _, o := range v.Orders {
										<tr>
											<td>
												<a class="goen-account__number" href={ templ.SafeURL("/orders/" + o.Number) }>
													{ o.Number }
												</a>
												<span class="goen-account__ordermeta">
													{ i18n.Count(ctx, i18n.KeyOrderLineCount, o.LineCount, o.LineCountText()) }
												</span>
												@components.StatLine(o.Facts(ctx), components.StatLineSmall)
											</td>
											<td>
												@components.Badge(components.BadgeProps{Intent: o.BadgeIntent()}) {
													{ o.StatusText(ctx) }
												}
												if v.PaymentsEnabled && o.AwaitingPayment() {
													<a class="goen-account__orderpay" href={ templ.SafeURL("/orders/" + o.Number + "/pay") }>{ i18n.T(ctx, i18n.KeyPay) }</a>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						} else if !v.OrdersBound.PastEnd {
							<p class="goen-account__empty">
								{ i18n.T(ctx, i18n.KeyNoOrdersYet) }
								<a href="/">{ i18n.T(ctx, i18n.KeyNoOrdersLink) }</a>
							</p>
						}
						@ListPager(v.OrdersBound)
					</section>
					<section class="goen-card goen-account__section" aria-labelledby="profile-heading">
						<h2 class="goen-account__heading" id="profile-heading">{ i18n.T(ctx, i18n.KeyProfile) }</h2>
						<form class="goen-account__form" method="post" action="/account/profile">
							<div class="goen-account__fields">
								<div class="goen-field">
									@components.Label(components.LabelProps{For: "acct-name"}) {
										{ i18n.T(ctx, i18n.KeyFieldFullName) }
									}
									@components.Input(components.FieldProps{
										ID:    "acct-name",
										Name:  "name",
										Type:  "text",
										Value: v.Name,
										Attrs: templ.Attributes{"maxlength": "60", "autocomplete": "name"},
									})
								</div>
								<div class="goen-field">
									@components.Label(components.LabelProps{For: "acct-phone"}) {
										{ i18n.T(ctx, i18n.KeyFieldPhone) }
									}
									@components.Input(components.FieldProps{
										ID:    "acct-phone",
										Name:  "phone",
										Type:  "tel",
										Value: v.Phone,
										Attrs: templ.Attributes{"maxlength": "30", "autocomplete": "tel"},
									})
								</div>
							</div>
							<div class="goen-account__actions">
								@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
									{ i18n.T(ctx, i18n.KeySave) }
								}
							</div>
						</form>
					</section>
					<section class="goen-card goen-account__section" aria-labelledby="addresses-heading">
						<h2 class="goen-account__heading" id="addresses-heading">{ i18n.T(ctx, i18n.KeyAddresses) }</h2>
						if v.HasAddresses() {
							<ul class="goen-account__addresses" role="list">
								for _, a := range v.Addresses {
									<li class="goen-account__address">
										<div class="goen-account__addrbody">
											<span class="goen-account__addrlabel">
												{ a.DisplayLabel(ctx) }
												if a.Default {
													@components.Badge(components.BadgeProps{}) {
														{ i18n.T(ctx, i18n.KeyDefaultBadge) }
													}
												}
											</span>
											<span class="goen-account__meta">{ a.Name } · { a.Phone }</span>
											<span class="goen-account__meta">{ a.Line() }</span>
										</div>
										<div class="goen-account__addractions">
											if !a.Default {
												<form method="post" action="/account/addresses/default">
													<input type="hidden" name="address" value={ a.ID }/>
													@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost, Size: components.SizeSmall}, "submit") {
														{ i18n.T(ctx, i18n.KeyMakeDefault) }
													}
												</form>
											}
											<form method="post" action="/account/addresses/delete">
												<input type="hidden" name="address" value={ a.ID }/>
												@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleGhost, Size: components.SizeSmall}, "submit") {
													{ i18n.T(ctx, i18n.KeyDelete) }
												}
											</form>
										</div>
									</li>
								}
							</ul>
						} else {
							<p class="goen-account__empty">{ i18n.T(ctx, i18n.KeyNoAddresses) }</p>
						}
						<details class="goen-account__disclosure" open?={ v.AddressOpen() }>
							<summary class="goen-account__summary">{ i18n.T(ctx, i18n.KeyAddAddress) }</summary>
							<form class="goen-account__form" method="post" action="/account/addresses">
								<div class="goen-account__fields">
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "addr-label"}) {
											{ i18n.T(ctx, i18n.KeyFieldLabelOpt) }
										}
										@components.Input(components.FieldProps{
											ID:        "addr-label",
											Value:     v.AddrValue("label"),
											Invalid:   v.AddrInvalid("label"),
											Describes: "addr-label-error",
											Name:      "label",
											Type:      "text",
											Attrs: templ.Attributes{
												"maxlength":    "30",
												"autocomplete": "off",
												"placeholder":  i18n.T(ctx, i18n.KeyLabelPlaceholder),
											},
										})
										if v.AddrInvalid("label") {
											<p class="ui-error-text" id="addr-label-error" role="alert">{ v.AddrErr("label") }</p>
										}
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "addr-name"}) {
											{ i18n.T(ctx, i18n.KeyFieldRecipient) }
										}
										@components.Input(components.FieldProps{
											ID:        "addr-name",
											Value:     v.AddrValue("name"),
											Invalid:   v.AddrInvalid("name"),
											Describes: "addr-name-error",
											Name:      "name",
											Type:      "text",
											Attrs:     templ.Attributes{"required": true, "maxlength": "60", "autocomplete": "name"},
										})
										if v.AddrInvalid("name") {
											<p class="ui-error-text" id="addr-name-error" role="alert">{ v.AddrErr("name") }</p>
										}
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "addr-phone"}) {
											{ i18n.T(ctx, i18n.KeyFieldPhoneShort) }
										}
										@components.Input(components.FieldProps{
											ID:        "addr-phone",
											Value:     v.AddrValue("phone"),
											Invalid:   v.AddrInvalid("phone"),
											Describes: "addr-phone-error",
											Name:      "phone",
											Type:      "tel",
											Attrs:     fieldrule.Phone.Attrs(ctx, templ.Attributes{"required": true, "maxlength": "30", "autocomplete": "tel"}),
										})
										if v.AddrInvalid("phone") {
											<p class="ui-error-text" id="addr-phone-error" role="alert">{ v.AddrErr("phone") }</p>
										}
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "addr-postal"}) {
											{ i18n.T(ctx, i18n.KeyFieldPostalCode) }
										}
										@components.Input(components.FieldProps{
											ID:        "addr-postal",
											Value:     v.AddrValue("postal_code"),
											Invalid:   v.AddrInvalid("postal_code"),
											Describes: "addr-postal-error",
											Name:      "postal_code",
											Type:      "text",
											Attrs: fieldrule.PostalCode.Attrs(ctx, templ.Attributes{
												"required":     true,
												"maxlength":    "6",
												"autocomplete": "postal-code",
											}),
										})
										if v.AddrInvalid("postal_code") {
											<p class="ui-error-text" id="addr-postal-error" role="alert">{ v.AddrErr("postal_code") }</p>
										}
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "addr-city"}) {
											{ i18n.T(ctx, i18n.KeyFieldCity) }
										}
										@components.Input(components.FieldProps{
											ID:        "addr-city",
											Value:     v.AddrValue("city"),
											Invalid:   v.AddrInvalid("city"),
											Describes: "addr-city-error",
											Name:      "city",
											Type:      "text",
											Attrs:     templ.Attributes{"required": true, "maxlength": "20", "autocomplete": "address-level1"},
										})
										if v.AddrInvalid("city") {
											<p class="ui-error-text" id="addr-city-error" role="alert">{ v.AddrErr("city") }</p>
										}
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "addr-district"}) {
											{ i18n.T(ctx, i18n.KeyFieldDistrict) }
										}
										@components.Input(components.FieldProps{
											ID:        "addr-district",
											Value:     v.AddrValue("district"),
											Invalid:   v.AddrInvalid("district"),
											Describes: "addr-district-error",
											Name:      "district",
											Type:      "text",
											Attrs:     templ.Attributes{"required": true, "maxlength": "20", "autocomplete": "address-level2"},
										})
										if v.AddrInvalid("district") {
											<p class="ui-error-text" id="addr-district-error" role="alert">{ v.AddrErr("district") }</p>
										}
									</div>
									<div class="goen-field goen-account__field--wide">
										@components.Label(components.LabelProps{For: "addr-street"}) {
											{ i18n.T(ctx, i18n.KeyFieldStreet) }
										}
										@components.Input(components.FieldProps{
											ID:        "addr-street",
											Value:     v.AddrValue("street"),
											Invalid:   v.AddrInvalid("street"),
											Describes: "addr-street-error",
											Name:      "street",
											Type:      "text",
											Attrs:     templ.Attributes{"required": true, "maxlength": "200", "autocomplete": "street-address"},
										})
										if v.AddrInvalid("street") {
											<p class="ui-error-text" id="addr-street-error" role="alert">{ v.AddrErr("street") }</p>
										}
									</div>
								</div>
								<label class="goen-check">
									<input class="goen-check__box" type="checkbox" name="default" value="1" checked?={ v.AddrDefault() }/>
									<span>{ i18n.T(ctx, i18n.KeySetAsDefault) }</span>
								</label>
								<div class="goen-account__actions">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
										{ i18n.T(ctx, i18n.KeySaveAddress) }
									}
								</div>
							</form>
						</details>
					</section>
					<section class="goen-card goen-account__section" aria-labelledby="email-heading">
						<h2 class="goen-account__heading" id="email-heading">{ i18n.T(ctx, i18n.KeyEmailSection) }</h2>
						<p class="goen-account__value">
							{ v.Email }
							if v.EmailVerified {
								@components.Badge(components.BadgeProps{}) {
									{ i18n.T(ctx, i18n.KeyEmailVerified) }
								}
							} else {
								@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
									{ i18n.T(ctx, i18n.KeyEmailUnverified) }
								}
							}
						</p>
						if !v.EmailVerified {
							<p class="goen-account__meta">{ i18n.T(ctx, i18n.KeyEmailUnverifiedHint) }</p>
							<form class="goen-account__form" method="post" action="/account/email/resend">
								<div class="goen-account__actions">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
										{ i18n.T(ctx, i18n.KeyEmailResend) }
									}
								</div>
							</form>
						}
						if v.PendingEmail != "" {
							<p class="goen-account__meta">
								{ fmt.Sprintf(i18n.T(ctx, i18n.KeyEmailPending), v.PendingEmail) }
							</p>
						}
						<details class="goen-account__disclosure">
							<summary class="goen-account__summary">{ i18n.T(ctx, i18n.KeyEmailChange) }</summary>
							<form class="goen-account__form" method="post" action="/account/email">
								<p class="goen-account__meta">{ i18n.T(ctx, i18n.KeyEmailChangeHint) }</p>
								<div class="goen-account__fields">
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "new-email"}) {
											{ i18n.T(ctx, i18n.KeyFieldNewEmail) }
										}
										@components.Input(components.FieldProps{
											ID:    "new-email",
											Name:  "email",
											Type:  "email",
											Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{"required": true, "autocomplete": "email"}),
										})
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "email-current"}) {
											{ i18n.T(ctx, i18n.KeyFieldCurrentPassword) }
										}
										@components.Input(components.FieldProps{
											ID:    "email-current",
											Name:  "current",
											Type:  "password",
											Attrs: templ.Attributes{"required": true, "autocomplete": "current-password"},
										})
									</div>
								</div>
								<div class="goen-account__actions">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
										{ i18n.T(ctx, i18n.KeyEmailChange) }
									}
								</div>
							</form>
						</details>
					</section>
					<section class="goen-card goen-account__section" aria-labelledby="password-heading">
						<h2 class="goen-account__heading" id="password-heading">{ i18n.T(ctx, i18n.KeyChangePassword) }</h2>
						<details class="goen-account__disclosure">
							<summary class="goen-account__summary">{ i18n.T(ctx, i18n.KeyChangePassword) }</summary>
							<form class="goen-account__form" method="post" action="/account/password">
								<div class="goen-account__fields">
									<div class="goen-field goen-account__field--wide">
										@components.Label(components.LabelProps{For: "pw-current"}) {
											{ i18n.T(ctx, i18n.KeyFieldCurrentPassword) }
										}
										@components.Input(components.FieldProps{
											ID:    "pw-current",
											Name:  "current",
											Type:  "password",
											Attrs: templ.Attributes{"required": true, "autocomplete": "current-password"},
										})
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "pw-new"}) {
											{ i18n.T(ctx, i18n.KeyFieldNewPassword) }
										}
										@components.Input(components.FieldProps{
											ID:   "pw-new",
											Name: "password",
											Type: "password",
											Attrs: templ.Attributes{
												"required":         true,
												"minlength":        "10",
												"autocomplete":     "new-password",
												"aria-describedby": "pw-hint",
											},
										})
										<p class="goen-account__hint" id="pw-hint">{ i18n.T(ctx, i18n.KeyPasswordHintEndsSessions) }</p>
									</div>
									<div class="goen-field">
										@components.Label(components.LabelProps{For: "pw-confirm"}) {
											{ i18n.T(ctx, i18n.KeyFieldConfirmNewPassword) }
										}
										@components.Input(components.FieldProps{
											ID:    "pw-confirm",
											Name:  "confirm",
											Type:  "password",
											Attrs: templ.Attributes{"required": true, "autocomplete": "new-password"},
										})
									</div>
								</div>
								<div class="goen-account__actions">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary}, "submit") {
										{ i18n.T(ctx, i18n.KeyChangePassword) }
									}
								</div>
							</form>
						</details>
					</section>
					if v.GoogleLinked {
						<section class="goen-card goen-account__section" aria-labelledby="google-heading">
							<h2 class="goen-account__heading" id="google-heading">{ i18n.T(ctx, i18n.KeyLinkedAccounts) }</h2>
							<p class="goen-account__value">{ i18n.T(ctx, i18n.KeyGoogleLinked) }</p>
							if v.CanUnlinkGoogle {
								<form class="goen-account__form" method="post" action="/account/google/unlink">
									<div class="goen-account__actions">
										@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline}, "submit") {
											{ i18n.T(ctx, i18n.KeyUnlinkGoogle) }
										}
									</div>
								</form>
							} else {
								<p class="goen-account__meta">{ i18n.T(ctx, i18n.KeyGoogleOnlyMethod) }</p>
							}
						</section>
					}
					<section class="goen-card goen-account__section goen-account__section--danger" aria-labelledby="erase-heading">
						<h2 class="goen-account__heading" id="erase-heading">{ i18n.T(ctx, i18n.KeyEraseAccount) }</h2>
						<p class="goen-account__meta">{ i18n.T(ctx, i18n.KeyEraseWarning) }</p>
						<details class="goen-account__disclosure">
							<summary class="goen-account__summary">{ i18n.T(ctx, i18n.KeyEraseDisclosure) }</summary>
							<form class="goen-account__form" method="post" action="/account/erase">
								<div class="goen-field">
									@components.Label(components.LabelProps{For: "erase-confirm"}) {
										{ fmt.Sprintf(i18n.T(ctx, i18n.KeyEraseConfirmLabel), v.Email) }
									}
									@components.Input(components.FieldProps{
										ID:    "erase-confirm",
										Name:  "confirm",
										Type:  "text",
										Attrs: templ.Attributes{"required": true, "autocomplete": "off"},
									})
								</div>
								<div class="goen-account__actions">
									@components.Button(components.ButtonProps{ButtonStyle: components.ButtonStyleOutline, Class: "goen-account__erase"}, "submit") {
										{ i18n.T(ctx, i18n.KeyEraseSubmit) }
									}
								</div>
							</form>
						</details>
					</section>
				</div>
			</div>
		</div>
	}
}
