package pages

import "github.com/koopa0/goen/internal/ui/layouts"

// AdminTaxonomy renders the brands and the category tree with their forms.
templ AdminTaxonomy(p layouts.Page, v *AdminTaxonomyView) {
	@layouts.Base(p) {
		<div class="goen-admin">
			@adminNav("taxonomy")
			<div class="ui-page-head">
				<div>
					<p class="ui-page-head__eyebrow">後台</p>
					<h1 class="ui-page-head__title">品牌與分類</h1>
					<p class="ui-page-head__sub">
						名稱可以改,網址代稱不行 —— 它在每個已經被索引和分享出去的連結裡。
						需要不同的代稱就建一個新的,再把商品移過去。
					</p>
				</div>
			</div>
			if v.Notice != "" {
				<p class="ui-alert ui-alert--info" role="status">{ v.Notice }</p>
			}
			<div class="goen-admin__productlayout">
				@taxonForm("brands", "新增品牌", v)
				@taxonList("brands", "品牌", v.Brands, v)
			</div>
			<div class="goen-admin__productlayout">
				@taxonForm("categories", "新增分類", v)
				@taxonList("categories", "分類", v.Categories, v)
			</div>
		</div>
	}
}

// taxonForm is the create form for one kind.
templ taxonForm(kind, title string, v *AdminTaxonomyView) {
	<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/taxonomy/" + kind) }>
		<h2 class="goen-admin__subhead">{ title }</h2>
		<div class="ui-field">
			<label class="ui-label" for={ kind + "-name" }>名稱</label>
			<input
				class="ui-input"
				id={ kind + "-name" }
				name="name"
				required
				maxlength="60"
				value={ v.DraftFor(kind, "name") }
				if v.HasErr(kind, "name") {
					aria-invalid="true"
				}
			/>
			if v.HasErr(kind, "name") {
				<p class="ui-error-text">{ v.Err(kind, "name") }</p>
			}
		</div>
		if kind == "categories" {
			// Categories only. A category name is in the header of EVERY page, so
			// leaving it untranslated is the half-English site the locale work
			// exists to prevent; a brand name is a proper noun and reads the same
			// either way.
			<div class="ui-field">
				<label class="ui-label" for={ kind + "-name-en" }>英文名稱</label>
				<input
					class="ui-input"
					id={ kind + "-name-en" }
					name="name_en"
					maxlength="60"
					value={ v.DraftFor(kind, "name_en") }
					if v.HasErr(kind, "name_en") {
						aria-invalid="true"
					}
				/>
				if v.HasErr(kind, "name_en") {
					<p class="ui-error-text">{ v.Err(kind, "name_en") }</p>
				}
				<p class="goen-admin__hint">
					留空的話,英文網站會顯示中文名稱 —— 讀得懂,但看得出還沒翻。
				</p>
			</div>
		}
		<div class="ui-field">
			<label class="ui-label" for={ kind + "-slug" }>網址代稱</label>
			<input
				class="ui-input"
				id={ kind + "-slug" }
				name="slug"
				required
				maxlength="120"
				placeholder="aurora"
				value={ v.DraftFor(kind, "slug") }
				if v.HasErr(kind, "slug") {
					aria-invalid="true"
				}
			/>
			if v.HasErr(kind, "slug") {
				<p class="ui-error-text">{ v.Err(kind, "slug") }</p>
			}
			<p class="goen-admin__hint">建立之後就不能改。</p>
		</div>
		if kind == "categories" {
			<div class="ui-field">
				<label class="ui-label" for="categories-parent">上層分類(選填)</label>
				<input
					class="ui-input"
					id="categories-parent"
					name="parent"
					maxlength="120"
					placeholder="phones"
					list="category-slugs"
					value={ v.DraftFor(kind, "parent") }
					if v.HasErr(kind, "parent") {
						aria-invalid="true"
					}
				/>
				// A datalist and not a select: it suggests without preventing,
				// so the field still works with the list unrendered and a
				// staff member can type a slug they know.
				<datalist id="category-slugs">
					for _, c := range v.Categories {
						<option value={ c.Slug }>{ c.Name }</option>
					}
				</datalist>
				if v.HasErr(kind, "parent") {
					<p class="ui-error-text">{ v.Err(kind, "parent") }</p>
				}
				<p class="goen-admin__hint">留空就是最上層。</p>
			</div>
		}
		<button class="ui-btn ui-btn--primary" type="submit">建立</button>
	</form>
}

// taxonList is one kind's rows, each with rename and delete.
templ taxonList(kind, title string, rows []AdminTaxon, v *AdminTaxonomyView) {
	<aside class="goen-admin__side">
		<h2 class="goen-admin__subhead">{ title }</h2>
		if len(rows) == 0 {
			<p class="goen-admin__hint">還沒有任何{ title }。</p>
		} else {
			<ul class="goen-admin__taxa" role="list">
				for _, t := range rows {
					<li class="goen-admin__taxon" style={ t.Indent() }>
						<form class="goen-admin__taxonform" method="post" action={ templ.SafeURL("/admin/taxonomy/" + kind + "/" + t.Slug) }>
							<input class="ui-input" name="name" value={ t.Name } required maxlength="60" aria-label={ t.Name + " 的名稱" }/>
							if kind == "categories" {
								// Rendered WITH its current value, not as an empty box.
								// Empty means "no translation" and the rename clears it,
								// so a blank field here would silently un-translate a
								// category every time somebody fixed a typo in its
								// Chinese name.
								<input
									class="ui-input"
									name="name_en"
									value={ t.NameEn }
									maxlength="60"
									placeholder="English"
									aria-label={ t.Name + " 的英文名稱" }
								/>
							}
							<button class="ui-btn ui-btn--secondary" type="submit" name="action" value="rename">更名</button>
							if t.Removable() {
								<button class="ui-btn ui-btn--secondary" type="submit" name="action" value="delete">刪除</button>
							}
						</form>
						<span class="ui-cart-line__meta">
							{ t.Slug }
							if kind == "categories" && !t.Translated() {
								// Said out loud, because this is the one page that can
								// fix it. An untranslated category shows its Chinese
								// name in the header of every page an English visitor
								// reads — visible to them and to nobody at the shop.
								<span class="ui-badge ui-badge--warn">未翻譯</span>
							}
							if t.Parent != "" {
								· 在 { t.Parent } 之下
							}
							if !t.Removable() {
								· { t.Why(ctx) }
							}
						</span>
					</li>
				}
			</ul>
		}
	</aside>
}
