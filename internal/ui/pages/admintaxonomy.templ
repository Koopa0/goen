package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// AdminTaxonomy renders the brands and the category tree with their forms.
//
// Two cards, each holding what it lists and the form that adds to it, because
// a brand and a category are separate jobs and the list is what a reader checks
// before typing into the form under it.
//
// The one filled button on the page is the category create. The tree is what
// the storefront's navigation is built from, and a row of equally weighted
// buttons makes a reader choose before they act.
templ AdminTaxonomy(p layouts.Page, v *AdminTaxonomyView) {
	@layouts.Admin(p, "taxonomy") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageTaxonomy) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminTaxLead) }
				</p>
			</div>
		</div>
		if v.Notice != "" {
			@components.Notice(components.NoticeProps{Tone: components.ToneAccent}) {
				{ v.Notice }
			}
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminTaxBrands) }</h2>
			@taxonList("brands", i18n.KeyAdminTaxNoBrands, v.Brands)
			@taxonForm("brands", i18n.KeyAdminTaxNewBrand, components.VariantOutline, v)
		}
		@components.Card(components.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminTaxCategories) }</h2>
			@taxonList("categories", i18n.KeyAdminTaxNoCategories, v.Categories)
			@taxonForm("categories", i18n.KeyAdminTaxNewCategory, components.VariantPrimary, v)
		}
	}
}

// taxonForm adds a brand or a category. Its fields keep the ids and names the
// handler and its tests read; only the boxes around them are new.
templ taxonForm(kind string, title i18n.Key, weight components.Variant, v *AdminTaxonomyView) {
	<form class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/taxonomy/" + kind) }>
		<h3 class="goen-admin__subhead">{ i18n.T(ctx, title) }</h3>
		if v.HasErr(kind, "form") {
			<p class="ui-error-text" role="alert">{ v.Err(kind, "form") }</p>
		}
		<div class="goen-admin__fields">
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: kind + "-name"}) {
					{ i18n.T(ctx, i18n.KeyAdminColName) }
				}
				<input
					class="goen-input"
					id={ kind + "-name" }
					name="name"
					required
					maxlength="60"
					value={ v.DraftFor(kind, "name") }
					if v.HasErr(kind, "name") {
						aria-invalid="true"
						aria-describedby={ kind + "-name" + "-error" }
					}
				/>
				if v.HasErr(kind, "name") {
					<p class="ui-error-text" id={ kind + "-name" + "-error" }>{ v.Err(kind, "name") }</p>
				}
			</div>
			if kind == "categories" {
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: kind + "-name-en"}) {
						{ i18n.T(ctx, i18n.KeyAdminTaxNameEn) }
					}
					<input
						class="goen-input"
						id={ kind + "-name-en" }
						name="name_en"
						maxlength="60"
						value={ v.DraftFor(kind, "name_en") }
						if v.HasErr(kind, "name_en") {
							aria-invalid="true"
							aria-describedby={ kind + "-name-en" + "-error" }
						}
					/>
					if v.HasErr(kind, "name_en") {
						<p class="ui-error-text" id={ kind + "-name-en" + "-error" }>{ v.Err(kind, "name_en") }</p>
					}
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminTaxNameEnHint) }
					</p>
				</div>
			}
			<div class="goen-admin__field">
				@components.Label(components.LabelProps{For: kind + "-slug"}) {
					{ i18n.T(ctx, i18n.KeyAdminColSlug) }
				}
				<input
					class="goen-input"
					id={ kind + "-slug" }
					name="slug"
					required
					maxlength="120"
					placeholder="aurora"
					value={ v.DraftFor(kind, "slug") }
					if v.HasErr(kind, "slug") {
						aria-invalid="true"
						aria-describedby={ kind + "-slug" + "-error" }
					}
				/>
				if v.HasErr(kind, "slug") {
					<p class="ui-error-text" id={ kind + "-slug" + "-error" }>{ v.Err(kind, "slug") }</p>
				}
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminTaxSlugFixed) }</p>
			</div>
			if kind == "categories" {
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "categories-icon"}) {
						{ i18n.T(ctx, i18n.KeyAdminColIcon) }
					}
					<select class="goen-input" id="categories-icon" name="icon_key">
						<option value="">{ i18n.T(ctx, i18n.KeyAdminIconNone) }</option>
						for _, k := range icons.CategoryKeys() {
							<option value={ k } selected?={ v.DraftFor(kind, "icon_key") == k }>{ k }</option>
						}
					</select>
					if v.HasErr(kind, "icon_key") {
						<p class="ui-error-text">{ v.Err(kind, "icon_key") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@components.Label(components.LabelProps{For: "categories-parent"}) {
						{ i18n.T(ctx, i18n.KeyAdminTaxParent) }
					}
					<input
						class="goen-input"
						id="categories-parent"
						name="parent"
						maxlength="120"
						placeholder="phones"
						list="category-slugs"
						value={ v.DraftFor(kind, "parent") }
						if v.HasErr(kind, "parent") {
							aria-invalid="true"
							aria-describedby="categories-parent-error"
						}
					/>
					<datalist id="category-slugs">
						for _, c := range v.Categories {
							<option value={ c.Slug }>{ c.Name }</option>
						}
					</datalist>
					if v.HasErr(kind, "parent") {
						<p class="ui-error-text" id="categories-parent-error">{ v.Err(kind, "parent") }</p>
					}
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminTaxParentHint) }</p>
				</div>
			}
		</div>
		@components.Button(components.ButtonProps{Variant: weight, Class: "goen-admin__submit"}, "submit") {
			{ i18n.T(ctx, i18n.KeyAdminTaxCreate) }
		}
	</form>
}

// taxonList is the tree. The indent is carried by data-depth and read by an
// attribute selector, because style-src holds no 'unsafe-inline' and a refused
// inline custom property would render the whole tree flat (#379).
templ taxonList(kind string, empty i18n.Key, rows []AdminTaxon) {
	if len(rows) == 0 {
		<div class="goen-admin__empty">
			<p class="goen-admin__emptytitle">{ i18n.T(ctx, empty) }</p>
		</div>
	} else {
		<ul class="goen-admin__taxa" role="list">
			for _, t := range rows {
				<li class="goen-admin__taxon" data-depth={ t.DepthText() }>
					<form class="goen-admin__taxonform" method="post" action={ templ.SafeURL("/admin/taxonomy/" + kind + "/" + t.Slug) }>
						<input
							class="goen-input"
							name="name"
							value={ t.Name }
							required
							maxlength="60"
							aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxNameOf), t.Name) }
						/>
						if kind == "categories" {
							// Rendered with its current value: the rename writes what the form carries.
							<input
								class="goen-input"
								name="name_en"
								value={ t.NameEn }
								maxlength="60"
								placeholder="English"
								aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxNameEnOf), t.Name) }
							/>
							<select
								class="goen-input"
								name="icon_key"
								aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxIconOf), t.Name) }
							>
								<option value="">{ i18n.T(ctx, i18n.KeyAdminIconNone) }</option>
								for _, k := range icons.CategoryKeys() {
									<option value={ k } selected?={ t.IconKey == k }>{ k }</option>
								}
							</select>
						}
						@components.Button(components.ButtonProps{
							Variant: components.VariantOutline,
							Size:    components.SizeSmall,
							Attrs:   templ.Attributes{"name": "action", "value": "rename"},
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminTaxRename) }
						}
						if t.Removable() {
							@components.Button(components.ButtonProps{
								Variant: components.VariantGhost,
								Size:    components.SizeSmall,
								Attrs:   templ.Attributes{"name": "action", "value": "delete"},
							}, "submit") {
								{ i18n.T(ctx, i18n.KeyAdminDelete) }
							}
						}
					</form>
					<span class="goen-admin__meta">
						{ t.Slug }
						if kind == "categories" && !t.Translated() {
							@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
								{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
							}
						}
						if t.Parent != "" {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxUnder), t.Parent) }
						}
						if !t.Removable() {
							· { t.Why(ctx) }
						}
					</span>
				</li>
			}
		</ul>
	}
}
