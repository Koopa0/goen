package pages

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// Returns is the customer's return request form.
templ Returns(p layouts.Page, v ReturnsView) {
	@layouts.Base(p) {
		<div class="goen-returns">
			<div class="goen-pagehead">
				<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, i18n.KeyReturnTitle) }</p>
				<h1 class="goen-pagehead__title">{ v.Number }</h1>
				<p class="goen-pagehead__sub">
					{ i18n.T(ctx, i18n.KeyReturnSub) }
				</p>
			</div>
			if v.Error != "" {
				// Written out rather than composed, because the textarea's
				// aria-describedby points at this id and the guard in
				// aria_test.go reads both out of this file's source.
				<p
					class="goen-notice goen-notice--danger"
					role="alert"
					id="return-reason-error"
				>{ v.Error }</p>
			}
			if len(v.Existing) > 0 {
				@components.Card(components.CardProps{
					Class: "goen-returns__existing",
					Attrs: templ.Attributes{"aria-labelledby": "existing-heading"},
				}) {
					<h2 id="existing-heading" class="goen-returns__subhead">{ i18n.T(ctx, i18n.KeyReturnHistory) }</h2>
					<ul class="goen-returns__records" role="list">
						for _, e := range v.Existing {
							<li class="goen-returns__record">
								<span class="goen-returns__recordbody">
									<span class="goen-returns__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReturnSentAt), e.CreatedAt) }</span>
									<span class="goen-returns__meta">{ e.Reason }</span>
									if e.Resolution != "" {
										<span class="goen-returns__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReturnResolution), e.Resolution) }</span>
									}
								</span>
								if e.Resolution != "" {
									@components.Badge(components.BadgeProps{Tone: components.ToneNeutral}) {
										{ e.StatusText }
									}
								} else {
									@components.Badge(components.BadgeProps{Tone: components.ToneWarn}) {
										{ e.StatusText }
									}
								}
							</li>
						}
					</ul>
				}
			}
			if v.HasOpen {
				@components.Notice(components.NoticeProps{Tone: components.ToneAccent, ID: "return-inflight"}) {
					{ i18n.T(ctx, i18n.KeyReturnInFlight) }
				}
			} else if !v.AnyReturnable() {
				@components.Notice(components.NoticeProps{Tone: components.ToneAccent, ID: "return-nothing"}) {
					{ i18n.T(ctx, i18n.KeyReturnNothing) }
				}
			} else {
				@components.Card(components.CardProps{Class: "goen-returns__panel"}) {
					<form class="goen-returns__form" method="post" action={ templ.SafeURL(v.Action()) }>
						<fieldset class="goen-returns__lines">
							<legend class="goen-returns__subhead">{ i18n.T(ctx, i18n.KeyReturnChoose) }</legend>
							for _, l := range v.Lines {
								if l.CanReturn() {
									<div class="goen-returns__line">
										<div class="goen-returns__recordbody">
											<p class="goen-returns__name">{ l.Name }</p>
											if l.Label != "" {
												<span class="goen-returns__meta">{ l.Label }</span>
											}
											<span class="goen-returns__meta">{ l.SKU } · { l.UnitPrice() }</span>
										</div>
										<div class="goen-field goen-returns__qty">
											@components.Label(components.LabelProps{For: l.Field()}) {
												{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReturnQuantity), l.Max()) }
											}
											@components.Input(components.FieldProps{
												ID:    l.Field(),
												Name:  l.Field(),
												Type:  "number",
												Value: l.ChosenText(),
												Attrs: templ.Attributes{
													"min":       "0",
													"max":       l.Max(),
													"step":      "1",
													"inputmode": "numeric",
												},
											})
										</div>
									</div>
								}
							}
						</fieldset>
						<div class="goen-field">
							@components.Label(components.LabelProps{For: "return-reason"}) {
								{ i18n.T(ctx, i18n.KeyFieldReturnReason) }
							}
							// Written out rather than composed: internal/site/policy_test.go
							// reads this element out of this file to decide whether the
							// policy page may say a reason is required.
							<textarea
								class="goen-input goen-input--area"
								id="return-reason"
								name="reason"
								rows="4"
								maxlength="500"
								if v.Error != "" {
									aria-invalid="true"
									aria-describedby="return-reason-error"
								}
							>{ v.Reason }</textarea>
						</div>
						<div class="goen-returns__actions">
							@components.Button(components.ButtonProps{Variant: components.VariantPrimary}, "submit") {
								{ i18n.T(ctx, i18n.KeyReturnSubmit) }
							}
							@components.ButtonLink(components.ButtonProps{
								Variant: components.VariantGhost,
							}, templ.SafeURL("/orders/"+v.Number)) {
								{ i18n.T(ctx, i18n.KeyBackToOrder) }
							}
						</div>
					</form>
				}
			}
			if v.HasOpen || !v.AnyReturnable() {
				<div class="goen-returns__actions">
					@components.ButtonLink(components.ButtonProps{
						Variant: components.VariantOutline,
					}, templ.SafeURL("/orders/"+v.Number)) {
						{ i18n.T(ctx, i18n.KeyBackToOrder) }
					}
				</div>
			}
		</div>
	}
}
