package chart

// Meter is how much of a limit is used, with the count as text beside it. It is
// hidden from assistive technology rather than a native <meter>: the row's own
// text already says the uses and the limit, and a <meter> would read them a
// second time while its pieces cannot be styled the same in every browser.
templ Meter(p MeterProps) {
	<div class="goen-chartmeter" aria-hidden="true">
		<svg width="100%" height="10" aria-hidden="true" focusable="false">
			<rect class="goen-chartmeter__track" x="0" y="0" width="100%" height="10"></rect>
			if p.Value > 0 {
				<rect class="goen-chartmeter__fill" x="0" y="0" width={ p.width() } height="10"></rect>
			}
		</svg>
		<span class="goen-chartmeter__label">{ p.Label }</span>
	</div>
}
