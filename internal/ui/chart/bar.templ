package chart

// Bar is a horizontal bar inside a list row or table cell, with its value as
// text beside it. It is hidden from assistive technology: the row's own text
// carries the value.
templ Bar(p BarProps) {
	<div class={ "goen-chartbar", templ.KV("goen-chartbar--wide", p.wide()) } aria-hidden="true">
		<svg width="100%" height="8" aria-hidden="true" focusable="false">
			<rect class="goen-chartbar__track" x="0" y="0" width="100%" height="8"></rect>
			if p.Value > 0 {
				<rect class="goen-chartbar__fill" x="0" y="0" width={ p.width() } height="8"></rect>
			}
		</svg>
		<span class="goen-chartbar__label">{ p.Label }</span>
	</div>
}
