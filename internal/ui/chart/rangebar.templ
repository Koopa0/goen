package chart

// RangeBar is a bar inside a list row with the range its value may lie in drawn
// under it and a reference line across both. It is hidden from assistive
// technology: the row's own text carries the value, the range and the line.
templ RangeBar(p RangeBarProps) {
	<div class="goen-rangebar" aria-hidden="true">
		<svg width="100%" height="16" aria-hidden="true" focusable="false">
			<line class="goen-rangebar__track" x1="0" x2="100%" y1="7.5" y2="7.5"></line>
			if p.Value > 0 {
				<rect class="goen-rangebar__fill" x="0" y="2" width={ p.position(p.Value) } height="6"></rect>
			}
			if p.ranged() {
				<line class="goen-rangebar__range" x1={ p.position(p.Low) } x2={ p.position(p.High) } y1="11.5" y2="11.5"></line>
				<line class="goen-rangebar__cap" x1={ p.position(p.Low) } x2={ p.position(p.Low) } y1="9.5" y2="13.5"></line>
				<line class="goen-rangebar__cap" x1={ p.position(p.High) } x2={ p.position(p.High) } y1="9.5" y2="13.5"></line>
			}
			<line class="goen-rangebar__mark" x1={ p.position(p.Mark) } x2={ p.position(p.Mark) } y1="0" y2="16"></line>
		</svg>
	</div>
}
