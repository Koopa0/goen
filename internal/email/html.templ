package email

// letterHTML is every letter's HTML part: the brand header, then the letter's
// own paragraphs.
//
// Every style is inline, because mail clients drop a <style> block and never
// fetch a stylesheet. Every colour is explicit, so no client's default can put
// dark text on a dark ground; ink and link are the mark's two colours. The
// width and height attributes are for the clients that ignore CSS sizes, and
// the alt text and ground colour are what shows while images are off.
templ letterHTML(lang, header string, body []paragraph) {
	<!DOCTYPE html>
	<html lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
		</head>
		<body style="margin: 0; padding: 0; background-color: #ffffff; color: #1b1b15">
			<table
				role="presentation"
				align="center"
				width="600"
				cellpadding="0"
				cellspacing="0"
				border="0"
				style="
		width: 100%;
		max-width: 600px;
		margin: 0 auto;
		background-color: #ffffff;
	"
			>
				<tr>
					<td style="background-color: #f9f9f9">
						<img
							src={ header }
							width="600"
							height="150"
							alt="goen"
							style="
		display: block;
		width: 100%;
		max-width: 600px;
		height: auto;
		border: 0;
		background-color: #f9f9f9;
		color: #1b1b15;
		font-family: Helvetica, Arial, sans-serif;
		font-size: 28px;
		font-weight: bold;
	"
						/>
					</td>
				</tr>
				<tr>
					<td style="padding:24px 16px;font-family:Helvetica,Arial,'PingFang TC','Microsoft JhengHei','Noto Sans TC',sans-serif;font-size:16px;line-height:1.6;color:#1b1b15;">
						for _, p := range body {
							<p style="margin: 0 0 16px">
								for i, line := range p {
									if i > 0 {
										<br/>
									}
									for _, s := range line {
										if s.link {
											<a href={ templ.URL(s.text) } style="color: #26395a; text-decoration: underline; word-break: break-all">{ s.text }</a>
										} else {
											{ s.text }
										}
									}
								}
							</p>
						}
					</td>
				</tr>
			</table>
		</body>
	</html>
}
