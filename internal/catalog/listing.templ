package catalog

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/policy"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/tile"
	"github.com/koopa0/goen/internal/ui/widget"
)

// rules and head are nil where the page has none to state.
//
// The head is words on the page, as a catalogue's section opens: the crumbs, the
// name, how many products, and the sub-categories in one row under them, the
// current one underlined. No photograph: the products are the pictures.
templ Listing(p frame.Page, v ListingView, rules *policy.Rules, head *DepartmentHead) {
	@frame.Base(p) {
		<div class="goen-listing__head">
			<div class="goen-pagehead">
				@widget.Breadcrumb(widget.BreadcrumbProps{
					Label:  i18n.T(ctx, i18n.KeyBreadcrumb),
					Crumbs: v.Trail(ctx),
				})
				<h1 class="goen-pagehead__title">{ v.Name }</h1>
				// Empty at zero: the empty state says nothing matched, and a count of
				// none would only repeat it. The box stays so a swap can fill it.
				<p class="goen-listing__count" id="listing-count" aria-hidden="true">
					if !v.Empty() {
						{ i18n.Count(ctx, i18n.KeyListingCount, v.Total, v.TotalText()) }
					}
				</p>
				if head != nil && head.Notice != nil {
					@departmentNotice(head.Notice)
				}
			</div>
			if len(v.Children()) > 1 {
				<nav class="goen-subindex" aria-label={ i18n.T(ctx, i18n.KeySubcategories) }>
					for _, c := range v.Children() {
						if c.Slug == v.Slug {
							<a class="goen-subindex__link" href={ templ.URL("/c/" + c.Slug) } aria-current="page">{ c.Name }</a>
						} else {
							<a class="goen-subindex__link" href={ templ.URL("/c/" + c.Slug) }>{ c.Name }</a>
						}
					}
				</nav>
			}
		</div>
		<div class="goen-listing">
			if head != nil {
				@departmentSlot(head)
			}
			<div class="goen-listing__layout">
				@listingFilters(v)
				<div class="goen-listing__main">
					@appliedFilters(v)
					<div
						class="goen-listing__results"
						id="listing-results"
						tabindex="-1"
						autofocus?={ v.Filtered && !isPartial(ctx) }
					>
						if v.Empty() {
							// The way back to everything is a secondary link, ink with a faint
							// line: the page's next step is to loosen a filter, not to leave.
							<div class="ui-empty goen-listing__empty">
								<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyListingEmpty) }</p>
								<p class="goen-empty__text">
									{ i18n.T(ctx, i18n.KeyListingEmptyHint) }<a class="goen-listing__all" href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyListingEmptyLink) }</a>
								</p>
							</div>
						} else {
							<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
							@compareForm(tile.AnyComparable(v.Grid())) {
								<ul class="goen-tiles__grid" role="list">
									for _, t := range v.Grid() {
										@tile.Cell(t)
									}
								</ul>
							}
							@showMore(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
						}
					</div>
				</div>
			</div>
			if rules != nil && !isPartial(ctx) {
				@policy.RulesSection(*rules)
			}
			if isPartial(ctx) {
				// The rail is not swapped, or the box the shopper just used would lose focus;
				// its counts are, because they follow the filters.
				for _, group := range v.Facets {
					for position, option := range group.Options {
						<span class="goen-filters__count" id={ group.CountID(position) } hx-swap-oob="true">{ option.CountText() }</span>
					}
					<span class="goen-filters__selected" id={ group.SelectedID() } hx-swap-oob="true">
						@selectedCount(group.SelectedCount())
					</span>
				}
				<span class="goen-filters__selected" id={ stockSelectedID } hx-swap-oob="true">
					@selectedCount(v.StockSelected())
				</span>
				<span class="goen-filters__selected" id={ priceSelectedID } hx-swap-oob="true">
					@selectedCount(v.PriceSelected())
				</span>
			}
		</div>
	}
}

// The form holds the filters and the sort. On a phone the filters fold into one
// disclosure named for them and the sort stays beside it, outside the fold; from
// 1024 the disclosure is forced open into a row of menus.
templ listingFilters(v ListingView) {
	<div class="goen-listing__filters">
		// With script, a changed control fetches the URL the button would have navigated
		// to and swaps the results, chips and announced count; the button stays for a
		// browser without script. A price box fires nothing until left or Enter.
		<form
			class="goen-filters"
			method="get"
			action={ templ.SafeURL(v.FilterAction()) }
			hx-get={ "/c/" + v.Slug }
			hx-trigger="change delay:300ms"
			hx-target="#listing-results"
			hx-select="#listing-results"
			hx-select-oob="#filters-applied, #listing-status:innerHTML, #listing-count:innerHTML, #listing-sort:innerHTML"
			hx-swap="outerHTML"
			hx-push-url="true"
			hx-sync="this:replace"
			hx-status:4xx="swap:none"
			hx-status:5xx="swap:none"
		>
			// Keeps the outline unbroken: without an h2 between the page title and a tile's
			// h3 the document skips a level (check-layout.mjs reads that as a defect).
			<h2 class="goen-filters__title">{ i18n.T(ctx, i18n.KeyFilters) }</h2>
			<details class="goen-filters__shell">
				<summary class="goen-filters__shell-summary">{ i18n.T(ctx, i18n.KeyFilters) }</summary>
				<div class="goen-filters__menus">
					for _, group := range v.Facets {
						<details class="goen-filters__group" name="filters" data-popover>
							<summary class="goen-filters__summary">
								{ group.Label }
								@selectedBadge(group.SelectedID(), group.SelectedCount())
							</summary>
							<div class="goen-filters__options">
								for position, option := range group.Options {
									<label class="goen-filters__option">
										<input type="checkbox" name={ group.Param() } value={ option.Value } class="goen-check" checked?={ option.Selected }/>
										<span class="goen-filters__label">{ option.Label }</span>
										<span class="goen-filters__count" id={ group.CountID(position) }>{ option.CountText() }</span>
									</label>
								}
							</div>
						</details>
					}
					<details class="goen-filters__group" name="filters" data-popover>
						<summary class="goen-filters__summary">
							{ i18n.T(ctx, i18n.KeyFacetStock) }
							@selectedBadge(stockSelectedID, v.StockSelected())
						</summary>
						<div class="goen-filters__options">
							<label class="goen-filters__option">
								<input type="checkbox" name="in_stock" value="1" class="goen-check" checked?={ v.InStockOnly }/>
								<span class="goen-filters__label">{ i18n.T(ctx, i18n.KeyFacetInStock) }</span>
							</label>
						</div>
					</details>
					<details class="goen-filters__group" name="filters" data-popover>
						<summary class="goen-filters__summary">
							{ i18n.T(ctx, i18n.KeyFacetPrice) }
							@selectedBadge(priceSelectedID, v.PriceSelected())
						</summary>
						<div class="goen-filters__prices">
							<label class="goen-sr-only" for="min-price">{ i18n.T(ctx, i18n.KeyPriceMin) }</label>
							// ui-input is what check-layout.mjs measures in its tap sweep; app.css writes the recipe.
							<input
								class="ui-input"
								id="min-price"
								type="number"
								name="min_price"
								inputmode="numeric"
								min="0"
								placeholder={ i18n.T(ctx, i18n.KeyPriceMinShort) }
								value={ v.MinPriceText() }
							/>
							<span class="goen-filters__dash" aria-hidden="true">–</span>
							<label class="goen-sr-only" for="max-price">{ i18n.T(ctx, i18n.KeyPriceMax) }</label>
							<input
								class="ui-input"
								id="max-price"
								type="number"
								name="max_price"
								inputmode="numeric"
								min="0"
								placeholder={ i18n.T(ctx, i18n.KeyPriceMaxShort) }
								value={ v.MaxPriceText() }
							/>
						</div>
					</details>
				</div>
			</details>
			<div class="goen-filters__end">
				// Nothing to sort when nothing is listed; the box stays so a swap can fill it.
				<div id="listing-sort" class="goen-filters__sort">
					if !v.Empty() {
						@sortField(v.SortOptions(ctx))
					}
				</div>
				@widget.Button(widget.ButtonProps{
					ButtonStyle: widget.ButtonStylePrimary,
					Block:       true,
					Class:       "goen-filters__apply",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyApplyFilters) }
				}
			</div>
		</form>
		// Shown by script when an update fails: the old results stay and this says why.
		<p class="goen-filters__error" role="alert" hidden>{ i18n.T(ctx, i18n.KeyCannotLoadListing) }</p>
		// Announced from here, a region that stays while the results around it are
		// replaced, so focus is left where it is.
		<p id="listing-status" class="goen-sr-only" role="status" aria-live="polite">{ i18n.Count(ctx, i18n.KeyListingCount, v.Total, v.TotalText()) }</p>
	</div>
}

// How many of a group's options are on, beside its name. The element is always
// drawn so a swapped response has a place to put the number.
templ selectedBadge(id string, n int64) {
	<span class="goen-filters__selected" id={ id }>
		@selectedCount(n)
	</span>
}

templ selectedCount(n int64) {
	if n > 0 {
		<span aria-hidden="true">{ strconv.FormatInt(n, 10) }</span>
		<span class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFiltersSelected), n) }</span>
	}
}

// Its own swap target: replaced by id beside the results.
templ appliedFilters(v ListingView) {
	<div id="filters-applied">
		if v.Filtered {
			<div class="goen-filters__applied">
				<span class="goen-filters__applied-label">{ i18n.T(ctx, i18n.KeyFiltersActive) }</span>
				<ul class="goen-filters__chips" role="list">
					for _, chip := range v.AppliedChips(ctx) {
						<li class="goen-filters__chip">
							<span>{ chip.Label }</span>
							<a class="goen-filters__chip-remove" href={ templ.URL(chip.Remove) } aria-label={ chip.RemoveLabel }><span aria-hidden="true">×</span></a>
						</li>
					}
				</ul>
				<a class="ui-filterbar__clear" href={ templ.URL("/c/" + v.Slug) }>{ i18n.T(ctx, i18n.KeyClearFilters) }</a>
			</div>
		}
	</div>
}

// Shared by the listing and the search; each owns what its empty value means.
templ sortField(options []SortOption) {
	<div class="goen-filters__field">
		@widget.Label(widget.LabelProps{For: "sort"}) {
			{ i18n.T(ctx, i18n.KeySort) }
		}
		<select class="ui-select" id="sort" name="sort">
			for _, o := range options {
				<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
			}
		</select>
	</div>
}

// A link to the next page, not a button: with scripting off it is the whole control.
// The progress line counts pages because each page replaces the one before it.
templ showMore(hasPrev, hasNext bool, prev, next, page, pages string) {
	if hasPrev || hasNext {
		<nav class="goen-pager goen-pager--more" aria-label={ i18n.T(ctx, i18n.KeyPagination) }>
			<p class="goen-pager__at">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPageOf), page, pages) }</p>
			<progress class="goen-pager__progress" value={ page } max={ pages } aria-hidden="true"></progress>
			<div class="goen-pager__links">
				if hasPrev {
					<a class="goen-pager__prev" href={ templ.URL(prev) } rel="prev">{ i18n.T(ctx, i18n.KeyPrevPage) }</a>
				}
				if hasNext {
					<a class="goen-btn goen-btn--outline" href={ templ.URL(next) } rel="next">{ i18n.T(ctx, i18n.KeyShowMore) }</a>
				}
			</div>
		</nav>
	}
}

// searchDepartments is the way on from a search page with nothing to show: the
// departments as the home page indexes them (frame.DepartmentIndex), under
// their heading.
templ searchDepartments() {
	if items := frame.TopNavFrom(ctx); len(items) > 0 {
		<section class="goen-search__section" aria-labelledby="search-departments">
			<h2 class="goen-search__heading" id="search-departments">{ i18n.T(ctx, i18n.KeySectionCategories) }</h2>
			@frame.DepartmentIndex()
		</section>
	}
}

templ searchNewest(v SearchView) {
	if len(v.Newest) > 0 {
		<section class="goen-search__section" aria-labelledby="search-newest">
			<h2 class="goen-listing__subhead" id="search-newest">{ i18n.T(ctx, i18n.KeySearchNewest) }</h2>
			@compareForm(tile.AnyComparable(v.Newest)) {
				<ul class="goen-tiles__grid" role="list">
					for _, t := range tile.FirstRowEager(v.Newest) {
						@tile.Cell(t)
					}
				</ul>
			}
		</section>
	}
}

// The search has no facets, so there is no filter rail. With nothing to show,
// the heading says so and the page offers the departments and the newest
// products as the way on.
templ Search(p frame.Page, v SearchView) {
	@frame.Base(p) {
		<div class="goen-listing goen-listing--search">
			<div class="goen-pagehead goen-pagehead--search">
				<h1 class="goen-pagehead__title">
					if !v.Searched() {
						{ i18n.T(ctx, i18n.KeySearchHeading) }
					} else if v.Empty() {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchNoResults), v.Query) }
					} else {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeySearchFor), v.Query) }
					}
				</h1>
				if !v.Searched() {
					<p class="goen-search__lead">{ i18n.T(ctx, i18n.KeySearchPrompt) }</p>
					<p class="goen-search__lead">{ i18n.T(ctx, i18n.KeySearchPromptHint) }</p>
				} else if v.Empty() {
					<p class="goen-search__lead">{ i18n.T(ctx, i18n.KeySearchNoResultsHint) }</p>
				}
			</div>
			if !v.Searched() || v.Empty() {
				@searchDepartments()
				@searchNewest(v)
			} else {
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				// With script, a changed sort fetches the URL the button would have navigated to
				// and swaps the results.
				<form
					class="goen-search-sort"
					method="get"
					action="/search"
					hx-get="/search"
					hx-trigger="change"
					hx-target="#search-results"
					hx-select="#search-results"
					hx-swap="outerHTML"
					hx-push-url="true"
					hx-sync="this:replace"
					hx-status:4xx="swap:none"
					hx-status:5xx="swap:none"
				>
					<input type="hidden" name="q" value={ v.Query }/>
					@sortField(v.SortOptions(ctx))
					@widget.Button(widget.ButtonProps{
						ButtonStyle: widget.ButtonStyleOutline,
						Class:       "goen-filters__apply",
					}, "submit") {
						{ i18n.T(ctx, i18n.KeySearchSortApply) }
					}
					<p class="goen-listing__count">{ i18n.Count(ctx, i18n.KeySearchResults, v.Total, v.TotalText()) }</p>
				</form>
				<p id="goen-search-sort-error" class="goen-filters__error" role="alert" hidden>{ i18n.T(ctx, i18n.KeyCannotLoadListing) }</p>
				<div id="search-results">
					@compareForm(tile.AnyComparable(v.Products)) {
						<ul class="goen-tiles__grid" role="list">
							for _, t := range tile.FirstRowEager(v.Products) {
								@tile.Cell(t)
							}
						</ul>
					}
					@showMore(v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
				</div>
			}
		</div>
	}
}
