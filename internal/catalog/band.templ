package catalog

import "github.com/koopa0/goen/internal/ui/widget"

// bandMedia is the band's first grid item: the photograph on goen's white,
// never on the tone.
templ bandMedia(imgClass, id string, p widget.Photo, onWell bool, sizes string) {
	<div class={ "goen-band__media", templ.KV("goen-band__media--well", onWell) }>
		<img
			class={ imgClass }
			src={ p.URL }
			srcset={ p.Srcset }
			sizes={ sizes }
			alt={ p.Alt }
			width="800"
			height="600"
			decoding="async"
			if id != "" {
				id={ id }
			}
		/>
	</div>
}
