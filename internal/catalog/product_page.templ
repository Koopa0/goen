package catalog

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/discount/campaign"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/shoptime"
	"github.com/koopa0/goen/internal/ui/fieldrule"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/tile"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ Product(p frame.Page, v *ProductView) {
	@frame.Base(awaiting(p, frame.AwaitBuyBox)) {
		<div class="goen-pdp">
			<div class="goen-pdp__intro">
				@widget.Breadcrumb(widget.BreadcrumbProps{
					Label:  i18n.T(ctx, i18n.KeyBreadcrumb),
					Crumbs: v.Trail(ctx),
				})
				<div class="goen-pdp__top">
					@productGallery(v)
					@productBuy(v)
				</div>
			</div>
		</div>
		<div class="goen-pdp goen-pdp--after">
			// The facts a shopper compares stand beside what buyers said of them, as drawn: the
			// description, the specifications, the labelling, the warranty and delivery in one column,
			// the reviews in the other.
			<div class="goen-pdp__split">
				<div class="goen-pdp__more">
					if v.Description != "" {
						@productDescription(v)
					}
					if v.HasSpecs() {
						<section class="goen-pdp__block" aria-labelledby="specs-heading">
							<h2 id="specs-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionSpecs) }</h2>
							<dl class="goen-pdp__speclist">
								for _, s := range v.Specs {
									<div class="goen-pdp__specrow">
										<dt class="goen-pdp__specterm">{ s.Label }</dt>
										<dd class="goen-pdp__specvalue">{ s.Value }</dd>
									</div>
								}
							</dl>
							@productCompare(v)
						</section>
					}
					if len(v.LabelRows(ctx)) > 0 {
						<section class="goen-pdp__block" aria-labelledby="product-label-heading">
							<h2 class="goen-pdp__sectiontitle" id="product-label-heading">{ i18n.T(ctx, i18n.KeyProductLabel) }</h2>
							<dl class="goen-pdp__speclist">
								for _, fact := range v.LabelRows(ctx) {
									<div class="goen-pdp__specrow">
										<dt class="goen-pdp__specterm">{ i18n.T(ctx, fact.Term) }</dt>
										<dd class="goen-pdp__specvalue">{ fact.Value }</dd>
									</div>
								}
							</dl>
						</section>
					}
					if v.HasWarranty() || v.WarrantyNote != "" {
						<section class="goen-pdp__block" aria-labelledby="warranty-heading">
							<h2 id="warranty-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionWarranty) }</h2>
							if v.HasWarranty() {
								<p class="goen-pdp__warranty">{ v.WarrantyText(ctx) }</p>
							}
							if v.WarrantyNote != "" {
								<p class="goen-pdp__warranty">{ v.WarrantyNote }</p>
							}
						</section>
					}
					<section class="goen-pdp__block goen-pdp__ship" aria-labelledby="delivery-heading">
						<h2 id="delivery-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionDelivery) }</h2>
						@widget.StatLine(v.ShippingFacts(ctx), widget.StatLinePairs)
						<ul class="goen-pdp__policies" role="list">
							<li><a href="/shipping">{ i18n.T(ctx, i18n.KeyShippingPolicy) }</a></li>
							<li><a href="/returns">{ i18n.T(ctx, i18n.KeyReturnsPolicy) }</a></li>
						</ul>
					</section>
					if !v.HasSpecs() {
						@productCompare(v)
					}
				</div>
				@productReviews(v)
			</div>
			@productQuestions(v)
			if v.HasRelated() {
				<section class="goen-pdp__related" aria-labelledby="related-heading">
					<h2 id="related-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionRelated) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.Related {
							@tile.Cell(t)
						}
					</ul>
				</section>
			} else if v.CategorySlug != "" {
				<p><a class="goen-pdp__browse" href={ templ.URL("/c/" + v.CategorySlug) }>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyBrowseCategory), v.CategoryName) } <span aria-hidden="true">&rarr;</span></a></p>
			}
			if v.HasRecommendations() {
				<section class="goen-pdp__also" aria-labelledby="also-heading">
					<h2 id="also-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionAlsoBought) }</h2>
					<ul class="goen-tiles__grid" role="list">
						for _, t := range v.AlsoBought {
							@tile.Cell(t)
						}
					</ul>
				</section>
			}
		</div>
		@productBuyBar(v)
	}
}

// A radio group drawn with CSS alone: a swap of #gallery by the colour swatches
// keeps no state, and there is nothing to initialise.
//
// Every shot sits in the same cell and the unchosen ones are only hidden with
// visibility, none lazy: choosing a thumbnail must show its photograph at once.
templ productGallery(v *ProductView) {
	<div class="goen-pdp__gallery" id="gallery">
		if v.HasImages() {
			for i, img := range v.Images {
				<div class="goen-pdp__item">
					if len(v.Images) > 1 {
						<input
							class="goen-sr-only goen-pdp__pick"
							type="radio"
							name="shot"
							id={ "shot-" + strconv.Itoa(i) }
							checked?={ i == 0 }
						/>
					}
					<figure class="goen-pdp__shot">
						<img
							class="goen-pdp__shotimg"
							src={ img.URL }
							srcset={ img.Srcset }
							sizes="(min-width: 1024px) 46rem, calc(100vw - 2rem)"
							alt={ img.Alt }
							if img.HasDimensions() {
								width={ img.WidthText() }
								height={ img.HeightText() }
							}
							if i == 0 {
								fetchpriority="high"
							}
							decoding="async"
						/>
					</figure>
					if len(v.Images) > 1 {
						<label class="goen-pdp__thumb" for={ "shot-" + strconv.Itoa(i) }>
							<img
								class="goen-pdp__thumbimg"
								src={ img.URL }
								srcset={ img.Srcset }
								sizes="6rem"
								alt={ img.Alt }
								if img.HasDimensions() {
									width={ img.WidthText() }
									height={ img.HeightText() }
								}
								decoding="async"
							/>
						</label>
					}
				</div>
			}
		} else {
			<div class="goen-pdp__shot goen-pdp__shot--empty">
				<span class="goen-ph">{ i18n.T(ctx, i18n.KeyImagePlaceholder) }</span>
			</div>
		}
	</div>
}

templ productDescription(v *ProductView) {
	<section class="goen-pdp__desc" aria-labelledby="desc-heading">
		<h2 id="desc-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionDescription) }</h2>
		<p
			class="goen-pdp__prose"
			if v.DescriptionUntranslated {
				lang={ i18n.ZhHant.Tag() }
			}
		>{ v.Description }</p>
	</section>
}

templ ratingStars(halves int) {
	<span class="goen-pdp__rate" aria-hidden="true">
		for i := 1; i <= 5; i++ {
			if halves == 2*i-1 {
				<span class="goen-pdp__rate--half">
					@icons.Star()
					<span class="goen-pdp__ratehalf">
						@icons.Star()
					</span>
				</span>
			} else {
				<span class={ templ.KV("goen-pdp__rate--on", halves >= 2*i) }>
					@icons.Star()
				</span>
			}
		}
	</span>
}

templ productBuy(v *ProductView) {
	<div class="goen-pdp__buy" id="buybox">
		<div class="goen-pdp__head">
			if v.Brand != "" || v.ShowsSKU() {
				// The brand and the chosen variant's code, the code only once a variant is chosen: before that
				// the page's price is the cheapest variant's, and its code would name one the visitor has not
				// picked.
				<p class="goen-pdp__brand">
					if v.Brand != "" {
						<span>{ v.Brand }</span>
					}
					if v.Brand != "" && v.ShowsSKU() {
						<span class="goen-sep" aria-hidden="true">·</span>
					}
					if v.ShowsSKU() {
						<span class="goen-pdp__sku"><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyPDPSKU) }</span>{ v.SKU }</span>
					}
				</p>
			}
			<h1 class="goen-pdp__title">{ v.Name }</h1>
			if v.Summary != "" {
				<p class="goen-pdp__lede">{ v.Summary }</p>
			}
		</div>
		if v.SelectionOK || v.FallbackPrice {
			<div class="goen-pdp__pricebox">
				if v.OnSale {
					// Said, not drawn: the struck original and the seal are the sign, and the words are for a
					// screen reader.
					<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyOnSale) }</span>
				}
				// The price keeps the price colour on sale: the seal beside it carries the red, once.
				<span class="goen-pdp__price">
					if v.PriceFrom() {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFromPrice), v.Price()) }
					} else {
						{ v.Price() }
					}
				</span>
				if v.OnSale {
					<span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyWasPrice) }</span>
					<s class="goen-pdp__was">{ v.Compare() }</s>
					<span class="goen-pdp__seal">{ v.SavesText(ctx) }</span>
				}
			</div>
			if v.OnSale {
				{{ before, after := v.Campaign.Source(ctx) }}
				<p class="goen-pdp__source">{ before }<a href={ templ.SafeURL(v.Campaign.Href()) }>{ v.Campaign.Title }</a>{ after }&nbsp;<span class="goen-sep" aria-hidden="true">·</span>{ " " }@campaign.Ends(v.Campaign.End)</p>
			}
		}
		{{ firstInvalid := v.FirstInvalidOption() }}
		{{ firstOpen := v.FirstOpenOption() }}
		for oi, o := range v.Options {
			if o.Fixed() {
				<p class="goen-pdp__fact">
					<span class="goen-pdp__optlabel">{ o.Label }</span>
					<span class="goen-pdp__optchosen">{ o.Values[0].Label }</span>
				</p>
			} else {
				<fieldset
					class="goen-pdp__option"
					if oi == firstOpen {
						id="option-first"
					}
					if v.OptionInvalid(o) {
						aria-invalid="true"
						aria-describedby="notify-option-error"
					}
				>
					// The group's name and, at the other end of the line, the value chosen in it: a colour's
					// name is on its box too, but the line says what is chosen before the eye reaches the row.
					// A row of colours not yet chosen in asks for one at the end of its line; a row of words
					// leaves the asking to the line under the add button.
					<legend class="goen-pdp__optname">
						<span class="goen-pdp__optlabel">{ o.Label }</span>
						if o.SelectedLabel() != "" {
							<span class="goen-pdp__optchosen">{ o.SelectedLabel() }</span>
						} else if o.HasSwatches() {
							<span class="goen-pdp__optchosen">{ i18n.T(ctx, i18n.KeyOptionChoose) }</span>
						}
					</legend>
					<div class={ "goen-pdp__values", templ.KV("goen-pdp__values--swatches", o.HasSwatches()) }>
						for vi, val := range o.Values {
							// A link, because the choice is an address. The hx- attributes ask for the same URL and
							// keep only the part that changes: no second server path.
							//
							// The gallery comes along only when a photograph shows one option value, because
							// only then can the choice reorder it; otherwise a test holds that the server sends
							// the same gallery byte for byte, and swapping it would rebuild an identical <img>.
							// The id lets htmx restore focus to the activated control after a swap.
							<a
								id={ "swatch-" + strconv.Itoa(oi) + "-" + strconv.Itoa(vi) }
								class={ "goen-swatch",
								templ.KV("goen-swatch--dot", o.HasSwatches()),
								templ.KV("goen-swatch--on", val.Selected),
								templ.KV("goen-swatch--out", !val.Available) }
								href={ templ.URL(val.Href) }
								hx-get={ val.Href }
								hx-select="#buybox"
								hx-target="#buybox"
								hx-sync="#buybox:replace"
								hx-select-oob={ v.ChoiceSwap() }
								hx-swap="outerHTML"
								hx-push-url="true"
								if val.Selected {
									aria-current="true"
								}
								if oi == firstInvalid && vi == 0 {
									autofocus
								}
							>
								if o.HasSwatches() {
									// A presentation attribute, not a style, so the CSP has nothing to refuse. The
									// dot shows the colour and the name beside it says it, to the eye and the ear.
									<svg class="goen-swatch__dot" viewBox="0 0 36 36" width="32" height="32" aria-hidden="true">
										<circle cx="18" cy="18" r="17.5" fill={ val.SwatchHex }></circle>
										if !val.Available {
											// Struck through, not dimmed: a line says sold out where lower opacity says
											// nothing. Two strokes, the ground under the ink, so the mark reads on a colour of any darkness.
											<line class="goen-swatch__barground" x1="7.4" y1="28.6" x2="28.6" y2="7.4"></line>
											<line class="goen-swatch__bar" x1="7.4" y1="28.6" x2="28.6" y2="7.4"></line>
										}
									</svg>
									<span class="goen-swatch__label">{ val.Label }</span>
								} else if !val.Available {
									<s>{ val.Label }</s>
								} else {
									{ val.Label }
								}
								if !val.Available {
									if !o.HasSwatches() {
										<small class="goen-swatch__note">{ v.ValueSoldOut(ctx) }</small>
									} else {
										<span class="goen-sr-only">{ v.ValueSoldOut(ctx) }</span>
									}
								}
							</a>
						}
					</div>
					if oi == firstInvalid {
						<p class="ui-error-text goen-pdp__opterror" id="notify-option-error">{ i18n.T(ctx, i18n.KeyRestockNoOption) }</p>
					}
				</fieldset>
			}
		}
		if !v.SelectionOK {
			@widget.Notice(widget.NoticeProps{Intent: widget.IntentWarn, Class: "goen-pdp__note"}) {
				{ i18n.T(ctx, i18n.KeyVariantNotFound) }
			}
		}
		@productStock(v)
		if v.NotifyUnavailable() {
			@widget.Notice(widget.NoticeProps{Intent: widget.IntentDanger, ID: "notify-unavailable"}) {
				{ i18n.T(ctx, i18n.KeyRestockUnavailable) }
			}
		}
		@productAddForm(v)
		if v.SoldOut() && v.ArrivalText() != "" {
			@widget.Notice(widget.NoticeProps{Intent: widget.IntentWarn, Class: "goen-pdp__note"}) {
				<time datetime={ v.ArrivalDay() }>{ v.ArrivalText() }</time>
			}
		}
		if v.NotifyOffered() {
			@productNotifyForm(v)
		}
		@productLinks(v)
		@widget.StatLine(v.BuyFacts(ctx), widget.StatLinePairs)
	</div>
}

// The stock of the chosen variant on the left and the rating on the right, on one shelf-coloured line.
// Before a variant is chosen there is no stock to state: only the rating stands. A chosen variant that
// is sold out is said here, after the values chosen where there was a choice, and nowhere else: the
// restock form under it is the one action, and no dead button repeats the words.
templ productStock(v *ProductView) {
	if v.SoldOut() || v.StockWord(ctx) != "" || v.HasRating() {
		<div class="goen-pdp__stock">
			if v.SoldOut() {
				if who := v.SoldOutWho(); who != "" {
					<p class="goen-pdp__status">{ who }{ v.SoldOutJoin(ctx) }<span class="goen-pdp__soldword">{ i18n.T(ctx, i18n.KeySoldOut) }</span></p>
				} else {
					<p class="goen-pdp__status">{ i18n.T(ctx, i18n.KeySoldOut) }</p>
				}
			} else if word := v.StockWord(ctx); word != "" {
				<p class={ "goen-pdp__status", templ.KV("goen-pdp__lowstock", v.LowStock()) }>{ word }</p>
			}
			if v.HasRating() {
				// One star, the average and the count; a screen reader hears the sentence instead.
				<p class="goen-pdp__rating">
					<a class="goen-pdp__ratinglink" href="#reviews">
						<span class="goen-pdp__ratingstar" aria-hidden="true">
							@icons.Star()
						</span>
						<span aria-hidden="true">{ v.RatingText() }&nbsp;({ v.ReviewCountText() })</span>
						<span class="goen-sr-only">{ v.RatingLabel(ctx) }</span>
					</a>
				</p>
			}
		</div>
	}
}

templ productLinks(v *ProductView) {
	<div class={ "goen-pdp__links", templ.KV("goen-pdp__links--text", !v.SignedIn) }>
		if v.SignedIn {
			// Toggling swaps the form alone; the plain post and its redirect serve a browser without script.
			<form
				method="post"
				action="/account/wishlist"
				class="goen-pdp__wish"
				hx-post="/account/wishlist"
				hx-target="this"
				hx-select=".goen-pdp__wish"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="slug" value={ v.Slug }/>
				<input type="hidden" name="return" value={ "/p/" + v.Slug }/>
				if v.Saved {
					<input type="hidden" name="action" value="remove"/>
				}
				@widget.Button(widget.ButtonProps{
					ButtonStyle: widget.ButtonStyleGhost,
					Attrs: templ.Attributes{
						"aria-label":   v.WishlistLabel(ctx),
						"aria-pressed": v.SavedText(),
					},
				}, "submit") {
					@icons.Heart()
					<span>{ v.WishlistLabel(ctx) }</span>
				}
			</form>
		} else {
			// A link to somewhere else, so the ink and the faint underline every such link wears; the
			// heart is the signed-in toggle's, which is a button with a state.
			<a class="goen-pdp__wishlink" href={ templ.SafeURL("/signin?next=/p/" + v.Slug + "%23wishlist") }>{ i18n.T(ctx, i18n.KeyWishlistSignIn) }</a>
		}
	</div>
}

templ productAddForm(v *ProductView) {
	<div class="goen-pdp__actions">
		// The same POST as the plain form, through htmx: the 303 is followed and hx-select takes the buy
		// column out of the page a reload would give. hx-select-oob names the header's cart link in that
		// response, so the count changes from the document the server just rendered. The address is not
		// pushed: ?added= is not a page to come back to.
		<form
			id="pdp-add"
			class="goen-pdp__form"
			method="post"
			action="/cart/items"
			hx-post="/cart/items"
			hx-target="#buybox"
			hx-swap="outerHTML"
			hx-select="#buybox"
			hx-select-oob="#cart-link,#buybar"
			hx-push-url="false"
		>
			<input type="hidden" name="variant" value={ v.VariantID }/>
			<input type="hidden" name="back" value={ v.Slug }/>
			<div class="goen-pdp__buyrow">
				if !v.SoldOut() && !v.AllSoldOut() {
					@widget.Label(widget.LabelProps{For: "quantity", Class: "goen-sr-only"}) {
						{ i18n.T(ctx, i18n.KeyQuantity) }
					}
					@widget.Stepper(widget.StepperProps{
						ID: "quantity", Name: "quantity", Value: "1",
						Min: "1", Max: v.MaxQuantity(), Disabled: !v.CanBuy(),
						DecreaseLabel: i18n.T(ctx, i18n.KeyQuantityDecrease),
						IncreaseLabel: i18n.T(ctx, i18n.KeyQuantityIncrease),
						Class:         "goen-pdp__qty",
					})
				}
				if v.AwaitsChoice() {
					// Still in the tab order, with the reason under it. A plain button, not a submit: until every
					// group is picked the form's variant is only the cheapest, and no key may post it.
					@widget.Button(widget.ButtonProps{
						ButtonStyle: widget.ButtonStylePrimary,
						Class:       "goen-pdp__add",
						Attrs:       templ.Attributes{"id": "add-to-cart", "aria-disabled": "true", "aria-describedby": "add-to-cart-why"},
					}, "button") {
						@icons.Cart()
						<span>{ i18n.T(ctx, i18n.KeyAddToCart) }</span>
					}
				} else if !v.SoldOut() {
					// A chosen variant that is sold out is said on the stock line, and the restock form is the
					// one action: no dead button repeats the words.
					@widget.Button(widget.ButtonProps{
						ButtonStyle: widget.ButtonStylePrimary,
						Class:       "goen-pdp__add",
						Attrs:       templ.Attributes{"id": "add-to-cart", "disabled": !v.CanBuy()},
					}, "submit") {
						@icons.Cart()
						if v.AllSoldOut() {
							<span>{ i18n.T(ctx, i18n.KeySoldOut) }</span>
						} else if v.CanBuy() {
							// What the press costs: the price times the quantity beside it, which goen.js keeps
							// in step with the field. It starts at one, as the field does. One run of text, so a
							// narrow button wraps it at the space; the dot never ends a line without its sum.
							<span>{ i18n.T(ctx, i18n.KeyAddToCart) } <span class="goen-pdp__addsum"><span aria-hidden="true">·</span> <span class="goen-pdp__addprice" data-unit-cents={ v.PriceCentsText() }>{ v.Price() }</span></span></span>
						} else {
							<span>{ i18n.T(ctx, i18n.KeyAddToCart) }</span>
						}
					}
				}
			</div>
			if v.AwaitsChoice() {
				<p class="goen-pdp__why" id="add-to-cart-why">{ i18n.T(ctx, i18n.KeyChooseOptions) }</p>
			}
			if v.JustAdded() {
				@widget.Notice(widget.NoticeProps{
					Intent: widget.IntentAccent, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyAddedToCart) }
					<a class="goen-pdp__addedlink" href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
				}
			}
			if v.AddAdjusted() {
				@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent, ID: "added", Class: "goen-pdp__added"}) {
					{ i18n.T(ctx, i18n.KeyAddAdjusted) }
					<a class="goen-pdp__addedlink" href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
				}
			}
			if v.AddRefused() {
				@widget.Notice(widget.NoticeProps{
					Intent: widget.IntentDanger, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyAddRefused) }
				}
			}
			if v.CartFull() {
				@widget.Notice(widget.NoticeProps{
					Intent: widget.IntentDanger, ID: "added", Class: "goen-pdp__added",
				}) {
					{ i18n.T(ctx, i18n.KeyCartLineLimit) }
				}
			}
		</form>
		// Beside the add, not in its form: a form cannot hold another, and the
		// toggle is a post of its own that swaps only itself.
		if v.Comparable {
			@CompareToggle(v.Slug, v.Name)
		}
	</div>
}

// Outside #buybox because a region with a view-transition-name contains its fixed
// descendants; rides every swap through hx-select-oob. It renders even when empty,
// or a swap would leave the previous bar standing.
templ productBuyBar(v *ProductView) {
	<div id="buybar" class={ "goen-buybar", templ.KV("goen-buybar--added", v.JustAdded() || v.AddAdjusted()) } data-follows={ v.BuyBarFollows() }>
		if msg := v.BuyBarOutcome(ctx); msg != "" {
			<p class="goen-buybar__msg" role="status">{ msg }</p>
			if v.JustAdded() || v.AddAdjusted() {
				// The same sentence and the same link as the notice under the button: the bar
				// turns inverse like it, and the way to the cart is a link, not a button.
				<a class="goen-buybar__link" href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a>
			}
		} else if v.CanBuy() || v.AwaitsChoice() {
			// The price and the struck original show only once the buy box's own price has left the
			// screen (goen.js sets data-price="hidden" while it is on it), so the two never stand
			// together. The struck price is a sibling of .goen-buybar__price, whose text has to equal
			// the buy box's price.
			<p class="goen-buybar__sum">
				<span class={ "goen-buybar__price", templ.KV("goen-buybar__price--sale", v.OnSale) }>
					if v.PriceFrom() {
						{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFromPrice), v.Price()) }
					} else {
						{ v.Price() }
					}
				</span>
				if v.OnSale {
					<span class="goen-buybar__was"><span class="goen-sr-only">{ i18n.T(ctx, i18n.KeyWasPrice) }</span><s>{ v.Compare() }</s></span>
				}
				if chosen := v.Chosen(); chosen != "" {
					<span class="goen-buybar__chosen">{ chosen }</span>
				}
			</p>
			if v.CanBuy() {
				@widget.Button(widget.ButtonProps{
					ButtonStyle: widget.ButtonStylePrimary,
					Class:       "goen-buybar__btn",
					Attrs:       templ.Attributes{"form": "pdp-add"},
				}, "submit") {
					@icons.Cart()
					<span>{ i18n.T(ctx, i18n.KeyAddToCart) }</span>
				}
			} else {
				// Nothing is chosen yet, so there is nothing to add: the bar's one action is the way to
				// the first group still open.
				@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Class: "goen-buybar__btn"}, templ.SafeURL("#option-first")) {
					{ i18n.T(ctx, i18n.KeyChooseOptions) }
				}
			}
		} else if v.NotifyOffered() {
			@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline, Class: "goen-buybar__btn"}, templ.SafeURL("#restock")) {
				{ i18n.T(ctx, i18n.KeyRestockHeading) }
			}
		}
	</div>
}

// The specifications lead to a ready-made comparison, the product beside the
// ones on its shelf priced closest to it: a link, as the compare page's own
// ready-made comparisons are, so the shopper's compare set is left as it was;
// the toggle in the buy column is what keeps the product in the set. The same
// blue link and arrow the department page uses for its comparison.
templ productCompare(v *ProductView) {
	if len(v.Similar) > 0 {
		<div class="goen-pdp__similar">
			<a class="goen-pdp__compare" href={ templ.SafeURL(v.CompareHref()) }>{ i18n.T(ctx, i18n.KeyCompareSimilar) } <span aria-hidden="true">&rarr;</span></a>
		</div>
	}
}

// The sold-out notice: what is missing, what the form does, and the form, on the savings tint that a
// notice about this variant's stock wears.
templ productNotifyForm(v *ProductView) {
	<form id="restock" class="goen-pdp__notify" method="post" action={ templ.SafeURL(v.NotifyAction()) }>
		<input type="hidden" name="variant" value={ v.NotifyVariant() }/>
		<p class="goen-pdp__notifyhead">{ v.RestockNote(ctx) }</p>
		if v.NotifyTaken() {
			@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent}) {
				{ v.NotifyConfirmation(ctx) }
			}
		} else {
			<p class="goen-pdp__notifybody">{ i18n.T(ctx, i18n.KeyRestockBody) }</p>
			@widget.Label(widget.LabelProps{For: "notify-email"}) {
				{ i18n.T(ctx, i18n.KeyFieldEmail) }
			}
			<div class="goen-pdp__notifyrow">
				@widget.Input(widget.FieldProps{
					ID: "notify-email", Name: "email", Type: "email", Value: v.NotifyEmailValue(),
					Invalid: v.NotifyRefused(), Describes: "notify-email-error",
					Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
						"required": true, "maxlength": "254", "autocomplete": "email",
					}, fieldrule.Message(i18n.KeyRestockBadEmail), fieldrule.ErrorID("notify-email-error")),
				})
				// The one action of a face with nothing to buy: the ink button, beside its field.
				@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary}, "submit") {
					{ i18n.T(ctx, i18n.KeyRestockSubmit) }
				}
			</div>
			if v.NotifyRefused() {
				<p class="ui-error-text" id="notify-email-error">{ i18n.T(ctx, i18n.KeyRestockBadEmail) }</p>
			} else {
				<p class="ui-error-text" id="notify-email-error" hidden></p>
			}
		}
	</form>
}

templ productReviews(v *ProductView) {
	<section class="goen-pdp__reviews" id="reviews" aria-labelledby="reviews-heading">
		<h2 id="reviews-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionReviews) }</h2>
		// The summary depends on there being ratings, not the section: the form that
		// writes the first rating is inside.
		if !v.HasRating() {
			<p class="goen-pdp__noreviews">{ i18n.T(ctx, i18n.KeyNoReviewsYet) }</p>
		}
		if v.HasRating() {
			<div class="goen-pdp__reviewlayout">
				<div class="goen-pdp__summary">
					<p class="goen-pdp__score">{ v.RatingText() }</p>
					<div class="goen-pdp__scoreside">
						@ratingStars(v.StarHalves())
						<p class="goen-pdp__scorecount">{ i18n.Count(ctx, i18n.KeyReviewCount, v.RatingCount, v.ReviewCountText()) }</p>
					</div>
					if v.RatingsBeyondList() {
						<div class="goen-pdp__bars">
							for _, b := range v.RatingBars {
								<div class="goen-pdp__bar">
									<span class="goen-pdp__barlabel">{ i18n.Count(ctx, i18n.KeyStarsLabel, int64(b.Stars), b.StarsText()) }</span>
									<span class="goen-pdp__bartrack">
										<span class={ "goen-pdp__barfill", b.WidthClass() }></span>
									</span>
									<span class="goen-pdp__barcount">{ b.CountText() }</span>
								</div>
							}
						</div>
					}
				</div>
				<div class="goen-pdp__reviewlist">
					for _, r := range v.Reviews {
						<article class="goen-pdp__review">
							<div class="goen-pdp__reviewhead">
								<span class="goen-pdp__reviewname">{ r.DisplayAuthor(ctx) }</span>
								if r.Own {
									@widget.Badge(widget.BadgeProps{}) {
										{ i18n.T(ctx, i18n.KeyYourReview) }
									}
								}
								if r.Verified {
									@widget.Badge(widget.BadgeProps{}) {
										{ i18n.T(ctx, i18n.KeyVerifiedBuyer) }
									}
								}
								<span class="goen-pdp__reviewstars" aria-hidden="true">
									@ratingStars(r.Rating * 2)
									<span class="goen-pdp__reviewscore">{ r.RatingText() }</span>
								</span>
							</div>
							<p class="goen-sr-only">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyRatingScore), r.RatingText()) }</p>
							if r.Title != "" {
								<p class="goen-pdp__reviewtitle">{ r.Title }</p>
							}
							<p class="goen-pdp__reviewbody">{ r.Body }</p>
							<time class="goen-pdp__reviewdate" datetime={ r.Date.ISO() }>{ shoptime.DateText(ctx, r.Date) }</time>
						</article>
					}
				</div>
			</div>
		}
		if v.ReviewPosted {
			@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent}) {
				{ i18n.T(ctx, i18n.KeyReviewThanks) }
			}
		}
		@reviewForm(v)
	</section>
}

// A question is a disclosure: its words are the summary, and who asked, when, and the answers open
// under it, so a long thread does not push the next question off the screen.
templ productQuestions(v *ProductView) {
	<section class="goen-pdp__qa" id="questions" aria-labelledby="qa-heading">
		<h2 id="qa-heading" class="goen-pdp__sectiontitle">{ i18n.T(ctx, i18n.KeySectionQA) }</h2>
		if v.AskTaken() {
			@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent}) {
				{ i18n.T(ctx, i18n.KeyQuestionPosted) }
			}
		}
		if v.HasQuestions() {
			<ul class="goen-qa" role="list">
				for _, q := range v.Questions {
					<li class="goen-qa__item">
						<details class="goen-qa__thread">
							<summary class="goen-qa__question">
								<span class="goen-qa__questionbody">{ q.Body }</span>
								<span class="goen-qa__count">{ q.AnswerCount(ctx) }</span>
							</summary>
							<div class="goen-qa__open">
								<span class="goen-pdp__meta">{ q.Who(ctx) } · { q.Asked }</span>
								if q.Answered() {
									// The count in the summary already says when none has come.
									<ul class="goen-qa__answers" role="list">
										for _, a := range q.Answers {
											<li class="goen-qa__answer">
												<p class="goen-qa__answerbody">{ a.Body }</p>
												<span class="goen-pdp__meta">
													{ a.Who(ctx) }
													if a.IsStaff {
														@widget.Badge(widget.BadgeProps{}) {
															{ i18n.T(ctx, i18n.KeyStaffAnswer) }
														}
													}
													{ " · " + a.At }
												</span>
											</li>
										}
									</ul>
								}
							</div>
						</details>
					</li>
				}
			</ul>
		} else {
			<p class="goen-pdp__meta">{ i18n.T(ctx, i18n.KeyNoQuestionsYet) }</p>
		}
		@askForm(v)
	</section>
}

templ askForm(v *ProductView) {
	if !v.SignedIn {
		<p class="goen-pdp__reviewnote">
			<a href={ templ.SafeURL(v.AskSignInHref()) }>{ i18n.T(ctx, i18n.KeySignInFirst) }</a>{ i18n.T(ctx, i18n.KeySignInToAsk) }
		</p>
	} else {
		<form class="goen-qa__form" method="post" action={ templ.SafeURL(v.AskAction()) }>
			<div class="goen-field">
				@widget.Label(widget.LabelProps{For: "ask-body"}) {
					{ i18n.T(ctx, i18n.KeyAskLabel) }
				}
				@widget.Textarea(widget.FieldProps{
					ID: "ask-body", Name: "body",
					Invalid: v.AskRefused(), Describes: v.askBodyDescribedBy(),
					Attrs: v.askBodyAttrs(templ.Attributes{
						"rows": "3", "required": true, "maxlength": "300",
						"placeholder": i18n.T(ctx, i18n.KeyAskPlaceholder),
					}),
				}) {
					{ v.AskDraft }
				}
				<p class="goen-pdp__reviewnote" id="ask-body-hint">{ i18n.T(ctx, i18n.KeyAskLengthHint) }</p>
				if v.AskRefused() {
					if v.AskTooLong() {
						<p class="ui-error-text" id="ask-body-error">{ i18n.T(ctx, i18n.KeyQuestionTooLong) }</p>
					} else {
						<p class="ui-error-text" id="ask-body-error">{ i18n.T(ctx, i18n.KeyQuestionRefused) }</p>
					}
				}
			</div>
			@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline}, "submit") {
				{ i18n.T(ctx, i18n.KeyAskSubmit) }
			}
		</form>
	}
}

templ reviewForm(v *ProductView) {
	if v.ReviewStanding == ReviewNotDelivered && len(v.ReviewErrors) == 0 {
		if v.HasRating() {
			<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyReviewAfterDelivery) }</p>
		}
	} else if v.ReviewStanding == ReviewAlreadyWritten {
		if !v.ReviewPosted {
			<p class="goen-pdp__reviewnote">{ i18n.T(ctx, i18n.KeyAlreadyReviewed) }</p>
		}
	} else if v.ReviewStanding != ReviewSignedOut {
		<div class="goen-pdp__reviewform">
			<form id="write-review" method="post" action={ templ.SafeURL(v.ReviewAction()) }>
				<h3 class="goen-pdp__reviewformhead">{ i18n.T(ctx, i18n.KeyWriteReview) }</h3>
				<fieldset class="goen-pdp__stars">
					<legend class="goen-label">{ i18n.T(ctx, i18n.KeyFieldRating) }</legend>
					<div class="goen-pdp__starrow">
						for _, n := range []int{1, 2, 3, 4, 5} {
							<label class="goen-pdp__star">
								<input
									class="goen-pdp__starinput goen-sr-only"
									type="radio"
									name="rating"
									value={ n }
									required
									checked?={ v.ReviewDraft.IsRating(n) }
								/>
								<span class="goen-pdp__starmark" aria-hidden="true">
									@icons.Star()
								</span>
								<span class="goen-sr-only">{ i18n.Count(ctx, i18n.KeyStarsLabel, int64(n), strconv.Itoa(n)) }</span>
							</label>
						}
					</div>
				</fieldset>
				if v.HasReviewErr("rating") {
					<p class="ui-error-text">{ v.ReviewErr("rating") }</p>
				}
				<div class="goen-field">
					@widget.Label(widget.LabelProps{For: "review-title"}) {
						{ i18n.T(ctx, i18n.KeyFieldReviewTitle) }
					}
					@widget.Input(widget.FieldProps{
						ID: "review-title", Name: "title", Value: v.ReviewDraft.Title,
						Invalid: v.HasReviewErr("title"), Describes: "review-title-error",
						Attrs: templ.Attributes{"maxlength": "80"},
					})
					if v.HasReviewErr("title") {
						<p class="ui-error-text" id="review-title-error">{ v.ReviewErr("title") }</p>
					}
				</div>
				<div class="goen-field">
					@widget.Label(widget.LabelProps{For: "review-body"}) {
						{ i18n.T(ctx, i18n.KeyFieldReviewBody) }
					}
					@widget.Textarea(widget.FieldProps{
						ID: "review-body", Name: "body", Class: "goen-pdp__reviewbody",
						Invalid: v.HasReviewErr("body"), Describes: v.reviewBodyDescribedBy(),
						Attrs: v.reviewBodyAttrs(),
					}) {
						{ v.ReviewDraft.Body }
					}
					if v.HasReviewErr("body") {
						<p class="ui-error-text" id="review-body-error">{ v.ReviewErr("body") }</p>
					} else {
						<p class="goen-pdp__reviewnote" id="review-body-hint">{ v.ReviewBodyHint(ctx) }</p>
					}
				</div>
				@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary}, "submit") {
					{ i18n.T(ctx, i18n.KeyReviewSubmit) }
				}
			</form>
		</div>
	}
}
