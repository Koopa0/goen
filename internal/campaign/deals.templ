package campaign

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/tile"
)

templ Deals(p layouts.Page, v DealsView) {
	@layouts.Base(p) {
		<div class="goen-listing">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyDealsTitle) }</h1>
				if v.Total > 0 {
					<p class="goen-pagehead__sub">{ i18n.Count(ctx, i18n.KeyDealsCount, v.Total, v.TotalText()) }</p>
				}
			</div>
			if v.HasCampaigns() {
				<section id="campaigns">
					@strip(v.Campaigns.Rows)
					@pager(i18n.T(ctx, i18n.KeyCampaignPagination), v.Campaigns.Page > 1, v.Campaigns.Page < v.Campaigns.Pages(), v.CampaignPageHref(v.Campaigns.Page-1), v.CampaignPageHref(v.Campaigns.Page+1), strconv.Itoa(v.Campaigns.Page), strconv.Itoa(v.Campaigns.Pages()))
				</section>
			}
			if v.Total == 0 {
				@components.Notice(components.NoticeProps{}) {
					{ i18n.T(ctx, i18n.KeyDealsEmpty) }
				}
			} else {
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				<ul class="goen-tiles__grid" role="list">
					for _, t := range tile.FirstRowEager(v.Products) {
						@tile.Cell(t)
					}
				</ul>
				@pager(i18n.T(ctx, i18n.KeyPagination), v.HasPrev(), v.HasNext(), v.PrevHref(), v.NextHref(), v.PageText(), v.PagesText())
			}
		</div>
	}
}

// A campaign is a destination and a product an item; drawn apart so they do not read as one kind of thing.
templ strip(campaigns []Summary) {
	<section class="goen-campaigns" aria-labelledby="campaigns-heading">
		<h2 id="campaigns-heading" class="goen-campaigns__heading">{ i18n.T(ctx, i18n.KeyCampaignsRunning) }</h2>
		<ul class="goen-campaigns__list" role="list">
			for _, c := range campaigns {
				<li>
					<a class="goen-campaigns__item" href={ templ.SafeURL(c.Href()) }>
						<span class="goen-campaigns__title">{ c.Title }</span>
						<span class="goen-campaigns__meta">
							{ i18n.Count(ctx, i18n.KeyCampaignProducts, c.Products, c.ProductsText()) }
							if c.EndsOn != "" {
								· { fmt.Sprintf(i18n.T(ctx, i18n.KeyCampaignUntil), c.EndsOn) }
							}
						</span>
					</a>
				</li>
			}
		</ul>
	</section>
}

// The end of the run stays visible as a disabled span so the control does not move.
templ pager(label string, hasPrev, hasNext bool, prev, next, page, pages string) {
	if hasPrev || hasNext {
		<nav class="goen-pager" aria-label={ label }>
			if hasPrev {
				<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(prev) } rel="prev">{ i18n.T(ctx, i18n.KeyPrevPage) }</a>
			} else {
				<span class="goen-btn goen-btn--outline goen-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyPrevPage) }</span>
			}
			<span class="goen-pager__at">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPageOf), page, pages) }</span>
			if hasNext {
				<a class="goen-btn goen-btn--outline goen-btn--sm" href={ templ.URL(next) } rel="next">{ i18n.T(ctx, i18n.KeyNextPage) }</a>
			} else {
				<span class="goen-btn goen-btn--outline goen-btn--sm" aria-disabled="true">{ i18n.T(ctx, i18n.KeyNextPage) }</span>
			}
		</nav>
	}
}
