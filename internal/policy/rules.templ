package policy

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ RulesSection(r Rules) {
	<section class="goen-rules" aria-labelledby="rules-heading">
		<h2 id="rules-heading" class="goen-sr-only">{ i18n.T(ctx, i18n.KeySectionRules) }</h2>
		@widget.StatLine(r.Stats(ctx), widget.StatLineWide)
	</section>
}
