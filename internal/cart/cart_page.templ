package cart

import (
	"fmt"

	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

templ Page(p layouts.Page, v View) {
	@layouts.Base(p) {
		<div class="goen-cart">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCart) }</h1>
				if !v.Empty() {
					<div id="cart-count" class="goen-cart__facts" role="status">
						if notice := v.StockNotice(ctx); notice != "" {
							<p id="cart-alert" class="goen-cart__alert">{ notice }</p>
						}
						@components.StatLine(v.Facts(ctx), components.StatLinePlain)
					</div>
				}
			</div>
			// Always present, so an update that changes only the notice has somewhere to put it.
			<div id="cart-notices" class="goen-cart__notices">
				if v.HasNotice() {
					if v.ContinueURL != "" {
						<div class="ui-alert ui-alert--info" id="cart-adjustment" role="status">
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" fill-rule="evenodd"></path>
							</svg>
							<div class="goen-cart__adjustment-content">
								<p class="goen-cart__adjustment-message">{ v.Notice }</p>
								<p class="goen-cart__adjustment-action">
									<a href={ templ.URL(v.ContinueURL) }>
										{ i18n.T(ctx, i18n.KeyCartAdjustmentContinue) }
										<span aria-hidden="true">→</span>
									</a>
								</p>
							</div>
						</div>
					} else {
						@components.Notice(components.NoticeProps{Intent: components.IntentAccent, ID: "cart-adjustment"}) {
							{ v.Notice }
						}
					}
				}
				if v.FromReorder() {
					@components.Notice(components.NoticeProps{Intent: components.IntentAccent}) {
						{ v.ReorderText(ctx) }
					}
				}
			</div>
			if v.Empty() {
				<div class="goen-empty">
					@components.EmptyArt(assets.EmptyCartImage)
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyEmptyCart) }</p>
					<p class="goen-empty__text">{ i18n.T(ctx, i18n.KeyCartEmptyDesc) }</p>
					@components.ButtonLink(components.ButtonProps{
						ButtonStyle: components.ButtonStylePrimary,
						Size:        components.SizeLarge,
					}, "/") {
						{ i18n.T(ctx, i18n.KeyCartEmptyLink) }
					}
				</div>
			} else {
				<div class="goen-cart__layout">
					<ul class="goen-cart__lines" role="list">
						for _, l := range v.Lines {
							@cartLine(l)
						}
					</ul>
					@components.Card(components.CardProps{
						Class: "goen-cart__summary",
						Attrs: templ.Attributes{"id": "cart-summary", "aria-labelledby": "summary-heading"},
					}) {
						<h2 id="summary-heading" class="goen-summary__title">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
						<dl class="goen-summary">
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeyShippingFee) }</dt>
								<dd class="goen-summary__value">
									if v.FreeDelivery.Kind == FreeDeliveryReached {
										{ v.FreeDelivery.Word(ctx) }
									} else {
										{ i18n.T(ctx, i18n.KeyShippingLater) }
									}
								</dd>
							</div>
							<div class="goen-summary__row goen-summary__row--total">
								<dt>{ i18n.T(ctx, i18n.KeySubtotal) }</dt>
								<dd class="goen-summary__value">{ v.Subtotal() }</dd>
							</div>
						</dl>
						if v.MixedTaxTypes {
							@components.Notice(components.NoticeProps{Intent: components.IntentWarn}) {
								{ i18n.T(ctx, i18n.KeyCartMixedTaxTypes) }
							}
						}
						if v.NoDelivery {
							@components.Notice(components.NoticeProps{Intent: components.IntentWarn, ID: "cart-delivery-unavailable"}) {
								{ i18n.T(ctx, i18n.KeyShippingUnavailable) }
							}
						}
						<div class="goen-summary__actions">
							if v.CanCheckout() && !v.NoDelivery {
								@components.ButtonLink(components.ButtonProps{
									ButtonStyle: components.ButtonStylePrimary,
									Size:        components.SizeLarge,
									Block:       true,
								}, "/checkout") {
									{ i18n.T(ctx, i18n.KeyCheckout) }
								}
							} else {
								// Present and plainly unavailable, not absent: a shopper who cannot check out
								// still needs the control, and it points at the sentence under the title that says why.
								<span
									class="goen-btn goen-btn--primary goen-btn--lg goen-btn--block"
									role="link"
									aria-disabled="true"
									if v.NoDelivery && v.StockNotice(ctx) != "" {
										aria-describedby="cart-alert cart-delivery-unavailable"
									}
									else
									if v.NoDelivery {
										aria-describedby="cart-delivery-unavailable"
									}
									else
									if v.StockNotice(ctx) != "" {
										aria-describedby="cart-alert"
									}
								>
									{ i18n.T(ctx, i18n.KeyCheckout) }
								</span>
							}
							@components.ButtonLink(components.ButtonProps{
								ButtonStyle: components.ButtonStyleGhost,
								Block:       true,
							}, "/") {
								{ i18n.T(ctx, i18n.KeyContinue) }
							}
						</div>
						<p class="goen-cart__hold">{ v.HoldNote(ctx) }</p>
					}
				</div>
			}
		</div>
	}
}

templ cartLine(l Line) {
	<li id={ "line-" + l.VariantID } class={ "goen-line", "goen-line--cart", templ.KV("goen-line--out", l.Unavailable) }>
		<a class="goen-line__thumb" href={ templ.URL("/p/" + l.Slug) }>
			if l.HasImage() {
				// Width and height on the element, not only in the sheet: the row's height is
				// reserved before the image arrives, so nothing below jumps.
				<img
					class="goen-line__img"
					src={ l.ImageURL }
					srcset={ l.ImageSrcset }
					sizes="96px"
					alt={ l.ImageAlt }
					width="96"
					height="96"
					loading="lazy"
					decoding="async"
				/>
			} else {
				<span class="goen-line__ph" aria-hidden="true"></span>
			}
		</a>
		<div class="goen-line__body" id={ "line-body-" + l.VariantID }>
			if l.Brand != "" {
				<span class="goen-line__brand">{ l.Brand }</span>
			}
			<a class="goen-line__name" href={ templ.URL("/p/" + l.Slug) }>{ l.Name }</a>
			if l.Label != "" {
				<span class="goen-line__meta">{ l.Label }</span>
			}
			<span class="goen-line__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyUnitPrice), l.UnitPrice()) }</span>
			if l.TaxExempt {
				@components.Badge(components.BadgeProps{}) {
					{ i18n.T(ctx, i18n.KeyInvoiceExempt) }
				}
			}
			if l.Unavailable {
				@components.Badge(components.BadgeProps{Intent: components.IntentDanger}) {
					{ i18n.T(ctx, i18n.KeySoldOut) }
				}
			} else if l.Short {
				@components.Badge(components.BadgeProps{Intent: components.IntentWarn}) {
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyOnlyLeft), l.AvailableText()) }
				}
			}
		</div>
		<div class="goen-line__money" id={ "line-money-" + l.VariantID }>
			if !l.Unavailable {
				<span class="goen-line__total">{ l.LineTotal() }</span>
			}
			if l.Short {
				<span class="goen-line__meta">
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyPricedFor), l.PricedQuantityText()) }
				</span>
			}
		</div>
		<form
			class="goen-line__controls"
			method="post"
			action="/cart/items/update"
			data-autosubmit
			hx-post="/cart/items/update"
			hx-swap="none"
			hx-select-oob={ cartLineSwap(l.VariantID) }
			hx-sync="closest .goen-cart__lines:queue all"
		>
			<input type="hidden" name="variant" value={ l.VariantID }/>
			// A sold-out line has nothing to adjust, so removing it is all it offers.
			if !l.Unavailable {
				<label class="goen-sr-only" for={ "qty-" + l.VariantID }>{ i18n.T(ctx, i18n.KeyQuantity) }</label>
				@components.Stepper(components.StepperProps{
					ID: "qty-" + l.VariantID, Name: "quantity",
					Value: l.QuantityText(),
					// Zero removes a line with no script, so the floor is zero here and one on the product page.
					Min: "0", Max: l.MaxQuantity(),
					DecreaseLabel: i18n.T(ctx, i18n.KeyQuantityDecrease),
					IncreaseLabel: i18n.T(ctx, i18n.KeyQuantityIncrease),
				})
				// Shown only where scripting is off: with it on, changing the quantity submits the form.
				@components.Button(components.ButtonProps{
					ButtonStyle: components.ButtonStyleOutline,
					Size:        components.SizeSmall,
					Class:       "goen-line__update",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyUpdate) }
				}
			}
			@components.Button(components.ButtonProps{
				ButtonStyle: components.ButtonStyleGhost,
				Size:        components.SizeSmall,
				Class:       "goen-line__remove",
				// Not dimmed while a quantity request is pending: the request is about the number.
				Attrs: templ.Attributes{"name": "remove", "value": "1", "data-feedback-skip": true, "formnovalidate": true},
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyRemove) }
			}
		</form>
	</li>
}
