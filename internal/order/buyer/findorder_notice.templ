package buyer

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
)

// FindOrderGrantFailed is what the order lookup shows when the access grant
// for an order it found could not be written. It is the lookup's own, so it
// stays out of the shared notice shell.
templ FindOrderGrantFailed(p layouts.Page) {
	@layouts.Base(p) {
		<div class="notice">
			<span class="notice__code" aria-hidden="true">500</span>
			<h1 class="notice__title">{ i18n.T(ctx, i18n.KeyFindOrderGrantFailedTitle) }</h1>
			<p class="notice__body">{ i18n.T(ctx, i18n.KeyFindOrderGrantFailedBody) }</p>
			<div class="notice__actions">
				@components.ButtonLink(components.ButtonProps{ButtonStyle: components.ButtonStylePrimary, Size: components.SizeLarge}, "/orders/find") {
					{ i18n.T(ctx, i18n.KeyFindOrderTitle) }
				}
			</div>
		</div>
	}
}
