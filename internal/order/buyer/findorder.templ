package buyer

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/fieldrule"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ FindOrder(p layouts.Page, v FindOrderView) {
	@layouts.Base(p) {
		<div class="goen-auth">
			<div class="goen-auth__panel">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyFindOrderTitle) }</h1>
				<p class="goen-auth__lede">{ i18n.T(ctx, i18n.KeyFindOrderSub) }</p>
				if v.Error != "" {
					@widget.Notice(widget.NoticeProps{
						Intent: widget.IntentDanger,
						ID:     "find-error",
					}) {
						{ v.Error }
					}
					<p><a href="/contact">{ i18n.T(ctx, i18n.KeyFindOrderContact) }</a></p>
				}
				<form class="goen-auth__form" method="post" action="/orders/find">
					<div class="goen-field">
						@widget.Label(widget.LabelProps{For: "find-number"}) {
							{ i18n.T(ctx, i18n.KeyFieldOrderNumber) }
						}
						@widget.Input(widget.FieldProps{
							ID:    "find-number",
							Name:  "number",
							Type:  "text",
							Value: v.Number,
							Attrs: templ.Attributes{
								"aria-describedby": "find-number-example",
								"autocomplete":     "off",
								"required":         true,
							},
						})
						<p class="goen-auth__hint" id="find-number-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), i18n.T(ctx, i18n.KeyOrderRefExample)) }</p>
					</div>
					<div class="goen-field">
						@widget.Label(widget.LabelProps{For: "find-email"}) {
							{ i18n.T(ctx, i18n.KeyFieldEmail) }
						}
						@widget.Input(widget.FieldProps{
							ID:    "find-email",
							Name:  "email",
							Type:  "email",
							Value: v.Email,
							Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
								"autocomplete": "email",
								"required":     true,
							}),
						})
					</div>
					@widget.Button(widget.ButtonProps{
						ButtonStyle: widget.ButtonStylePrimary,
						Size:        widget.SizeLarge,
						Block:       true,
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyFindOrderSubmit) }
					}
				</form>
				<p class="goen-auth__alt">
					{ i18n.T(ctx, i18n.KeyFindOrderSignIn) }
					<a href="/signin">{ i18n.T(ctx, i18n.KeySignIn) }</a>
				</p>
			</div>
		</div>
	}
}
