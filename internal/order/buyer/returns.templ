package buyer

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ Returns(p layouts.Page, v ReturnsView) {
	@layouts.Base(p) {
		<div class="goen-returns">
			<div class="goen-pagehead">
				<p class="goen-pagehead__eyebrow">{ i18n.T(ctx, i18n.KeyReturnTitle) }</p>
				<h1 class="goen-pagehead__title">{ v.Number }</h1>
				for i, parcel := range v.Shipments {
					if len(v.Shipments) > 1 {
						<p class="goen-returns__meta">{ v.parcelTitle(ctx, i) }</p>
					}
					<p class="goen-pagehead__sub">{ v.returnWindow(ctx, parcel) }</p>
				}
				if !v.HasOpen && v.AnyReturnable() {
					<p class="goen-pagehead__sub">
						{ i18n.T(ctx, i18n.KeyReturnSub) }
					</p>
				}
			</div>
			if !v.HasOpen && v.FormRefusal != "" {
				<p class="goen-notice goen-notice--danger" role="alert" id="return-form-error">{ v.FormRefusal }</p>
			}
			if len(v.Existing) > 0 {
				@widget.Card(widget.CardProps{
					Class: "goen-returns__existing",
					Attrs: templ.Attributes{"aria-labelledby": "existing-heading"},
				}) {
					<h2 id="existing-heading" class="goen-returns__subhead">{ i18n.T(ctx, i18n.KeyReturnHistory) }</h2>
					<ul class="goen-returns__records" role="list">
						for _, e := range v.Existing {
							<li class="goen-returns__record">
								<span class="goen-returns__recordbody">
									<span class="goen-returns__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReturnSentAt), e.CreatedAt) }</span>
									<span class="goen-returns__meta">{ e.Reason }</span>
									if e.Resolution != "" {
										<span class="goen-returns__meta">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReturnResolution), e.Resolution) }</span>
									}
								</span>
								if e.Resolution != "" {
									@widget.Badge(widget.BadgeProps{Intent: widget.IntentNeutral}) {
										{ e.StatusText(ctx) }
									}
								} else {
									@widget.Badge(widget.BadgeProps{Intent: widget.IntentWarn}) {
										{ e.StatusText(ctx) }
									}
								}
							</li>
						}
					</ul>
				}
			}
			if v.Filed {
				@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent, ID: "return-sent"}) {
					{ i18n.T(ctx, i18n.KeyReturnRequestSent) }
				}
			} else if v.HasOpen {
				@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent, ID: "return-inflight"}) {
					{ i18n.T(ctx, i18n.KeyReturnInFlight) }
				}
			} else if !v.AnyReturnable() {
				@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent, ID: "return-nothing"}) {
					{ i18n.T(ctx, i18n.KeyReturnNothingShort) }
				}
			}
			if (!v.HasOpen && v.AnyReturnable()) || v.HasDraft {
				@widget.Card(widget.CardProps{Class: "goen-returns__panel"}) {
					<form class="goen-returns__form" method="post" action={ templ.SafeURL(v.Action()) }>
						<fieldset class="goen-returns__lines">
							<legend class="goen-returns__subhead">{ i18n.T(ctx, i18n.KeyReturnChoose) }</legend>
							for _, l := range v.Lines {
								if l.CanReturn() || l.Quantity != "" {
									<div class="goen-returns__line">
										<div class="goen-returns__recordbody">
											<p class="goen-returns__name">{ l.Name }</p>
											if l.Label != "" {
												<span class="goen-returns__meta">{ l.Label }</span>
											}
											<span class="goen-returns__meta">{ l.SKU } · { l.UnitPrice() }</span>
										</div>
										<div class="goen-field goen-returns__qty">
											@widget.Label(widget.LabelProps{For: l.Field()}) {
												{ fmt.Sprintf(i18n.T(ctx, i18n.KeyReturnQuantity), l.Max()) }
											}
											@widget.Input(widget.FieldProps{
												ID:        l.Field(),
												Name:      l.Field(),
												Type:      l.QuantityType(),
												Value:     l.Quantity,
												Invalid:   l.Refusal != "",
												Describes: l.RefusalID(),
												Attrs: templ.Attributes{
													"min":       "0",
													"max":       l.Max(),
													"step":      "1",
													"inputmode": "numeric",
												},
											})
											if l.Refusal != "" {
												<p class="goen-notice goen-notice--danger" role="alert" id={ l.RefusalID() }>{ l.Refusal }</p>
											}
										</div>
									</div>
								}
							}
						</fieldset>
						<div class="goen-field">
							@widget.Label(widget.LabelProps{For: "return-reason"}) {
								{ i18n.T(ctx, i18n.KeyFieldReturnReason) }
							}
							// Written out, not composed: internal/policy/policy_test.go reads this element
							// to decide whether the policy page may say a reason is required.
							<textarea
								class="goen-input goen-input--area"
								id="return-reason"
								name="reason"
								rows="4"
								maxlength="500"
								if v.ReasonRefusal != "" {
									aria-invalid="true"
									aria-describedby="return-reason-error"
								}
							>{ v.Reason }</textarea>
							if v.ReasonRefusal != "" {
								<p class="goen-notice goen-notice--danger" role="alert" id="return-reason-error">{ v.ReasonRefusal }</p>
							}
						</div>
						<div class="goen-returns__actions">
							@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Attrs: templ.Attributes{"disabled": v.HasOpen || !v.AnyReturnable()}}, "submit") {
								{ i18n.T(ctx, i18n.KeyReturnSubmit) }
							}
							@widget.ButtonLink(widget.ButtonProps{
								ButtonStyle: widget.ButtonStyleGhost,
							}, templ.SafeURL("/orders/"+v.Number)) {
								{ i18n.T(ctx, i18n.KeyBackToOrder) }
							}
						</div>
					</form>
				}
			}
			if !v.HasDraft && (v.HasOpen || !v.AnyReturnable()) {
				<div class="goen-returns__actions">
					@widget.ButtonLink(widget.ButtonProps{
						ButtonStyle: widget.ButtonStyleOutline,
					}, templ.SafeURL("/orders/"+v.Number)) {
						{ i18n.T(ctx, i18n.KeyBackToOrder) }
					}
				</div>
			}
		</div>
	}
}
