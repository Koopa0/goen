package dashboard

import (
	"fmt"
	"strconv"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/product/inventory"
	"github.com/koopa0/goen/internal/ui/chart"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/stockrisk"
	"github.com/koopa0/goen/internal/ui/widget"
)

// Every figure and every task is a link: a count on its own says there is work and not where it is.
templ Dashboard(p frame.Page, v View) {
	@frame.Admin(p, "dashboard") {
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminQueueDashboardTitle) }</h1>
			</div>
		</div>
		if v.HealthUnavailable {
			<p class="goen-admin__hint" role="status">{ i18n.T(ctx, i18n.KeyAdminQueueHealthUnavailable) }</p>
		}
		<div class="goen-dash">
			<section class="goen-admin__queue goen-dash__tasks" aria-labelledby="tasks-heading">
				<h2 class="goen-admin__heading" id="tasks-heading">{ i18n.T(ctx, i18n.KeyAdminQueueTasksHeading) }</h2>
				if len(v.Tasks) == 0 {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueNothingWaiting) }</p>
				} else {
					<ul class="goen-admin__tasks" role="list">
						for _, t := range v.Tasks {
							<li class={ "goen-admin__task", templ.KV("goen-admin__task--alert", t.Alert) }>
								<a href={ templ.URL(t.Href) }>{ i18n.T(ctx, t.Label) }</a>
								<span class="goen-admin__taskfigure">
									<span class="goen-admin__cellnum">{ strconv.FormatInt(t.Count, 10) }</span>
									if t.HasAge {
										<span class="goen-admin__taskage">
											{ t.AgeText(ctx) }
											if t.Overdue {
												@widget.Badge(widget.BadgeProps{Intent: widget.IntentWarn}) {
													<span aria-hidden="true">▲</span>
													{ i18n.T(ctx, i18n.KeyAdminOverdue) }
												}
											}
										</span>
									}
								</span>
							</li>
						}
					</ul>
				}
			</section>
			<section class="goen-admin__queue goen-dash__sales" aria-labelledby="sales-heading">
				<h2 class="goen-admin__heading" id="sales-heading">
					<a href="/admin/reports?days=7">{ i18n.Count(ctx, i18n.KeyAdminQueueRevenueDays, DailyDays, DailyDays) }</a>
				</h2>
				if v.WeekUnavailable {
					<p class="goen-admin__hint" role="status">{ i18n.T(ctx, i18n.KeyAdminQueueWeekUnavailable) }</p>
				} else {
					if v.Daily.Density() >= chart.DensitySparse {
						@chart.Columns(v.SalesChart(ctx))
					} else {
						<p class="goen-admin__hint">{ v.SalesSentence(ctx) }</p>
					}
					@widget.StatLine(v.WeekStats(ctx), widget.StatLineGlance)
				}
			</section>
			<section class="goen-admin__queue goen-dash__stock" aria-labelledby="runway-heading">
				<h2 class="goen-admin__heading" id="runway-heading">
					<a href="/admin/reports#stock">{ i18n.T(ctx, i18n.KeyAdminRepStock) }</a>
				</h2>
				if len(v.Runway) == 0 {
					switch v.RunwayBasis {
						case RunwayEstimated:
							<p class="goen-admin__hint">{ i18n.Count(ctx, i18n.KeyAdminQueueRunwayNone, inventory.CoverWarnDays, inventory.CoverWarnDays) }</p>
						case RunwayNothingInStock:
							<p class="goen-admin__hint">{ i18n.Count(ctx, i18n.KeyAdminQueueRunwayNoStock, inventory.CoverWindowDays, inventory.CoverWindowDays) }</p>
						default:
							<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueRunwayUnknown) }</p>
					}
				} else {
					<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQueueRunwayLegend), inventory.CoverWindowDays, inventory.CoverWarnDays) }</p>
					@stockrisk.Rows(v.Runway, 0, inventory.CoverWindowDays)
				}
				<p class="goen-admin__hint">
					if v.RunwayCut {
						<a href="/admin/reports#stock">{ i18n.T(ctx, i18n.KeyAdminQueueRunwayRest) }</a>
					} else {
						<a href="/admin/reports#stock">{ i18n.T(ctx, i18n.KeyAdminQueueRunwayAll) }</a>
					}
				</p>
			</section>
			<section class="goen-admin__queue goen-dash__sellers" aria-labelledby="sellers-heading">
				<h2 class="goen-admin__heading" id="sellers-heading">
					<a href="/admin/reports?days=7">{ i18n.Count(ctx, i18n.KeyAdminQueueSellersHeading, WeekDays, WeekDays) }</a>
				</h2>
				if v.WeekUnavailable {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueWeekUnavailable) }</p>
				} else if len(v.Sellers) == 0 {
					<p class="goen-admin__hint">{ i18n.Count(ctx, i18n.KeyAdminQueueSellersNone, WeekDays, WeekDays) }</p>
				} else {
					<ul class="goen-report__rows" role="list">
						{{ top := v.TopUnits() }}
						for _, item := range v.Sellers {
							@widget.ReportRow(item.Name, item.Href(), item.Facts(ctx)) {
								if len(v.Sellers) > 1 {
									<div class="goen-report__plot">
										@chart.Bar(chart.BarProps{Value: item.Units, Max: top, Label: item.UnitsText()})
									</div>
								}
							}
						}
					</ul>
				}
			</section>
			<section class="goen-admin__queue goen-dash__orders" aria-labelledby="orders-heading">
				<h2 class="goen-admin__heading" id="orders-heading">
					<a href="/admin/orders">{ i18n.T(ctx, i18n.KeyAdminQueueOrders) }</a>
				</h2>
				if len(v.Recent) == 0 {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminQueueNoneYet) }</p>
				} else {
					<div class="goen-admin__tablewrap">
						<table class="ui-table goen-admin__table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, i18n.KeyFieldOrderNumber) }</th>
									<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColStatus) }</th>
									<th scope="col">{ i18n.T(ctx, i18n.KeyFieldRecipient) }</th>
									<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColPlacedAt) }</th>
									<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColAmount) }</th>
								</tr>
							</thead>
							<tbody>
								for _, o := range v.Recent {
									<tr>
										<td class="goen-admin__cellkey">
											<a href={ templ.URL("/admin/orders/" + o.Number) }>{ o.Number }</a>
										</td>
										<td>
											<div class="goen-admin__cellbadges">
												@widget.Badge(widget.BadgeProps{Intent: o.StatusIntent}) {
													{ o.StatusText }
												}
											</div>
										</td>
										<td>{ o.RecipientText(ctx) }</td>
										<td>{ o.PlacedAt }</td>
										<td class="goen-admin__cellnum">{ o.Total() }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		</div>
	}
}
