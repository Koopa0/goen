package taxonomy

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/widget"
)

// The tone is set on the taxonomy row, beside the name it belongs to.
templ CategoryForm(p frame.Page, v CategoryView) {
	@frame.Admin(p, "taxonomy") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">
					<a href="/admin/taxonomy">{ i18n.T(ctx, i18n.KeyAdminPageTaxonomy) }</a>
				</p>
				<h1 class="ui-page-head__title">{ v.Name }</h1>
			</div>
		</div>
		@widget.Announce(v.Notice)
		@widget.Card(widget.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminCatImage) }</h2>
			if v.Image.Has() && v.Image.URL() != "" {
				<img class="goen-admin__heroshot goen-admin__heroshot--category" src={ v.Image.URL() } srcset={ v.Image.Srcset() } sizes="160px" alt={ v.Image.Alt } loading="lazy" width="160" height="107"/>
				<form method="post" action={ templ.SafeURL(v.ImageRemoveAction()) }>
					@widget.Button(widget.ButtonProps{
						ButtonStyle: widget.ButtonStyleOutline,
						Size:        widget.SizeSmall,
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyAdminRemove) }
					}
				</form>
			}
			// Without enctype a browser posts only the filename.
			<form class="goen-admin__form" method="post" action={ templ.SafeURL(v.ImageAction()) } enctype="multipart/form-data">
				<div class="goen-admin__field">
					@widget.Label(widget.LabelProps{For: "cat-image"}) {
						{ i18n.T(ctx, i18n.KeyAdminProdUpload) }
					}
					<input
						class="goen-input"
						id="cat-image"
						name="image"
						type="file"
						accept="image/*"
						required?={ !v.Image.Has() }
						if v.HasErr("image") {
							aria-invalid="true"
							aria-describedby="cat-image-error"
						}
					/>
					if v.HasErr("image") {
						<p class="ui-error-text" id="cat-image-error" role="alert">{ v.Err("image") }</p>
					} else {
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminCatImageHint) }</p>
					}
				</div>
				<div class="goen-admin__field">
					@widget.Label(widget.LabelProps{For: "cat-alt"}) {
						{ i18n.T(ctx, i18n.KeyAdminCatAlt) }
					}
					<input
						class="goen-input"
						id="cat-alt"
						name="alt"
						value={ v.ImageAltDraft }
						maxlength="200"
						required
						if v.HasErr("alt") {
							aria-invalid="true"
							aria-describedby="cat-alt-hint cat-alt-error"
						} else {
							aria-describedby="cat-alt-hint"
						}
					/>
					<p class="goen-admin__hint" id="cat-alt-hint">{ i18n.T(ctx, i18n.KeyAdminCatAltHint) }</p>
					if v.HasErr("alt") {
						<p class="ui-error-text" id="cat-alt-error" role="alert">{ v.Err("alt") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@widget.Label(widget.LabelProps{For: "cat-alt-en"}) {
						{ i18n.T(ctx, i18n.KeyAdminCatAltEn) }
					}
					<input
						class="goen-input"
						id="cat-alt-en"
						name="alt_en"
						value={ v.ImageAltEnDraft }
						maxlength="200"
						if v.HasErr("alt_en") {
							aria-invalid="true"
							aria-describedby="cat-alt-en-hint cat-alt-en-error"
						} else {
							aria-describedby="cat-alt-en-hint"
						}
					/>
					<p class="goen-admin__hint" id="cat-alt-en-hint">{ i18n.T(ctx, i18n.KeyAdminCatAltHint) }</p>
					if v.HasErr("alt_en") {
						<p class="ui-error-text" id="cat-alt-en-error" role="alert">{ v.Err("alt_en") }</p>
					}
				</div>
				@widget.Button(widget.ButtonProps{
					ButtonStyle: widget.ButtonStylePrimary,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminProdSave) }
				}
			</form>
		}
	}
}
