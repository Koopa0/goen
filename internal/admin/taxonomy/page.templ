package taxonomy

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/tone"
	"github.com/koopa0/goen/internal/ui/widget"
)

// Two cards, each holding what it lists and the form that adds to it, because a brand
// and a category are separate jobs. The one filled button is the category create.
templ Taxonomy(p frame.Page, v *View) {
	@frame.Admin(p, "taxonomy") {
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminQueueTaxonomy) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminTaxLead) }
				</p>
			</div>
		</div>
		@widget.Announce(v.Notice)
		if v.Which == "brands" {
			@widget.RefusalSummary(widget.SummarizeRefusal(i18n.KeyAdminTaxNewBrand, v.Errors, widget.RefusalField{Key: "name", ID: "brands-name"}, widget.RefusalField{Key: "slug", ID: "brands-slug"}))
		} else if v.Which == "categories" {
			@widget.RefusalSummary(widget.SummarizeRefusal(i18n.KeyAdminTaxNewCategory, v.Errors, widget.RefusalField{Key: "name", ID: "categories-name"}, widget.RefusalField{Key: "name_en", ID: "categories-name-en"}, widget.RefusalField{Key: "slug", ID: "categories-slug"}, widget.RefusalField{Key: "icon_key", ID: "categories-icon"}, widget.RefusalField{Key: "tone", ID: "categories-tone"}, widget.RefusalField{Key: "parent", ID: "categories-parent"}))
		}
		@widget.Card(widget.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminTaxBrands) }</h2>
			@taxonList("brands", i18n.KeyAdminTaxNoBrands, v.Brands)
			@taxonForm("brands", i18n.KeyAdminTaxNewBrand, widget.ButtonStyleOutline, v)
		}
		@widget.Card(widget.CardProps{Class: "goen-admin__section"}) {
			<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminTaxCategories) }</h2>
			@taxonList("categories", i18n.KeyAdminTaxNoCategories, v.Categories)
			@taxonForm("categories", i18n.KeyAdminTaxNewCategory, widget.ButtonStylePrimary, v)
		}
	}
}

// taxonForm's fields keep the ids and names the handler and its tests read.
templ taxonForm(kind string, title i18n.Key, style widget.ButtonStyle, v *View) {
	<form id={ "new-" + kind } class="goen-admin__form" method="post" action={ templ.SafeURL("/admin/taxonomy/" + kind + "#new-" + kind) }>
		<h3 class="goen-admin__subhead">{ i18n.T(ctx, title) }</h3>
		if v.HasErr(kind, "form") {
			<p class="ui-error-text" role="alert">{ v.Err(kind, "form") }</p>
		}
		<div class="goen-admin__fields">
			<div class="goen-admin__field">
				@widget.Label(widget.LabelProps{For: kind + "-name"}) {
					{ i18n.T(ctx, i18n.KeyAdminColName) }
				}
				<input
					class="goen-input"
					id={ kind + "-name" }
					name="name"
					required
					maxlength="60"
					value={ v.DraftFor(kind, "name") }
					if v.HasErr(kind, "name") {
						aria-invalid="true"
						aria-describedby={ kind + "-name" + "-error" }
					}
				/>
				if v.HasErr(kind, "name") {
					<p class="ui-error-text" id={ kind + "-name" + "-error" }>{ v.Err(kind, "name") }</p>
				}
			</div>
			if kind == "categories" {
				<div class="goen-admin__field">
					@widget.Label(widget.LabelProps{For: kind + "-name-en"}) {
						{ i18n.T(ctx, i18n.KeyAdminTaxNameEn) }
					}
					<input
						class="goen-input"
						id={ kind + "-name-en" }
						name="name_en"
						maxlength="60"
						value={ v.DraftFor(kind, "name_en") }
						if v.HasErr(kind, "name_en") {
							aria-invalid="true"
							aria-describedby={ kind + "-name-en" + "-error" }
						}
					/>
					if v.HasErr(kind, "name_en") {
						<p class="ui-error-text" id={ kind + "-name-en" + "-error" }>{ v.Err(kind, "name_en") }</p>
					}
					<p class="goen-admin__hint">
						{ i18n.T(ctx, i18n.KeyAdminTaxNameEnHint) }
					</p>
				</div>
			}
			<div class="goen-admin__field">
				@widget.Label(widget.LabelProps{For: kind + "-slug"}) {
					{ i18n.T(ctx, i18n.KeyAdminColSlug) }
				}
				<input
					class="goen-input"
					id={ kind + "-slug" }
					name="slug"
					required
					maxlength="120"
					value={ v.DraftFor(kind, "slug") }
					if v.HasErr(kind, "slug") {
						aria-invalid="true"
						aria-describedby={ kind + "-slug" + "-error" }
					}
				/>
				if v.HasErr(kind, "slug") {
					<p class="ui-error-text" id={ kind + "-slug" + "-error" }>{ v.Err(kind, "slug") }</p>
				}
				<div class="goen-admin__hints">
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminTaxSlugFixed) }</p>
					<p class="goen-admin__hint">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminExample), slugExample(kind)) }</p>
				</div>
			</div>
			if kind == "categories" {
				<div class="goen-admin__field">
					@widget.Label(widget.LabelProps{For: "categories-icon"}) {
						{ i18n.T(ctx, i18n.KeyAdminColIcon) }
					}
					<select
						class="goen-input"
						id="categories-icon"
						name="icon_key"
						if v.HasErr(kind,"icon_key") {
							aria-invalid="true"
							aria-describedby="categories-icon-error"
						}
					>
						if v.HasErr(kind,"icon_key") && v.DraftFor(kind,"icon_key")!="" {
							<option value={ v.DraftFor(kind, "icon_key") } selected>{ v.DraftFor(kind,"icon_key") }</option>
						}
						<option value="">{ i18n.T(ctx, i18n.KeyAdminIconNone) }</option>
						for _, k := range icons.CategoryKeys() {
							<option value={ k } selected?={ v.DraftFor(kind, "icon_key") == k }>{ k }</option>
						}
					</select>
					if v.HasErr(kind, "icon_key") {
						<p class="ui-error-text" id="categories-icon-error">{ v.Err(kind, "icon_key") }</p>
					}
				</div>
				<div class="goen-admin__field">
					@widget.Label(widget.LabelProps{For: "categories-tone"}) {
						{ i18n.T(ctx, i18n.KeyAdminColTone) }
					}
					<select
						class="goen-input"
						id="categories-tone"
						name="tone"
						if v.HasErr(kind,"tone") {
							aria-invalid="true"
							aria-describedby="categories-tone-error"
						}
					>
						if v.HasErr(kind,"tone") && v.DraftFor(kind,"tone")!="" {
							<option value={ v.DraftFor(kind, "tone") } selected>{ v.DraftFor(kind,"tone") }</option>
						}
						<option value="">{ i18n.T(ctx, i18n.KeyAdminToneInherit) }</option>
						for k := range tone.All() {
							<option value={ string(k) } selected?={ v.DraftFor(kind, "tone") == string(k) }>{ k.Label(ctx) }</option>
						}
					</select>
					if v.HasErr(kind, "tone") {
						<p class="ui-error-text" id="categories-tone-error">{ v.Err(kind, "tone") }</p>
					}
				</div>
				<label class="goen-check">
					<input class="goen-check__box" type="checkbox" name="comparable" value="1" checked?={ v.DraftFor(kind, "comparable") != "" }/>
					<span>{ i18n.T(ctx, i18n.KeyAdminColComparable) }</span>
				</label>
				<div class="goen-admin__field">
					@widget.Label(widget.LabelProps{For: "categories-parent"}) {
						{ i18n.T(ctx, i18n.KeyAdminTaxParent) }
					}
					<select
						class="goen-input"
						id="categories-parent"
						name="parent"
						if v.HasErr(kind, "parent") {
							aria-invalid="true"
							aria-describedby="categories-parent-error"
						}
					>
						<option value="">{ i18n.T(ctx, i18n.KeyAdminTaxTopLevel) }</option>
						for _, c := range v.Categories {
							<option value={ c.Slug } selected?={ v.DraftFor(kind, "parent") == c.Slug }>{ c.Name }</option>
						}
						if v.missingParentChoice() != "" {
							<option value={ v.missingParentChoice() } selected>{ v.missingParentChoice() }</option>
						}
					</select>
					if v.HasErr(kind, "parent") {
						<p class="ui-error-text" id="categories-parent-error">{ v.Err(kind, "parent") }</p>
					}
					<div class="goen-admin__hints">
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminTaxParentHint) }</p>
					</div>
				</div>
			}
		</div>
		@widget.Button(widget.ButtonProps{ButtonStyle: style, Class: "goen-admin__submit"}, "submit") {
			{ i18n.T(ctx, i18n.KeyAdminTaxCreate) }
		}
	</form>
}

// taxonList is the tree. The indent is carried by data-depth and read by an
// attribute selector, because style-src holds no 'unsafe-inline' and a refused
// inline custom property would render the whole tree flat (#379).
templ taxonList(kind string, empty i18n.Key, rows []Taxon) {
	if len(rows) == 0 {
		<div class="goen-admin__empty">
			<p class="goen-admin__emptytitle">{ i18n.T(ctx, empty) }</p>
		</div>
	} else {
		if kind == "categories" {
			<p class="goen-admin__hint goen-admin__taxonhead">
				<span>{ i18n.T(ctx, i18n.KeyAdminColName) }</span>
				<span>{ i18n.T(ctx, i18n.KeyAdminTaxNameEn) }</span>
				<span>{ i18n.T(ctx, i18n.KeyAdminColIcon) }</span>
				<span>{ i18n.T(ctx, i18n.KeyAdminColTone) }</span>
				<span>{ i18n.T(ctx, i18n.KeyAdminColComparable) }</span>
			</p>
		}
		<ul class="goen-admin__taxa" role="list">
			for _, t := range rows {
				<li class="goen-admin__taxon" data-depth={ t.DepthText() }>
					<form class={ "goen-admin__taxonform", templ.KV("goen-admin__taxonform--category", kind == "categories") } method="post" action={ templ.SafeURL("/admin/taxonomy/" + kind + "/" + t.Slug) }>
						if kind == "categories" {
							<div class="goen-admin__taxonfield">
								<label class="goen-admin__taxonlabel" for={ "tax-name-" + t.Slug }>{ i18n.T(ctx, i18n.KeyAdminColName) }</label>
								<input class="goen-input" id={ "tax-name-" + t.Slug } name="name" value={ t.Name } required maxlength="60" aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxNameOf), t.Name) }/>
							</div>
						} else {
							<input
								class="goen-input"
								name="name"
								value={ t.Name }
								required
								maxlength="60"
								aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxNameOf), t.Name) }
							/>
						}
						if kind == "categories" {
							<div class="goen-admin__taxonfield">
								<label class="goen-admin__taxonlabel" for={ "tax-name-en-" + t.Slug }>{ i18n.T(ctx, i18n.KeyAdminTaxNameEn) }</label>
								// Rendered with its current value: the rename writes what the form carries.
								<input
									class="goen-input"
									name="name_en"
									id={ "tax-name-en-" + t.Slug }
									value={ t.NameEn }
									maxlength="60"
									placeholder="English"
									aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxNameEnOf), t.Name) }
								/>
							</div>
							<div class="goen-admin__taxonfield">
								<label class="goen-admin__taxonlabel" for={ "tax-icon-" + t.Slug }>{ i18n.T(ctx, i18n.KeyAdminColIcon) }</label>
								<select
									class="goen-input"
									name="icon_key"
									id={ "tax-icon-" + t.Slug }
									aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxIconOf), t.Name) }
								>
									<option value="">{ i18n.T(ctx, i18n.KeyAdminIconNone) }</option>
									for _, k := range icons.CategoryKeys() {
										<option value={ k } selected?={ t.IconKey == k }>{ k }</option>
									}
								</select>
							</div>
							<div class="goen-admin__taxonfield">
								<label class="goen-admin__taxonlabel" for={ "tax-tone-" + t.Slug }>{ i18n.T(ctx, i18n.KeyAdminColTone) }</label>
								<select
									class="goen-input"
									name="tone"
									id={ "tax-tone-" + t.Slug }
									aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxToneOf), t.Name) }
								>
									<option value="">{ i18n.T(ctx, i18n.KeyAdminToneInherit) }</option>
									for k := range tone.All() {
										<option value={ string(k) } selected?={ t.Tone == string(k) }>{ k.Label(ctx) }</option>
									}
								</select>
							</div>
							if t.Depth == 0 {
								<div class="goen-admin__taxonfield">
									<label class="goen-check">
										<input
											class="goen-check__box"
											type="checkbox"
											name="comparable"
											value="1"
											checked?={ t.Comparable }
											aria-label={ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxComparableOf), t.Name) }
										/>
										<span>{ i18n.T(ctx, i18n.KeyAdminColComparable) }</span>
									</label>
								</div>
							} else {
								<span class="goen-admin__taxonfield" aria-hidden="true"></span>
							}
						}
						@widget.Button(widget.ButtonProps{
							ButtonStyle: widget.ButtonStyleOutline,
							Size:        widget.SizeSmall,
							Attrs:       templ.Attributes{"name": "action", "value": "rename"},
						}, "submit") {
							{ i18n.T(ctx, i18n.KeyAdminProdSave) }
						}
						if t.Removable() {
							@widget.Button(widget.ButtonProps{
								ButtonStyle: widget.ButtonStyleGhost,
								Size:        widget.SizeSmall,
								Attrs:       templ.Attributes{"name": "action", "value": "delete"},
							}, "submit") {
								{ i18n.T(ctx, i18n.KeyAdminDelete) }
							}
						}
					</form>
					<span class="goen-admin__meta">
						{ t.Slug }
						if kind == "categories" && !t.Translated() {
							@widget.Badge(widget.BadgeProps{Intent: widget.IntentWarn}) {
								{ i18n.T(ctx, i18n.KeyAdminUntranslated) }
							}
						}
						if t.Parent != "" {
							{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminTaxUnder), t.Parent) }
						}
						if !t.Removable() {
							· { t.Why(ctx) }
						}
						if kind == "categories" {
							<a href={ templ.SafeURL(t.HeaderHref()) }>{ i18n.T(ctx, i18n.KeyAdminTaxHeader) }</a>
						}
					</span>
				</li>
			}
		</ul>
	}
}
