package banners

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ Banners(p layouts.Page, v *BannersView) {
	@layouts.Admin(p, "banners") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminHomeBanner) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminHomeBannerLead) }
				</p>
			</div>
		</div>
		@layouts.Announce(v.Notice)
		@layouts.RefusalSummary(layouts.SummarizeRefusal(i18n.KeyAdminRefusalBanner, v.Errors, layouts.RefusalField{Key: "message", ID: "b-message"}, layouts.RefusalField{Key: "short", ID: "b-short"}, layouts.RefusalField{Key: "message_en", ID: "b-message-en"}, layouts.RefusalField{Key: "short_en", ID: "b-short-en"}, layouts.RefusalField{Key: "cta", ID: "b-cta-href"}, layouts.RefusalField{Key: "days", ID: "b-days"}))
		<div class="goen-admin__productlayout">
			<form class="goen-admin__form" id="new-banner" method="post" action="/admin/banners#new-banner">
				@widget.LangSwitch("banner_lang", v.InEnglish())
				<div class="goen-admin__langgroup" data-lang="zh">
					<div class="ui-field">
						<label class="ui-label" for="b-message">{ i18n.T(ctx, i18n.KeyAdminHomeBannerMessage) }</label>
						<input
							class="ui-input"
							id="b-message"
							name="message"
							aria-required="true"
							maxlength="60"
							value={ v.Draft.Message }
							if v.HasErr("message") {
								aria-invalid="true"
								aria-describedby="b-message-example b-message-error"
							} else {
								aria-describedby="b-message-example"
							}
						/>
						<p class="goen-admin__hint" id="b-message-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), i18n.T(ctx, i18n.KeyAdminHomeBannerMessageExample)) }</p>
						if v.HasErr("message") {
							<p class="ui-error-text" id="b-message-error">{ v.Err("message") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-short">{ i18n.T(ctx, i18n.KeyAdminHomeBannerShort) }</label>
						<input
							class="ui-input"
							id="b-short"
							name="short"
							maxlength="60"
							value={ v.Draft.Short }
							if v.HasErr("short") {
								aria-invalid="true"
								aria-describedby="b-short-example b-short-error"
							} else {
								aria-describedby="b-short-example"
							}
						/>
						<p class="goen-admin__hint" id="b-short-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), i18n.T(ctx, i18n.KeyAdminHomeBannerShortExample)) }</p>
						<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminHomeBannerShortHint) }</p>
						if v.HasErr("short") {
							<p class="ui-error-text" id="b-short-error">{ v.Err("short") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-cta-label">{ i18n.T(ctx, i18n.KeyAdminHomeBannerCTALabel) }</label>
						<input class="ui-input" id="b-cta-label" aria-describedby="b-cta-label-example" name="cta_label" maxlength="20" value={ v.Draft.CTALabel }/>
						<p class="goen-admin__hint" id="b-cta-label-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), i18n.T(ctx, i18n.KeyAdminHomeBannerCTAExample)) }</p>
					</div>
				</div>
				<div class="goen-admin__langgroup" data-lang="en">
					<div class="ui-field">
						<label class="ui-label" for="b-message-en">{ i18n.T(ctx, i18n.KeyAdminHomeBannerMessageEn) }</label>
						<input
							class="ui-input"
							id="b-message-en"
							name="message_en"
							maxlength="60"
							value={ v.Draft.MessageEn }
							if v.HasErr("message_en") {
								aria-invalid="true"
								aria-describedby="b-message-en-example b-message-en-error"
							} else {
								aria-describedby="b-message-en-example"
							}
						/>
						<p class="goen-admin__hint" id="b-message-en-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), i18n.T(ctx, i18n.KeyAdminHomeBannerMessageEnExample)) }</p>
						if v.HasErr("message_en") {
							<p class="ui-error-text" id="b-message-en-error">{ v.Err("message_en") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-short-en">{ i18n.T(ctx, i18n.KeyAdminHomeBannerShortEn) }</label>
						<input
							class="ui-input"
							id="b-short-en"
							name="short_en"
							maxlength="60"
							value={ v.Draft.ShortEn }
							if v.HasErr("short_en") {
								aria-invalid="true"
								aria-describedby="b-short-en-error"
							}
						/>
						if v.HasErr("short_en") {
							<p class="ui-error-text" id="b-short-en-error">{ v.Err("short_en") }</p>
						}
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-cta-label-en">{ i18n.T(ctx, i18n.KeyAdminHomeBannerCTALabelEn) }</label>
						<input class="ui-input" id="b-cta-label-en" aria-describedby="b-cta-label-en-example" name="cta_label_en" maxlength="20" value={ v.Draft.CTALabelEn }/>
						<p class="goen-admin__hint" id="b-cta-label-en-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), i18n.T(ctx, i18n.KeyAdminHomeBannerCTAEnExample)) }</p>
					</div>
				</div>
				<div class="goen-checkout__fields">
					<div class="ui-field">
						<label class="ui-label" for="b-cta-href">{ i18n.T(ctx, i18n.KeyAdminHomeBannerCTAHref) }</label>
						<input
							class="ui-input"
							id="b-cta-href"
							name="cta_href"
							maxlength="200"
							value={ v.Draft.CTAHref }
							if v.HasErr("cta") {
								aria-invalid="true"
								aria-describedby="b-cta-href-example b-cta-error"
							} else {
								aria-describedby="b-cta-href-example"
							}
						/>
						<p class="goen-admin__hint" id="b-cta-href-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), "/deals") }</p>
					</div>
					<div class="ui-field">
						<label class="ui-label" for="b-code">{ i18n.T(ctx, i18n.KeyAdminHomeBannerCode) }</label>
						<input class="ui-input" id="b-code" aria-describedby="b-code-example" name="code" maxlength="40" value={ v.Draft.Code }/>
						<p class="goen-admin__hint" id="b-code-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), "FREESHIP") }</p>
					</div>
				</div>
				<div class="ui-field">
					<label class="ui-label" for="b-days">{ i18n.T(ctx, i18n.KeyAdminHomeDays) }</label>
					<input
						class="ui-input"
						id="b-days"
						name="days"
						type="number"
						min="0"
						max="365"
						step="1"
						inputmode="numeric"
						value={ v.Draft.Days }
						if v.HasErr("days") {
							aria-invalid="true"
							aria-describedby="b-days-example b-days-error"
						} else {
							aria-describedby="b-days-example"
						}
					/>
					<p class="goen-admin__hint" id="b-days-example">{ i18n.T(ctx, i18n.KeyAdminHomeDaysHint) }</p>
					if v.HasErr("days") {
						<p class="ui-error-text" id="b-days-error">{ v.Err("days") }</p>
					}
				</div>
				if v.HasErr("cta") {
					<p class="ui-error-text" id="b-cta-error" role="alert">{ v.Err("cta") }</p>
				}
				@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminHomeBannerAdd) }
				}
			</form>
			<aside class="goen-admin__side">
				<h2 class="goen-admin__subhead" id="banner-history">{ i18n.T(ctx, i18n.KeyAdminHomeBannerCurrent) }</h2>
				if !v.HasBanners() && !v.Bound.PastEnd {
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminHomeBannerEmpty) }</p>
				} else if v.HasBanners() {
					<ul class="goen-admin__coupons" role="list">
						for _, b := range v.Rows {
							<li class="goen-admin__coupon">
								<div class="goen-admin__couponhead">
									<span class="goen-admin__sku">{ b.Message }</span>
									if b.Active {
										<span class="ui-badge ui-badge--brand">{ i18n.T(ctx, i18n.KeyAdminHomeShowing) }</span>
									} else {
										<span class="ui-badge">{ i18n.T(ctx, i18n.KeyAdminHomeBannerOff) }</span>
									}
									if !b.Translated() {
										<span class="ui-badge ui-badge--warn">{ i18n.T(ctx, i18n.KeyAdminUntranslated) }</span>
									}
								</div>
								<span class="ui-cart-line__meta">
									if b.MessageEn != "" {
										{ b.MessageEn }
									}
									if b.HasCTA() {
										· { b.CTALabel } → { b.CTAHref }
									}
									if b.Scheduled() {
										{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminHomeBannerEndsAt), b.EndsAt) }
									}
								</span>
								<form method="post" action={ templ.SafeURL("/admin/banners/" + b.ID + "/active") }>
									if b.Active {
										<input type="hidden" name="active" value="0"/>
										<button class="ui-btn ui-btn--secondary" type="submit">{ i18n.T(ctx, i18n.KeyAdminHomeBannerClose) }</button>
									} else {
										<input type="hidden" name="active" value="1"/>
										<button class="ui-btn ui-btn--secondary" type="submit">{ i18n.T(ctx, i18n.KeyAdminHomeBannerOpen) }</button>
									}
								</form>
							</li>
						}
					</ul>
				}
				@widget.ListPager(v.Bound, "banner-history")
			</aside>
		</div>
	}
}
