package questions

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/widget"
)

// A divided list rather than a column of cards: the queue is read down the page for
// the rows that still owe an answer, and the state is a badge, not a colour.
// Neither button is primary: a filled button on every row is a screen of them.
// The list keeps the class the layout gate finds the page by
// (scripts/check-layout.mjs); the divided list paints it.
templ Questions(p frame.Page, v View) {
	@frame.Admin(p, "questions") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">{ i18n.T(ctx, i18n.KeyAdminEyebrow) }</p>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminPageQuestions) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminQuestionsLead) }
				</p>
				if v.Waiting() > 0 {
					<p class="goen-admin__headcount">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQuestionsWaiting), v.WaitingText()) }</p>
				}
			</div>
			@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStyleGhost, Class: "goen-modqueue__switch"}, templ.SafeURL(v.OtherQueueHref())) {
				{ v.OtherQueueLabel(ctx) }
			}
		</div>
		@widget.Announce(v.Notice)
		if v.Empty() {
			<div class="goen-admin__empty">
				<span class="goen-modqueue__emptyicon">
					@icons.Chat()
				</span>
				<p class="goen-admin__emptytitle">{ v.EmptyLabel(ctx) }</p>
			</div>
		} else {
			<ul class="goen-admin__questions goen-modqueue" role="list">
				for _, q := range v.Rows {
					<li class="goen-modqueue__item">
						<div class="goen-modqueue__record">
							<div class="goen-modqueue__head">
								<p class="goen-modqueue__title">
									<a href={ templ.SafeURL(q.ProductHref()) }>{ q.ProductName }</a>
								</p>
								if q.Waiting() {
									@widget.Badge(widget.BadgeProps{Intent: widget.IntentWarn}) {
										{ q.State(ctx) }
									}
								} else {
									@widget.Badge(widget.BadgeProps{}) {
										{ q.State(ctx) }
									}
								}
							</div>
							<p class="goen-admin__note">{ q.Body }</p>
							<span class="goen-admin__meta">
								{ q.Who(ctx) } · { q.Asked } · { fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminQuestionAnswers), q.AnswersText()) }
							</span>
							if len(q.Answers) > 0 {
								<ul class="goen-modqueue" role="list">
									for _, answer := range q.Answers {
										<li>
											if answer.IsStaff {
												@widget.Badge(widget.BadgeProps{}) {
													{ i18n.T(ctx, i18n.KeyStaffAnswer) }
												}
											}
											if answer.Hidden {
												@widget.Badge(widget.BadgeProps{}) {
													{ i18n.T(ctx, i18n.KeyAdminQHidden) }
												}
											}
											<p class="goen-admin__note">{ answer.Body }</p>
											<span class="goen-admin__meta">
												if answer.Author != "" {
													{ answer.Author } ·
												}
												{ answer.At }
											</span>
											if !answer.Hidden {
												<form method="post" action={ templ.SafeURL(q.AnswerAction()) }>
													<input type="hidden" name="answer_id" value={ answer.ID }/>
													@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStyleGhost, Size: widget.SizeSmall, Attrs: templ.Attributes{"name": "action", "value": string(QuestionHideAnswerAction)}}, "submit") {
														{ i18n.T(ctx, i18n.KeyAdminAnswerHide) }
													}
												</form>
											}
										</li>
									}
								</ul>
							}
						</div>
						<form class="goen-admin__form" method="post" action={ templ.SafeURL(q.AnswerAction()) }>
							if !q.Hidden {
								<div class="goen-admin__field">
									@widget.Label(widget.LabelProps{For: "answer-" + q.ID}) {
										{ i18n.T(ctx, i18n.KeyAdminQuestionReply) }
									}
									@widget.Textarea(widget.FieldProps{
										ID:        "answer-" + q.ID,
										Name:      "body",
										Invalid:   q.Error != "",
										Describes: "answer-error-" + q.ID,
										Attrs: templ.Attributes{
											"maxlength":   "1000",
											"placeholder": i18n.T(ctx, i18n.KeyAdminQuestionHint),
											"rows":        "3",
										},
									}) {
										{ q.Draft }
									}
									if q.Error != "" {
										<p class="ui-error-text" id={ "answer-error-" + q.ID } role="alert">{ q.Error }</p>
									}
								</div>
							}
							<div class="goen-modqueue__actions">
								if !q.Hidden {
									@widget.Button(widget.ButtonProps{
										ButtonStyle: widget.ButtonStyleOutline,
										Size:        widget.SizeSmall,
										Attrs:       templ.Attributes{"name": "action", "value": string(QuestionAnswerAction)},
									}, "submit") {
										{ i18n.T(ctx, i18n.KeyAdminQuestionSend) }
									}
								}
								@widget.Button(widget.ButtonProps{
									ButtonStyle: widget.ButtonStyleGhost,
									Size:        widget.SizeSmall,
									Attrs:       templ.Attributes{"name": "action", "value": string(q.VisibilityAction())},
								}, "submit") {
									{ q.VisibilityLabel(ctx) }
								}
							</div>
						</form>
					</li>
				}
			</ul>
		}
		@widget.ListPager(v.Bound)
	}
}
