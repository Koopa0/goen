package stock

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/product/inventory"
	"github.com/koopa0/goen/internal/ui/components"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/stockrisk"
)

templ Variants(p layouts.Page, v VariantsView) {
	@layouts.Admin(p, "stock") {
		<div class="ui-page-head">
			<div>
				<h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminQueueStock) }</h1>
				<p class="ui-page-head__sub">
					{ i18n.T(ctx, i18n.KeyAdminQueueStockLead) }
				</p>
			</div>
		</div>
		@layouts.Announce(v.Notice)
		for _, refusal := range v.Refusals() {
			@layouts.RefusalSummary(refusal)
		}
		if v.ShowCover {
			<section class="goen-admin__cover">
				@stockrisk.Section(v.AtRisk, v.MoreSoldOut, inventory.CoverWindowDays)
			</section>
		}
		<section aria-labelledby="stock-list-heading">
			<h2 class="goen-sr-only" id="stock-list-heading">{ i18n.T(ctx, i18n.KeyAdminStockList) }</h2>
			<form class="goen-admin__search" method="get" action="/admin/stock">
				if v.SoldOutOnly {
					<input type="hidden" name="soldout" value="1"/>
				}
				<label class="goen-sr-only" for="stock-search">{ i18n.T(ctx, i18n.KeyAdminStockSearch) }</label>
				<input
					class="ui-input"
					id="stock-search"
					type="search"
					name="q"
					value={ v.Term }
					placeholder={ i18n.T(ctx, i18n.KeyAdminStockSearchPlaceholder) }
					autocomplete="off"
				/>
				<button class="ui-btn ui-btn--secondary" type="submit">{ i18n.T(ctx, i18n.KeyAdminSearch) }</button>
			</form>
			<div class="ui-filterbar goen-admin__tabs">
				<a
					class="ui-filter"
					href={ templ.SafeURL(v.AllHref()) }
					if !v.SoldOutOnly {
						aria-current="page"
					}
				>{ i18n.T(ctx, i18n.KeyAdminTabAll) }</a>
				<a
					class="ui-filter"
					href={ templ.SafeURL(v.SoldOutHref()) }
					if v.SoldOutOnly {
						aria-current="page"
					}
				>{ i18n.T(ctx, i18n.KeyAdminQueueSoldOutOnly) }</a>
			</div>
			if v.Empty() && !v.PastEnd {
				<div class="ui-empty">
					<p class="ui-empty__title">{ i18n.T(ctx, i18n.KeyAdminQueueNoVariants) }</p>
				</div>
			} else if !v.Empty() {
				<div class="goen-admin__tablewrap">
					@variantTable(v.Variants, v.Return)
				</div>
			}
			@components.ListPager(v.Bound)
		</section>
	}
}

templ variantTable(variants []Variant, back string) {
	<table class="ui-table goen-admin__table goen-admin__stock">
		<thead>
			<tr>
				<th scope="col">SKU</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColProduct) }</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminQueueColStock) }</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminQueueColPrice) }</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminVariantArrival) }</th>
				<th scope="col">{ i18n.T(ctx, i18n.KeyAdminQueueAdjust) }</th>
			</tr>
		</thead>
		<tbody>
			for _, x := range variants {
				<tr id={ "row-" + x.SKU } class={ templ.KV("goen-admin__row--low", x.Low()) }>
					<td>
						<a href={ templ.SafeURL("/admin/stock/" + x.SKU) }>{ x.SKU }</a>
						<span class="ui-cart-line__meta">
							<a href={ templ.URL("/p/" + x.Slug) }>{ i18n.T(ctx, i18n.KeyAdminQueueViewProduct) }</a>
						</span>
						if !x.Active {
							<span class="ui-badge">{ i18n.T(ctx, i18n.KeyAdminQueueVariantOff) }</span>
						}
					</td>
					<td>
						{ x.ProductName }
						if x.OptionText() != "" {
							<span class="ui-cart-line__meta">{ x.OptionText() }</span>
						}
						<span class="ui-cart-line__meta">{ x.Brand }</span>
					</td>
					<td>
						{ x.StockText() } / { x.SafetyText() } /
						<strong>{ x.SellableText() }</strong>
					</td>
					<td>
						<form class="goen-admin__inline" method="post" action="/admin/stock/price">
							<input type="hidden" name="return" value={ back }/>
							<input type="hidden" name="sku" value={ x.SKU }/>
							<label class="goen-sr-only" for={ "price-" + x.SKU }>{ i18n.T(ctx, i18n.KeyAdminQueuePrice) }</label>
							<input class="ui-input ui-input--sm goen-admin__num" id={ "price-" + x.SKU } type="number" name="price" value={ x.PriceText() } min="0" step="1"/>
							<label class="goen-sr-only" for={ "cmp-" + x.SKU }>{ i18n.T(ctx, i18n.KeyAdminQueueComparePrice) }</label>
							<input
								class="ui-input ui-input--sm goen-admin__num"
								id={ "cmp-" + x.SKU }
								type="number"
								name="compare_at"
								value={ x.CompareText() }
								min="0"
								step="1"
								placeholder={ i18n.T(ctx, i18n.KeyAdminQueueComparePrice) }
							/>
							<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminQueuePriceSave) }</button>
						</form>
					</td>
					<td>
						<form class="goen-admin__inline" method="post" action="/admin/stock/arrival">
							<input type="hidden" name="return" value={ back }/>
							<input type="hidden" name="sku" value={ x.SKU }/>
							<label class="goen-sr-only" for={ "arrival-" + x.SKU }>{ i18n.T(ctx, i18n.KeyAdminVariantArrival) }</label>
							<input
								class="ui-input ui-input--sm"
								id={ "arrival-" + x.SKU }
								type="date"
								name="arrival_on"
								value={ x.ArrivalInput }
								if x.ArrivalError != "" {
									aria-invalid="true"
									aria-describedby={ "arrival-error-" + x.SKU }
								}
							/>
							if x.ArrivalError != "" {
								<p class="ui-error-text" id={ "arrival-error-" + x.SKU } role="alert">{ x.ArrivalError }</p>
							}
							<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminVariantArrivalSave) }</button>
						</form>
					</td>
					<td>
						<form class="goen-admin__inline" method="post" action={ templ.URL("/admin/stock/adjust#row-" + x.SKU) }>
							<input type="hidden" name="return" value={ back }/>
							<input type="hidden" name="sku" value={ x.SKU }/>
							<input type="hidden" name="idempotency" value={ x.AdjustKey() }/>
							<label class="goen-sr-only" for={ "adj-" + x.SKU }>{ i18n.T(ctx, i18n.KeyAdminQueueAdjustQty) }</label>
							<input
								class="ui-input ui-input--sm goen-admin__num"
								id={ "adj-" + x.SKU }
								type={ components.DollarInputType(x.DraftDelta) }
								inputmode="numeric"
								name="delta"
								value={ x.DraftDelta }
								step="1"
								if x.DeltaError != "" {
									aria-invalid="true"
									aria-describedby={ "adj-example-" + x.SKU + " adj-error-" + x.SKU }
								} else {
									aria-describedby={ "adj-example-" + x.SKU }
								}
							/>
							<p class="goen-admin__hint" id={ "adj-example-" + x.SKU }>{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), "+10") }</p>
							if x.DeltaError != "" {
								<p class="ui-error-text" id={ "adj-error-" + x.SKU } role="alert">{ x.DeltaError }</p>
							}
							<button class="ui-btn ui-btn--secondary ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminQueueAdjust) }</button>
						</form>
						<form class="goen-admin__inline" method="post" action="/admin/stock/active">
							<input type="hidden" name="return" value={ back }/>
							<input type="hidden" name="sku" value={ x.SKU }/>
							if x.Active {
								<input type="hidden" name="active" value="0"/>
								<button class="ui-btn ui-btn--ghost ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminToggleOff) }</button>
							} else {
								<input type="hidden" name="active" value="1"/>
								<button class="ui-btn ui-btn--ghost ui-btn--sm" type="submit">{ i18n.T(ctx, i18n.KeyAdminToggleOn) }</button>
							}
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
