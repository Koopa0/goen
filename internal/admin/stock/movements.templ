package stock

import (
	"fmt"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/chart"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/widget"
)

// The receiving form comes before the ledger because a delivery has arrived and
// the count has to be raised; the ledger is read afterwards to check it landed.
// The correction and the switch-off sit with it because the stock list's rows
// only receive.
templ Movements(p frame.Page, v *MovementsView) {
	@frame.Admin(p, "stock") {
		<div class="ui-page-head">
			<div>
				<p class="ui-page-head__eyebrow">
					<a href="/admin/stock">{ i18n.T(ctx, i18n.KeyAdminStockLink) }</a>
				</p>
				<h1 class="ui-page-head__title">{ v.SKU }</h1>
				<p class="ui-page-head__sub">
					<a href={ templ.SafeURL("/admin/products/" + v.Slug) }>{ v.ProductName }</a>
					{ fmt.Sprintf(i18n.T(ctx, i18n.KeyAdminStockNowSafe), v.StockText(), v.SafetyText()) }
				</p>
			</div>
		</div>
		@widget.Announce(v.Notice)
		@receiveForm(v)
		@adjustForm(v)
		@activeForm(v)
		if v.HasStockDays() && !v.Empty() {
			if v.DrawsStockLine() {
				@chart.StepLine(v.StockLine(ctx))
			} else {
				<p class="goen-admin__hint">{ v.NoStockLine(ctx) }</p>
			}
		}
		if v.Empty() && !v.PastEnd {
			<div class="goen-admin__empty">
				<p class="goen-admin__emptytitle">{ i18n.T(ctx, i18n.KeyAdminLedgerEmpty) }</p>
			</div>
		} else if !v.Empty() {
			<div class="goen-admin__tablewrap">
				<table class="ui-table goen-admin__table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColWhen) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColChange) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColReason) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColOrder) }</th>
							<th scope="col">{ i18n.T(ctx, i18n.KeyAdminColActor) }</th>
							<th class="goen-admin__cellnum" scope="col">{ i18n.T(ctx, i18n.KeyAdminColBalance) }</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range v.Rows {
							<tr>
								<td class="goen-admin__cellkey">{ m.At }</td>
								<td class={ "goen-admin__cellnum", templ.KV("goen-admin__in", m.In()) }>{ m.DeltaText() }</td>
								<td>{ m.Reason.Label(ctx) }</td>
								<td>
									if m.HasOrder() {
										<a href={ templ.SafeURL("/admin/orders/" + m.OrderNumber) }>{ m.OrderNumber }</a>
									} else {
										—
									}
								</td>
								<td>{ m.By(ctx) }</td>
								<td class="goen-admin__cellnum">{ m.RunningText() }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminLedgerFoot) }
			</p>
		}
		@widget.ListPager(v.Bound)
	}
}

// receiveForm raises the count. The idempotency key is rendered with the
// form so a reload cannot post the same delivery twice.
templ receiveForm(v *MovementsView) {
	@widget.Card(widget.CardProps{Class: "goen-admin__section"}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminReceiveButton) }</h2>
		<form class="goen-admin__form" method="post" action="/admin/stock/receive">
			<input type="hidden" name="sku" value={ v.SKU }/>
			<input type="hidden" name="idempotency" value={ v.ReceiveKey() }/>
			<div class="goen-admin__field">
				@widget.Label(widget.LabelProps{For: "receive-qty"}) {
					{ i18n.T(ctx, i18n.KeyAdminReceiveQty) }
				}
				<input
					class="goen-input goen-admin__num"
					id="receive-qty"
					type="text"
					inputmode="numeric"
					name="quantity"
					value={ v.DraftQuantity }
					if v.QuantityError != "" {
						aria-invalid="true"
						aria-describedby="receive-qty-error"
					}
					required
				/>
				if v.QuantityError != "" {
					<p class="ui-error-text" id="receive-qty-error" role="alert">{ v.QuantityError }</p>
				}
			</div>
			@widget.Button(widget.ButtonProps{
				ButtonStyle: widget.ButtonStylePrimary,
				Class:       "goen-admin__submit",
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminReceiveButton) }
			}
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminReceiveHint) }
			</p>
		</form>
	}
}

// adjustForm corrects the count either way, for a stocktake difference or
// damaged goods. Its key is rendered with the form for the reason the receiving
// form's is.
templ adjustForm(v *MovementsView) {
	@widget.Card(widget.CardProps{Class: "goen-admin__section"}) {
		<h2 class="goen-admin__heading">{ i18n.T(ctx, i18n.KeyAdminAdjustHeading) }</h2>
		<form class="goen-admin__form" method="post" action="/admin/stock/adjust">
			<input type="hidden" name="sku" value={ v.SKU }/>
			<input type="hidden" name="idempotency" value={ v.AdjustKey() }/>
			<div class="goen-admin__field">
				@widget.Label(widget.LabelProps{For: "adjust-delta"}) {
					{ i18n.T(ctx, i18n.KeyAdminQueueAdjustQty) }
				}
				<input
					class="goen-input goen-admin__num"
					id="adjust-delta"
					type="text"
					inputmode="numeric"
					name="delta"
					value={ v.DraftDelta }
					if v.DeltaError != "" {
						aria-invalid="true"
						aria-describedby="adjust-delta-example adjust-delta-error"
					} else {
						aria-describedby="adjust-delta-example"
					}
					required
				/>
				<p class="goen-admin__hint" id="adjust-delta-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), "-3") }</p>
				if v.DeltaError != "" {
					<p class="ui-error-text" id="adjust-delta-error" role="alert">{ v.DeltaError }</p>
				}
			</div>
			@widget.Button(widget.ButtonProps{
				ButtonStyle: widget.ButtonStyleSecondary,
				Class:       "goen-admin__submit",
			}, "submit") {
				{ i18n.T(ctx, i18n.KeyAdminQueueAdjust) }
			}
			<p class="goen-admin__hint">
				{ i18n.T(ctx, i18n.KeyAdminAdjustHint) }
			</p>
		</form>
	}
}

// activeForm switches the variant off behind a disclosure, and on again in one
// step. Switching off can be undone on this page, which is why it asks for a
// second click and not a page of its own.
templ activeForm(v *MovementsView) {
	@widget.Card(widget.CardProps{Class: "goen-admin__section"}) {
		if v.Active {
			<details class="goen-admin__retire">
				<summary>{ i18n.T(ctx, i18n.KeyAdminRetireSummary) }</summary>
				<form class="goen-admin__form" method="post" action="/admin/stock/active">
					<input type="hidden" name="sku" value={ v.SKU }/>
					<input type="hidden" name="active" value="0"/>
					<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminRetireEffect) }</p>
					@widget.Button(widget.ButtonProps{
						ButtonStyle: widget.ButtonStyleDanger,
						Class:       "goen-admin__submit",
					}, "submit") {
						{ i18n.T(ctx, i18n.KeyAdminToggleOff) }
					}
				</form>
			</details>
		} else {
			<form class="goen-admin__form" method="post" action="/admin/stock/active">
				<input type="hidden" name="sku" value={ v.SKU }/>
				<input type="hidden" name="active" value="1"/>
				<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminVariantIsOff) }</p>
				@widget.Button(widget.ButtonProps{
					ButtonStyle: widget.ButtonStyleSecondary,
					Class:       "goen-admin__submit",
				}, "submit") {
					{ i18n.T(ctx, i18n.KeyAdminToggleOn) }
				}
			</form>
		}
	}
}
