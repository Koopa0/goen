package refunds

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ ConfirmRefund(p frame.Page, v Confirmation) {
	@frame.Admin(p, "orders") {
		<div class="ui-page-head"><h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminRefundTitle) }</h1></div>
		@widget.Card(widget.CardProps{Class: "goen-admin__op"}) {
			<dl class="ui-dl">
				<div class="ui-dl__row"><dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminRetConfirmOrder) }</dt><dd class="ui-dl__desc">{ v.OrderNumber }</dd></div>
				<div class="ui-dl__row"><dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminRefundConfirmAmount) }</dt><dd class="ui-dl__desc">{ v.Amount() }</dd></div>
			</dl>
			if v.CreditPaid {
				<p class="goen-admin__hint">{ v.CreditCancellation(ctx) }</p>
			} else if ch := v.Channel(ctx); ch != "" {
				<p class="goen-admin__hint">{ ch }</p>
			}
			<form method="post" action={ templ.SafeURL(v.Action()) } class="goen-admin__form">
				<input type="hidden" name="total" value={ v.Total() }/>
				if !v.Resume {
					<div class="ui-field">
						<label class="ui-label" for="refund-reason">
							{ i18n.T(ctx, i18n.KeyAdminRetResolution) }
							@widget.RequiredMark()
						</label>
						<p class="goen-admin__hint" id="refund-reason-hint">{ i18n.T(ctx, i18n.KeyAdminRefundReasonHint) }</p>
						<input class="ui-input" id="refund-reason" name="reason" required maxlength="300" autocomplete="off" aria-invalid={ v.ReasonInvalid } aria-describedby="refund-reason-hint refund-reason-error" value={ v.Reason }/>
						if v.ReasonInvalid {
							<p class="ui-error-text" id="refund-reason-error">{ i18n.T(ctx, i18n.KeyAdminRefundErrReason) }</p>
						}
					</div>
				}
				<div class="goen-admin__decidebtns">
					@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Attrs: templ.Attributes{"name": "confirm", "value": "refund"}}, "submit") {
						if v.Resume {
							{ i18n.T(ctx, i18n.KeyAdminRefundResume) }
						} else if v.CreditPaid {
							{ i18n.T(ctx, i18n.KeyAdminRefundCreditCancel) }
						} else {
							{ i18n.T(ctx, i18n.KeyAdminRefundTitle) }
						}
					}
					@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline}, templ.SafeURL(v.Back())) {
						{ i18n.T(ctx, i18n.KeyBackToOrder) }
					}
				</div>
			</form>
		}
	}
}
