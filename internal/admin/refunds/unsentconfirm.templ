package refunds

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/widget"
)

// ConfirmUnsentRefund is the second step of the refund of units an order will
// not send: nothing has moved yet, and the amount is what confirming freezes.
templ ConfirmUnsentRefund(p layouts.Page, v UnsentRefundConfirmation) {
	@layouts.Admin(p, "orders") {
		<div class="ui-page-head"><h1 class="ui-page-head__title">{ i18n.T(ctx, i18n.KeyAdminUnsentTitle) }</h1></div>
		@widget.Card(widget.CardProps{Class: "goen-admin__op"}) {
			<dl class="ui-dl">
				<div class="ui-dl__row"><dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminRetConfirmOrder) }</dt><dd class="ui-dl__desc">{ v.OrderNumber }</dd></div>
				<div class="ui-dl__row"><dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminUnsentConfirmItems) }</dt><dd class="ui-dl__desc">{ v.ItemsText(ctx) }</dd></div>
				<div class="ui-dl__row"><dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminUnsentReason) }</dt><dd class="ui-dl__desc">{ v.ReasonText(ctx) }</dd></div>
				<div class="ui-dl__row"><dt class="ui-dl__term">{ i18n.T(ctx, i18n.KeyAdminUnsentConfirmAmount) }</dt><dd class="ui-dl__desc">{ v.Amount() }</dd></div>
			</dl>
			if ch := v.Channel(ctx); ch != "" {
				<p class="goen-admin__hint">{ ch }</p>
			}
			<p class="goen-admin__hint">{ v.StockText(ctx) }</p>
			<p class="goen-admin__hint">{ i18n.T(ctx, i18n.KeyAdminUnsentDeliveryKept) }</p>
			<form method="post" action={ templ.SafeURL(v.Action()) } class="goen-admin__form">
				<input type="hidden" name="total" value={ v.Total() }/>
				<input type="hidden" name="reason" value={ string(v.Reason) }/>
				for _, l := range v.Lines {
					<input type="hidden" name={ l.Field() } value={ l.QuantityText() }/>
				}
				if !v.Resume {
					<div class="ui-field">
						<label class="ui-label" for="unsent-note">
							{ i18n.T(ctx, i18n.KeyAdminRetResolution) }
							@widget.RequiredMark()
						</label>
						<p class="goen-admin__hint" id="unsent-note-hint">{ i18n.T(ctx, i18n.KeyAdminUnsentNoteHint) }</p>
						<input class="ui-input" id="unsent-note" name="note" required maxlength="300" autocomplete="off" aria-invalid={ v.NoteInvalid } aria-describedby="unsent-note-hint unsent-note-error" value={ v.Note }/>
						if v.NoteInvalid {
							<p class="ui-error-text" id="unsent-note-error">{ i18n.T(ctx, i18n.KeyAdminRefundErrReason) }</p>
						}
					</div>
				}
				<div class="goen-admin__decidebtns">
					@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Attrs: templ.Attributes{"name": "confirm", "value": "refund-unsent"}}, "submit") {
						if v.Resume {
							{ i18n.T(ctx, i18n.KeyAdminRefundResume) }
						} else {
							{ i18n.T(ctx, i18n.KeyAdminUnsentTitle) }
						}
					}
					@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline}, templ.SafeURL(v.Back())) {
						{ i18n.T(ctx, i18n.KeyBackToOrder) }
					}
				</div>
			</form>
		}
	}
}
