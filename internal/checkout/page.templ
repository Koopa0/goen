package checkout

import (
	"fmt"

	"github.com/koopa0/goen/internal/discount/coupon"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/invoice"
	"github.com/koopa0/goen/internal/ui/fieldrule"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ Page(p frame.Page, v *View) {
	@frame.Base(p) {
		<div class="goen-checkout">
			<div class="goen-pagehead">
				<h1 class="goen-pagehead__title">{ i18n.T(ctx, i18n.KeyCheckoutTitle) }</h1>
				<p class="goen-pagehead__sub">{ i18n.T(ctx, i18n.KeyCheckoutSub) }</p>
			</div>
			<div id="checkout-region">
				<form
					class="goen-checkout__layout"
					id="checkout-form"
					method="post"
					action="/checkout"
					novalidate
					data-focus-refused?={ v.AnyErrors() }
				>
					// The form's DEFAULT button: HTML makes the first submit button in tree order the
					// one Enter activates, and the chooser's 更新 buttons sit above the real one. Inert
					// to keyboard and screen reader; it carries the same words as the visible button
					// so the two cannot drift.
					<button
						class="goen-sr-only"
						type="submit"
						tabindex="-1"
						aria-hidden="true"
						disabled?={ !v.HasShipping() }
					>{ i18n.T(ctx, v.PlaceOrderKey()) }</button>
					<input type="hidden" name="idempotency" value={ v.IdempotencyKey }/>
					// One fixed-size identity for the lines, prices, delivery, coupon and credit spend.
					// The server rebuilds it while holding the database locks; it is a witness, not pricing input.
					<input type="hidden" id="checkout-quote" name="checkout_quote" value={ v.QuoteID }/>
					// The figures this page shows, so a refusal for a changed quote can name the rows that
					// moved. Nothing reads them to decide anything; the quote above alone does.
					<div id="checkout-shown" hidden>
						for _, f := range v.ShownFields() {
							<input type="hidden" name={ f.Name } value={ f.Value }/>
						}
					</div>
					<div class="goen-checkout__main">
						if v.AnyErrors() {
							@widget.Notice(widget.NoticeProps{
								Intent: widget.IntentDanger,
								Class:  "ui-alert--error",
							}) {
								if v.OnlyCouponRefused() {
									{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCheckoutCouponRefused), v.Err("coupon")) }
								} else {
									{ i18n.T(ctx, i18n.KeyCheckoutHasErrors) }
								}
							}
						}
						@widget.Card(widget.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "shipping"},
						}) {
							<h2 class="goen-checkout__heading" id="shipping-heading">{ i18n.T(ctx, i18n.KeySectionShipping) }</h2>
							// Unavailable delivery refuses the cart, so it has no invalid control.
							if !v.HasShipping() {
								<p id="shipping-unavailable" role="alert">{ i18n.T(ctx, i18n.KeyShippingUnavailable) }</p>
								<p><a href="/cart">{ i18n.T(ctx, i18n.KeyViewCart) }</a> · <a href="/contact">{ i18n.T(ctx, i18n.KeyContact) }</a></p>
							} else {
								// A radio inside the form, not a link: the choice decides which fields the form
								// asks for, so changing it re-renders, and a link would drop what was typed.
								//
								// The refusal is announced on the GROUP, not an option: a form refuses the choice,
								// not one of the things on offer.
								<div
									class="goen-checkout__choices"
									{ checkoutChoiceSwap("shipping")... }
									role="radiogroup"
									aria-labelledby="shipping-heading"
									aria-invalid={ v.Invalid("shipping") }
									if v.HasErr("shipping") {
										aria-describedby="shipping-error"
									}
								>
									for _, c := range v.Shipping {
										<label class="goen-checkout__ship">
											<input
												class="goen-sr-only"
												id={ "shipping-" + c.VersionID }
												type="radio"
												name="shipping"
												value={ c.VersionID }
												checked?={ c.VersionID == v.Chosen }
											/>
											<span class="goen-checkout__shipname">
												{ c.Name }
												if c.Carrier != "" {
													<span class="goen-checkout__shipnote">{ c.Carrier }</span>
												}
											</span>
											<span class="goen-checkout__shipfee">{ v.ChoiceFee(ctx, c) }</span>
										</label>
									}
								</div>
								@applyChoice("shipping")
								if v.HasErr("shipping") {
									<p class="ui-error-text" id="shipping-error">{ v.Err("shipping") }</p>
								}
							}
							if v.Repriced != "" {
								@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent}) {
									{ v.Repriced }
								}
							}
							if v.CreditChanged != "" {
								@widget.Notice(widget.NoticeProps{
									Intent: widget.IntentAccent,
									Class:  "ui-alert--info",
								}) {
									{ v.CreditChanged }
								}
							}
						}
						@widget.Card(widget.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "address"},
						}) {
							<h2 class="goen-checkout__heading" id="recipient-heading">{ i18n.T(ctx, i18n.KeySectionRecipient) }</h2>
							if v.OffersTheProfile() {
								// Fills the name and phone from the account, all it knows of a recipient. With
								// scripting the page's script does it from the data below; without, the button
								// applies it on the server. Neither overwrites what has been typed.
								<label class="goen-check" id="recipient">
									<input
										class="goen-check__box"
										type="checkbox"
										name="recipient_me"
										value="1"
										checked?={ v.RecipientMe }
										data-recipient-me
										data-name={ v.Profile.Name }
										data-phone={ v.Profile.Phone }
										data-email={ v.Profile.Email }
									/>
									<span>{ i18n.T(ctx, i18n.KeyRecipientIsMe) }</span>
								</label>
								<input type="hidden" name="recipient_prev_name" value={ v.RecipientPrevName }/>
								<input type="hidden" name="recipient_prev_phone" value={ v.RecipientPrevPhone }/>
								@applyChoice("recipient")
							}
							if v.OffersTheAddressBook() {
								// Choosing applies the address on the server, which also re-quotes delivery for
								// its postal code.
								<div class="goen-field">
									@widget.Label(widget.LabelProps{For: "address-book"}) {
										{ i18n.T(ctx, i18n.KeyChooseSavedAddress) }
									}
									<select
										class="goen-checkout__select"
										id="address-book"
										name="address"
										{ checkoutChoiceSwap("address")... }
										aria-invalid={ v.Invalid("address") }
										if v.HasErr("address") {
											aria-describedby="address-error"
										}
									>
										for _, a := range v.SavedAddresses {
											<option value={ a.ID } selected?={ a.ID == v.ChosenAddress }>
												{ a.DisplayLabel(ctx) } — { a.Line() }
											</option>
										}
										<option value={ OtherAddress } selected?={ v.ChosenAddress == OtherAddress }>
											{ i18n.T(ctx, i18n.KeyOtherAddress) }
										</option>
									</select>
								</div>
								@applyChoice("address")
								if v.HasErr("address") {
									<p class="ui-error-text" id="address-error">{ v.Err("address") }</p>
								}
							}
							<div class="goen-checkout__fields">
								@field("email", i18n.T(ctx, i18n.KeyFieldEmail), "email", v.Address.Email, v)
								@field("name", i18n.T(ctx, i18n.KeyFieldName), "text", v.Address.Name, v)
								@field("phone", i18n.T(ctx, i18n.KeyFieldPhone), "tel", v.Address.Phone, v)
								if v.ToPickupPoint() {
									// The chain is what the shopper chooses; the store comes from the carrier's own
									// picker, because nobody types a store number correctly.
									//
									// The chooser re-renders the form: the chain decides which map the button below
									// opens, and that form is built on the server.
									<div class="goen-field goen-checkout__wide" id="pickup_chain">
										<p class="goen-label" id="pickup_chain-label">{ i18n.T(ctx, i18n.KeyFieldPickupChain) }</p>
										if v.PickupRefused {
											// The message says a store could not be confirmed and repeats NONE of what
											// arrived: that text came from a cross-site post. It sits here because the
											// next step is the choice below: with no chain chosen there is no map button.
											@widget.Notice(widget.NoticeProps{
												Intent: widget.IntentDanger,
												Class:  "ui-alert--error",
											}) {
												{ i18n.T(ctx, i18n.KeyPickupStoreUnconfirmed) }
											}
										}
										<div
											class="goen-checkout__choices"
											{ checkoutChoiceSwap("pickup_chain")... }
											role="radiogroup"
											aria-labelledby="pickup_chain-label"
											aria-invalid={ v.Invalid("pickup_chain") }
											if v.HasErr("pickup_chain") {
												aria-describedby="pickup_chain-error"
											}
										>
											for _, b := range v.PickupChains {
												<label class="goen-checkout__ship">
													<input
														class="goen-sr-only"
														id={ "pickup_chain-" + string(b) }
														type="radio"
														name="pickup_chain"
														value={ string(b) }
														checked?={ b == v.Address.PickupChain }
													/>
													<span class="goen-checkout__shipname">{ b.Name() }</span>
												</label>
											}
										</div>
										@applyChoice("pickup_chain")
										if v.HasErr("pickup_chain") {
											<p class="ui-error-text" id="pickup_chain-error">{ v.Err("pickup_chain") }</p>
										}
										@pickupStore(v)
									</div>
								} else {
									@field("postal_code", i18n.T(ctx, i18n.KeyFieldPostalCode), "text", v.Address.PostalCode, v)
									@field("city", i18n.T(ctx, i18n.KeyFieldCity), "text", v.Address.City, v)
									@field("district", i18n.T(ctx, i18n.KeyFieldDistrict), "text", v.Address.District, v)
									<div class="goen-field goen-checkout__wide">
										@widget.Label(widget.LabelProps{For: "street"}) {
											{ i18n.T(ctx, i18n.KeyFieldStreet) }
										}
										<input
											class="goen-input"
											id="street"
											type="text"
											name="street"
											value={ v.Address.Street }
											required
											maxlength="200"
											autocomplete="street-address"
											aria-invalid={ v.Invalid("street") }
											if v.HasErr("street") {
												aria-describedby="street-error"
											}
										/>
										if v.HasErr("street") {
											<p class="ui-error-text" id="street-error">{ v.Err("street") }</p>
										}
									</div>
								}
								<div class="goen-field goen-checkout__wide">
									@widget.Label(widget.LabelProps{For: "note"}) {
										{ i18n.T(ctx, i18n.KeyFieldNote) }
									}
									<textarea
										class="goen-input goen-input--area"
										id="note"
										name="note"
										autocomplete="off"
										maxlength="500"
										rows="2"
										aria-invalid={ v.Invalid("note") }
										if v.HasErr("note") {
											aria-describedby="note-error"
										}
									>{ v.Address.Note }</textarea>
									if v.HasErr("note") {
										<p class="ui-error-text" id="note-error">{ v.Err("note") }</p>
									}
								</div>
							</div>
						}
						@widget.Card(widget.CardProps{
							Class: "goen-checkout__section",
							Attrs: templ.Attributes{"id": "invoice"},
						}) {
							<h2 class="goen-checkout__heading" id="invoice-heading">{ i18n.T(ctx, i18n.KeySectionInvoice) }</h2>
							<div
								class="goen-checkout__choices"
								role="radiogroup"
								aria-labelledby="invoice-heading"
								aria-invalid={ v.Invalid("invoice_type") }
								if v.HasErr("invoice_type") {
									aria-describedby="invoice_type-error"
								}
							>
								for _, c := range v.InvoiceChoices {
									<div class="goen-checkout__option">
										<label class="goen-checkout__ship">
											<input
												class="goen-sr-only"
												id={ "invoice_type-" + string(c.Value) }
												type="radio"
												name="invoice_type"
												value={ string(c.Value) }
												checked?={ v.Invoice.Is(c.Value) }
											/>
											<span class="goen-checkout__shipname">{ c.Label }</span>
										</label>
										@invoiceFields(c.Value, v)
									</div>
								}
							</div>
							if v.HasErr("invoice_type") {
								<p class="ui-error-text" id="invoice_type-error">{ v.Err("invoice_type") }</p>
							}
						}
					</div>
					@widget.Card(widget.CardProps{
						Class: "goen-checkout__summary",
						Attrs: templ.Attributes{"id": "summary", "aria-labelledby": "summary-heading"},
					}) {
						<h2 id="summary-heading" class="goen-summary__title">{ i18n.T(ctx, i18n.KeyOrderSummary) }</h2>
						<ul class="goen-checkout__lines" role="list">
							for _, l := range v.Cart.Lines {
								<li>
									<span>
										{ l.Name } × { l.QuantityText() }
										if l.Label != "" {
											<span class="goen-line__meta">{ l.Label }</span>
										}
									</span>
									<span class="goen-summary__value">{ l.LineTotal() }</span>
								</li>
							}
						</ul>
						// Above the rows, so the reader meets what changed before the figures it changed.
						// Hidden while empty because the panel's gap would leave a blank band.
						<div id="summary-moved" hidden?={ !v.HasMoved() }>
							if v.HasMoved() {
								@widget.NoticeBlock(widget.NoticeProps{Intent: widget.IntentAccent}) {
									{ i18n.T(ctx, i18n.KeyCheckoutMoved) }
									<ul class="goen-summary__moved" role="list">
										for _, m := range v.Moved {
											<li>{ m.Text }</li>
										}
									</ul>
								}
							}
						</div>
						<dl class="goen-summary" id="summary-totals">
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeySubtotal) } @movedMark(v, rowSubtotal)</dt>
								<dd class="goen-summary__value">{ v.Cart.Subtotal() }</dd>
							</div>
							<div class="goen-summary__row">
								<dt>{ i18n.T(ctx, i18n.KeyShippingFee) } @movedMark(v, rowShipping)</dt>
								<dd class="goen-summary__value">
									if v.HasShipping() {
										{ v.ShippingRow(ctx) }
									} else {
										{ i18n.T(ctx, i18n.KeyShippingUnavailableShort) }
									}
								</dd>
							</div>
							if v.HasCoupon() && v.CouponDiscountCents > 0 {
								<div class="goen-summary__row">
									<dt>{ coupon.DiscountLabel(ctx, v.CouponApplied) } @movedMark(v, rowDiscount)</dt>
									<dd class="goen-summary__value">{ v.CouponDiscount() }</dd>
								</div>
							}
							if v.UsesCredit() {
								<div class="goen-summary__row">
									<dt>{ i18n.T(ctx, i18n.KeyStoreCredit) } @movedMark(v, rowCredit)</dt>
									<dd class="goen-summary__value">{ v.Credit() }</dd>
									<dd class="goen-summary__note">{ v.CreditNote(ctx) }</dd>
								</div>
							}
							<div class="goen-summary__row goen-summary__row--total">
								<dt>{ i18n.T(ctx, i18n.KeyTotal) } @movedMark(v, rowTotal)</dt>
								<dd class="goen-summary__value">{ v.Total() }</dd>
							</div>
						</dl>
						<div class="goen-field" id="coupon-field">
							@widget.Label(widget.LabelProps{For: "coupon"}) {
								{ i18n.T(ctx, i18n.KeyCouponCode) }
							}
							<div class="goen-checkout__couponrow">
								<input
									class="goen-input"
									id="coupon"
									name="coupon"
									maxlength="32"
									autocomplete="off"
									value={ v.CouponCode }
									aria-invalid={ v.Invalid("coupon") }
									if v.HasErr("coupon") {
										aria-describedby="coupon-hint coupon-error"
									} else {
										aria-describedby="coupon-hint"
									}
								/>
								@widget.Button(widget.ButtonProps{
									ButtonStyle: widget.ButtonStyleOutline,
									Attrs:       couponButtonAttrs(ctx),
								}, "submit") {
									{ i18n.T(ctx, i18n.KeyApplyCoupon) }
								}
							</div>
							<p class="goen-checkout__note" id="coupon-hint">{ i18n.T(ctx, i18n.KeyCouponPlaceholder) }</p>
							<div id="coupon-message" aria-live="polite">
								if v.HasErr("coupon") {
									<p class="ui-error-text" id="coupon-error">{ v.Err("coupon") }</p>
								}
								if v.HasCoupon() {
									<p class="goen-checkout__note">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyCouponApplied), v.CouponApplied) }</p>
								}
							</div>
						</div>
						<p class="goen-checkout__note">
							{ v.PlacementNote(ctx) }
						</p>
						@widget.Button(widget.ButtonProps{
							ButtonStyle: widget.ButtonStylePrimary,
							Size:        widget.SizeLarge,
							Block:       true,
							Attrs:       templ.Attributes{"disabled": !v.HasShipping()},
						}, "submit") {
							{ i18n.T(ctx, v.PlaceOrderKey()) }
						}
					}
				</form>
			</div>
		</div>
	}
}

// movedMark says in a word, not a colour, that a row's figure is not the one the
// shopper was shown.
templ movedMark(v *View, row summaryRow) {
	if v.RowMoved(row) {
		<span class="goen-summary__flag">{ i18n.T(ctx, i18n.KeyCheckoutMovedMark) }</span>
	}
}

// The summary is a SECURITY CONTROL, not decoration. The map's callback carries no
// signature and the map is run by the convenience-store chain, so a reported store
// cannot be checked by any means goen has. The shopper reading the name AND the
// address before paying is the only check. Do not reduce it to the name.
templ pickupStore(v *View) {
	if v.OffersTheStoreMap() || v.HasPickupStore() {
		<div class="goen-pickup">
			if v.HasPickupStore() {
				// Carried back so the order can be placed from this page. The ADDRESS is not among
				// them: it is read from the URL for the summary above, never posted, never stored.
				<input type="hidden" name="pickup_store_code" value={ v.Address.PickupStoreCode }/>
				<input type="hidden" name="pickup_store_name" value={ v.Address.PickupStoreName }/>
				<input type="hidden" name="pickup_store_chain" value={ string(v.Address.PickupChain) }/>
				<input type="hidden" name="pickup_n" value={ v.PickupNonce }/>
				<p class="goen-pickup__name">{ v.Address.PickupStoreName } ({ v.Address.PickupStoreCode })</p>
				if v.PickupStoreAddr != "" {
					<p class="goen-pickup__addr">{ v.PickupStoreAddr }</p>
				}
			}
			if v.HasErr("pickup_store") {
				<p class="ui-error-text" id="pickup_store-error">{ v.Err("pickup_store") }</p>
			}
			if v.OffersTheStoreMap() {
				// A submit button of the checkout form aimed at goen's own start route by
				// formaction: the server keeps what was typed, then opens the carrier's map. It has
				// no name or value, and the route is local, so what was typed never goes to a third party.
				//
				// It is also the control a refusal belongs to: nobody types a store.
				{{ storeAttrs := checkoutStoreButtonAttrs(v.Invalid("pickup_store"), v.HasErr("pickup_store")) }}
				@widget.Button(widget.ButtonProps{
					ButtonStyle: widget.ButtonStyleOutline,
					Attrs:       storeAttrs,
				}, "submit") {
					if v.HasPickupStore() {
						{ i18n.T(ctx, i18n.KeyPickupChangeStore) }
					} else {
						{ i18n.T(ctx, i18n.KeyPickupChooseStore) }
					}
				}
			}
		</div>
	}
}

// A submit button, not a link: the form carries everything typed and a link only
// the choice. It is the path without scripting; the stylesheet hides it where the
// change itself applies the choice. The fragment opens the answer at this section's
// heading, not the top of a form the customer scrolled past.
templ applyChoice(which string) {
	<div class="goen-checkout__apply">
		@widget.Button(widget.ButtonProps{
			ButtonStyle: widget.ButtonStyleOutline,
			Size:        widget.SizeSmall,
			Attrs: templ.Attributes{
				"formaction":     "/checkout#" + which,
				"name":           "update",
				"value":          which,
				"formnovalidate": true,
			},
		}, "submit") {
			{ i18n.T(ctx, i18n.KeyApplyChoice) }
		}
	</div>
}

// invoiceFields is what one invoice type asks for, shown under its own card while that type is
// chosen. Every type's fields are in the page and CSS opens only the chosen one, so changing the
// choice sends nothing and needs no script; a browser that cannot ask :has shows all of them. None
// is required: the form is novalidate and the server blanks what the chosen type does not use.
templ invoiceFields(t invoice.Preference, v *View) {
	switch t {
		case invoice.PreferenceMobile:
			<div class="goen-checkout__fields goen-checkout__optionfields">
				<div class="goen-field">
					@widget.Label(widget.LabelProps{For: "invoice_carrier"}) {
						{ i18n.T(ctx, i18n.KeyFieldMobileBarcode) }
					}
					<input
						class="goen-input"
						{ fieldrule.MobileBarcode.Attrs(ctx, nil)... }
						id="invoice_carrier"
						name="invoice_carrier"
						maxlength="8"
						autocomplete="off"
						value={ v.Invoice.MobileBarcode }
						aria-invalid={ v.Invalid("invoice_carrier") }
						if v.HasErr("invoice_carrier") {
							aria-describedby="invoice_carrier-format invoice_carrier-example invoice_carrier-error"
						} else {
							aria-describedby="invoice_carrier-format invoice_carrier-example"
						}
					/>
					<p class="goen-checkout__hint" id="invoice_carrier-format">{ i18n.T(ctx, i18n.KeyMobileBarcodeFormat) }</p>
					<p class="goen-auth__hint" id="invoice_carrier-example">{ fmt.Sprintf(i18n.T(ctx, i18n.KeyFieldExample), "/ABC+123") }</p>
					if v.HasErr("invoice_carrier") {
						<p class="ui-error-text" id="invoice_carrier-error">{ v.Err("invoice_carrier") }</p>
					}
				</div>
			</div>
		case invoice.PreferenceDonate:
			<div class="goen-checkout__fields goen-checkout__optionfields">
				<div class="goen-field">
					@widget.Label(widget.LabelProps{For: "invoice_donation_code"}) {
						{ i18n.T(ctx, i18n.KeyFieldDonationCode) }
					}
					<input
						class="goen-input"
						{ fieldrule.DonationCode.Attrs(ctx, nil)... }
						id="invoice_donation_code"
						name="invoice_donation_code"
						type="text"
						inputmode="numeric"
						maxlength="7"
						autocomplete="off"
						value={ v.Invoice.DonationCode }
						aria-invalid={ v.Invalid("invoice_donation_code") }
						if v.HasErr("invoice_donation_code") {
							aria-describedby="invoice_donation_code-help invoice_donation_code-error"
						} else {
							aria-describedby="invoice_donation_code-help"
						}
					/>
					<p class="goen-checkout__hint" id="invoice_donation_code-help">{ i18n.T(ctx, i18n.KeyDonationCodeHelp) }</p>
					if v.HasErr("invoice_donation_code") {
						<p class="ui-error-text" id="invoice_donation_code-error">{ v.Err("invoice_donation_code") }</p>
					}
				</div>
			</div>
		case invoice.PreferenceCompany:
			<div class="goen-checkout__fields goen-checkout__optionfields">
				<div class="goen-field">
					@widget.Label(widget.LabelProps{For: "invoice_company_name"}) {
						{ i18n.T(ctx, i18n.KeyFieldCompanyName) }
					}
					<input
						class="goen-input"
						id="invoice_company_name"
						name="invoice_company_name"
						maxlength="60"
						autocomplete="organization"
						value={ v.Invoice.CompanyName }
						aria-invalid={ v.Invalid("invoice_company_name") }
						if v.HasErr("invoice_company_name") {
							aria-describedby="invoice_company_name-error"
						}
					/>
					if v.HasErr("invoice_company_name") {
						<p class="ui-error-text" id="invoice_company_name-error">{ v.Err("invoice_company_name") }</p>
					}
				</div>
				<div class="goen-field">
					@widget.Label(widget.LabelProps{For: "invoice_tax_id"}) {
						{ i18n.T(ctx, i18n.KeyFieldTaxID) }
					}
					<input
						class="goen-input"
						{ fieldrule.TaxID.Attrs(ctx, nil)... }
						id="invoice_tax_id"
						name="invoice_tax_id"
						maxlength="8"
						inputmode="numeric"
						autocomplete="off"
						value={ v.Invoice.TaxID }
						aria-invalid={ v.Invalid("invoice_tax_id") }
						if v.HasErr("invoice_tax_id") {
							aria-describedby="invoice_tax_id-format invoice_tax_id-error"
						} else {
							aria-describedby="invoice_tax_id-format"
						}
					/>
					<p class="goen-checkout__hint" id="invoice_tax_id-format">{ i18n.T(ctx, i18n.KeyTaxIDFormat) }</p>
					if v.HasErr("invoice_tax_id") {
						<p class="ui-error-text" id="invoice_tax_id-error">{ v.Err("invoice_tax_id") }</p>
					}
				</div>
				<p class="goen-checkout__note goen-checkout__wide">{ i18n.T(ctx, i18n.KeyInvoiceCompanyStored) }</p>
			</div>
	}
}

templ field(name, label, kind, value string, v *View) {
	{{ hints := checkoutHintsFor(name) }}
	<div class="goen-field">
		@widget.Label(widget.LabelProps{For: name}) {
			{ label }
		}
		<input
			class="goen-input"
			id={ name }
			type={ kind }
			name={ name }
			value={ value }
			required
			autocomplete={ hints.Autocomplete }
			if hints.InputMode != "" {
				inputmode={ hints.InputMode }
			}
			if hints.AutoCapitalize != "" {
				autocapitalize={ hints.AutoCapitalize }
			}
			if hints.SpellCheck != "" {
				spellcheck={ hints.SpellCheck }
			}
			if hints.Pattern != "" {
				pattern={ hints.Pattern }
				if !v.HasErr(name) {
					data-checkout-constraint
				}
			}
			if hints.Rule != nil {
				{ hints.Rule.Attrs(ctx, nil)... }
				if !v.HasErr(name) {
					data-checkout-constraint
				}
			}
			if v.HasErr(name) {
				aria-invalid="true"
			}
			if v.HasErr(name) || hints.Constrained() {
				aria-describedby={ name + "-error" }
			}
		/>
		if v.HasErr(name) {
			<p class="ui-error-text" id={ name + "-error" }>{ v.Err(name) }</p>
		} else if hints.Constrained() {
			<p class="ui-error-text goen-field__constraint" id={ name + "-error" }>{ hints.ConstraintText(ctx) }</p>
		}
	</div>
}
