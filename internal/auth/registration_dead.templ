package auth

import (
	"net/url"

	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/icons"
	"github.com/koopa0/goen/internal/ui/layouts"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ RegistrationDead(p layouts.Page, next string) {
	@layouts.Base(p) {
		<div class="notice">
			<span class="goen-medallion" aria-hidden="true">
				@icons.Mail()
			</span>
			<h1 class="notice__title">{ i18n.T(ctx, i18n.KeyVerifyDeadTitle) }</h1>
			<p class="notice__body">{ i18n.T(ctx, i18n.KeyRegisterDeadBody) }</p>
			<div class="notice__actions">
				@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge}, templ.URL("/register?"+url.Values{"resend": {"1"}, "next": {next}}.Encode())) {
					{ i18n.T(ctx, i18n.KeyRegisterResend) }
				}
				@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline, Size: widget.SizeLarge, Class: "notice__back"}, "/") {
					{ i18n.T(ctx, i18n.KeyBackToShop) }
				}
			</div>
		</div>
	}
}
