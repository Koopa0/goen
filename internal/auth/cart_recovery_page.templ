package auth

import (
	"strconv"

	"github.com/koopa0/goen/internal/cart/cartitem"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ CartRecovery(p frame.Page, v CartRecoveryView) {
	@frame.Base(p) {
		<div class="notice">
			<h1 class="notice__title">{ i18n.T(ctx, i18n.KeyCartMergeRecoveryTitle) }</h1>
			if v.Welcome {
				@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent}) {
					{ i18n.T(ctx, i18n.KeyAccountWelcome) }
				}
			}
			@widget.Notice(widget.NoticeProps{Intent: v.Notice.Outcome.Intent(), ID: "cart-recovery", Class: "notice__body"}) {
				{ v.Notice.Text }
			}
			@cartRecoveryList("cart-recovery-before", i18n.KeyCartRecoveryBeforeSignIn, v.Contents.BeforeSignIn)
			@cartRecoveryList("cart-recovery-account", i18n.KeyCartRecoveryAccount, v.Contents.Account)
			<form class="notice__form" method="post" action="/account/cart/retry">
				<input type="hidden" name="next" value={ v.Next }/>
				@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge, Block: true}, "submit") {
					{ v.Retry }
				}
			</form>
			@widget.ButtonLink(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline, Class: "notice__back"}, "/cart") {
				{ i18n.T(ctx, i18n.KeyCartRecoveryBack) }
			}
		</div>
	}
}

templ cartRecoveryList(id string, heading i18n.Key, lines []cartitem.Item) {
	<section class="goen-cart-recovery__cart" aria-labelledby={ id }>
		<h2 class="goen-account__heading" id={ id }>{ i18n.T(ctx, heading) }</h2>
		if len(lines) == 0 {
			<p>{ i18n.T(ctx, i18n.KeyEmptyCart) }</p>
		} else {
			<ul class="goen-cart__lines" role="list">
				for _, line := range lines {
					<li class="goen-line goen-line--recovery">
						<span class="goen-line__thumb">
							if line.ImageURL != "" {
								<img class="goen-line__img" src={ line.ImageURL } srcset={ line.ImageSrcset } sizes="96px" alt={ line.ImageAlt } width="96" height="96" loading="lazy" decoding="async"/>
							} else {
								<span class="goen-line__ph" aria-hidden="true"></span>
							}
						</span>
						<div class="goen-line__body">
							<span class="goen-line__name">{ line.Name }</span>
							if line.Label != "" {
								<span class="goen-line__meta">{ line.Label }</span>
							}
							<span class="goen-line__meta">{ i18n.T(ctx, i18n.KeyQuantity) } { strconv.FormatInt(int64(line.Quantity), 10) }</span>
						</div>
					</li>
				}
			</ul>
		}
	</section>
}
