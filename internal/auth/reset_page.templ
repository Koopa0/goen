package auth

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/fieldrule"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ Forgot(p frame.Page, v ForgotView) {
	@frame.Base(p) {
		<div class="goen-auth">
			<div class="goen-auth__panel">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyForgotTitle) }</h1>
				<p class="goen-auth__lede">{ i18n.T(ctx, i18n.KeyForgotSub) }</p>
				if v.Sent {
					@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent, ID: "forgot-sent"}) {
						{ v.SentMessage(ctx) }
					}
				}
				if v.Notice.Text != "" {
					@widget.Notice(widget.NoticeProps{Intent: v.Notice.Outcome.Intent()}) {
						{ v.Notice.Text }
					}
				}
				if v.Sent {
					<p class="goen-auth__alt"><a href="/forgot">{ i18n.T(ctx, i18n.KeyEmailReenter) }</a></p>
					<details class="goen-account__disclosure" id="forgot-resend">
						<summary class="goen-account__summary">{ i18n.T(ctx, i18n.KeyForgotResend) }</summary>
						@forgotForm(false)
					</details>
				} else {
					@forgotForm(true)
				}
				<p class="goen-auth__alt">
					{ i18n.T(ctx, i18n.KeyRemembered) }
					<a href="/signin">{ i18n.T(ctx, i18n.KeyBackToSignIn) }</a>
				</p>
			</div>
		</div>
	}
}

templ forgotForm(autofocus bool) {
	<form class="goen-auth__form" method="post" action="/forgot">
		<div class="goen-field">
			@widget.Label(widget.LabelProps{For: "email"}) {
				{ i18n.T(ctx, i18n.KeyFieldEmail) }
			}
			@widget.Input(widget.FieldProps{
				ID:   "email",
				Name: "email",
				Type: "email",
				Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
					"autocomplete": "email",
					"autofocus":    autofocus,
					"maxlength":    "254",
					"required":     true,
				}),
			})
		</div>
		@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge, Block: true}, "submit") {
			{ i18n.T(ctx, i18n.KeyForgotSubmit) }
		}
	</form>
}

templ Reset(p frame.Page, v ResetView) {
	if v.Usable() {
		@frame.Base(p) {
			<div class="goen-auth">
				<div class="goen-auth__panel">
					<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyResetTitle) }</h1>
					<form class="goen-auth__form" method="post" action="/reset">
						<input type="hidden" name="token" value={ v.Token }/>
						<div class="goen-field">
							@widget.Label(widget.LabelProps{For: "password"}) {
								{ i18n.T(ctx, i18n.KeyFieldNewPassword) }
							}
							@widget.Input(widget.FieldProps{
								ID:        "password",
								Name:      "password",
								Type:      "password",
								Invalid:   v.Invalid("password"),
								Describes: "reset-error",
								Attrs: v.PasswordAttrs(templ.Attributes{
									"autocomplete": "new-password",
									"autofocus":    !v.Invalid("confirm"),
									"minlength":    "10",
									"required":     true,
								}),
							})
							if v.Invalid("password") {
								<p class="ui-error-text" id="reset-error" role="alert">{ v.Error }</p>
							} else {
								<p class="goen-auth__hint" id="password-hint">{ i18n.T(ctx, i18n.KeyPasswordHint) }</p>
							}
						</div>
						<div class="goen-field">
							@widget.Label(widget.LabelProps{For: "confirm"}) {
								{ i18n.T(ctx, i18n.KeyFieldConfirmPassword) }
							}
							@widget.Input(widget.FieldProps{
								ID:        "confirm",
								Name:      "confirm",
								Type:      "password",
								Invalid:   v.Invalid("confirm"),
								Describes: "reset-error",
								Attrs: templ.Attributes{
									"autocomplete": "new-password",
									"autofocus":    v.Invalid("confirm"),
									"minlength":    "10",
									"required":     true,
								},
							})
							if v.Invalid("confirm") {
								<p class="ui-error-text" id="reset-error" role="alert">{ v.Error }</p>
							}
						</div>
						<p class="goen-auth__hint">{ i18n.T(ctx, i18n.KeyResetEndsSessions) }</p>
						@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge, Block: true}, "submit") {
							{ i18n.T(ctx, i18n.KeyResetTitle) }
						}
					</form>
				</div>
			</div>
		}
	} else {
		@frame.EmailLinkPage(p, v.RecoveryView(ctx))
	}
}
