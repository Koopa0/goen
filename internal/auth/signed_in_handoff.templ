package auth

import (
	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
)

// Not frame.Base, like OrderReload: the page is on screen for an instant.
// target is the return path the visitor chose before leaving for Google, cleaned
// by siteurl.PathOr and, for a cart that changed, moved to the cart by
// cartAdoptionLanding, so it never leaves goen.
templ SignedInHandoff(target string) {
	<!DOCTYPE html>
	<html lang={ i18n.FromContext(ctx).Tag() } class="theme-blue">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta http-equiv="refresh" content={ "0; url=" + target }/>
			<title>{ i18n.T(ctx, i18n.KeyGoogleSignedIn) }</title>
			<link rel="icon" type="image/svg+xml" href={ templ.URL(assets.URL(assets.MarkSVG)) }/>
			<link rel="stylesheet" href={ templ.URL(assets.URL(assets.FontsCSS)) }/>
			<link rel="stylesheet" href={ templ.URL(assets.URL(assets.BaseCSS)) }/>
			<link rel="stylesheet" href={ templ.URL(assets.URL(assets.AppCSS)) }/>
		</head>
		<body class="goen-shell">
			<main class="goen-handoff" id="main">
				<p class="goen-handoff__text">{ i18n.T(ctx, i18n.KeyGoogleSignedIn) }</p>
				<a class="goen-handoff__link" href={ templ.URL(target) }>{ i18n.T(ctx, i18n.KeyGoogleContinue) }</a>
			</main>
		</body>
	</html>
}
