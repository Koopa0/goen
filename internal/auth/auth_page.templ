package auth

import (
	"github.com/koopa0/goen/assets"
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/fieldrule"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ SignIn(p frame.Page, v View) {
	@frame.Base(p) {
		<div class={ "goen-auth", templ.KV("goen-auth--door", !v.HideRegister) }>
			<div class="goen-auth__panel">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeySignIn) }</h1>
				if v.ReturnMessage != "" {
					<p class="goen-auth__lede">{ v.ReturnMessage }</p>
				}
				if v.HasErr("oauth") {
					<p class="goen-notice goen-notice--danger" id="signin-google-error" role="alert">
						{ v.Err("oauth") }
						if v.Recovery != SignInNoRecovery {
							<a href={ templ.SafeURL(v.Recovery.Href()) }>{ v.Recovery.Label(ctx) }</a>
						}
					</p>
				}
				if v.HasNotice() {
					@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent}) {
						{ v.Notice }
					}
				}
				if v.OffersDemoAccount() {
					@demoAccountNote(v)
				}
				<form class="goen-auth__form" method="post" action="/signin">
					<input type="hidden" name="next" value={ v.Next }/>
					if v.HideRegister {
						<input type="hidden" name="reauth" value="erase"/>
					}
					if v.HasErr("form") {
						// Not the notice component: a guard reads role="alert" from this source (aria_test.go).
						<p class="goen-notice goen-notice--danger" id="signin-error" role="alert">{ v.Err("form") }</p>
					}
					<div class="goen-field">
						@widget.Label(widget.LabelProps{For: "email"}) {
							{ i18n.T(ctx, i18n.KeyFieldEmail) }
						}
						@widget.Input(widget.FieldProps{
							ID:    "email",
							Name:  "email",
							Type:  "email",
							Value: v.Email,
							Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
								"autocomplete": "email",
								"autofocus":    !v.PasswordFocus && !v.OffersDemoAccount(),
								"required":     true,
							}),
						})
					</div>
					<div class="goen-field">
						@widget.Label(widget.LabelProps{For: "password"}) {
							{ i18n.T(ctx, i18n.KeyFieldPassword) }
						}
						@widget.Input(widget.FieldProps{
							ID:        "password",
							Name:      "password",
							Type:      "password",
							Invalid:   v.HasErr("form"),
							Describes: "signin-error",
							Attrs: templ.Attributes{
								"autocomplete": "current-password",
								"autofocus":    v.PasswordFocus,
								"required":     true,
							},
						})
						<a class="goen-auth__forgot" href="/forgot">{ i18n.T(ctx, i18n.KeyForgotPassword) }</a>
					</div>
					@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge, Block: true}, "submit") {
						{ i18n.T(ctx, i18n.KeySignIn) }
					}
				</form>
				if v.GoogleSignIn {
					@widget.ButtonLink(widget.ButtonProps{
						ButtonStyle: widget.ButtonStyleOutline,
						Size:        widget.SizeLarge,
						Block:       true,
						Class:       "goen-auth__oauth",
					}, templ.SafeURL(v.GoogleLink())) {
						{ i18n.T(ctx, i18n.KeySignInWithGoogle) }
					}
				}
				if !v.HideRegister {
					<p class="goen-auth__alt">
						{ i18n.T(ctx, i18n.KeyNoAccountYet) }
						<a href={ templ.SafeURL(v.authPageLink("/register")) }>{ i18n.T(ctx, i18n.KeyNoAccountLink) }</a>
					</p>
				}
			</div>
			if !v.HideRegister {
				@authDoor()
			}
		</div>
	}
}

// The photo adds nothing to the form, so it follows the form in the document.
templ authDoor() {
	<div class="goen-auth__media">
		<img
			src={ assets.Image{BundledKey: "department-books-stationery.webp"}.URL() }
			srcset={ assets.Image{BundledKey: "department-books-stationery.webp"}.Srcset() }
			sizes="(min-width: 64rem) 57vw, 1px"
			alt=""
			width="1600"
			height="1200"
			loading="lazy"
			decoding="async"
		/>
	</div>
}

// Credentials as plain text for a browser without scripting; goen.js reveals the button that fills and submits the form.
templ demoAccountNote(v View) {
	<section class="goen-auth__demo" aria-labelledby="demo-account-title">
		<h2 class="goen-auth__demotitle" id="demo-account-title">{ i18n.T(ctx, i18n.KeyDemoAccount) }</h2>
		<dl class="goen-auth__democreds">
			<div>
				<dt>{ i18n.T(ctx, i18n.KeyFieldEmail) }</dt>
				<dd><code>{ v.DemoEmail }</code></dd>
			</div>
			<div>
				<dt>{ i18n.T(ctx, i18n.KeyFieldPassword) }</dt>
				<dd><code>{ v.DemoPassword }</code></dd>
			</div>
		</dl>
		<p class="goen-auth__demonote">{ i18n.T(ctx, i18n.KeyDemoAccountShared) }</p>
		@widget.Button(widget.ButtonProps{
			ButtonStyle: widget.ButtonStyleOutline,
			Block:       true,
			Class:       "goen-auth__demofill",
			Attrs: templ.Attributes{
				"hidden":         true,
				"data-demo-fill": true,
				"data-email":     v.DemoEmail,
				"data-password":  v.DemoPassword,
			},
		}, "button") {
			{ i18n.T(ctx, i18n.KeyDemoAccountSignIn) }
		}
	</section>
}

templ Register(p frame.Page, v View) {
	@frame.Base(p) {
		<div class="goen-auth goen-auth--door">
			<div class="goen-auth__panel">
				if v.OffersResend && v.HasNotice() {
					<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyCheckInbox) }</h1>
				} else {
					<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyCreateAccount) }</h1>
				}
				if v.HasNotice() {
					@widget.Notice(widget.NoticeProps{Intent: widget.IntentAccent, ID: "register-sent"}) {
						{ v.Notice }
					}
				}
				if v.AnyErrors() {
					@widget.Notice(widget.NoticeProps{Intent: widget.IntentDanger}) {
						{ i18n.T(ctx, i18n.KeyFormHasErrors) }
					}
				}
				if v.OffersResend {
					<form class="goen-auth__form" method="post" action="/register/resend">
						<input type="hidden" name="next" value={ v.Next }/>
						if v.Email != "" {
							<input type="hidden" name="email" value={ v.Email }/>
						} else {
							<div class="goen-field">
								@widget.Label(widget.LabelProps{For: "email"}) {
									{ i18n.T(ctx, i18n.KeyFieldEmail) }
								}
								@widget.Input(widget.FieldProps{
									ID:   "email",
									Name: "email",
									Type: "email",
									Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
										"autocomplete": "email",
										"required":     true,
									}),
								})
							</div>
						}
						@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStyleOutline, Size: widget.SizeLarge, Block: true}, "submit") {
							{ i18n.T(ctx, i18n.KeyRegisterResend) }
						}
					</form>
					if v.HasNotice() {
						<p class="goen-auth__alt">
							<a href={ templ.SafeURL(v.authPageLink("/register")) }>{ i18n.T(ctx, i18n.KeyRegisterOtherAddress) }</a>
						</p>
					}
				} else {
					<form class="goen-auth__form" method="post" action="/register">
						<input type="hidden" name="next" value={ v.Next }/>
						<div class="goen-field">
							@widget.Label(widget.LabelProps{For: "email"}) {
								{ i18n.T(ctx, i18n.KeyFieldEmail) }
							}
							@widget.Input(widget.FieldProps{
								ID:        "email",
								Name:      "email",
								Type:      "email",
								Value:     v.Email,
								Invalid:   v.HasErr("email"),
								Describes: "email-error",
								Attrs: fieldrule.Email.Attrs(ctx, templ.Attributes{
									"autocomplete": "email",
									"autofocus":    true,
									"required":     true,
								}),
							})
							if v.HasErr("email") {
								<p class="ui-error-text" id="email-error" role="alert">{ v.Err("email") }</p>
							}
						</div>
						<div class="goen-field">
							@widget.Label(widget.LabelProps{For: "name"}) {
								{ i18n.T(ctx, i18n.KeyFieldNameOpt) }
							}
							@widget.Input(widget.FieldProps{
								ID:        "name",
								Name:      "name",
								Type:      "text",
								Value:     v.Name,
								Invalid:   v.HasErr("name"),
								Describes: "name-error",
								Attrs: templ.Attributes{
									"autocomplete": "name",
									"maxlength":    "60",
								},
							})
							if v.HasErr("name") {
								<p class="ui-error-text" id="name-error" role="alert">{ v.Err("name") }</p>
							}
						</div>
						<div class="goen-field">
							@widget.Label(widget.LabelProps{For: "password"}) {
								{ i18n.T(ctx, i18n.KeyFieldPassword) }
							}
							@widget.Input(widget.FieldProps{
								ID:        "password",
								Name:      "password",
								Type:      "password",
								Invalid:   v.HasErr("password"),
								Describes: "password-error",
								Attrs: v.PasswordAttrs(templ.Attributes{
									"autocomplete": "new-password",
									"minlength":    "10",
									"required":     true,
								}),
							})
							if v.HasErr("password") {
								<p class="ui-error-text" id="password-error" role="alert">{ v.Err("password") }</p>
							} else {
								<p class="goen-auth__hint" id="password-hint">{ i18n.T(ctx, i18n.KeyPasswordHint) }</p>
							}
						</div>
						<div class="goen-field">
							@widget.Label(widget.LabelProps{For: "confirm"}) {
								{ i18n.T(ctx, i18n.KeyFieldConfirmPassword) }
							}
							@widget.Input(widget.FieldProps{
								ID:        "confirm",
								Name:      "confirm",
								Type:      "password",
								Invalid:   v.HasErr("confirm"),
								Describes: "confirm-error",
								Attrs: templ.Attributes{
									"autocomplete": "new-password",
									"required":     true,
								},
							})
							if v.HasErr("confirm") {
								<p class="ui-error-text" id="confirm-error" role="alert">{ v.Err("confirm") }</p>
							}
						</div>
						@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge, Block: true}, "submit") {
							{ i18n.T(ctx, i18n.KeyCreateAccount) }
						}
						<p class="goen-auth__hint">{ i18n.T(ctx, i18n.KeyRegisterEmailFollows) }</p>
						<p class="goen-auth__hint">
							{ i18n.T(ctx, i18n.KeyRegisterPolicyBefore) }<a href="/terms">{ i18n.T(ctx, i18n.KeyTermsPolicy) }</a>{ i18n.T(ctx, i18n.KeyRegisterPolicyBetween) }<a href="/privacy">{ i18n.T(ctx, i18n.KeyPrivacyPolicy) }</a>{ i18n.T(ctx, i18n.KeyRegisterPolicyAfter) }
						</p>
					</form>
				}
				<p class="goen-auth__alt">
					{ i18n.T(ctx, i18n.KeyHaveAccount) }
					<a href={ templ.SafeURL(v.authPageLink("/signin")) }>{ i18n.T(ctx, i18n.KeySignIn) }</a>
				</p>
			</div>
			@authDoor()
		</div>
	}
}

templ RegisterComplete(p frame.Page, v RegisterCompleteView) {
	@frame.Base(p) {
		<div class="goen-auth">
			<div class="goen-auth__panel">
				<h1 class="goen-auth__title">{ i18n.T(ctx, i18n.KeyRegisterCompleteTitle) }</h1>
				<p class="goen-auth__hint">{ i18n.T(ctx, i18n.KeyRegisterCompleteWhy) }</p>
				<form class="goen-auth__form" method="post" action="/register/complete">
					<input type="hidden" name="token" value={ v.Token }/>
					<input type="hidden" name="next" value={ v.Next }/>
					<div class="goen-field">
						@widget.Label(widget.LabelProps{For: "password"}) {
							{ i18n.T(ctx, i18n.KeyFieldPassword) }
						}
						@widget.Input(widget.FieldProps{
							ID:        "password",
							Name:      "password",
							Type:      "password",
							Invalid:   v.HasError(),
							Describes: "complete-error",
							Attrs: templ.Attributes{
								"autocomplete": "current-password",
								"autofocus":    true,
								"required":     true,
							},
						})
						if v.HasError() {
							<p class="ui-error-text" id="complete-error" role="alert">{ v.Error }</p>
						}
					</div>
					@widget.Button(widget.ButtonProps{ButtonStyle: widget.ButtonStylePrimary, Size: widget.SizeLarge, Block: true}, "submit") {
						{ i18n.T(ctx, i18n.KeyRegisterCompleteSubmit) }
					}
				</form>
				<p class="goen-auth__alt">
					{ i18n.T(ctx, i18n.KeyRegisterCompleteNotYou) }
					<a href="/forgot">{ i18n.T(ctx, i18n.KeyResetPasswordLink) }</a>
				</p>
			</div>
		</div>
	}
}
