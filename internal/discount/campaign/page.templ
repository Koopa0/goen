package campaign

import (
	"github.com/koopa0/goen/internal/i18n"
	"github.com/koopa0/goen/internal/ui/frame"
	"github.com/koopa0/goen/internal/ui/tile"
	"github.com/koopa0/goen/internal/ui/widget"
)

templ Page(p frame.Page, v View) {
	@frame.Base(p) {
		<div class="goen-listing">
			<header class="goen-campaign__band">
				if v.Image.Shown() {
					<img
						class="goen-campaign__header"
						src={ v.Image.URL }
						if v.Image.Srcset != "" {
							srcset={ v.Image.Srcset }
							sizes="(min-width: 1024px) 600px, 100vw"
						}
						alt={ v.Image.Alt }
						width="1600"
						height="600"
						fetchpriority="high"
					/>
				}
				<div class="goen-pagehead" data-tone={ v.Tone.Attr() }>
					<h1 class="goen-pagehead__title">{ v.Title }</h1>
					if v.Schedule.End != nil {
						<p class="goen-pagehead__ends">
							@Ends(*v.Schedule.End)
						</p>
					} else {
						@widget.StatLine(v.Schedule.Facts, widget.StatLinePlain)
					}
					if v.Schedule.HasPeriod {
						@widget.Period(v.Schedule.Period)
					}
				</div>
			</header>
			if v.Empty() {
				<div class="ui-empty">
					<p class="goen-empty__title">{ i18n.T(ctx, i18n.KeyCampaignEmpty) }</p>
					<p class="goen-empty__text">
						{ i18n.T(ctx, i18n.KeyCampaignEmptyHint) } <a href="/deals">{ i18n.T(ctx, i18n.KeyCampaignEmptyLink) }</a>
					</p>
				</div>
			} else {
				<h2 class="goen-sr-only">{ i18n.T(ctx, i18n.KeyResultsHeading) }</h2>
				<ul class="goen-tiles__grid" role="list">
					for _, t := range tile.FirstRowEager(v.Products) {
						@tile.Cell(t)
					}
				</ul>
			}
		</div>
	}
}
