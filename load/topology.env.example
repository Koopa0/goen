# Copy to load/topology.env and adjust. The load harness reads this file;
# it never touches the development database on 127.0.0.1:5433.
#
# Pinned tool and image versions. Record these in every evidence bundle.
K6_IMAGE=grafana/k6:0.54.0
POSTGRES_IMAGE=postgres:18-alpine
VALKEY_IMAGE=valkey/valkey:8.0.2-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.21.6
NGINX_IMAGE=nginx:1.27.4-alpine

# Fixture identity — repeating a profile with the same seed should give
# comparable logical outcomes.
LOAD_SEED=7292
LOAD_FIXTURE_ID=load-catalog-v1

# Host ports (isolated from `make db-up` on 5433 / `make run` on 9700).
LOAD_DB_PORT=15433
LOAD_HTTP_PORT=19700
LOAD_VALKEY_PORT=16379
LOAD_MAIL_UI_PORT=18026

# Per-process pool sizes are fixed in cmd/goen/main.go (store 25, admin 10,
# maintenance 2). Two app instances therefore offer 50 storefront connections.
LOAD_INSTANCE_COUNT=2
LOAD_STORE_MAX_CONNS_PER_INSTANCE=25
LOAD_ADMIN_MAX_CONNS_PER_INSTANCE=10

# k6 defaults for acceptance runs. Override per profile in load/k6/profiles/*.js.
LOAD_K6_VUS_MAX=40
LOAD_K6_DURATION=2m
LOAD_K6_ARRIVAL_RATE=20

# Provider doubles — simulated, not sandbox acceptance (#40).
LOAD_STRIPE_SIMULATED=1
LOAD_ECPAY_SIMULATED=0
