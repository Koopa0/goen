# Template only. Not evidence of credentials installed on the demo host.
# Operator-only settings read by restore-demo-db.sh; application GOEN_* settings
# belong in goen.service's environment (see manifest.env and .env.example).
# The login is goen, the schema owner, or a LOGIN role that is an INHERIT member
# of goen: PUBLIC may not connect, so the login connects through goen's own
# privilege (the script restores as goen either way). Never an application role.
GOEN_RESTORE_DATABASE_URL=postgres://goen:REPLACE_ON_HOST@127.0.0.1:5432/goen?sslmode=disable
GOEN_RESTORE_SNAPSHOT=/var/lib/goen/snapshots/catalog.dump
# The migrations of the checkout goen was built from; defaults to the
# checkout this script is in. A snapshot of any other schema is refused.
# GOEN_RESTORE_MIGRATIONS=/opt/goen/migrations
# This restores fixed dates and starts goen; it does not run seed/demo_shift.sql.
# Keep the snapshot's database name and anchor day separately for an operator-run
# calendar shift before goen starts. See deploy/demo/README.md.
