# Template only. Not evidence of credentials installed on the demo host.
# Use a separately authorized owner/restore login; never widen an application role.
GOEN_RESTORE_DATABASE_URL=postgres://restore_operator:REPLACE_ON_HOST@127.0.0.1:5432/goen?sslmode=disable
GOEN_RESTORE_SNAPSHOT=/var/lib/goen/snapshots/catalog.dump
