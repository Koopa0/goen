# Intended sanitized demo configuration for https://goen.koopa0.dev
# This is a template, not a current host attestation. Secret values are omitted.

GOEN_BASE_URL=https://goen.koopa0.dev
GOEN_ADDR=127.0.0.1:9700
GOEN_LOG_LEVEL=info

# This reference terminates TLS in front of goen. Only loopback reaches a listener
# on 127.0.0.1, so the proxy that sets X-Forwarded-For connects from there; goen
# refuses to start with a list that can never match that peer.
GOEN_TRUSTED_PROXIES=127.0.0.1,::1
# Keep secure cookies enabled here. Only local HTTP development uses this opt-out.
# GOEN_INSECURE_COOKIES=1

# Stripe sandbox: configure both secret values on the host, never in Git.
# GOEN_STRIPE_API_KEY=<sandbox key: sk_test_, rk_test_ or rkcs_test_>
# GOEN_STRIPE_WEBHOOK_SECRET=<matching sandbox endpoint signing secret>
# GOEN_STRIPE_SECRET_KEY is a compatibility fallback when GOEN_STRIPE_API_KEY
# is unset. Configure GOEN_STRIPE_API_KEY instead.

# This reference directs outbound mail to an on-host Mailpit sink, without relay credentials.
GOEN_SMTP_ADDR=127.0.0.1:1025
GOEN_SMTP_FROM=goen <no-reply@goen.example>
# GOEN_SMTP_USER=
# GOEN_SMTP_PASSWORD=

# Database URLs use least-privilege _svc roles; passwords redacted.
GOEN_DATABASE_URL=postgres://store_svc:***@127.0.0.1:5432/goen?sslmode=disable
GOEN_ADMIN_DATABASE_URL=postgres://admin_svc:***@127.0.0.1:5432/goen?sslmode=disable
GOEN_MAINTENANCE_DATABASE_URL=postgres://maintenance_svc:***@127.0.0.1:5432/goen?sslmode=disable

# Configure the required staff second-factor key on the host; replace this redaction.
# GOEN_TOTP_KEY=***

# Google sign-in is optional and unconfigured here. Set both values or neither.
# GOEN_GOOGLE_CLIENT_ID=
# GOEN_GOOGLE_CLIENT_SECRET=

# Shared public demo account. Set both on the host or neither; the sign-in page
# publishes both and every start repairs the verified customer account.
# Neither may be set beside a live Stripe key. Never use a staff address.
# GOEN_DEMO_ACCOUNT_EMAIL=demo@goen.example
# GOEN_DEMO_ACCOUNT_PASSWORD=<public demo password>

# This reference uses 綠界's staging invoice and store-map endpoints with the
# test merchant documented in .env.example. It specifies no production credentials.
# Leave both endpoint overrides unset: with a Stripe test key they default to staging,
# which answers the map with one fixed store and shows no map.
GOEN_ECPAY_MERCHANT_ID=2000132
GOEN_ECPAY_HASH_KEY=***
GOEN_ECPAY_HASH_IV=***
GOEN_ECPAY_LOGISTICS=b2c
# GOEN_ECPAY_BASE_URL=
# GOEN_ECPAY_LOGISTICS_BASE_URL=

# Seller (消保法 §18): this reference leaves the disclosure unset, so
# goen logs a startup warning. A shop that takes orders sets both.
# GOEN_SELLER=
# GOEN_SELLER_CONTACT=
