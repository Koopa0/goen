# Copy to .env and adjust. The Makefile reads .env when it is present.
#
# Never commit the real file, and never put a real secret in THIS one: this file
# IS committed. Every value below is a development default or a placeholder.

# ============================================================================
# Database
# ============================================================================

# The storefront pool. goen connects with this URL and immediately does
# SET ROLE store, so the schema's privilege model applies to the running binary:
# store cannot write stock, a payment, a ledger or the audit log directly — only
# the SECURITY DEFINER functions can. The binary refuses to serve if the session
# is still a superuser after that SET ROLE.
GOEN_DATABASE_URL=postgres://goen:goen@127.0.0.1:5433/goen?sslmode=disable

# The back office's pool, which does SET ROLE admin instead. It defaults to
# GOEN_DATABASE_URL, which is right in development — the owning superuser can
# assume either role — and wrong anywhere else: the two should connect as
# different accounts, so a storefront connection somebody gets hold of is not
# also the back office.
# GOEN_ADMIN_DATABASE_URL=postgres://admin_svc:changeme@db.internal:5432/goen?sslmode=verify-full

# What the recommendation projection's worker connects with. Same story as the
# admin pool, with one extra edge: pgxpool connects LAZILY, so a deployment that
# leaves this pointing at store_svc STARTS FINE and then fails its SET ROLE on
# every refresh — permission denied at boot and again every fifteen minutes,
# while the site looks healthy and 買了又買 quietly stops updating.
# GOEN_MAINTENANCE_DATABASE_URL=postgres://maintenance_svc:changeme@db.internal:5432/goen?sslmode=verify-full

# The roles the migration creates, and the one question each answers:
#
#   goen             owns the schema and runs migrations.
#   store            what a customer-facing request may do.
#   store_svc        who connects for it.
#   admin            what the back office may do — products, campaigns, refunds.
#   admin_svc        who connects for it.
#   maintenance      one function: rebuilding the co-purchase projection.
#   maintenance_svc  who connects for it.
#   reporting        what a dashboard may read.
#
# The _svc roles are the LOGIN ones; the rest are privilege sets with no password
# and no way to connect. "LOGIN" here is the PostgreSQL role attribute —
# permission to open a database connection. It has nothing to do with a customer
# signing in to the site.
#
# In development the URL above is the owning superuser, which can assume any of
# them, so everything runs — and the binary logs a warning, because a superuser
# LOGIN role can RESET ROLE back to full privilege. Anywhere else, point each URL
# at the matching _svc role, set its password out of band (ALTER ROLE store_svc
# LOGIN PASSWORD ...), and run migrations as goen on a separate connection. Each
# _svc role is NOSUPERUSER and owns nothing, so RESET ROLE cannot escalate it.
#
# One gap to know before deploying: the co-purchase worker has no URL of its own.
# It opens its pool from GOEN_DATABASE_URL and does SET ROLE maintenance, which
# the development superuser may do and store_svc may not — so a deployment that
# points GOEN_DATABASE_URL at store_svc fails to start until that worker gets its
# own connection string.

# ============================================================================
# HTTP
# ============================================================================

GOEN_ADDR=127.0.0.1:9700
GOEN_LOG_LEVEL=info

# The origin Stripe returns the customer to, and the one every emailed link
# points at. It falls back to http:// plus GOEN_ADDR, which is correct in
# development and silently wrong the moment anything is deployed — a customer
# would be sent back to 127.0.0.1 after paying, and a password-reset link would
# go nowhere. Set it.
# GOEN_BASE_URL=https://goen.example

# Development only, and `make run` sets it for you. The cart, session and
# placed-order cookies carry Secure and the __Host- prefix by default, and a
# browser never sends such a cookie back over the plain http:// this serves on —
# the cart would appear to lose itself on every request. The default is secure,
# so forgetting this in a deployment fails safe.
# GOEN_INSECURE_COOKIES=1

# ============================================================================
# Stripe
# ============================================================================

# With no key the site still sells: the payment page says 金流尚未啟用 and every
# other surface is unchanged. A key WITHOUT a webhook secret refuses to start,
# because that combination takes money over an endpoint nothing authenticates —
# and the signature-verified webhook is the only thing that ever marks an order
# paid.
# GOEN_STRIPE_SECRET_KEY=sk_test_replace_me
# GOEN_STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ============================================================================
# 統一發票 (ECPay 電子發票)
# ============================================================================

# The same posture as Stripe above: with no credentials goen issues nothing and
# the order page says so, while HALF a configuration refuses to start — a
# merchant id cannot sign a request without its keys, and finding that out at
# the first issue is finding it out after an order was placed.
#
# The values below are ECPay's own PUBLISHED staging credentials, usable without
# a contract. That is what makes this a real integration rather than a fake
# issuer: the code sends a real AES envelope to a real server, which really
# allocates a 發票號碼 and really refuses a malformed 統編. Going live is a
# change of these three values and GOEN_ECPAY_BASE_URL.
#
# Do NOT use them anywhere real. They file documents into a shared sandbox.
# GOEN_ECPAY_MERCHANT_ID=2000132
# GOEN_ECPAY_HASH_KEY=ejCk326UnaZWKisg
# GOEN_ECPAY_HASH_IV=q9jcZX8Ib9LM8wYk
# Defaults to https://einvoice-stage.ecpay.com.tw; production is
# https://einvoice.ecpay.com.tw and needs credentials of your own.
# GOEN_ECPAY_BASE_URL=

# ============================================================================
# Google sign-in
# ============================================================================

# The same posture again: with no credentials the button is absent and the two
# routes 404, so a deployment without them looks like one that never offered it.
# BOTH or neither — a client id that cannot exchange a code fails AFTER the
# customer has been to Google and consented, which reads as goen losing their
# account.
#
# Password authentication is complete on its own, so this adds convenience
# rather than capability.
#
# From console.cloud.google.com: create an OAuth 2.0 Client ID of type "Web
# application" and add GOEN_BASE_URL + /auth/google/callback as an authorised
# redirect URI. Google compares it on every exchange, which is what stops an
# authorisation code being redirected somewhere else.
# GOEN_GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
# GOEN_GOOGLE_CLIENT_SECRET=replace_me

# ============================================================================
# Staff second factor
# ============================================================================

# Encrypts stored TOTP secrets with AES-256-GCM. The value is hashed to the key,
# so any length will do — `openssl rand -hex 32` is a good source. A
# staff_totp_credentials row is a password-equivalent, so this is what stops a
# database dump alone defeating the second factor.
#
# Empty disables ENROLMENT the way an empty Stripe key disables payment: off and
# saying so, rather than half on with secrets in the clear.
#
# It is REQUIRED once GOEN_INSECURE_COOKIES is unset — that is, anywhere with TLS
# in front of it. Without a key the step-up gate is skipped entirely and the
# whole back office falls back to a password alone, silently, so goen refuses to
# start rather than serve /admin in that state.
# GOEN_TOTP_KEY=replace_me

# ============================================================================
# Rate limiting behind a proxy
# ============================================================================

# The CIDRs whose X-Forwarded-For goen will believe, comma-separated. Empty is
# the default and means it believes nobody: every rate limit keys on the
# connection's own address.
#
# Set this if ANYTHING terminates TLS in front of goen. Without it every visitor
# arrives from the proxy's address, so they all share one bucket and a single
# attacker can exhaust sign-in, /forgot, the newsletter and order lookup for
# everybody at once.
#
# Do NOT widen it to 0.0.0.0/0 to make a problem go away — that is "believe every
# client about who they are", which hands an attacker an unlimited supply of
# rate-limit keys and is strictly worse than having no limiter, because it looks
# like there is one. goen refuses that value at startup.
# GOEN_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# ============================================================================
# Email
# ============================================================================

# With no address, mail is written to the log instead of sent — visibly, which is
# what a development machine should do. The outbox worker still runs, so the
# whole path is exercised either way.
# GOEN_SMTP_ADDR=smtp.example:587
# GOEN_SMTP_FROM=goen <no-reply@goen.example>
# GOEN_SMTP_USER=
# GOEN_SMTP_PASSWORD=
