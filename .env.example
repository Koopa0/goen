# Copy to .env and adjust. The Makefile reads .env when it is present.
# Never commit the real file: it holds the database password.

GOEN_DATABASE_URL=postgres://goen:goen@127.0.0.1:5433/goen?sslmode=disable
GOEN_ADDR=127.0.0.1:9700
GOEN_LOG_LEVEL=info

# The application connects and immediately does SET ROLE goen_app, so the
# privilege model in the schema applies to the running binary. The binary
# refuses to serve if the session is still a superuser after that SET ROLE.
#
# In development the superuser above can assume goen_app directly (it is not a
# superuser once assumed), so the app runs — but it logs a warning, because a
# superuser LOGIN role can RESET ROLE back to full privilege. In production,
# connect as the NON-superuser login role the migration creates (goen_web): set
# its password out of band (ALTER ROLE goen_web LOGIN PASSWORD ...) and point
# GOEN_DATABASE_URL at it. Run migrations as the owner on a separate connection.
# goen_web is a member of goen_app and owns nothing, so RESET ROLE cannot
# escalate it.
